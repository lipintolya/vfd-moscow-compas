  "type": "module",
  "version": "0.0.1",
  "private": true,
  "homepage": "https://vfd74.ru",
  "repository": {
    "type": "git",
    "url": "https://github.com/lipintolya/vfd74.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
