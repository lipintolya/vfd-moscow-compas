---
import '../styles/global.css'
import Header from '../components/layout/Header.vue'
import Footer from '../components/layout/Footer.vue'
import PhotoLightbox from '../components/ui/PhotoLightbox.vue'
import CookieConsent from '../components/analytics/CookieConsent.astro'
import BackToTop from '../components/ui/BackToTop.astro'
import { HERO_COVER_IMAGE } from '../data/hero-image'
import { SITE } from '../config/site'

interface Props {
  title?:         string
  description?:   string
  ogImage?:       string
  /** Размер и описание og:image — с ними мессенджеры сразу рисуют крупное
      превью, не скачивая картинку для замера. Только для своих картинок
      с известным размером (например, /og/*.jpg 1200×630). */
  ogImageMeta?:   { width: number; height: number; alt: string }
  ogType?:        'website' | 'article'
  noIndex?:       boolean
  canonical?:     string
  structuredData?: Record<string, unknown> | Record<string, unknown>[]
  preloadImage?:  string
  /** srcset для preloadImage — мобильный LCP грузил тот же ~1670px
      десктопный файл, что и десктоп (5.2s LCP на throttled 4G вместо
      2.5s на десктопе). Опционально: только для картинок, у которых
      есть заранее сгенерированный уменьшенный вариант. */
  preloadImageSrcset?: string
  /** sizes для preloadImageSrcset — должен совпадать с sizes у самого <img>,
      иначе браузер выберет для preload один вариант, а для картинки другой
      и скачает оба. */
  preloadImageSizes?: string
  /** ISO-дата публикации — только для ogType="article" (og:article:published_time) */
  publishedTime?: string
}

const {
  title        = `Двери ${SITE.name} в ${SITE.address.mall} — салон дверей ${SITE.city.in}`,
  description  = `Фирменный салон дверей и алюминиевых перегородок в ${SITE.address.mall} (${SITE.address.street}, ${SITE.address.floor}): межкомнатные и скрытые двери ${SITE.manufacturerOf}.`,
  ogImage      = HERO_COVER_IMAGE,
  ogImageMeta,
  ogType       = 'website',
  noIndex      = false,
  canonical,
  structuredData,
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes = '(max-width: 63.9375rem) 100vw, 55vw',
  publishedTime,
} = Astro.props

const effectiveCanonical = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined)

/* Соцсети и поисковики понимают только полные адреса картинок, а фото
   сайта лежат в проекте (/media/…, /renders/…) — дописываем домен.
   В JSON-LD так же: любой путь сайта ("/…") становится полным адресом. */
const absolute = (src: string) => new URL(src, SITE.url).href
const ogImageUrl = absolute(ogImage)
const absolutizeLd = (v: unknown): unknown =>
  typeof v === 'string' ? (v.startsWith('/') && !v.startsWith('//') ? absolute(v) : v)
  : Array.isArray(v) ? v.map(absolutizeLd)
  : v && typeof v === 'object' ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, absolutizeLd(x)]))
  : v
const structuredDataJson = structuredData
  ? JSON.stringify(absolutizeLd(structuredData)).replace(/</g, '\\u003c')
  : null
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

    <meta property="og:title"        content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageUrl} />
    {ogImageMeta && (
      <>
        <meta property="og:image:width"  content={String(ogImageMeta.width)} />
        <meta property="og:image:height" content={String(ogImageMeta.height)} />
        <meta property="og:image:alt"    content={ogImageMeta.alt} />
      </>
    )}
    <meta property="og:type"        content={ogType} />

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <meta property="og:locale"       content="ru_RU" />
    <meta property="og:site_name"    content={SITE.studioName} />
    <meta name="theme-color"         content="#f7f7f8" />{/* = slate-50, meta не понимает var() */}

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageUrl} />

    {effectiveCanonical && <meta property="og:url" content={effectiveCanonical} />}
    {effectiveCanonical && <link rel="canonical" href={effectiveCanonical} />}

    <title>{title}</title>

    {/* Favicons */}
    <link rel="icon" type="image/x-icon" href="/favicons/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    {/* Google показывает в выдаче значок со стороной, кратной 48 px — 16 и 32 не берёт */}
    <link rel="icon" type="image/png" sizes="192x192" href="/favicons/android-chrome-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <meta name="theme-color" content="#1f1f23" />{/* = slate-900 (графит) */}

    {/* Имя сайта для системных поверхностей */}
    <meta name="apple-mobile-web-app-title" content={SITE.studioName} />
    <meta name="application-name" content={SITE.studioName} />


    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/manrope-cyrillic-wght-normal.woff2"
      crossorigin
    />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/manrope-latin-wght-normal.woff2"
      crossorigin
    />

    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        fetchpriority="high"
        imagesrcset={preloadImageSrcset}
        imagesizes={preloadImageSrcset ? preloadImageSizes : undefined}
      />
    )}

    {structuredDataJson && (
      <script
        type="application/ld+json"
        is:inline
        set:html={structuredDataJson}
      />
    )}
  </head>

  <body class="min-h-screen flex flex-col">

    {/* Header: только клиент, без hydration mismatch */}
    <Header client:only="vue" />

    <main
      id="main-content"
      class="flex-1 relative overflow-x-clip pt-(--header-height)"
    >
      <slot />
    </main>

    {/* Footer: ссылки на разделы — в готовом HTML, чтобы их видел любой робот
         без JS; Vue оживляет окна «Правовая информация» и «Разработчик» */}
    <Footer client:load />

    {/* Окно просмотра фото — одно на сайт, открывается событием
         'open-lightbox' (src/lib/lightbox.ts) */}
    <PhotoLightbox client:only="vue" />

    <BackToTop />

    <CookieConsent />

    <script>
      import { initCopyOnClick } from '../lib/copy-on-click'
      initCopyOnClick()
    </script>
  </body>
</html>

