---
import '../styles/global.css'
import Header from '../components/layout/Header.vue'
import Footer from '../components/layout/Footer.vue'
import YandexMetrika from '../components/analytics/YandexMetrika.astro'
import BackToTop from '../components/ui/BackToTop.astro'
import { HERO_COVER_IMAGE } from '../data/hero-image'

interface Props {
  title?:         string
  description?:   string
  ogImage?:       string
  ogType?:        'website' | 'article'
  noIndex?:       boolean
  canonical?:     string
  structuredData?: Record<string, unknown> | Record<string, unknown>[]
  preloadImage?:  string
  /** srcset для preloadImage — мобильный LCP грузил тот же ~1670px
      десктопный файл, что и десктоп (5.2s LCP на throttled 4G вместо
      2.5s на десктопе). Опционально: только для картинок, у которых
      есть заранее сгенерированный уменьшенный вариант. */
  preloadImageSrcset?: string
  /** ISO-дата публикации — только для ogType="article" (og:article:published_time) */
  publishedTime?: string
}

const {
  title        = 'Двери ВФД на Кашириных — Салон дверей в Челябинске',
  description  = 'Фирменный салон дверей и алюминиевых перегородок на Братьев Кашириных 131Б. Работаем с 2014 года.',
  ogImage      = HERO_COVER_IMAGE,
  ogType       = 'website',
  noIndex      = false,
  canonical,
  structuredData,
  preloadImage,
  preloadImageSrcset,
  publishedTime,
} = Astro.props

const effectiveCanonical = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined)
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : null
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

    <meta property="og:title"        content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:type"        content={ogType} />

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <meta property="og:locale"       content="ru_RU" />
    <meta property="og:site_name"    content="Салон дверей ВФД" />
    <meta name="theme-color"         content="#f8f9fa" />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    {effectiveCanonical && <meta property="og:url" content={effectiveCanonical} />}
    {effectiveCanonical && <link rel="canonical" href={effectiveCanonical} />}

    <title>{title}</title>

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicons/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <meta name="theme-color" content="#212124" />

    <!-- Имя сайта для системных поверхностей -->
    <meta name="apple-mobile-web-app-title" content="ВФД на Кашириных" />
    <meta name="application-name" content="ВФД на Кашириных" />

    <YandexMetrika />

    <link rel="preconnect" href="https://storage.yandexcloud.net" />
    <link rel="dns-prefetch" href="https://storage.yandexcloud.net" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/manrope-cyrillic-wght-normal.woff2"
      crossorigin
    />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/manrope-latin-wght-normal.woff2"
      crossorigin
    />

    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        fetchpriority="high"
        imagesrcset={preloadImageSrcset}
        imagesizes={preloadImageSrcset ? '(max-width: 1023px) 100vw, 55vw' : undefined}
      />
    )}

    {structuredDataJson && (
      <script
        type="application/ld+json"
        is:inline
        set:html={structuredDataJson}
      />
    )}
  </head>

  <body class="min-h-screen flex flex-col">

    <!-- Header: только клиент, без hydration mismatch -->
    <Header client:only="vue" />

    <main
      id="main-content"
      class="flex-1 relative overflow-x-hidden"
      style="padding-top: var(--header-height, 88px)"
    >
      <slot />
    </main>

    <!-- Footer: модальное окно требует Vue -->
    <Footer client:only="vue" />

    <BackToTop />

    <!-- Баннер согласия с обработкой данных (ФЗ-152) -->
    <div
      id="cookie-banner"
      style="
        display:none;
        position:fixed;
        bottom:calc(1rem + env(safe-area-inset-bottom));
        left:50%;
        transform:translateX(-50%);
        z-index:9999;
        width:calc(100% - 2rem);
        max-width:22rem;
      "
    >
      <div
        style="
          position:relative;
          background:#ffffff;
          border:1px solid #e2e8f0;
          border-radius:0.75rem;
          padding:0.875rem 2.25rem 0.875rem 1rem;
          display:flex;
          align-items:center;
          gap:0.75rem;
          box-shadow:0 8px 24px rgba(15,23,42,0.1),0 2px 6px rgba(15,23,42,0.05);
        "
      >
        <!-- Текст -->
        <p
          style="
            margin:0;
            color:#475569;
            font-size:0.8125rem;
            line-height:1.4;
            flex:1;
          "
        >
          Мы используем файлы <span style="color:#212124;font-weight:600;">куки</span>,
          чтобы обеспечить вам максимальное удобство на нашем сайте.&nbsp;
          <a
            href="/privacy/"
            style="
              color:#212124;
              text-decoration:underline;
              text-underline-offset:2px;
              font-weight:600;
            "
          >
            Подробнее
          </a>
        </p>

        <!-- Кнопка -->
        <button
          id="cookie-accept"
          style="
            flex-shrink:0;
            padding:0.4rem 0.875rem;
            background:#212124;
            color:#fff;
            border:none;
            border-radius:0.5rem;
            font-size:0.8125rem;
            font-weight:600;
            cursor:pointer;
            white-space:nowrap;
            transition:background .15s;
          "
        >
          Принять
        </button>

        <!-- Крестик -->
        <button
          id="cookie-close"
          aria-label="Закрыть"
          style="
            position:absolute;
            top:0.5rem;
            right:0.5rem;
            width:1.5rem;
            height:1.5rem;
            display:flex;
            align-items:center;
            justify-content:center;
            padding:0;
            background:transparent;
            border:none;
            border-radius:9999px;
            color:#94a3b8;
            cursor:pointer;
            transition:background .15s,color .15s;
          "
        >
          <svg
            viewBox="0 0 16 16"
            width="13"
            height="13"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 4l8 8M12 4l-8 8"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>
    </div>

    <script is:inline>
      (function() {
        var banner = document.getElementById('cookie-banner');

        if (!localStorage.getItem('cookie-consent') && banner) {
          banner.style.display = 'block';
        }

        function hideBanner() {
          localStorage.setItem('cookie-consent', '1');

          var banner = document.getElementById('cookie-banner');

          if (banner) {
            banner.style.transition = 'opacity .25s, transform .25s';
            banner.style.opacity = '0';
            banner.style.transform = 'translateX(-50%) translateY(1rem)';

            setTimeout(function() {
              banner.style.display = 'none';
            }, 260);
          }
        }

        var btn = document.getElementById('cookie-accept');

        if (btn) {
          btn.addEventListener('click', hideBanner);

          btn.addEventListener('mouseenter', function() {
            btn.style.background = '#3f3f42';
          });

          btn.addEventListener('mouseleave', function() {
            btn.style.background = '#212124';
          });
        }

        var closeBtn = document.getElementById('cookie-close');

        if (closeBtn) {
          closeBtn.addEventListener('click', hideBanner);

          closeBtn.addEventListener('mouseenter', function() {
            closeBtn.style.background = '#f1f5f9';
            closeBtn.style.color = '#475569';
          });

          closeBtn.addEventListener('mouseleave', function() {
            closeBtn.style.background = 'transparent';
            closeBtn.style.color = '#94a3b8';
          });
        }
      })();
    </script>

  </body>
</html>
