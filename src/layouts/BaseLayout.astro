---
import '../styles/global.css'
import Header from '../components/layout/Header.vue'
import Footer from '../components/layout/Footer.vue'
import PhotoLightbox from '../components/ui/PhotoLightbox.vue'
import YandexMetrika from '../components/analytics/YandexMetrika.astro'
import BackToTop from '../components/ui/BackToTop.astro'
import { HERO_COVER_IMAGE } from '../data/hero-image'
import { SITE } from '../config/site'

interface Props {
  title?:         string
  description?:   string
  ogImage?:       string
  /** Размер и описание og:image — с ними мессенджеры сразу рисуют крупное
      превью, не скачивая картинку для замера. Только для своих картинок
      с известным размером (например, /og/*.jpg 1200×630). */
  ogImageMeta?:   { width: number; height: number; alt: string }
  ogType?:        'website' | 'article'
  noIndex?:       boolean
  canonical?:     string
  structuredData?: Record<string, unknown> | Record<string, unknown>[]
  preloadImage?:  string
  /** srcset для preloadImage — мобильный LCP грузил тот же ~1670px
      десктопный файл, что и десктоп (5.2s LCP на throttled 4G вместо
      2.5s на десктопе). Опционально: только для картинок, у которых
      есть заранее сгенерированный уменьшенный вариант. */
  preloadImageSrcset?: string
  /** sizes для preloadImageSrcset — должен совпадать с sizes у самого <img>,
      иначе браузер выберет для preload один вариант, а для картинки другой
      и скачает оба. */
  preloadImageSizes?: string
  /** ISO-дата публикации — только для ogType="article" (og:article:published_time) */
  publishedTime?: string
}

const {
  title        = `Двери ${SITE.name} в ${SITE.address.mall} — салон дверей ${SITE.city.in}`,
  description  = `Фирменный салон дверей и алюминиевых перегородок в ${SITE.address.mall} (${SITE.address.street}, ${SITE.address.floor}): межкомнатные и скрытые двери ${SITE.manufacturerOf}.`,
  ogImage      = HERO_COVER_IMAGE,
  ogImageMeta,
  ogType       = 'website',
  noIndex      = false,
  canonical,
  structuredData,
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes = '(max-width: 63.9375rem) 100vw, 55vw',
  publishedTime,
} = Astro.props

const effectiveCanonical = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined)
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : null
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

    <meta property="og:title"        content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    {ogImageMeta && (
      <>
        <meta property="og:image:width"  content={String(ogImageMeta.width)} />
        <meta property="og:image:height" content={String(ogImageMeta.height)} />
        <meta property="og:image:alt"    content={ogImageMeta.alt} />
      </>
    )}
    <meta property="og:type"        content={ogType} />

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <meta property="og:locale"       content="ru_RU" />
    <meta property="og:site_name"    content={`Салон дверей ${SITE.name}`} />
    <meta name="theme-color"         content="#f7f7f8" /><!-- = slate-50, meta не понимает var() -->

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    {effectiveCanonical && <meta property="og:url" content={effectiveCanonical} />}
    {effectiveCanonical && <link rel="canonical" href={effectiveCanonical} />}

    <title>{title}</title>

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicons/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <meta name="theme-color" content="#1f1f23" /><!-- = slate-900 (графит) -->

    <!-- Имя сайта для системных поверхностей -->
    <meta name="apple-mobile-web-app-title" content={`${SITE.name} в ${SITE.address.mall}`} />
    <meta name="application-name" content={`${SITE.name} в ${SITE.address.mall}`} />

    <YandexMetrika />

    <link rel="preconnect" href="https://storage.yandexcloud.net" />
    <link rel="dns-prefetch" href="https://storage.yandexcloud.net" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/manrope-cyrillic-wght-normal.woff2"
      crossorigin
    />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/manrope-latin-wght-normal.woff2"
      crossorigin
    />

    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        fetchpriority="high"
        imagesrcset={preloadImageSrcset}
        imagesizes={preloadImageSrcset ? preloadImageSizes : undefined}
      />
    )}

    {structuredDataJson && (
      <script
        type="application/ld+json"
        is:inline
        set:html={structuredDataJson}
      />
    )}
  </head>

  <body class="min-h-screen flex flex-col">

    <!-- Header: только клиент, без hydration mismatch -->
    <Header client:only="vue" />

    <main
      id="main-content"
      class="flex-1 relative overflow-x-clip pt-(--header-height)"
    >
      <slot />
    </main>

    <!-- Footer: модальное окно требует Vue -->
    <Footer client:only="vue" />

    <!-- Окно просмотра фото — одно на сайт, открывается событием
         'open-lightbox' (src/lib/lightbox.ts) -->
    <PhotoLightbox client:only="vue" />

    <BackToTop />

    <!-- Баннер согласия с обработкой данных (ФЗ-152) -->
    <!-- Уведомление о куки (152-ФЗ). Показывается скриптом, пока согласие
         не сохранено; без JS не показывается вовсе. Стили — ниже, токены. -->
    <div id="cookie-banner" class="cookie" role="region" aria-label="Уведомление о файлах cookie" hidden>
      <div class="cookie__box">
        <p class="cookie__text">
          Мы используем файлы <strong>куки</strong>, чтобы обеспечить вам
          максимальное удобство на&nbsp;нашем сайте.&nbsp;<a href="/privacy/" class="cookie__link">Подробнее</a>
        </p>
        <button type="button" class="cookie__accept" data-cookie-ok>Принять</button>
        <button type="button" class="cookie__close" data-cookie-ok aria-label="Закрыть уведомление">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>

    <script is:inline>
      (function () {
        var KEY = 'cookie-consent';
        var banner = document.getElementById('cookie-banner');
        if (!banner) return;
        /* localStorage может бросить исключение (приватный режим Safari,
           запрет данных сайта) — тогда показываем баннер и просто
           прячем его по нажатию, без запоминания */
        var stored = null;
        try { stored = localStorage.getItem(KEY); } catch (e) {}
        if (stored) return;
        banner.hidden = false;
        var hide = function () {
          try { localStorage.setItem(KEY, '1'); } catch (e) {}
          banner.classList.add('cookie--leaving');
          setTimeout(function () { banner.hidden = true; }, 260);
        };
        banner.querySelectorAll('[data-cookie-ok]').forEach(function (btn) {
          btn.addEventListener('click', hide);
        });
      })();
    </script>

  </body>
</html>

<style is:global>
  /* ── Уведомление о куки ── */
  .cookie {
    position: fixed;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0rem));
    left: 50%;
    z-index: 9999;
    width: calc(100% - 2rem);
    max-width: 22rem;
    translate: -50% 0;
    transition: opacity 250ms var(--ease-out), translate 250ms var(--ease-out);
  }
  .cookie[hidden] { display: none; }
  .cookie--leaving { opacity: 0; translate: -50% 1rem; }
  .cookie__box {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 2.5rem 0.875rem 1rem;
    border: 0.0625rem solid var(--color-slate-200);
    border-radius: 0.75rem;
    background: var(--color-white);
    box-shadow:
      0 0.5rem 1.5rem color-mix(in srgb, var(--color-slate-900) 10%, transparent),
      0 0.125rem 0.375rem color-mix(in srgb, var(--color-slate-900) 5%, transparent);
  }
  .cookie__text { flex: 1; margin: 0; font-size: 0.8125rem; line-height: 1.4; color: var(--color-slate-600); }
  .cookie__text strong { font-weight: 600; color: var(--color-fg); }
  .cookie__link { font-weight: 600; color: var(--color-fg); text-decoration: underline; text-underline-offset: 0.125rem; }
  .cookie__accept {
    flex-shrink: 0;
    padding: 0.5rem 0.875rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--color-fg);
    color: var(--color-white);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 150ms var(--ease-out);
  }
  .cookie__accept:hover { background: var(--color-slate-700); }
  .cookie__close {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 999rem;
    background: transparent;
    color: var(--color-slate-400);
    cursor: pointer;
    transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out);
  }
  .cookie__close:hover { background: var(--color-slate-100); color: var(--color-slate-600); }
  .cookie__close svg { width: 0.8125rem; height: 0.8125rem; }
  .cookie :is(a, button):focus-visible { outline: 0.125rem solid var(--color-secondary-600); outline-offset: 0.125rem; }
  @media (prefers-reduced-motion: reduce) { .cookie { transition: none; } }
</style>
