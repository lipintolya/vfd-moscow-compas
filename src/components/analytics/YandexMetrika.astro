---
/**
 * Яндекс Метрика — загружается только в production и только если задан
 * ID счётчика (SITE.analytics.yandexMetrikaId в src/config/site.ts).
 *
 * Почему такая установка:
 * - is:inline — Astro/Vite не трогает и не бандлит скрипт
 * - import.meta.env.PROD — в dev счётчик молчит (статистика чистая, консоль не шумит)
 * - dataLayer инициализируется до ym() — ecommerce события не потеряются
 * - ssr:true убран — нужен только для Next.js/Nuxt SSR, не для Astro SSG
 * - referrer/url убраны из init — Метрика детектит их автоматически
 * - инициализация отложена до window 'load': вебвизор (webvisor: true) сканирует
 *   и трогает DOM сразу после старта, и если это происходит одновременно
 *   с гидратацией client:load Vue-островов (каталог, галереи), Vue видит DOM,
 *   отличающийся от отрендеренного на сервере → "Hydration completed but
 *   contains mismatches" в проде. К моменту window.load гидратация уже
 *   гарантированно завершена.
 */
import { SITE } from '../../config/site'

const counterId = SITE.analytics.yandexMetrikaId
const enabled = import.meta.env.PROD && Boolean(counterId)
---

{enabled && (
  <script is:inline define:vars={{ counterId: Number(counterId) }}>
    window.addEventListener('load', function () {
      window.dataLayer = window.dataLayer || [];

      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}
        k=e.createElement(t);a=e.getElementsByTagName(t)[0];
        k.async=1;k.src=r;a.parentNode.insertBefore(k,a)
      })(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');

      ym(counterId,'init',{
        clickmap:            true,
        trackLinks:          true,
        accurateTrackBounce: true,
        webvisor:            true,
        ecommerce:           'dataLayer',
      });
    });
  </script>
)}
{enabled && (
  <noscript>
    <div>
      <img src={`https://mc.yandex.ru/watch/${counterId}`} style="position:absolute;left:-9999px;" alt="" />
    </div>
  </noscript>
)}
