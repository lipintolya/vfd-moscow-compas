---
/**
 * Карточка объекта портфолио (src/data/portfolio-works.ts) — главная
 * («Наши работы») и страница скрытых дверей. Без `work` — заглушка
 * направления «Фотоотчёт появится позже» (пока объектов этой категории нет).
 * Превью — облегчённая копия обложки (scripts/gen-portfolio-thumbs.mjs).
 * Стили — токены дизайн-системы (.home, src/styles/home.css).
 */
import { CATEGORY_LABELS, OBJECT_TYPE_LABELS, type PortfolioWork, type WorkCategory } from '../../data/portfolio-works'
import { typograph } from '../../lib/typograph'

type Props =
  | { work: PortfolioWork; category?: never; headingLevel?: 'h3' | 'h4' }
  | { work?: never; category: WorkCategory; headingLevel?: never }

const { work, category, headingLevel = 'h3' } = Astro.props
const Heading = headingLevel
---

{work ? (
  <a href={`/portfolio/${work.id}/`} class="work">
    <span class="h-media work__media">
      <img src={`/renders/portfolio/${work.id}.webp`} alt={work.title} loading="lazy" decoding="async" />
    </span>
    <p class="h-meta work__meta">
      <span class="work__kind">{CATEGORY_LABELS[work.category]}</span>
      <span>{OBJECT_TYPE_LABELS[work.objectType]}</span>
    </p>
    <Heading class="h-h3 work__title">{typograph(work.title)}</Heading>
    <p class="h-body work__place">{typograph(work.location)}</p>
  </a>
) : (
  <a href="/portfolio/" class="work">
    <span class="h-media work__media work__media--empty">
      <span class="work__noimg">Фотоотчёт появится позже</span>
    </span>
    <p class="h-meta work__meta">
      <span class="work__kind">{CATEGORY_LABELS[category!]}</span>
    </p>
    <p class="h-h3 work__title">Объект появится позже</p>
  </a>
)}

<style>
  .work { display: flex; flex-direction: column; color: inherit; text-decoration: none; }
  /* Дверь — вертикальный кадр */
  .work__media { aspect-ratio: 4 / 5; }
  .work__media--empty { display: grid; place-items: center; }
  .work__noimg { font-size: 0.875rem; font-weight: 500; color: var(--h-muted); }

  /* Направление — тёмным, тип объекта — приглушённым */
  .work__meta { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; margin: 1.25rem 0 0; }
  .work__kind { font-weight: 600; color: var(--h-ink); }
  .work__title { margin-top: 0.375rem; }
  .work__place { margin-top: 0.5rem; font-size: 0.9375rem; }

  /* Наведение — красное подчёркивание названия (принцип 4 home.css) */
  .work__media img { transition: transform 700ms var(--ease-out); }
  .work:hover .work__media img { transform: scale(1.025); }
  .work:hover .work__title {
    text-decoration: underline;
    text-decoration-color: var(--h-signal);
    text-decoration-thickness: 0.0625rem;
    text-underline-offset: 0.2em;
  }
  @media (prefers-reduced-motion: reduce) {
    .work__media img { transition: none; }
    .work:hover .work__media img { transform: none; }
  }
</style>
