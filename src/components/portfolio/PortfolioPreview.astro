---
import { PORTFOLIO_WORKS, CATEGORY_LABELS } from '../../data/portfolio-works'

const preview = [...PORTFOLIO_WORKS]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 4)

const total = PORTFOLIO_WORKS.length
const totalWord = total === 1 ? 'фотоотчёт' : total < 5 ? 'фотоотчёта' : 'фотоотчётов'
---

{preview.length > 0 && (
  <section class="section" aria-labelledby="portfolio-preview-heading">
    <div class="container">

      <!-- Единая рамка-модуль — та же визуальная весовая категория, что у
           соседних секций (Скрытые двери, Рефлекс): иначе плитка
           из мелких превью терялась на фоне их крупных карточек с ценами
           и CTA. Сама архивная сетка (фото без затемнения, подпись под
           кадром) — как на /portfolio/, чтобы переход по «Все работы» не
           обрывался сменой стилистики. -->
      <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-8">
        <header class="flex flex-col gap-4 mb-6 sm:mb-8 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="t-eyebrow mb-2">Наши работы</p>
            <h2 id="portfolio-preview-heading" class="text-3xl font-medium leading-tight tracking-tight text-slate-900 md:text-4xl">
              Фотоотчёты с объектов
            </h2>
            <p class="mt-2 text-base text-slate-600">
              Реальные объекты наших клиентов по Челябинску и области · {total} {totalWord} в портфолио
            </p>
          </div>
          <a href="/portfolio/" class="btn btn-primary shrink-0">
            Все работы
            <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </header>

        <ul class="grid grid-cols-2 gap-x-3 gap-y-6 sm:grid-cols-4 sm:gap-x-5 sm:gap-y-8" role="list">
          {preview.map((work, i) => (
            <li>
              <a href={`/portfolio/${work.id}/`} class="group block min-w-0">
                <span class="relative block aspect-3/4 overflow-hidden rounded-xl border border-slate-200 bg-slate-100 shadow-sm transition-shadow duration-200 group-hover:shadow-md">
                  <img
                    src={`/renders/portfolio/${work.id}.webp`}
                    alt={work.title}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  />
                </span>
                <span class="mt-3 block">
                  <span class="block line-clamp-2 text-sm font-semibold leading-snug text-slate-900 transition-colors duration-150 group-hover:text-teal-700">
                    {work.title}
                  </span>
                  <span class="mt-1 flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs font-medium text-slate-400">
                    <span>{CATEGORY_LABELS[work.category]}</span>
                    <span aria-hidden="true">·</span>
                    <span>{work.label}</span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </section>
)}
