---
interface Props { dir?: 'left' | 'right'; size?: number; class?: string }
const { dir = 'right', size = 15, class: cls = '' } = Astro.props
const d = dir === 'left' ? 'M15 18l-6-6 6-6' : 'M9 18l6-6-6-6'
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <path d={d} stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
</svg>
