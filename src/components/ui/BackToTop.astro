---
/**
 * Кнопка «Наверх» — появляется, когда прокрутили больше экрана.
 * Без бесконечной пульсации: постоянное мигание в углу отвлекает от
 * страницы. Плавная прокрутка — только если не отключена анимация.
 */
---
<button
  id="btt-btn"
  type="button"
  aria-label="Наверх — прокрутить страницу в начало"
  title="Наверх"
>
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="1.8"
          stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</button>

<style>
  /* Графитовая плашка с белой стрелкой — в тон шапке; без градиента и цветной обводки */
  #btt-btn {
    position: fixed;
    right: 1.5rem;
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0rem));
    z-index: 48;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 1rem;
    background: var(--color-graphite);
    color: var(--color-white);
    box-shadow: 0 0.5rem 1.5rem color-mix(in srgb, var(--color-slate-950) 22%, transparent);
    cursor: pointer;
    opacity: 0;
    translate: 0 0.625rem;
    pointer-events: none;
    transition:
      opacity 220ms var(--ease-out),
      translate 220ms var(--ease-out),
      background-color 150ms var(--ease-out);
  }
  #btt-btn svg { width: 1.25rem; height: 1.25rem; transition: translate 200ms var(--ease-out); }

  #btt-btn.btt-visible {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
  }
  #btt-btn:hover { background: var(--color-slate-700); }
  #btt-btn:hover svg { translate: 0 -0.125rem; }
  #btt-btn:active { background: var(--color-slate-950); }
  #btt-btn:focus-visible { outline: 0.125rem solid var(--color-secondary-600); outline-offset: 0.1875rem; }

  @media (max-width: 40rem) {
    #btt-btn { right: 1rem; bottom: calc(1.25rem + env(safe-area-inset-bottom, 0rem)); }
  }

  @media (prefers-reduced-motion: reduce) {
    #btt-btn, #btt-btn svg { transition: opacity 150ms linear; }
    #btt-btn:hover svg { translate: none; }
  }
</style>

<script>
  const btn = document.getElementById('btt-btn')
  if (btn) {
    // Показываем после первого экрана — порог от высоты окна, а не число
    const onScroll = () => btn.classList.toggle('btt-visible', window.scrollY > window.innerHeight)
    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()

    const still = matchMedia('(prefers-reduced-motion: reduce)')
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: still.matches ? 'auto' : 'smooth' })
    })
  }
</script>
