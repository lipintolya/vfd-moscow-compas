---
/**
 * Кнопка «Наверх» — появляется, когда прокрутили больше экрана.
 * Без бесконечной пульсации: постоянное мигание в углу отвлекает от
 * страницы. Плавная прокрутка — только если не отключена анимация.
 */
---
<button
  id="btt-btn"
  type="button"
  aria-label="Наверх — прокрутить страницу в начало"
  title="Наверх"
>
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</button>

<style>
  #btt-btn {
    position: fixed;
    right: 1.5rem;
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0rem));
    z-index: 48;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0.0625rem solid var(--color-accent-200);
    border-radius: 999rem;
    background: linear-gradient(135deg, var(--color-accent-50) 0%, var(--color-white) 60%);
    color: var(--color-accent-600);
    box-shadow: 0 0.25rem 1rem color-mix(in srgb, var(--color-slate-950) 8%, transparent);
    cursor: pointer;
    opacity: 0;
    translate: 0 0.625rem;
    scale: 0.9;
    pointer-events: none;
    transition:
      opacity 220ms var(--ease-out),
      translate 220ms var(--ease-out),
      scale 220ms var(--ease-out),
      background-color 150ms var(--ease-out),
      border-color 150ms var(--ease-out);
  }
  #btt-btn svg { width: 1.125rem; height: 1.125rem; }

  #btt-btn.btt-visible {
    opacity: 1;
    translate: 0 0;
    scale: 1;
    pointer-events: auto;
  }
  #btt-btn:hover {
    border-color: var(--color-accent-400);
    background: linear-gradient(135deg, var(--color-accent-100) 0%, var(--color-accent-50) 100%);
    box-shadow: 0 0.375rem 1.25rem color-mix(in srgb, var(--color-accent-600) 22%, transparent);
  }
  #btt-btn:active { scale: 0.94; }
  #btt-btn:focus-visible { outline: 0.125rem solid var(--color-secondary-600); outline-offset: 0.125rem; }

  @media (max-width: 40rem) {
    #btt-btn { right: 1rem; bottom: calc(1.25rem + env(safe-area-inset-bottom, 0rem)); }
  }

  @media (prefers-reduced-motion: reduce) {
    #btt-btn { transition: opacity 150ms linear; }
  }
</style>

<script>
  const btn = document.getElementById('btt-btn')
  if (btn) {
    // Показываем после первого экрана — порог от высоты окна, а не число
    const onScroll = () => btn.classList.toggle('btt-visible', window.scrollY > window.innerHeight)
    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()

    const still = matchMedia('(prefers-reduced-motion: reduce)')
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: still.matches ? 'auto' : 'smooth' })
    })
  }
</script>
