---
/**
 * «Входные двери VFD со сменными панелями (накладками)» — отдельный блок на
 * /catalog/vhodnye-dveri/ после групп каталога, по образцу группы: слева название,
 * пояснение и «9 моделей, 40 накладок, от …», справа лента карточек моделей (VfdCard,
 * общая лента .rail со стрелками и полоской). Карточка ведёт на страницу модели
 * (/catalog/vhodnye-dveri/vfd/<id>/), где выбирают накладку. Данные и тексты —
 * src/data/entrance-vfd.ts.
 */
import VfdCard from './VfdCard.astro'
import RailBar from '../ui/RailBar.astro'
import { VFD_MODELS, VFD_SECTION } from '../../data/entrance-vfd'
import { typograph } from '../../lib/typograph'
---

<section id={VFD_SECTION.id} class="h-sec vfd-sec" aria-labelledby="vfd-title">
  <div class="container vfd-sec__layout">
    <header class="vfd-sec__head">
      <h2 id="vfd-title" class="h-h2 vfd-sec__title">{typograph(VFD_SECTION.title)}</h2>
      <p class="h-body vfd-sec__lead">{typograph(VFD_SECTION.lead)}</p>
      <p class="vfd-sec__meta">{VFD_SECTION.meta}</p>
    </header>

    <div class="rail vfd-sec__rail" data-rail>
      <ul class="rail__track vfd-sec__track" data-track role="list">
        {VFD_MODELS.map((m) => <li><VfdCard model={m} /></li>)}
      </ul>
      <RailBar />
    </div>
  </div>
</section>

<script>
  import { initRails } from '../../lib/rail'
  initRails()
</script>

<style>
  .vfd-sec { scroll-margin-top: 1rem; }
  .vfd-sec__layout { display: grid; gap: 1.75rem var(--h-gutter); }
  .vfd-sec__head { display: grid; gap: 0.75rem; align-content: start; }
  .vfd-sec__title, .vfd-sec__lead, .vfd-sec__meta { margin: 0; }
  .vfd-sec__title { font-size: clamp(1.625rem, 2vw + 1rem, 2.25rem); }
  .vfd-sec__lead { color: var(--h-soft); }
  .vfd-sec__meta { margin-top: 0.25rem; font-size: 0.9375rem; font-weight: 600; color: var(--h-ink); }
  .vfd-sec__rail { min-width: 0; }
  .vfd-sec__track { --rail-col: 9rem; --rail-gap: 0.875rem; }
  @media (min-width: 43.75rem) { .vfd-sec__track { --rail-col: 14.5rem; --rail-gap: 1.5rem; } }
  @media (min-width: 62.5rem) {
    .vfd-sec__layout { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .vfd-sec__head { grid-column: 1 / span 3; }
    .vfd-sec__rail { grid-column: 4 / span 9; }
  }
</style>
