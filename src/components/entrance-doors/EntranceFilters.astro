---
/**
 * Фильтры и сортировка каталога входных дверей (ориентир — строка фильтров
 * на volhovec.ru): графитовая «Все фильтры», выпадающие таблетки «Тип двери»,
 * «Цена», «Сталь» (на компьютере), сортировка и строка «Подходит N из M».
 * На телефоне остаются «Фильтры» и сортировка, все группы открываются листом
 * снизу. Один набор чекбоксов выводится дважды (в выпадашке и в листе) —
 * скрипт держит их в согласии. Карточки фильтруются по data-атрибутам
 * `li[data-door-li]` (group, pf — ступень цены, steel, price, name), без
 * запросов к серверу; без скрипта блок скрыт, а каталог работает как есть.
 * Событие doors:filter ({ group }) включает одну группу — его шлёт «Подберём
 * за минуту» и путеводитель. Тексты и ступени — в src/data/entrance-doors.ts.
 */
import { DOOR_GROUPS, PRICE_FACETS, STEEL_FACETS, ENTRANCE_DOORS, priceFacetOf } from '../../data/entrance-doors'
import { pluralRu } from '../../lib/plural'

const total = ENTRANCE_DOORS.length
const count = (pick: (d: (typeof ENTRANCE_DOORS)[number]) => string, v: string) => ENTRANCE_DOORS.filter((d) => pick(d) === v).length

const facets = [
  { id: 'group', label: 'Тип двери', options: DOOR_GROUPS.map((g) => ({ value: g.id, label: g.nav, n: count((d) => d.group, g.id) })) },
  { id: 'price', label: 'Цена «от», ₽', options: PRICE_FACETS.map((f) => ({ value: f.id, label: f.label, n: count((d) => priceFacetOf(d.from), f.id) })) },
  { id: 'steel', label: 'Сталь', options: STEEL_FACETS.map((v) => ({ value: v, label: `${v} мм`, n: count((d) => d.steel, v) })) },
]
const SORTS = [
  { id: 'price-asc', label: 'Сначала недорогие' },
  { id: 'price-desc', label: 'Сначала дорогие' },
  { id: 'name', label: 'По названию' },
]
const doorsWord = (n: number) => pluralRu(n, ['модель', 'модели', 'моделей'])
---

<div class="ef" data-filters hidden>
  <div class="container">
    <div class="ef__bar">
      <button type="button" class="ef__all" data-open aria-haspopup="dialog">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true"><path d="M3 6h9M16 6h1M3 14h1M8 14h9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="14" cy="6" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="6" cy="14" r="2" stroke="currentColor" stroke-width="1.6"/></svg>
        <span>Все фильтры</span>
        <b class="ef__badge" data-badge hidden></b>
      </button>

      <div class="ef__pills">
        {facets.map((f) => (
          <details class="ef__pill" data-pill={f.id}>
            <summary>
              <span>{f.label}</span>
              <b class="ef__badge ef__badge--pill" data-pill-badge hidden></b>
              <svg class="ef__chev" viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="ef__pop">
              {f.options.map((o) => (
                <label class="ef__opt">
                  <input type="checkbox" data-facet={f.id} value={o.value} />
                  <span class="ef__box" aria-hidden="true"></span>
                  <span class="ef__txt">{o.label}</span>
                  <span class="ef__n">{o.n}</span>
                </label>
              ))}
            </div>
          </details>
        ))}
      </div>

      <label class="ef__sort">
        <span class="sr-only">Сортировка</span>
        <select data-sort>
          {SORTS.map((s) => <option value={s.id}>{s.label}</option>)}
        </select>
        <svg class="ef__chev" viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </label>
    </div>
    <p class="ef__count" role="status" aria-live="polite">
      <span data-count>{total} {doorsWord(total)}</span>
      <button type="button" class="ef__reset" data-reset hidden>Сбросить фильтры</button>
    </p>
  </div>

  <dialog class="ef__sheet" data-sheet aria-labelledby="ef-sheet-title">
    <form method="dialog" class="ef__form">
      <header class="ef__head">
        <h2 id="ef-sheet-title" class="ef__title">Фильтры</h2>
        <button type="submit" class="ef__x" aria-label="Закрыть">
          <svg viewBox="0 0 16 16" width="18" height="18" fill="none" aria-hidden="true"><path d="m3.5 3.5 9 9m0-9-9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>
      </header>
      <div class="ef__body">
        {facets.map((f) => (
          <fieldset class="ef__set">
            <legend>{f.label}</legend>
            {f.options.map((o) => (
              <label class="ef__opt">
                <input type="checkbox" data-facet={f.id} value={o.value} />
                <span class="ef__box" aria-hidden="true"></span>
                <span class="ef__txt">{o.label}</span>
                <span class="ef__n">{o.n}</span>
              </label>
            ))}
          </fieldset>
        ))}
      </div>
      <footer class="ef__foot">
        <button type="button" class="h-btn h-btn--quiet" data-reset-sheet>Сбросить</button>
        <button type="submit" class="h-btn h-btn--ink" data-apply>Показать&nbsp;<span data-count-sheet>{total}</span></button>
      </footer>
    </form>
  </dialog>
</div>

<script>
  import { pluralRu } from '../../lib/plural'

  type Facet = 'group' | 'price' | 'steel'
  const FACETS: Facet[] = ['group', 'price', 'steel']
  const root = document.querySelector<HTMLElement>('[data-filters]')
  if (root) {
    root.hidden = false
    const state: Record<Facet, Set<string>> = { group: new Set(), price: new Set(), steel: new Set() }
    const items = [...document.querySelectorAll<HTMLElement>('li[data-door-li]')]
    const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')]
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[data-facet]')]
    const sheet = root.querySelector<HTMLDialogElement>('[data-sheet]')!
    const sortSel = root.querySelector<HTMLSelectElement>('[data-sort]')!
    const countEl = root.querySelector<HTMLElement>('[data-count]')!
    const countSheet = root.querySelector<HTMLElement>('[data-count-sheet]')!
    const badge = root.querySelector<HTMLElement>('[data-badge]')!
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]')!
    const pills = [...root.querySelectorAll<HTMLDetailsElement>('details.ef__pill')]
    const total = items.length
    const plural = (n: number) => pluralRu(n, ['модель', 'модели', 'моделей'])
    const smooth = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth')

    const matches = (li: HTMLElement) =>
      (!state.group.size || state.group.has(li.dataset.group!)) &&
      (!state.price.size || state.price.has(li.dataset.pf!)) &&
      (!state.steel.size || state.steel.has(li.dataset.steel!))

    function sortItems() {
      const how = sortSel.value
      const key = (li: HTMLElement) => (how === 'name' ? 0 : Number(li.dataset.price))
      const ordered = [...items].sort((a, b) => {
        if (how === 'name') return a.dataset.name!.localeCompare(b.dataset.name!, 'ru')
        return how === 'price-desc' ? key(b) - key(a) : key(a) - key(b)
      })
      ordered.forEach((li, i) => { li.style.order = String(i) })
    }

    function apply() {
      let shown = 0
      for (const li of items) {
        const ok = matches(li)
        li.hidden = !ok
        if (ok) shown++
      }
      for (const s of sections) s.hidden = !s.querySelector('li[data-door-li]:not([hidden])')
      const active = FACETS.reduce((n, f) => n + state[f].size, 0)
      countEl.textContent = !active ? `${total} ${plural(total)}` : shown ? `Подходит ${shown} из ${total} ${plural(total)}` : 'Ничего не нашлось — снимите часть фильтров'
      countSheet.textContent = String(shown)
      resetBtn.hidden = !active
      badge.hidden = !active
      badge.textContent = String(active)
      for (const p of pills) {
        const b = p.querySelector<HTMLElement>('[data-pill-badge]')!
        const n = state[p.dataset.pill as Facet].size
        b.hidden = !n
        b.textContent = String(n)
        p.classList.toggle('is-set', n > 0)
      }
      for (const i of inputs) i.checked = state[i.dataset.facet as Facet].has(i.value)
    }

    function reset() {
      for (const f of FACETS) state[f].clear()
      apply()
    }

    for (const i of inputs) {
      i.addEventListener('change', () => {
        const set = state[i.dataset.facet as Facet]
        if (i.checked) set.add(i.value)
        else set.delete(i.value)
        apply()
      })
    }
    sortSel.addEventListener('change', sortItems)
    resetBtn.addEventListener('click', reset)
    root.querySelector('[data-reset-sheet]')!.addEventListener('click', reset)

    /* Лист фильтров: нативный <dialog> (фокус и Esc), страница под ним не прокручивается */
    const lock = (on: boolean) => { document.documentElement.style.overflow = on ? 'hidden' : '' }
    root.querySelector('[data-open]')!.addEventListener('click', () => { for (const p of pills) p.open = false; sheet.showModal(); lock(true) })
    sheet.addEventListener('close', () => lock(false))
    sheet.addEventListener('click', (e) => { if (e.target === sheet) sheet.close() })

    /* Выпадашки: открыта одна, закрываются кликом мимо и Esc */
    for (const p of pills) p.addEventListener('toggle', () => { if (p.open) for (const q of pills) if (q !== p) q.open = false })
    document.addEventListener('click', (e) => { if (!(e.target as Element).closest('details.ef__pill')) for (const p of pills) p.open = false })
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') for (const p of pills) p.open = false })

    /* «Подберём за минуту» и путеводитель включают одну группу и ведут к ней */
    document.addEventListener('doors:filter', (e) => {
      const group = (e as CustomEvent<{ group: string }>).detail.group
      for (const f of FACETS) state[f].clear()
      if (group !== 'all') state.group.add(group)
      apply()
      const target = group !== 'all' ? document.getElementById(`doors-${group}`) : root
      target?.scrollIntoView({ block: 'start', behavior: smooth() })
    })

    /* Плитки групп ведут к секции; если фильтр её скрыл — сначала сбрасываем */
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a.edn__tile')) {
      a.addEventListener('click', () => {
        const s = document.querySelector<HTMLElement>(a.getAttribute('href')!)
        if (s?.hidden) reset()
      })
    }

    sortItems()
    apply()
  }
</script>

<style>
  .ef {
    position: sticky;
    top: var(--header-height);
    z-index: 30;
    padding: 0.625rem 0 0.25rem;
    background: var(--color-white);
    border-bottom: 0.0625rem solid var(--h-rule);
  }
  .ef[hidden] { display: none; }
  .ef__bar { display: flex; align-items: center; gap: 0.5rem; }
  .ef__all, .ef__pill > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding: 0 1.125rem;
    border: 0.0625rem solid var(--color-slate-300);
    border-radius: 999rem;
    background: none;
    color: var(--h-ink);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
    transition: border-color 200ms var(--ease-out), background-color 200ms var(--ease-out);
  }
  .ef__pill > summary::-webkit-details-marker { display: none; }
  .ef__all { border-color: var(--h-ink); background: var(--h-ink); color: var(--color-white); }
  .ef__all:hover { background: var(--color-slate-700); border-color: var(--color-slate-700); }
  .ef__pill > summary:hover { border-color: var(--h-ink); }
  .ef__pill[open] > summary, .ef__pill.is-set > summary { border-color: var(--h-ink); }
  .ef__all:focus-visible, .ef__pill > summary:focus-visible, .ef__sort select:focus-visible, .ef__x:focus-visible, .ef__reset:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.125rem; }
  .ef__chev { flex: none; transition: transform 200ms var(--ease-out); }
  .ef__pill[open] .ef__chev { transform: rotate(180deg); }
  .ef__badge { display: inline-grid; place-items: center; min-width: 1.25rem; height: 1.25rem; padding: 0 0.3125rem; border-radius: 999rem; background: var(--color-white); color: var(--h-ink); font-size: 0.75rem; font-weight: 600; line-height: 1; }
  .ef__badge[hidden] { display: none; }
  .ef__badge--pill { background: var(--h-ink); color: var(--color-white); }

  /* Выпадашки — только на компьютере; на телефоне всё в листе */
  .ef__pills { display: none; gap: 0.5rem; }
  .ef__pill { position: relative; }
  .ef__pop {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 5;
    display: grid;
    gap: 0.125rem;
    min-width: 16rem;
    padding: 0.5rem;
    border: 0.0625rem solid var(--h-rule);
    border-radius: 1rem;
    background: var(--color-white);
    box-shadow: 0 1rem 2.5rem -1rem color-mix(in srgb, var(--color-graphite) 35%, transparent);
  }
  @media (min-width: 43.75rem) { .ef__pills { display: flex; } }

  .ef__sort { position: relative; display: inline-flex; align-items: center; margin-left: auto; color: var(--h-ink); }
  .ef__sort select { appearance: none; height: 2.75rem; padding: 0 1.5rem 0 0.5rem; border: 0; background: none; color: inherit; font: inherit; font-size: 0.9375rem; font-weight: 500; cursor: pointer; }
  .ef__sort .ef__chev { position: absolute; right: 0.25rem; pointer-events: none; }

  .ef__count { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; margin: 0.25rem 0 0; min-height: 1.75rem; font-size: 0.875rem; color: var(--h-muted); }
  .ef__reset { padding: 0; border: 0; background: none; color: var(--h-ink); font: inherit; font-weight: 600; text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; }
  .ef__reset:hover { color: var(--h-signal); }
  .ef__reset[hidden] { display: none; }

  /* Строка выбора: чекбокс, подпись, сколько моделей */
  .ef__opt { display: flex; align-items: center; gap: 0.75rem; min-height: 2.75rem; padding: 0 0.625rem; border-radius: 0.625rem; color: var(--h-ink); cursor: pointer; }
  .ef__opt:hover { background: var(--h-wall); }
  .ef__opt input { position: absolute; opacity: 0; pointer-events: none; }
  .ef__box { position: relative; flex: none; width: 1.25rem; height: 1.25rem; border: 0.09375rem solid var(--color-slate-400); border-radius: 0.3125rem; transition: background-color 150ms var(--ease-out), border-color 150ms var(--ease-out); }
  .ef__opt input:checked + .ef__box { background: var(--h-ink); border-color: var(--h-ink); }
  .ef__opt input:checked + .ef__box::after { content: ''; position: absolute; left: 0.3125rem; top: 0.0625rem; width: 0.3125rem; height: 0.625rem; border: solid var(--color-white); border-width: 0 0.125rem 0.125rem 0; transform: rotate(45deg); }
  .ef__opt input:focus-visible + .ef__box { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.125rem; }
  .ef__txt { flex: 1; font-size: 0.9375rem; }
  .ef__n { font-size: 0.8125rem; color: var(--h-muted); font-variant-numeric: tabular-nums; }

  /* Лист фильтров: на телефоне снизу, на компьютере — по центру */
  .ef__sheet { width: 100%; max-width: 100%; max-height: 88dvh; margin: auto 0 0; padding: 0; border: 0; border-radius: 1.25rem 1.25rem 0 0; background: var(--color-white); color: var(--h-ink); overflow: hidden; }
  .ef__sheet::backdrop { background: color-mix(in srgb, var(--color-graphite) 55%, transparent); }
  .ef__sheet[open] { display: flex; animation: ef-up 280ms var(--ease-out); }
  @keyframes ef-up { from { transform: translateY(2rem); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .ef__sheet[open] { animation: none; } }
  .ef__form { display: flex; flex-direction: column; width: 100%; min-height: 0; }
  .ef__head { display: flex; align-items: center; justify-content: space-between; padding: 1.125rem 1.25rem 0.5rem; }
  .ef__title { margin: 0; font-size: 1.25rem; font-weight: 600; }
  .ef__x { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; padding: 0; border: 0; border-radius: 999rem; background: var(--h-wall); color: var(--h-ink); cursor: pointer; }
  .ef__body { flex: 1; min-height: 0; overflow-y: auto; padding: 0.5rem 0.75rem 1rem; overscroll-behavior: contain; }
  .ef__set { margin: 0 0 0.75rem; padding: 0; border: 0; }
  .ef__set legend { padding: 0.75rem 0.625rem 0.375rem; font-size: 0.875rem; color: var(--h-muted); }
  .ef__foot { display: grid; grid-template-columns: 1fr 1.6fr; gap: 0.75rem; padding: 0.875rem 1.25rem calc(0.875rem + env(safe-area-inset-bottom, 0rem)); border-top: 0.0625rem solid var(--h-rule); }
  .ef__foot .h-btn { width: 100%; justify-content: center; }
  @media (min-width: 43.75rem) {
    .ef__sheet { max-width: 30rem; margin: auto; border-radius: 1.25rem; }
  }
</style>
