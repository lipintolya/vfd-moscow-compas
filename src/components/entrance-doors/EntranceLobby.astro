---
/**
 * Визуализации входных дверей на площадке и в холле — под каталогом на
 * /catalog/vhodnye-dveri/, перед путеводителем. Рендеры — assets/entrance-renders/
 * lobby-<n>.* → npm run gen:entrance-renders; места и подписи — ENTRANCE_LOBBY
 * (src/data/entrance-guide.ts). Нет ни одного рендера — блок не выводится.
 * Кадр открывается крупно в общем просмотрщике (data-lightbox).
 */
import { ENTRANCE_LOBBY } from '../../data/entrance-guide'
import { renderOf } from '../../lib/entrance-renders'
import { typograph } from '../../lib/typograph'

const shots = ENTRANCE_LOBBY.visuals.map((v) => renderOf(v)).filter((r) => r !== null)
const sizes = '(min-width: 56.25rem) 32vw, (min-width: 43.75rem) 48vw, 82vw'
---

{shots.length > 0 && (
  <section id="lobby" class="h-sec h-sec--tight-top" aria-labelledby="lobby-title">
    <div class="container">
      <header class="h-head">
        <h2 id="lobby-title" class="h-h2">{typograph(ENTRANCE_LOBBY.title)}</h2>
        <p class="h-lead">{typograph(ENTRANCE_LOBBY.lead)}</p>
      </header>
      <ul
        class="lobby h-rail"
        role="list"
        data-lightbox
        data-lightbox-images={JSON.stringify(shots.map((r) => ({ src: r.src, alt: r.alt })))}
      >
        {shots.map((r, i) => (
          <li>
            <button type="button" class="h-media lobby__zoom" data-lightbox-index={i} aria-label={`Открыть крупно: ${r.alt}`}>
              <img src={r.src} srcset={r.srcset} sizes={sizes} alt={r.alt} width={r.width} height={r.height} loading="lazy" decoding="async" />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<script>
  import { initLightboxGroups } from '../../lib/lightbox'
  initLightboxGroups()
</script>

<style>
  .lobby { display: grid; gap: var(--h-tile-gap); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 43.75rem) { .lobby { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* Колонок столько, сколько кадров */
  @media (min-width: 56.25rem) { .lobby { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); } }
  .lobby__zoom { width: 100%; padding: 0; border: 0; cursor: zoom-in; aspect-ratio: 3 / 2; }
  .lobby__zoom img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease-out); }
  .lobby__zoom:hover img { transform: scale(1.02); }
  @media (prefers-reduced-motion: reduce) { .lobby__zoom img { transition: none; } .lobby__zoom:hover img { transform: none; } }
</style>
