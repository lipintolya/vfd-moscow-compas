---
/**
 * Выбор накладки на странице модели входной двери VFD (/catalog/vhodnye-dveri/vfd/<id>/).
 * Данные, цены «от» и тексты — src/data/entrance-vfd.ts; разметку собирает
 * src/lib/vfd-view.ts, одна и та же на сервере (первый показ) и в браузере (выбор).
 *
 * Слева сцена: дверь снаружи, в интерьере или изнутри с выбранной накладкой; справа
 * название, накладка (серия → цвет с миниатюрами), цена «от», кнопки Telegram и MAX
 * с готовым текстом (модель, накладка, цена) и раскрывающиеся характеристики и
 * комплектация. Без скрипта виден первый показ, выбор не работает.
 */
import DoorRequest from './DoorRequest.astro'
import { VFD_SECTION, VIEW_LABEL, type VfdModel } from '../../data/entrance-vfd'
import { initialState, headHtml, stageImage, specsHtml, hardwareHtml, askText } from '../../lib/vfd-view'

interface Props { model: VfdModel }
const { model } = Astro.props
const state = initialState(model.id)
const img = stageImage(state)
const views = Object.keys(VIEW_LABEL) as (keyof typeof VIEW_LABEL)[]
---

<section class="vfd vfd--page" aria-label="Выбор накладки" data-vfd data-model={model.id}>
  <div class="container">
    <div class="vfd__grid">
      <div class="vfd__stage">
        <div class="h-toggles" role="group" aria-label="Вид двери">
          {views.map((v) => <button type="button" class="h-toggle" data-view={v} aria-pressed={v === state.view}>{VIEW_LABEL[v]}</button>)}
        </div>
        <div class="h-media vfd__frame" data-vfd-frame data-view={state.view}>
          <img data-vfd-img src={img.src} srcset={img.srcset} sizes={img.sizes} alt={img.alt} width={img.width} height={img.height} loading="eager" fetchpriority="high" decoding="async" />
        </div>
      </div>

      <div class="vfd__info">
        <div data-vfd-head set:html={headHtml(state)} />
        <div class="vfd__ask"><DoorRequest text={askText(state)} /></div>
        <details class="vfd__more">
          <summary>{VFD_SECTION.specsTitle}</summary>
          <div data-vfd-specs set:html={specsHtml(model)} />
        </details>
        <details class="vfd__more">
          <summary>{VFD_SECTION.hardwareTitle}</summary>
          <div data-vfd-hardware set:html={hardwareHtml(model)} />
        </details>
      </div>
    </div>
  </div>
</section>

<script>
  import { initialState, settle, modelOf, stageImage, headHtml, askText, type VfdState, type VfdView } from '../../lib/vfd-view'
  import { optionsOf } from '../../data/entrance-vfd'
  import { telegramWithText, maxWithText } from '../../lib/messengers'

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches

  for (const root of document.querySelectorAll<HTMLElement>('[data-vfd]')) {
    let state: VfdState = initialState(root.dataset.model!)
    const frame = root.querySelector<HTMLElement>('[data-vfd-frame]')!
    const img = frame.querySelector<HTMLImageElement>('[data-vfd-img]')!
    const head = root.querySelector<HTMLElement>('[data-vfd-head]')!
    const tg = root.querySelector<HTMLAnchorElement>('[data-ask="tg"]')
    const max = root.querySelector<HTMLAnchorElement>('[data-ask="max"]')
    let swapId = 0

    /* Кадр меняется, когда новый уже загружен и разобран, — без пустой рамки между кадрами */
    function showImage() {
      const next = stageImage(state)
      const apply = () => {
        img.srcset = next.srcset
        img.sizes = next.sizes
        img.src = next.src
        img.alt = next.alt
        img.width = next.width
        img.height = next.height
        frame.classList.remove('is-swap')
      }
      const id = ++swapId
      const pre = new Image()
      pre.sizes = next.sizes
      pre.srcset = next.srcset
      pre.src = next.src
      if (still) { apply(); return }
      frame.classList.add('is-swap')
      const done = () => { if (id === swapId) apply() }
      Promise.race([pre.decode(), new Promise((r) => setTimeout(r, 700))]).then(done, done)
    }

    function render(prev: VfdState, focus?: string) {
      root.querySelectorAll<HTMLElement>('[data-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === state.view)))
      frame.dataset.view = state.view
      showImage()
      if (prev.skin !== state.skin) {
        head.innerHTML = headHtml(state)
        // фокус с клавиатуры не должен теряться вместе с заменённой кнопкой
        if (focus) head.querySelector<HTMLElement>(focus)?.focus()
      }
      const text = askText(state)
      if (tg) tg.href = telegramWithText(text)
      if (max) max.dataset.copyText = maxWithText(text)
    }

    function set(patch: Partial<VfdState>, focus?: string) {
      const prev = state
      state = settle(patch.model ?? state.model, patch.skin ?? state.skin, patch.view ?? state.view)
      render(prev, focus)
    }

    root.addEventListener('click', (e) => {
      const t = (e.target as Element).closest<HTMLElement>('[data-view], [data-series], [data-skin]')
      if (!t || !root.contains(t)) return
      if (t.dataset.view) set({ view: t.dataset.view as VfdView })
      else if (t.dataset.skin) set({ skin: t.dataset.skin, view: 'inside' }, `[data-skin="${t.dataset.skin}"]`)
      else if (t.dataset.series) {
        // серия: первая накладка серии у этой модели
        const first = optionsOf(modelOf(state.model)).find((o) => o.skin.name === t.dataset.series)
        if (first) set({ skin: first.skin.id, view: 'inside' }, `[data-series="${CSS.escape(t.dataset.series)}"]`)
      }
    })
  }
</script>

<style is:global>
  /* Страница модели: сцена и выбор сразу под хлебными крошками */
  .vfd--page { padding-block: clamp(1rem, 2vw, 1.5rem) var(--h-sec); }

  /* Сцена слева, выбор справа; на компьютере сцена стоит на месте, пока читают характеристики */
  .vfd__grid { display: grid; gap: 2rem var(--h-gutter); align-items: start; }
  .vfd__stage { display: grid; gap: 1rem; }
  @media (min-width: 62.5rem) {
    .vfd__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .vfd__stage { grid-column: 1 / span 5; position: sticky; top: calc(var(--header-height) + 1rem); }
    .vfd__info { grid-column: 7 / span 6; }
  }
  .vfd .vfd__frame { position: relative; aspect-ratio: 1; border-radius: var(--h-tile-radius); }
  @media (min-width: 43.75rem) { .vfd .vfd__frame { aspect-ratio: 4 / 5; } }
  .vfd .vfd__frame img { box-sizing: border-box; padding: clamp(0.75rem, 3vw, 1.5rem); object-fit: contain; transition: opacity 150ms var(--ease-out); }
  .vfd .vfd__frame[data-view='render'] img { padding: 0; object-fit: cover; }
  .vfd .vfd__frame.is-swap img { opacity: 0.35; }

  .vfd__name { margin: 0; font-size: clamp(1.625rem, 1rem + 2vw, 2.25rem); font-weight: var(--h-weight-display); line-height: 1.1; letter-spacing: -0.03em; color: var(--h-ink); text-wrap: balance; }
  .vfd__tagline { margin: 0.5rem 0 0; max-width: 34rem; }
  .vfd__pick { display: grid; gap: 0.875rem; margin-top: 1.75rem; }
  .vfd__label { margin: 0; font-size: 0.9375rem; color: var(--h-soft); }
  .vfd__label b { font-weight: 600; color: var(--h-ink); }
  .vfd__glass { display: block; margin-top: 0.125rem; font-size: 0.8125rem; color: var(--h-muted); }
  .vfd__skins { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .vfd__skin { display: block; width: 3.75rem; aspect-ratio: 7 / 15; padding: 0; border: 0.125rem solid transparent; border-radius: 0; background: var(--h-wall); overflow: hidden; outline: 0.0625rem solid var(--h-rule); outline-offset: -0.0625rem; cursor: pointer; transition: border-color 200ms var(--ease-out); }
  .vfd__skin img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .vfd__skin:hover { border-color: var(--color-slate-400); }
  .vfd__skin[aria-pressed='true'] { border-color: var(--h-signal); outline-color: transparent; }
  .vfd__skin:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.125rem; }

  /* Телефон: серии и миниатюры — одной строкой вбок, а не четыре строки пилюль */
  @media (max-width: 43.6875rem) {
    .vfd__series, .vfd__skins {
      flex-wrap: nowrap;
      margin-inline: calc(-1 * var(--h-pad));
      padding-inline: var(--h-pad);
      overflow-x: auto;
      overflow-y: hidden;
      scroll-padding-inline: var(--h-pad);
      scrollbar-width: none;
    }
    .vfd__series::-webkit-scrollbar, .vfd__skins::-webkit-scrollbar { display: none; }
    .vfd__series > *, .vfd__skins > li { flex: none; }
  }

  .vfd__price { margin: 1.75rem 0 0; font-size: clamp(1.75rem, 1rem + 2.4vw, 2.25rem); font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; color: var(--h-ink); }
  .vfd__note { margin: 0.5rem 0 0; max-width: 32rem; font-size: 0.9375rem; line-height: 1.45; color: var(--h-soft); }
  .vfd__ask { margin-top: 1.25rem; }

  /* Характеристики и комплектация — свёрнуты под кнопками */
  .vfd__info > .vfd__more:first-of-type { margin-top: clamp(1.75rem, 3vw, 2.5rem); }
  .vfd__more { border-top: 0.0625rem solid var(--h-rule); }
  .vfd__more:last-child { border-bottom: 0.0625rem solid var(--h-rule); }
  .vfd__more > summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.125rem 0; font-size: 1.1875rem; font-weight: 600; color: var(--h-ink); list-style: none; cursor: pointer; }
  .vfd__more > summary::-webkit-details-marker { display: none; }
  .vfd__more > summary::after { content: '+'; font-size: 1.5rem; font-weight: 300; line-height: 1; }
  .vfd__more[open] > summary::after { content: '\2212'; }
  .vfd__more > summary:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: -0.1875rem; border-radius: 0.375rem; }
  .vfd__spec { margin: 0 0 1.25rem; }
  .vfd__row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 1rem; padding: 0.75rem 0; border-top: 0.0625rem solid var(--h-rule); }
  .vfd__row dt { color: var(--h-muted); }
  .vfd__row dd { margin: 0; color: var(--h-ink); }
  @media (max-width: 43.6875rem) { .vfd__row { grid-template-columns: 1fr; gap: 0.25rem; } }
  .vfd__hw { margin: 0 0 1.25rem; padding: 0; list-style: none; }
  .vfd__hw li { padding: 0.625rem 0; border-top: 0.0625rem solid var(--h-rule); color: var(--h-ink); }

  @media (prefers-reduced-motion: reduce) {
    .vfd__thumb, .vfd__skin, .vfd .vfd__frame img { transition: none; }
  }
</style>
