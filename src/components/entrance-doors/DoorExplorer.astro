---
/**
 * «На что смотреть при выборе»: настоящая дверь из каталога (фото модели
 * GUIDE.explorerDoor) с точками на узлах и список критериев рядом. Узел или
 * строка — открывает критерий: что это, и что выбрать в квартиру и в
 * частный дом; на фото подсвечиваются нужные части (контуры нарисованы под
 * этот кадр, SHAPE_FRAME — его размер: другой кадр — другие контуры, сборка
 * не даст перепутать). Тексты, части и точки — src/data/entrance-guide.ts
 * (GUIDE_CRITERIA); подписи размеров — из каталога. Без скрипта все
 * критерии раскрыты и читаются списком; со скриптом открыт один.
 */
import { GUIDE, GUIDE_CRITERIA, LEVEL_LABEL } from '../../data/entrance-guide'
import { doorById } from '../../data/entrance-doors'
import { typograph } from '../../lib/typograph'

const FIRST = GUIDE_CRITERIA.find((c) => c.key === 'thermo') ?? GUIDE_CRITERIA[0]!
const PLACES = [['flat', 'Квартира'], ['house', 'Частный дом']] as const

const door = doorById(GUIDE.explorerDoor)
if (!door) throw new Error(`«На что смотреть»: в каталоге нет модели «${GUIDE.explorerDoor}» (GUIDE.explorerDoor)`)
const photo = door.cover
/* Контуры подсветки заданы в пикселях кадра 503×977 (Версаль, вид снаружи) */
const SHAPE_FRAME = { width: 503, height: 977 }
if (photo.width !== SHAPE_FRAME.width || photo.height !== SHAPE_FRAME.height) {
  throw new Error(`«На что смотреть»: фото «${door.id}» ${photo.width}×${photo.height}, а контуры подсветки нарисованы под ${SHAPE_FRAME.width}×${SHAPE_FRAME.height} — перерисуйте их в DoorExplorer.astro`)
}
---

<div class="dx" data-explorer data-active={FIRST.key} data-parts={FIRST.parts.join(' ')}>
  <div class="dx__fig">
    <div class="dx__stage" style={`aspect-ratio: ${photo.width} / ${photo.height}`}>
      <img class="dx__photo" src={photo.src} srcset={photo.srcset} sizes="(min-width: 62.5rem) 19rem, 17rem" alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
      <svg class="dx__svg" viewBox={`0 0 ${photo.width} ${photo.height}`} aria-hidden="true" focusable="false">
        <!-- Короб: левая и правая стойки и перемычка -->
        <g class="dp-frame">
          <rect x="1" y="1" width="33" height="975" />
          <rect x="1" y="1" width="501" height="30" />
          <rect x="469" y="1" width="33" height="975" />
        </g>
        <!-- Полотно и контур уплотнения -->
        <rect class="dp-leaf" x="36" y="32" width="432" height="944" />
        <rect class="dp-seal" x="41" y="36" width="422" height="936" rx="3" />
        <line class="dp-edge" x1="467" y1="32" x2="467" y2="976" />
        <!-- Филёнки -->
        <g class="dp-panels">
          <rect x="126" y="122" width="256" height="378" rx="4" />
          <rect x="126" y="570" width="256" height="80" rx="4" />
          <rect x="126" y="700" width="256" height="276" rx="4" />
        </g>
        <!-- Замки и ручка -->
        <g class="dp-locks">
          <rect x="54" y="346" width="52" height="58" rx="26" />
          <rect x="54" y="494" width="98" height="104" rx="22" />
        </g>
        <!-- Петли -->
        <g class="dp-hinges">
          <rect x="466" y="56" width="30" height="72" rx="4" />
          <rect x="466" y="196" width="30" height="72" rx="4" />
          <rect x="466" y="888" width="30" height="76" rx="4" />
        </g>
        <rect class="dp-threshold" x="36" y="954" width="432" height="22" />
        <!-- Размеры по каталогу: линии поверх фото, подписи на белых плашках -->
        <g class="dp-dims">
          <line x1="36" y1="889" x2="468" y2="889" />
          <line x1="36" y1="877" x2="36" y2="901" />
          <line x1="468" y1="877" x2="468" y2="901" />
          <rect class="dp-pill" x="156" y="867" width="192" height="44" rx="22" />
          <text x="252" y="897" text-anchor="middle">{GUIDE.doorWidth} мм</text>
          <line x1="443" y1="36" x2="443" y2="972" />
          <line x1="431" y1="36" x2="455" y2="36" />
          <line x1="431" y1="972" x2="455" y2="972" />
          <g transform="translate(443 442) rotate(90)">
            <rect class="dp-pill" x="-96" y="-22" width="192" height="44" rx="22" />
            <text x="0" y="10" text-anchor="middle">{GUIDE.doorHeight} мм</text>
          </g>
        </g>
      </svg>
      {GUIDE_CRITERIA.flatMap((c) => c.spots.map(([x, y], i) => (
        <button type="button" class="dx__spot" data-spot={c.key} style={`left:${x}%;top:${y}%`} aria-label={`${c.title}: показать`} aria-pressed={c.key === FIRST.key ? 'true' : 'false'} tabindex={i === 0 ? undefined : -1}></button>
      )))}
    </div>
  </div>

  <ul class="dx__list" role="list">
    {GUIDE_CRITERIA.map((c) => (
      <li class="dx__row" data-crit={c.key} data-parts={c.parts.join(' ')} data-open={c.key === FIRST.key ? '' : undefined}>
        <h3 class="dx__h">
          <button type="button" class="dx__btn" aria-expanded={c.key === FIRST.key ? 'true' : 'false'} aria-controls={`dx-${c.key}`}>
            <span class="dx__name">{c.title}</span>
            <span class="dx__what">{typograph(c.what)}</span>
            <span class="dx__chev" aria-hidden="true"></span>
          </button>
        </h3>
        <div class="dx__body" id={`dx-${c.key}`}>
          <div class="dx__inner">
            <p class="dx__text">{typograph(c.text)}</p>
            <div class="dx__pick">
              {PLACES.map(([place, label]) => (
                <div class={`dx__v dx__v--${c[place].level}`}>
                  <span class="dx__who">{label} · {LEVEL_LABEL[c[place].level].toLowerCase()}</span>
                  <strong class="dx__verdict">{typograph(c[place].verdict)}</strong>
                  <p class="dx__note">{typograph(c[place].note)}</p>
                </div>
              ))}
            </div>
            <button type="button" class="dx__show" data-show>Показать на двери</button>
          </div>
        </div>
      </li>
    ))}
  </ul>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-explorer]')
  if (root) {
    root.classList.add('is-ready')
    const rows = [...root.querySelectorAll<HTMLElement>('[data-crit]')]
    const spots = [...root.querySelectorAll<HTMLButtonElement>('[data-spot]')]
    const narrow = () => matchMedia('(max-width: 62.4375rem)').matches

    function select(key: string, fromSpot: boolean) {
      const row = rows.find((r) => r.dataset.crit === key)
      if (!row) return
      root!.dataset.active = key
      root!.dataset.parts = row.dataset.parts
      for (const r of rows) {
        const open = r === row
        r.toggleAttribute('data-open', open)
        r.querySelector('.dx__btn')!.setAttribute('aria-expanded', String(open))
      }
      for (const s of spots) s.setAttribute('aria-pressed', String(s.dataset.spot === key))
      /* Нажали на дверь на телефоне — список ниже фото: подводим его к экрану */
      if (fromSpot && narrow()) row.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
    }
    for (const r of rows) r.querySelector('.dx__btn')!.addEventListener('click', () => select(r.dataset.crit!, false))
    for (const s of spots) s.addEventListener('click', () => select(s.dataset.spot!, true))
    /* Телефон: фото стоит над списком — кнопка в разборе возвращает к ней */
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-show]')) {
      b.addEventListener('click', () => root.querySelector('.dx__fig')!.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }))
    }
  }
</script>

<style>
  .dx { display: grid; gap: 2rem var(--h-gutter); align-items: start; }
  @media (min-width: 62.5rem) {
    .dx { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 3rem var(--h-gutter); }
    .dx__fig { position: sticky; top: calc(var(--header-height) + 1.5rem); }
  }

  /* Фото двери на серой подложке; контуры подсветки и точки-кнопки лежат поверх кадра */
  .dx__fig { display: grid; place-items: center; padding: clamp(1rem, 3vw, 2rem); border-radius: var(--h-tile-radius); background: var(--h-wall); }
  .dx__stage { position: relative; width: min(100%, 17rem); }
  @media (min-width: 62.5rem) { .dx__stage { width: min(100%, 19rem); } }
  .dx__photo { display: block; width: 100%; height: 100%; }
  .dx__svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; --hot: var(--h-signal); fill: none; stroke: var(--hot); stroke-width: 3; stroke-linecap: round; }
  .dx__svg * { vector-effect: non-scaling-stroke; }
  /* Контуры скрыты; выбранный узел проявляет свои части */
  .dp-frame, .dp-leaf, .dp-seal, .dp-edge, .dp-panels, .dp-locks, .dp-hinges, .dp-threshold, .dp-dims { opacity: 0; transition: opacity 250ms var(--ease-out); }
  .dp-frame rect, .dp-leaf, .dp-panels rect, .dp-locks rect, .dp-hinges rect, .dp-threshold { fill: color-mix(in srgb, var(--hot) 16%, transparent); }
  .dp-seal { stroke-dasharray: 7 6; }
  .dp-edge { stroke-width: 6; }
  .dp-dims line { stroke-width: 2; }
  .dp-pill { fill: var(--color-white); stroke: none; }
  .dp-dims text { fill: var(--h-ink); stroke: none; font-size: 26px; font-weight: 600; font-family: var(--h-font); font-variant-numeric: tabular-nums; vector-effect: none; }
  .dx[data-parts~='frame'] .dp-frame, .dx[data-parts~='leaf'] .dp-leaf, .dx[data-parts~='seal'] .dp-seal, .dx[data-parts~='edge'] .dp-edge,
  .dx[data-parts~='panels'] .dp-panels, .dx[data-parts~='finish'] .dp-panels, .dx[data-parts~='locks'] .dp-locks,
  .dx[data-parts~='hinges'] .dp-hinges, .dx[data-parts~='threshold'] .dp-threshold, .dx[data-parts~='dims'] .dp-dims { opacity: 1; }
  /* «Отделка» — только контур филёнок, «звук» — с заливкой */
  .dx[data-parts~='finish'] .dp-panels rect { fill: none; }
  .dx[data-parts~='finish'][data-parts~='panels'] .dp-panels rect { fill: color-mix(in srgb, var(--hot) 16%, transparent); }

  .dx__spot {
    position: absolute;
    width: 0.875rem;
    height: 0.875rem;
    margin: -0.4375rem 0 0 -0.4375rem;
    padding: 0;
    border: 0.125rem solid var(--color-white);
    border-radius: 50%;
    background: var(--color-slate-500);
    box-shadow: 0 0 0 0.0625rem var(--color-slate-500);
    cursor: pointer;
    transition: background-color 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .dx__spot::after { content: ''; position: absolute; inset: -0.5rem; } /* зона нажатия ≥ 44 px */
  .dx__spot:hover { transform: scale(1.3); background: var(--color-slate-900); box-shadow: 0 0 0 0.0625rem var(--color-slate-900); }
  .dx__spot[aria-pressed='true'] { transform: scale(1.35); background: var(--h-signal); box-shadow: 0 0 0 0.0625rem var(--h-signal), 0 0 0 0.375rem color-mix(in srgb, var(--h-signal) 22%, transparent); }
  .dx__spot:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.25rem; }
  :global(.dx:not(.is-ready)) .dx__spot { display: none; }

  /* Список критериев: названия, под выбранным — разбор */
  .dx__list { margin: 0; padding: 0; list-style: none; border-top: 0.0625rem solid var(--h-rule); }
  .dx__row { position: relative; border-bottom: 0.0625rem solid var(--h-rule); }
  /* Красный отрезок над открытым критерием — тот же знак, что у шагов на сайте */
  .dx__row::before { content: ''; position: absolute; top: -0.0625rem; left: 0; width: 2rem; height: 0.125rem; background: var(--h-signal); transform: scaleX(0); transform-origin: left; transition: transform 300ms var(--ease-out); }
  .dx__row[data-open]::before { transform: none; }
  .dx__h { margin: 0; }
  .dx__btn {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.25rem;
    gap: 0.125rem 1rem;
    align-items: center;
    width: 100%;
    padding: 1.125rem 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .dx__btn:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: -0.1875rem; border-radius: 0.375rem; }
  .dx__name { grid-column: 1; font-size: 1.1875rem; font-weight: 600; line-height: 1.25; color: var(--h-ink); }
  .dx__what { grid-column: 1; font-size: 0.9375rem; line-height: 1.4; color: var(--h-muted); }
  .dx__chev { grid-column: 2; grid-row: 1 / span 2; position: relative; width: 1rem; height: 1rem; justify-self: end; }
  .dx__chev::before, .dx__chev::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 0.125rem; margin-top: -0.0625rem; background: var(--h-ink); transition: transform 250ms var(--ease-out); }
  .dx__chev::after { transform: rotate(90deg); }
  .dx__row[data-open] .dx__chev::after { transform: rotate(0); }
  .dx__btn:hover .dx__name { text-decoration: underline; text-decoration-color: var(--h-signal); text-underline-offset: 0.2em; }

  /* Раскрытие — плавное, без скрипта всё раскрыто */
  .dx__body { display: grid; grid-template-rows: 1fr; }
  .dx__inner { min-height: 0; overflow: hidden; }
  :global(.dx.is-ready) .dx__body { grid-template-rows: 0fr; transition: grid-template-rows 320ms var(--ease-out); }
  :global(.dx.is-ready) .dx__row[data-open] .dx__body { grid-template-rows: 1fr; }
  .dx__text { margin: 0; max-width: 40rem; color: var(--h-soft); }
  .dx__pick { display: grid; gap: 1rem var(--h-gutter); margin: 1.25rem 0 1.5rem; }
  @media (min-width: 43.75rem) { .dx__pick { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .dx__v { display: grid; gap: 0.25rem; align-content: start; padding-left: 1rem; border-left: 0.1875rem solid var(--color-slate-900); }
  .dx__v--good { border-left-color: var(--color-slate-500); }
  .dx__v--skip { border-left-color: var(--color-slate-300); border-left-style: dotted; }
  .dx__who { font-size: 0.8125rem; font-weight: 600; color: var(--h-muted); }
  .dx__verdict { font-size: 1.0625rem; font-weight: 600; line-height: 1.3; color: var(--h-ink); }
  .dx__v--skip .dx__verdict { color: var(--h-muted); }
  .dx__show { margin: 0 0 1.25rem; padding: 0.5rem 0; border: 0; background: none; color: var(--h-soft); font: inherit; font-size: 0.9375rem; font-weight: 600; text-decoration: underline; text-decoration-color: var(--h-rule); text-underline-offset: 0.2em; cursor: pointer; }
  .dx__show:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.125rem; }
  @media (min-width: 62.5rem) { .dx__show { display: none; } }
  :global(.dx:not(.is-ready)) .dx__show { display: none; }
  .dx__note { margin: 0; font-size: 0.9375rem; line-height: 1.45; color: var(--h-soft); }

  @media (prefers-reduced-motion: reduce) {
    .dx__svg *, .dx__spot, .dx__row::before, .dx__chev::before, .dx__chev::after, :global(.dx.is-ready) .dx__body { transition: none; }
  }
</style>
