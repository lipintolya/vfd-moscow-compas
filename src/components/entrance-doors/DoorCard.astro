---
/**
 * Карточка модели входной двери в сетке каталога: фото «снаружи и изнутри»,
 * название, два признака, «Цена по запросу». Вся карточка — ссылка на страницу модели.
 */
import type { EntranceDoor } from '../../data/entrance-doors'
import { typograph } from '../../lib/typograph'

interface Props { door: EntranceDoor }
const { door } = Astro.props
---

<a class="dcard" href={door.href}>
  <span class="h-media dcard__photo">
    <img src={door.cover.src} srcset={door.cover.srcset} sizes="(min-width: 62.5rem) 22rem, (min-width: 43.75rem) 30vw, 46vw" alt={door.cover.alt} width={door.cover.width} height={door.cover.height} loading="lazy" decoding="async" />
  </span>
  <span class="h-h3 dcard__name">{typograph(door.name)}</span>
  <span class="dcard__chips">{door.chips.slice(0, 2).join(' · ')}</span>
  <span class="dcard__price">Цена по запросу</span>
</a>

<style>
  .dcard { display: grid; gap: 0.375rem; align-content: start; color: inherit; text-decoration: none; }
  .dcard__photo { aspect-ratio: 5 / 4; border-radius: var(--h-tile-radius); }
  .dcard__photo img { transition: transform 600ms var(--ease-out); }
  .dcard:hover .dcard__photo img { transform: scale(1.03); }
  .dcard__name { margin: 0.5rem 0 0; }
  .dcard:hover .dcard__name { text-decoration: underline; text-decoration-color: var(--h-signal); text-underline-offset: 0.15em; }
  .dcard__chips { font-size: 0.9375rem; line-height: 1.35; color: var(--h-soft); }
  .dcard__price { font-size: 0.9375rem; line-height: 1.35; color: var(--h-muted); }
  @media (prefers-reduced-motion: reduce) { .dcard__photo img { transition: none; } }
</style>
