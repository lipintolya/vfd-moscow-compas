---
/**
 * Карточка модели входной двери: дверь в рост (левая половина фото — вид
 * снаружи),
 * название, сталь и толщина, число вариантов отделки и цена «от». Вся
 * карточка — ссылка на страницу модели (растянутая ссылка на названии).
 * Кнопок связи на карточке нет: они на странице модели и в блоке
 * «Не нашли нужную отделку» — иначе их десятки одинаковых.
 */
import { fromPrice } from '../../data/entrance-doors'
import type { EntranceDoor } from '../../data/entrance-doors'
import { typograph } from '../../lib/typograph'
import { pluralRu } from '../../lib/plural'

interface Props { door: EntranceDoor; group?: string }
const { door, group = door.group } = Astro.props
const n = door.variants.length
---

<article class="dcard" data-door data-group={group} data-name={door.name.toLowerCase()}>
  <div class="h-media dcard__photo" style={`--ar: 500 / ${door.cover.height}; --iw: ${(door.cover.width / door.cover.split) * 100}%`}>
    <img src={door.cover.src} srcset={door.cover.srcset} sizes="(min-width: 62.5rem) 28rem, (min-width: 43.75rem) 60vw, 92vw" alt={door.cover.alt} width={door.cover.width} height={door.cover.height} loading="lazy" decoding="async" />
    {n > 1 && <span class="dcard__count"><span class="dcard__long">{n} {pluralRu(n, ['вариант', 'варианта', 'вариантов'])} отделки</span><span class="dcard__short">{n} {pluralRu(n, ['отделка', 'отделки', 'отделок'])}</span></span>}
  </div>
  <h3 class="dcard__name"><a class="dcard__link" href={door.href}>{typograph(door.name)}</a></h3>
  <p class="dcard__chips">{door.chips.slice(0, 2).map((c, i, a) => <><span>{i < a.length - 1 ? `${c},` : c}</span>{' '}</>)}</p>
  <p class="dcard__price">{fromPrice(door)}</p>
</article>

<style>
  .dcard { position: relative; display: grid; gap: 0.25rem; align-content: start; }
  /* Половина кадра: слева дверь снаружи, справа изнутри. Рамка по размерам самого
     фото (--ar) — дверь видна в полную высоту, ничего не срезается */
  .dcard__photo { position: relative; aspect-ratio: var(--ar, 5 / 8); border-radius: 0 }
  /* Ширину карточки задаёт лента на странице: на компьютере 14,5 rem — дверь по высоте как у межкомнатных */
  .dcard__photo img {
    width: var(--iw, 200%);
    max-width: none;
    height: 100%;
    /* граница половин у коллекций разная (на 1–2 %) — растяжение незаметно, зато карточки в ряду одной высоты */
    object-fit: fill;
  }
  .dcard__short { display: none; }
  .dcard__count {
    position: absolute;
    left: 0.625rem;
    bottom: 0.625rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999rem;
    background: color-mix(in srgb, var(--color-white) 92%, transparent);
    color: var(--h-ink);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .dcard__name { margin: 0.625rem 0 0; font-size: 1.125rem; font-weight: 600; line-height: 1.25; color: var(--h-ink); }
  .dcard__link { color: inherit; text-decoration: none; }
  .dcard__link::after { content: ''; position: absolute; inset: 0; }
  .dcard:hover .dcard__link { text-decoration: underline; text-decoration-color: var(--h-signal); text-underline-offset: 0.15em; }
  .dcard__link:focus-visible { outline: none; }
  .dcard:has(.dcard__link:focus-visible) .dcard__photo { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.125rem; }
  .dcard__chips { margin: 0; font-size: 0.875rem; line-height: 1.35; color: var(--h-soft); }
  /* Признаки не рвём посреди («Толщина 115 / мм»): переносится целиком */
  .dcard__chips span { display: inline-block; white-space: nowrap; }
  .dcard__price { margin: 0.375rem 0 0; font-size: 1.1875rem; font-weight: 600; line-height: 1.2; color: var(--h-ink); font-variant-numeric: tabular-nums; }
  /* На телефоне подписи плотнее: две карточки в ряд */
  @media (max-width: 43.6875rem) {
    .dcard__long { display: none; }
    .dcard__short { display: inline; white-space: nowrap; }
    .dcard__name { font-size: 1rem; }
    .dcard__count { font-size: 0.6875rem; padding: 0.1875rem 0.5rem; left: 0.5rem; bottom: 0.5rem; }
  }
</style>
