---
/**
 * Карточка модели входной двери: дверь в рост (левая половина фото —
 * вид снаружи; при наведении кадр сдвигается на вид изнутри), название,
 * сталь и толщина, число вариантов отделки, цена «от» и две кнопки
 * связи с менеджером (Telegram, MAX). Вся карточка — ссылка на страницу модели (растянутая ссылка
 * на названии), кнопка цены лежит поверх неё.
 */
import { fromPrice } from '../../data/entrance-doors'
import type { EntranceDoor } from '../../data/entrance-doors'
import { telegramWithText, maxWithText, maxChatUrl, TELEGRAM_CHAT, MAX_CHAT } from '../../lib/messengers'
import TelegramIcon from '../ui/TelegramIcon.vue'
import MaxIcon from '../ui/MaxIcon.vue'
import { typograph } from '../../lib/typograph'
import { pluralRu } from '../../lib/plural'

interface Props { door: EntranceDoor; group?: string }
const { door, group = door.group } = Astro.props
const n = door.variants.length
---

<article class="dcard" data-door data-group={group} data-name={door.name.toLowerCase()}>
  <div class="h-media dcard__photo">
    <img src={door.cover.src} srcset={door.cover.srcset} sizes="(min-width: 62.5rem) 28rem, (min-width: 43.75rem) 60vw, 92vw" alt={door.cover.alt} width={door.cover.width} height={door.cover.height} loading="lazy" decoding="async" />
    {n > 1 && <span class="dcard__count">{n} {pluralRu(n, ['вариант', 'варианта', 'вариантов'])} отделки</span>}
  </div>
  <h3 class="dcard__name"><a class="dcard__link" href={door.href}>{typograph(door.name)}</a></h3>
  <p class="dcard__chips">{door.chips.slice(0, 2).join(', ')}</p>
  <div class="dcard__foot">
    <p class="dcard__price">{fromPrice(door)}</p>
    <span class="dcard__asks">
      {TELEGRAM_CHAT && (
        <a class="dcard__ask" href={telegramWithText(door.request)} target="_blank" rel="noopener" aria-label={`Написать менеджеру про ${door.title} в Telegram`} title="Написать в Telegram">
          <TelegramIcon class="dcard__ico" tone="dark" />
        </a>
      )}
      {MAX_CHAT && (
        <a class="dcard__ask" href={maxChatUrl()} target="_blank" rel="noopener" data-copy-text={maxWithText(door.request)} aria-label={`Написать менеджеру про ${door.title} в MAX (текст скопируется)`} title="Написать в MAX">
          <MaxIcon class="dcard__ico" tone="dark" />
        </a>
      )}
    </span>
  </div>
</article>

<style>
  .dcard { position: relative; display: grid; gap: 0.25rem; align-content: start; }
  /* Половина кадра: слева дверь снаружи, справа изнутри. Верх двери виден целиком,
     лишнее срезается снизу (object-position 0 0) */
  .dcard__photo { position: relative; aspect-ratio: 5 / 8; border-radius: var(--h-tile-radius); }
  .dcard__photo img {
    width: 200%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
    transition: transform 700ms var(--ease-out);
  }
  .dcard:hover .dcard__photo img, .dcard:focus-within .dcard__photo img { transform: translateX(-50%); }
  .dcard__count {
    position: absolute;
    left: 0.625rem;
    bottom: 0.625rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999rem;
    background: color-mix(in srgb, var(--color-white) 92%, transparent);
    color: var(--h-ink);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .dcard__name { margin: 0.625rem 0 0; font-size: 1.125rem; font-weight: 600; line-height: 1.25; color: var(--h-ink); }
  .dcard__link { color: inherit; text-decoration: none; }
  .dcard__link::after { content: ''; position: absolute; inset: 0; }
  .dcard:hover .dcard__link { text-decoration: underline; text-decoration-color: var(--h-signal); text-underline-offset: 0.15em; }
  .dcard__link:focus-visible { outline: none; }
  .dcard:has(.dcard__link:focus-visible) .dcard__photo { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.125rem; }
  .dcard__chips { margin: 0; font-size: 0.875rem; line-height: 1.35; color: var(--h-soft); }
  .dcard__foot { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: 0.625rem; }
  .dcard__price { margin: 0; font-size: 1.125rem; font-weight: 600; line-height: 1.2; color: var(--h-ink); font-variant-numeric: tabular-nums; }
  .dcard__asks { display: inline-flex; gap: 0.375rem; }
  .dcard__ask {
    position: relative; /* над растянутой ссылкой карточки */
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999rem;
    background: var(--h-ink);
    transition: background-color 200ms var(--ease-out);
  }
  .dcard__ask:hover { background: var(--color-slate-700); }
  .dcard__ask :global(.dcard__ico) { width: 1.125rem; height: 1.125rem; }
  @media (prefers-reduced-motion: reduce) { .dcard__photo img { transition: none; } }
  /* На телефоне подписи плотнее: две карточки в ряд */
  @media (max-width: 43.6875rem) {
    .dcard__name { font-size: 1rem; }
    .dcard__count { font-size: 0.6875rem; padding: 0.1875rem 0.5rem; left: 0.5rem; bottom: 0.5rem; }
  }
</style>
