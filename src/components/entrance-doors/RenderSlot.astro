---
/**
 * Место под рендер в путеводителе входных дверей. Есть рендер
 * (assets/entrance-renders/<место>.* → npm run gen:entrance-renders) —
 * показываем его; нет — в режиме разработки рамка с описанием, что
 * нарисовать, на сайте — ничего (блок остаётся текстовым).
 */
import type { GuideVisual } from '../../data/entrance-guide'
import { renderOf } from '../../lib/entrance-renders'

interface Props {
  visual: GuideVisual
  /** sizes картинки — по ширине кадра в сетке */
  sizes: string
  class?: string
}
const { visual, sizes, class: cls } = Astro.props
const render = renderOf(visual)
const ratio = visual.ratio.replace(':', ' / ')
const minWidth = visual.ratio === '4:5' ? 1200 : 1600
const isDev = import.meta.env.DEV
---

{render ? (
  <figure class:list={['rs', cls]}>
    <span class="h-media rs__frame" style={`aspect-ratio: ${ratio}`}>
      <img src={render.src} srcset={render.srcset} sizes={sizes} alt={render.alt} width={render.width} height={render.height} loading="lazy" decoding="async" />
    </span>
  </figure>
) : isDev ? (
  <div class:list={['rs rs--slot', cls]} style={`aspect-ratio: ${ratio}`}>
    <strong>Место для рендера</strong>
    <code>assets/entrance-renders/{visual.slot}.jpg</code>
    <span>{visual.ratio}, от {minWidth} px по ширине → npm run gen:entrance-renders</span>
    <em>{visual.brief}</em>
  </div>
) : null}

<style>
  .rs { margin: 0; }
  .rs__frame { position: relative; display: block; border-radius: var(--h-tile-radius); overflow: hidden; }
  .rs__frame img { width: 100%; height: 100%; object-fit: cover; }
  .rs--slot {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 0.125rem dashed var(--color-slate-300);
    border-radius: var(--h-tile-radius);
    color: var(--h-muted);
    text-align: center;
    font-size: 0.875rem;
  }
  .rs--slot strong { color: var(--h-ink); }
  .rs--slot em { max-width: 32rem; font-style: normal; color: var(--h-soft); }
</style>
