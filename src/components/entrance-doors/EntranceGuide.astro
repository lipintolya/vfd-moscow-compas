---
/**
 * Путеводитель по выбору входной двери под каталогом на /catalog/vhodnye-dveri/:
 * введение с рендером дома, виды дверей (с кнопкой «показать модели»),
 * критерии для квартиры и для дома, из чего состоит дверь, шаги выбора и
 * частые ошибки. Тексты и цифры — src/data/entrance-guide.ts (цифры из
 * каталога); рендеры — RenderSlot.astro.
 */
import RenderSlot from './RenderSlot.astro'
import { GUIDE, GUIDE_KINDS, GUIDE_CRITERIA, GUIDE_PARTS, GUIDE_STEPS, GUIDE_MISTAKES, LEVEL_LABEL } from '../../data/entrance-guide'
import { renderOf } from '../../lib/entrance-renders'
import { typograph } from '../../lib/typograph'

const hasHouse = !!renderOf(GUIDE.house)
const hasAnatomy = !!renderOf(GUIDE.anatomy)

/* Значки критериев: контур 24×24, цвет — currentColor */
const ICONS: Record<string, string> = {
  steel: 'M12 3 3 8l9 5 9-5-9-5ZM3 12l9 5 9-5M3 16l9 5 9-5',
  layers: 'M4 5h16v14H4ZM4 9h16M4 15h16',
  snow: 'M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9M9.5 4.5 12 7l2.5-2.5M9.5 19.5 12 17l2.5 2.5',
  seal: 'M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6l8-3Z',
  lock: 'M6 11h12v9H6ZM8.5 11V8a3.5 3.5 0 0 1 7 0v3',
  hinge: 'M5 4h5v16H5ZM14 4h5v16h-5ZM10 8h4M10 16h4',
  paint: 'M12 3a9 9 0 1 0 0 18c1.5 0 2-1 1.5-2.2-.6-1.4.4-2.8 2-2.8H18a3 3 0 0 0 3-3C21 7 17 3 12 3ZM7.5 11.5h.01M10 7.5h.01M14.5 7.5h.01',
  size: 'M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5',
  sound: 'M4 9v6h4l5 4V5L8 9H4ZM16.5 9a4 4 0 0 1 0 6M18.5 7a7 7 0 0 1 0 10',
}
---

<div class="eg">
  <section id="guide" class="h-sec" aria-labelledby="guide-title">
    <div class="container egi" data-with-media={hasHouse || undefined}>
      <div class="egi__text">
        <h2 id="guide-title" class="h-h2">{typograph(GUIDE.title)}</h2>
        <p class="h-lead egi__lead">{typograph(GUIDE.lead)}</p>
        <nav class="egi__nav" aria-label="Разделы путеводителя">
          <a class="h-pill h-pill--line" href="#guide-kinds">Виды дверей</a>
          <a class="h-pill h-pill--line" href="#guide-criteria">Что учесть</a>
          <a class="h-pill h-pill--line" href="#guide-parts">Из чего состоит дверь</a>
          <a class="h-pill h-pill--line" href="#guide-steps">Шаги выбора</a>
        </nav>
      </div>
      {hasHouse && <RenderSlot visual={GUIDE.house} sizes="(min-width: 62.5rem) 52vw, 100vw" class="egi__media" />}
    </div>
  </section>

  <section id="guide-kinds" class="h-sec h-sec--wall" aria-labelledby="kinds-title">
    <div class="container">
      <h2 id="kinds-title" class="h-h2 eg__h2">{GUIDE.kindsTitle}</h2>
      <ul class="egk" role="list">
        {GUIDE_KINDS.map((k) => (
          <li class="egk__item">
            <RenderSlot visual={k.visual} fallback={k.fallback} sizes="(min-width: 62.5rem) 18rem, (min-width: 43.75rem) 30vw, 90vw" class="egk__media" />
            <div class="egk__body">
              <h3 class="egk__title">{k.title}</h3>
              <p class="egk__fits">{k.fits}</p>
              <p class="egk__text">{typograph(k.text)}</p>
              <p class="egk__stats">{k.stats}</p>
              <button type="button" class="h-btn h-btn--quiet egk__go" data-kind={k.id}>Показать модели</button>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="guide-criteria" class="h-sec" aria-labelledby="criteria-title">
    <div class="container egc" data-place="flat">
      <header class="egc__head">
        <div class="egc__intro">
          <h2 id="criteria-title" class="h-h2">{GUIDE.criteriaTitle}</h2>
          <p class="h-body eg__note">{typograph(GUIDE.criteriaLead)}</p>
        </div>
        <div class="egc__switch" role="group" aria-label="Для чего выбираете дверь">
          <button type="button" data-place-set="flat" aria-pressed="true">Квартира</button>
          <button type="button" data-place-set="house" aria-pressed="false">Частный дом</button>
        </div>
      </header>

      <div class="egc__cols" aria-hidden="true">
        <span>Критерий</span><span>Квартира</span><span>Частный дом</span>
      </div>
      <ul class="egc__list" role="list">
        {GUIDE_CRITERIA.map((c) => (
          <li class="cr">
            <div class="cr__row">
              <div class="cr__what">
                <span class="cr__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={ICONS[c.icon]} /></svg>
                </span>
                <div>
                  <h3 class="cr__title">{c.title}</h3>
                  <p class="cr__desc">{typograph(c.what)}</p>
                </div>
              </div>
              {(['flat', 'house'] as const).map((place) => (
                <div class={`cr__cell cr__cell--${place}`}>
                  <span class="cr__place">{place === 'flat' ? 'Квартира' : 'Частный дом'}</span>
                  <span class={`cr__level cr__level--${c[place].level}`}>{LEVEL_LABEL[c[place].level]}</span>
                  <strong class="cr__verdict">{typograph(c[place].verdict)}</strong>
                </div>
              ))}
            </div>
            <details class="cr__more">
              <summary>Подробнее</summary>
              <div class="cr__body">
                <p>{typograph(c.text)}</p>
                <dl>
                  <div><dt>Квартира</dt><dd>{typograph(c.flat.note)}</dd></div>
                  <div><dt>Частный дом</dt><dd>{typograph(c.house.note)}</dd></div>
                </dl>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="guide-parts" class="h-sec h-sec--wall" aria-labelledby="parts-title">
    <div class="container egp" data-with-media={hasAnatomy || undefined}>
      {hasAnatomy && <RenderSlot visual={GUIDE.anatomy} sizes="(min-width: 62.5rem) 56vw, 100vw" class="egp__media" />}
      <div class="egp__text">
        <h2 id="parts-title" class="h-h2 eg__h2">{GUIDE.partsTitle}</h2>
        <ul class="egp__list" role="list">
          {GUIDE_PARTS.map((p) => (
            <li><h3 class="egp__name">{p.title}</h3><p class="egp__desc">{typograph(p.text)}</p></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="guide-steps" class="h-sec" aria-labelledby="steps-title">
    <div class="container">
      <h2 id="steps-title" class="h-h2 eg__h2">{GUIDE.stepsTitle}</h2>
      <ol class="egs" role="list">
        {GUIDE_STEPS.map((s) => (
          <li class="egs__item">
            <h3 class="egs__title">{s.title}</h3>
            <p class="egs__text">{typograph(s.text)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="h-sec h-sec--wall" aria-labelledby="mistakes-title">
    <div class="container">
      <h2 id="mistakes-title" class="h-h2 eg__h2">{GUIDE.mistakesTitle}</h2>
      <ul class="egm" role="list">
        {GUIDE_MISTAKES.map((m) => (
          <li class="egm__item">
            <h3 class="egm__title">{m.title}</h3>
            <p class="egm__text">{typograph(m.text)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</div>

<script>
  /* Переключатель «Квартира / Частный дом» — на телефоне показывает один столбец советов */
  const crit = document.querySelector<HTMLElement>('.egc')
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-place-set]')) {
    b.addEventListener('click', () => {
      crit!.dataset.place = b.dataset.placeSet
      for (const x of document.querySelectorAll<HTMLButtonElement>('[data-place-set]')) x.setAttribute('aria-pressed', String(x === b))
    })
  }

  /* «Показать модели» у вида двери — фильтр каталога выше (слушает index.astro) */
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-kind]')) {
    b.addEventListener('click', () => document.dispatchEvent(new CustomEvent('doors:filter', { detail: { group: b.dataset.kind } })))
  }
</script>

<style>
  .eg__h2 { margin: 0 0 clamp(1.75rem, 4vw, 2.75rem); }
  .eg__head { display: grid; gap: 0.75rem; margin-bottom: clamp(1.75rem, 4vw, 2.75rem); }
  .eg__head :global(h2), .eg__note { margin: 0; }
  .eg__note { max-width: 40rem; color: var(--h-soft); }

  /* Введение: текст и рендер дома рядом; без рендера — текст на всю ширину колонки */
  .egi { display: grid; gap: 2rem var(--h-gutter); align-items: center; }
  .egi__text { display: grid; gap: 1rem; max-width: 46rem; }
  .egi__text :global(h2), .egi__lead { margin: 0; }
  .egi__nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  @media (min-width: 62.5rem) {
    .egi[data-with-media] { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .egi[data-with-media] .egi__text { grid-column: 1 / span 5; }
    .egi[data-with-media] :global(.egi__media) { grid-column: 7 / span 6; }
  }

  /* Виды: карточки с фото слева, на телефоне — одна под другой */
  .egk { display: grid; gap: clamp(2rem, 4vw, 3rem) var(--h-gutter); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 62.5rem) { .egk { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .egk__item { display: grid; gap: 1.25rem 1.5rem; align-items: start; }
  @media (min-width: 43.75rem) { .egk__item { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
  @media (max-width: 43.6875rem) { .egk :global(.egk__media) { max-width: 16rem; } }
  .egk__body { display: grid; gap: 0.625rem; justify-items: start; }
  .egk__title { margin: 0; font-size: 1.375rem; font-weight: 600; line-height: 1.2; color: var(--h-ink); }
  .egk__fits { margin: 0; font-size: 0.9375rem; font-weight: 600; color: var(--h-muted); }
  .egk__text { margin: 0; color: var(--h-soft); }
  .egk__stats { margin: 0; font-weight: 600; color: var(--h-ink); }
  .egk__go { margin-top: 0.5rem; }

  /* Критерии: таблица «критерий — квартира — частный дом», совет и важность в строке,
     пояснение — под «Подробнее»; на телефоне один столбец по переключателю */
  .egc__head { display: grid; gap: 1.25rem; margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .egc__intro { display: grid; gap: 0.75rem; }
  .egc__intro :global(h2), .egc__intro .eg__note { margin: 0; }
  .egc__switch { display: inline-grid; grid-template-columns: 1fr 1fr; justify-self: start; padding: 0.25rem; border-radius: 999rem; background: var(--h-wall); }
  .egc__switch button {
    min-height: 2.5rem;
    padding: 0 1.125rem;
    border: 0;
    border-radius: 999rem;
    background: none;
    color: var(--h-soft);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 200ms var(--ease-out), color 200ms var(--ease-out);
  }
  .egc__switch button[aria-pressed='true'] { background: var(--h-ink); color: var(--color-white); }
  .egc__switch button:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.125rem; }
  .egc__cols { display: none; }
  .egc__list { margin: 0; padding: 0; list-style: none; border-top: 0.0625rem solid var(--h-rule); }
  .cr { border-bottom: 0.0625rem solid var(--h-rule); }
  .cr__row { display: grid; gap: 0.875rem 1.5rem; padding: 1.25rem 0 0.5rem; }
  .cr__what { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); gap: 0.875rem; align-items: start; }
  .cr__icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 0.875rem; background: var(--h-wall); color: var(--h-ink); }
  .cr__icon svg { width: 1.5rem; height: 1.5rem; }
  .cr__title { margin: 0; font-size: 1.1875rem; font-weight: 600; line-height: 1.25; color: var(--h-ink); }
  .cr__desc { margin: 0.25rem 0 0; font-size: 0.9375rem; line-height: 1.4; color: var(--h-soft); }
  .cr__cell { display: grid; gap: 0.375rem; align-content: start; justify-items: start; }
  .cr__place { font-size: 0.8125rem; font-weight: 600; color: var(--h-muted); }
  .cr__verdict { font-size: 1.0625rem; font-weight: 600; line-height: 1.3; color: var(--h-ink); }
  .cr__level { display: inline-flex; align-items: center; padding: 0.1875rem 0.625rem; border-radius: 999rem; font-size: 0.75rem; font-weight: 600; line-height: 1.3; }
  .cr__level--must { background: var(--h-ink); color: var(--color-white); }
  .cr__level--good { box-shadow: inset 0 0 0 0.0625rem var(--h-ink); color: var(--h-ink); }
  .cr__level--skip { background: var(--h-wall); color: var(--h-muted); }
  .cr__more { padding-bottom: 1rem; }
  .cr__more summary { display: inline-block; padding: 0.375rem 0; font-size: 0.875rem; font-weight: 600; color: var(--h-soft); cursor: pointer; text-decoration: underline; text-decoration-color: var(--h-rule); text-underline-offset: 0.2em; }
  .cr__more summary:hover { color: var(--h-ink); }
  .cr__more summary:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.125rem; }
  .cr__body { display: grid; gap: 0.75rem; max-width: 52rem; padding: 0.5rem 0 0; }
  .cr__body p { margin: 0; color: var(--h-soft); }
  .cr__body dl { display: grid; gap: 0.5rem; margin: 0; }
  .cr__body dl > div { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 0.75rem; }
  .cr__body dt { font-size: 0.875rem; font-weight: 600; color: var(--h-muted); }
  .cr__body dd { margin: 0; font-size: 0.9375rem; line-height: 1.45; color: var(--h-ink); }

  /* Телефон и планшет: показываем один столбец — по переключателю */
  @media (max-width: 62.4375rem) {
    .egc[data-place='flat'] .cr__cell--house, .egc[data-place='house'] .cr__cell--flat { display: none; }
    .cr__cell { padding: 0.75rem 0.875rem; border-radius: 0.875rem; background: var(--h-wall); grid-template-columns: auto 1fr; align-items: center; gap: 0.25rem 0.75rem; }
    .cr__place { display: none; }
    .cr__verdict { grid-column: 1 / -1; }
  }
  @media (min-width: 62.5rem) {
    .egc__switch { display: none; }
    .egc__cols, .cr__row { grid-template-columns: minmax(0, 5fr) minmax(0, 3.5fr) minmax(0, 3.5fr); }
    .egc__cols { display: grid; gap: 1.5rem; padding-bottom: 0.75rem; font-size: 0.8125rem; font-weight: 600; color: var(--h-muted); }
    .cr__row { align-items: start; }
    .cr__place { display: none; }
  }

  /* Из чего состоит: рендер разреза слева, список слева-направо; без рендера — две колонки */
  .egp { display: grid; gap: 2rem var(--h-gutter); align-items: center; }
  .egp__list { display: grid; gap: 1.25rem var(--h-gutter); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 43.75rem) { .egp__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .egp__name { margin: 0 0 0.25rem; font-size: 1.0625rem; font-weight: 600; color: var(--h-ink); }
  .egp__desc { margin: 0; font-size: 0.9375rem; line-height: 1.45; color: var(--h-soft); }
  @media (min-width: 62.5rem) {
    .egp[data-with-media] { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .egp[data-with-media] :global(.egp__media) { grid-column: 1 / span 7; }
    .egp[data-with-media] .egp__text { grid-column: 8 / span 5; }
    .egp[data-with-media] .egp__list { grid-template-columns: 1fr; }
  }

  /* Шаги — настоящая последовательность, номера уместны */
  .egs { display: grid; gap: 1.75rem var(--h-gutter); margin: 0; padding: 0; list-style: none; counter-reset: step; }
  @media (min-width: 43.75rem) { .egs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 75rem) { .egs { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .egs__item { position: relative; counter-increment: step; display: grid; gap: 0.5rem; align-content: start; padding-top: 3.25rem; }
  .egs__item::before {
    content: counter(step);
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999rem;
    background: var(--h-ink);
    color: var(--color-white);
    font-size: 1rem;
    font-weight: 600;
  }
  .egs__title { margin: 0; font-size: 1.0625rem; font-weight: 600; line-height: 1.3; color: var(--h-ink); }
  .egs__text { margin: 0; font-size: 0.9375rem; line-height: 1.45; color: var(--h-soft); }

  .egm { display: grid; gap: 1.5rem var(--h-gutter); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 43.75rem) { .egm { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .egm__item { padding: 1.5rem; border-radius: var(--h-radius); background: var(--color-white); }
  .egm__title { margin: 0 0 0.5rem; font-size: 1.125rem; font-weight: 600; color: var(--h-ink); }
  .egm__text { margin: 0; color: var(--h-soft); }
</style>
