---
/**
 * Обложка раздела на /catalog/vhodnye-dveri/: рендер двери на площадке или в
 * холле во всю ширину контейнера, без подписи. Кадры — assets/entrance-renders/
 * lobby-<n>.* → npm run gen:entrance-renders; места и описания для поиска по
 * картинкам — ENTRANCE_LOBBY (src/data/entrance-guide.ts). Нет рендера — блок
 * не выводится. По нажатию кадр открывается крупно (data-lightbox).
 */
import { ENTRANCE_LOBBY } from '../../data/entrance-guide'
import { renderOf } from '../../lib/entrance-renders'

interface Props {
  /** Номер кадра в ENTRANCE_LOBBY.visuals */
  n: number
  /** Куда смотреть при обрезке до 16:9 — дверь стоит не всегда по центру */
  position?: string
}
const { n, position = '50% 50%' } = Astro.props
const visual = ENTRANCE_LOBBY.visuals[n]
if (!visual) throw new Error(`Обложка входных дверей: нет кадра №${n} в ENTRANCE_LOBBY (src/data/entrance-guide.ts)`)
const shot = renderOf(visual)
---

{shot && (
  <div class="container ecv" data-lightbox data-lightbox-images={JSON.stringify([{ src: shot.src, alt: shot.alt }])}>
    <button type="button" class="h-media ecv__zoom" data-lightbox-index="0" aria-label={`Открыть крупно: ${shot.alt}`}>
      <img
        src={shot.src} srcset={shot.srcset} sizes="(min-width: 80rem) 76rem, 100vw" alt={shot.alt}
        width={shot.width} height={shot.height} loading="lazy" decoding="async" style={`object-position: ${position}`}
      />
    </button>
  </div>
)}

<script>
  import { initLightboxGroups } from '../../lib/lightbox'
  initLightboxGroups()
</script>

<style>
  .ecv { padding-block: clamp(1.5rem, 4vw, 3rem); }
  .ecv__zoom { width: 100%; padding: 0; border: 0; cursor: zoom-in; aspect-ratio: 3 / 2; }
  @media (min-width: 43.75rem) { .ecv__zoom { aspect-ratio: 16 / 9; } }
  .ecv__zoom img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease-out); }
  .ecv__zoom:hover img { transform: scale(1.02); }
  @media (prefers-reduced-motion: reduce) { .ecv__zoom img { transition: none; } .ecv__zoom:hover img { transform: none; } }
</style>
