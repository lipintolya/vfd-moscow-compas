---
/**
 * Кадр «дверь на доме» в ленте на /catalog/vhodnye-dveri/: рендер целиком (без
 * обрезки — ширину задаёт лента по пропорции кадра); нажатие на кадр открывает
 * его крупно (группа [data-lightbox] — лента на странице), под кадром название
 * модели — ссылка на её страницу — и цена «от». Кадры — src/data/entrance-scenes.ts.
 */
import { fromPrice } from '../../data/entrance-doors'
import type { SceneImage } from '../../lib/entrance-scenes'
import { typograph } from '../../lib/typograph'

interface Props { scene: SceneImage; /** Номер кадра в группе для lightbox */ index: number }
const { scene, index } = Astro.props
const { door } = scene
---

<article class="scard">
  <button type="button" class="h-media scard__photo" style={`aspect-ratio: ${scene.width} / ${scene.height}`} data-lightbox-index={index} aria-label={`Открыть крупно: ${scene.alt}`}>
    <img src={scene.src} srcset={scene.srcset} sizes="(min-width: 43.75rem) 30rem, 85vw" alt={scene.alt} width={scene.width} height={scene.height} loading="lazy" decoding="async" />
    <span class="scard__zoom" aria-hidden="true">Увеличить</span>
  </button>
  <h3 class="scard__name"><a class="scard__link" href={door.href}>{typograph(door.name)}</a></h3>
  <p class="scard__price">{fromPrice(door)}</p>
</article>

<style>
  .scard { display: grid; gap: 0.25rem; align-content: start; }
  .scard__photo { position: relative; display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in; }
  /* Наведение — кадр чуть приближается, как фото-плитки на главной */
  .scard__photo img { transition: transform 700ms var(--ease-out); }
  @media (hover: hover) { .scard__photo:hover img { transform: scale(1.04); } }
  .scard__photo:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.125rem; }
  .scard__zoom {
    position: absolute; right: 0.625rem; bottom: 0.625rem;
    padding: 0.25rem 0.625rem; border-radius: 999rem;
    background: color-mix(in srgb, var(--color-white) 92%, transparent); color: var(--h-ink);
    font-size: 0.75rem; font-weight: 600; line-height: 1.3;
  }
  .scard__name { margin: 0.625rem 0 0; font-size: 1.125rem; font-weight: 600; line-height: 1.25; }
  .scard__link { color: var(--h-ink); text-decoration: none; }
  .scard__link:hover { text-decoration: underline; text-decoration-color: var(--h-signal); text-underline-offset: 0.15em; }
  .scard__link:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.125rem; border-radius: 0.125rem; }
  .scard__price { margin: 0; font-size: 1.1875rem; font-weight: 600; line-height: 1.2; color: var(--h-ink); font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: reduce) { .scard__photo img { transition: none; } .scard__photo:hover img { transform: none; } }
  @media (max-width: 43.6875rem) { .scard__name { font-size: 1rem; } .scard__price { font-size: 1.0625rem; } }
</style>
