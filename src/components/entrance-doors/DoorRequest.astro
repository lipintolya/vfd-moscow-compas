---
/**
 * «Узнать цену» входной двери: WhatsApp, Telegram и MAX с готовым текстом
 * (цены на сайте нет — её называет менеджер), как у направлений плинтуса.
 */
import { whatsappWithText, telegramWithText, maxWithText, maxChatUrl, TELEGRAM_CHAT, MAX_CHAT } from '../../lib/messengers'
import WhatsAppIcon from '../ui/WhatsAppIcon.vue'
import TelegramIcon from '../ui/TelegramIcon.vue'
import MaxIcon from '../ui/MaxIcon.vue'

interface Props { text: string }
const { text } = Astro.props
---

<div class="dreq">
  <a class="h-btn h-btn--signal dreq__btn" href={whatsappWithText(text)} target="_blank" rel="noopener" aria-label="Узнать цену в WhatsApp">
    <WhatsAppIcon class="dreq__ico" tone="dark" />Узнать цену
  </a>
  {TELEGRAM_CHAT && (
    <a class="h-btn h-btn--quiet dreq__btn" href={telegramWithText(text)} target="_blank" rel="noopener" aria-label={`Написать в Telegram: @${TELEGRAM_CHAT}`}>
      <TelegramIcon class="dreq__ico" />Telegram
    </a>
  )}
  {MAX_CHAT && (
    <a class="h-btn h-btn--quiet dreq__btn" href={maxChatUrl()} target="_blank" rel="noopener" data-copy-text={maxWithText(text)} aria-label="Написать в MAX (текст скопируется)">
      <MaxIcon class="dreq__ico" />MAX
    </a>
  )}
</div>

<style>
  .dreq { display: flex; flex-wrap: wrap; gap: 0.625rem; }
  .dreq__btn { gap: 0.5rem; }
  .dreq__btn :global(.dreq__ico) { width: 1.25rem; height: 1.25rem; }
  @media (max-width: 43.6875rem) {
    .dreq { display: grid; grid-template-columns: 1fr 1fr; }
    .dreq > :first-child { grid-column: 1 / -1; }
  }
</style>
