---
import { getCollection } from 'astro:content'
import { articleCoverImg } from '../../lib/article-images'

const all = await getCollection('articles')
const articles = all
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3)

const getSlug = (id: string) => id.split('/')[0]!.replace(/\.mdoc$/, '')

const dateStr = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })
---

{articles.length > 0 && (
  /* padding-top у смежных .section обычно зануляется (см. global.css —
     полагаемся на padding-bottom предыдущей секции), но здесь это давало
     резкий обрыв: белая секция выше кончается вплотную к чёрному фону,
     без миллиметра воздуха — на глаз читалось как «обрезано». Единственная
     секция на главной со сплошным bg-graphite (не карточкой на белом
     фоне), поэтому явно возвращаем свой отступ поверх общего правила. */
  <section class="section bg-graphite pt-[clamp(2.5rem,4vw,3.5rem)]!" aria-labelledby="articles-heading">
    <div class="container">

      <!-- Мобайл-фёрст: заголовок и «Все статьи» в одну строку только от sm, на
           мобильном кнопка уходит под текст на всю ширину. -->
      <header class="mb-10 flex flex-col gap-6 sm:mb-14 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="mb-3 inline-flex items-center rounded-full border border-white/15 px-3 py-1 text-xs font-medium uppercase tracking-widest text-teal-400">
            Блог
          </p>
          <h2 id="articles-heading" class="text-3xl font-medium leading-tight tracking-tight text-white md:text-5xl">
            Полезные статьи о дверях, фурнитуре и дизайне
          </h2>
          <p class="mt-4 text-base leading-relaxed text-slate-400 md:text-lg">
            Советы по выбору, покрытиям и монтажу от специалистов ВФД на Кашириных
          </p>
        </div>

        <a
          href="/articles/"
          class="inline-flex w-fit shrink-0 items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-900 transition-colors hover:bg-teal-400"
        >
          Все статьи
          <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </header>

      <!-- Плитки на всю ширину контейнера, друг под другом; внутри каждой —
           горизонтальный сплит (текст слева, фото справа) от sm, на мобильном
           фото сверху текста, во всю ширину. -->
      <ul class="flex flex-col gap-4 sm:gap-6" role="list">
        {articles.map((article) => {
          const slug = getSlug(article.id)
          return (
            <li>
              <a
                href={`/articles/${slug}/`}
                class="group flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-graphite-card shadow-[0_1px_0_rgba(255,255,255,0.04)_inset] transition-colors duration-200 hover:border-white/20 hover:bg-[#28272C] focus-visible:outline-2 focus-visible:outline-teal-400 focus-visible:outline-offset-2 sm:flex-row sm:items-center sm:gap-8 sm:p-6 lg:gap-12 lg:p-10"
              >
                <div class="flex flex-1 flex-col p-6 sm:p-0">
                  <time
                    datetime={article.data.publishDate.toISOString()}
                    class="mb-4 inline-flex w-fit items-center rounded-full border border-white/15 px-3 py-1 text-xs font-medium uppercase tracking-widest tabular-nums text-teal-400"
                  >
                    {dateStr(article.data.publishDate)}
                  </time>

                  <h3 class="mb-3 text-2xl font-medium leading-tight tracking-tight text-white transition-colors duration-200 line-clamp-2 sm:text-3xl group-hover:text-teal-400">
                    {article.data.title}
                  </h3>

                  <p class="mb-6 max-w-lg text-sm leading-relaxed text-slate-400 line-clamp-2 sm:text-base">
                    {article.data.description}
                  </p>

                  <span class="inline-flex w-fit items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-900 transition-colors group-hover:bg-teal-400" aria-hidden="true">
                    Читать статью
                    <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">
                      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>

                <div class="relative aspect-video w-full shrink-0 overflow-hidden bg-slate-800 sm:w-2/5 sm:rounded-2xl lg:w-1/3">
                  {article.data.coverImage ? (
                    <img
                      {...articleCoverImg(article.data.coverImage, 'card')}
                      sizes="(min-width: 1024px) 400px, (min-width: 640px) 40vw, 100vw"
                      width="800"
                      height="450"
                      alt={article.data.coverImageAlt ?? ''}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04] motion-reduce:transition-none"
                    />
                  ) : (
                    <div class="absolute inset-0 bg-linear-to-br from-slate-700 to-slate-900" />
                  )}
                </div>
              </a>
            </li>
          )
        })}
      </ul>

    </div>
  </section>
)}
