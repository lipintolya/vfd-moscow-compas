---
/**
 * «Статьи и публикации» на главной — свежие материалы раздела /articles/.
 * Только опубликованные (src/lib/articles.ts); нет ни одной — блока нет.
 * Одна статья — крупная карточка (фото и текст рядом), две и больше —
 * сетка до трёх (на телефоне — лента вбок). Карточка — ArticleCard,
 * та же, что в разделе.
 */
import ArticleCard from '../articles/ArticleCard.astro'
import { getArticles } from '../../lib/articles'
import { ARTICLES_SECTION } from '../../data/article-kinds'
import { typograph } from '../../lib/typograph'

const HOME_POSTS = 3
const posts = (await getArticles()).slice(0, HOME_POSTS)
---

{posts.length > 0 && (
  <section class="h-sec h-sec--wall" aria-labelledby="articles-heading">
    <div class="container">
      <header class="h-head">
        <h2 id="articles-heading" class="h-h2">{typograph(ARTICLES_SECTION)}</h2>
        <div>
          <p class="h-lead">
            Разбираем выбор дверей, покрытия и&nbsp;монтаж, рассказываем о&nbsp;новинках
            фабрики и&nbsp;событиях салона.
          </p>
          <a href="/articles/" class="h-pill h-pill--line posts-all">
            Все материалы
            <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </header>

      {posts.length === 1
        ? <ArticleCard article={posts[0]!} feature />
        : (
          <ul class="posts h-rail" role="list">
            {posts.map((post) => <li><ArticleCard article={post} /></li>)}
          </ul>
        )}
    </div>
  </section>
)}

<style>
  .posts-all { margin-top: 1.25rem; }
  .posts { display: grid; gap: 3rem var(--h-gutter); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 43.75rem) { .posts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 62.5rem) { .posts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
