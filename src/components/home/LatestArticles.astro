---
import { getCollection } from 'astro:content'
import { articleCoverImg } from '../../lib/article-images'

const all = await getCollection('articles')
const articles = all
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3)

const getSlug = (id: string) => id.split('/')[0]!.replace(/\.mdoc$/, '')

const dateStr = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })
---

{articles.length > 0 && (
  <section class="h-sec" aria-labelledby="articles-heading">
    <div class="container">
      <header class="h-head">
        <h2 id="articles-heading" class="h-h2">Статьи о&nbsp;дверях</h2>
        <p class="h-lead">Покрытия, фурнитура, монтаж — разбираем то, о чём спрашивают в салоне. <a href="/articles/" class="h-link">Все статьи</a></p>
      </header>

      <ul class="posts" role="list">
        {articles.map((article) => (
          <li>
            <a href={`/articles/${getSlug(article.id)}/`} class="post">
              <span class:list={['h-media post__media', { 'post__media--empty': !article.data.coverImage }]}>
                {!article.data.coverImage && <span class="post__noimg">Фото статьи</span>}
                {article.data.coverImage && (
                  <img
                    {...articleCoverImg(article.data.coverImage, 'card')}
                    sizes="(min-width: 900px) 33vw, 100vw"
                    width="800"
                    height="450"
                    alt={article.data.coverImageAlt ?? ''}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </span>
              {!article.data.placeholder && (
                <time datetime={article.data.publishDate.toISOString()} class="h-meta post__date">
                  {dateStr(article.data.publishDate)}
                </time>
              )}
              {article.data.placeholder
                ? <p class="h-h3 post__title post__title--first">{article.data.title}</p>
                : <h3 class="h-h3 post__title">{article.data.title}</h3>}
              <p class="h-body post__desc">{article.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .posts {
    display: grid;
    gap: 3rem var(--h-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) { .posts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* Телефон: лента с прокруткой вбок вместо столбика карточек — край
     следующей карточки подсказывает, что ряд листается. */
  @media (max-width: 699px) {
    .posts {
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      gap: 0.75rem;
      margin-inline: calc(-1 * var(--h-pad));
      padding-inline: var(--h-pad);
      scroll-padding-inline: var(--h-pad);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .posts::-webkit-scrollbar { display: none; }
    .posts > li { scroll-snap-align: start; }
  }
  
  .post { display: flex; flex-direction: column; color: inherit; text-decoration: none; }
  .post__media { aspect-ratio: 3 / 2; }
  .post__date { margin-top: 1.25rem; }
  .post__title { margin-top: 0.375rem; }
  .post__title--first { margin-top: 1.25rem; }
  .post__media--empty { display: grid; place-items: center; background: var(--color-slate-200); }
  .post__noimg { font-size: 0.875rem; font-weight: 500; color: var(--color-slate-500); }
  .post:hover .post__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.25em; }
  .post__desc {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
