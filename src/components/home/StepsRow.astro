---
/**
 * «Как мы работаем» — четыре шага (нумерация оправдана: это реальная
 * последовательность). Текст тот же, что в HowTo-разметке (howItWorksSteps).
 * Единственный тёмный блок главной.
 */
import { howItWorksSteps } from '../../data/how-it-works'
---

<section class="h-sec steps" aria-labelledby="steps-heading">
  <div class="container">
    <header class="h-head">
      <h2 id="steps-heading" class="h-h2 steps__h2">Как мы работаем</h2>
      <p class="h-lead steps__lead">От выбора модели до установки — без посредников и субподрядчиков.</p>
    </header>

    <ol class="steps__list" role="list">
      {howItWorksSteps.map((s) => (
        <li class="step">
          <span class="step__num" aria-hidden="true">{s.num}</span>
          <h3 class="h-h3 step__title">{s.title}</h3>
          <p class="h-body step__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { background: var(--color-slate-900); }
  .steps__h2 { color: #fff; }
  .steps__lead { color: var(--color-slate-400); }

  .steps__list {
    display: grid;
    gap: 2.5rem var(--h-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 43.75rem) { .steps__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 68.75rem) { .steps__list { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  /* Красный отрезок поверх линейки — начало шага; номер того же цвета:
     нумерация здесь — реальная последовательность. */
  .step { position: relative; padding-top: 1.25rem; border-top: 0.0625rem solid var(--color-slate-700); }
  .step::before {
    content: '';
    position: absolute;
    top: -0.0625rem;
    left: 0;
    width: 2rem;
    height: 0.125rem;
    background: var(--h-signal);
  }
  .step__num {
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--h-signal);
  }
  .step__title { margin-top: 2.5rem; color: #fff; }
  /* Телефон: номер — узкой колонкой слева, заголовок и текст справа */
  @media (max-width: 43.6875rem) {
    .steps__list { gap: 1.75rem; }
    .step {
      display: grid;
      grid-template-columns: 2.25rem minmax(0, 1fr);
      align-items: baseline;
    }
    .step__num { grid-row: 1; padding-top: 0.125rem; }
    .step__title { grid-column: 2; margin-top: 0; }
    .step__text { grid-column: 2; }
  }
  .step__text { margin-top: 0.75rem; max-width: 24rem; font-size: 0.9375rem; color: var(--color-slate-300); }
</style>
