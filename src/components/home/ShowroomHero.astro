---
/**
 * Первый экран главной.
 *
 * Сцена — интерьеры на скруглённой подложке, плавно сменяются (слайдер);
 * поверх — H1 и белая панель с тремя направлениями салона. Каждый кадр
 * принадлежит направлению (HERO_SLIDES.way): пока он на обложке, строка
 * направления подсвечена, а полоска под ней показывает время до смены
 * кадра — видно и что сейчас на фото, и что это слайдер. Наведение (или
 * фокус) на направление показывает его кадр и ставит слайдер на паузу;
 * после ухода показ продолжается с этого направления. Каждое направление —
 * ссылка на свой раздел: посетитель выбирает тип двери, а не серии.
 * Под сценой три плитки: работы, видео руководителя, где мы.
 *
 * H1 — единственный на странице и несёт ключевой запрос.
 */
import { SITE } from '../../config/site'
import { HERO_SLIDES, type HeroWay } from '../../data/hero-image'

/* Время показа одного кадра — и для таймера, и для полоски прогресса */
const SLIDE_MS = 6000

const directions: { way: HeroWay; title: string; text: string; cta: string; href: string }[] = [
  { way: 'interior',   title: 'Межкомнатные двери',      text: 'Покрытия Эмалекс, эмаль, ПЭТ, экошпон', cta: 'Каталог дверей',       href: '/catalog/' },
  { way: 'hidden',     title: 'Скрытые двери',           text: 'Заподлицо со стеной, без наличников',   cta: 'Смотреть скрытые',     href: '/catalog/skrytye-dveri/' },
  { way: 'partitions', title: 'Алюминиевые перегородки', text: 'Стекло в алюминиевом профиле',          cta: 'Смотреть перегородки', href: '/partitions/' },
]

/* Дверь ВФД «Доррен» ДГ, цвет Polar — вырезанный кадр (WebP с прозрачностью)
   для плитки «Наши работы». Локальная уменьшенная копия с того же сервера,
   что и сайт, — см. scripts/gen-home-tiles.mjs */
const WORKS_DOOR = '/renders/home/door-dorren-polar.webp'

const arrow = '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="stage" data-stage data-interval={SLIDE_MS}>
      <div class="stage__media">
        {HERO_SLIDES.map((l, i) => (
          <img
            class:list={['stage__img', { 'is-on': i === 0 }]}
            data-layer={i}
            data-way={l.way}
            src={l.src}
            alt={i === 0 ? l.alt : ''}
            width="1672"
            height="941"
            style={`object-position: ${l.position}`}
            fetchpriority={i === 0 ? 'high' : undefined}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        ))}
      </div>

      <div class="stage__copy">
        <h1 id="hero-heading" class="stage__title">
          Шоурум дверей ВФД в&nbsp;Москве
        </h1>
        <p class="stage__since">{SITE.experience}</p>
        <p class="stage__lead">
          Посмотрите двери, покрытия и&nbsp;фурнитуру вживую — в&nbsp;нашем салоне на&nbsp;северо-востоке
          Москвы, {SITE.address.districtIn} ({SITE.address.okrug}). Замер и&nbsp;монтаж под ключ.
        </p>
      </div>

      <nav class="ways" aria-label="Направления салона">
        {directions.map((d) => (
          <a href={d.href} class:list={['way', { 'is-current': d.way === HERO_SLIDES[0].way }]} data-way={d.way}>
            <span class="way__progress" aria-hidden="true"></span>
            <span class="way__title">{d.title}</span>
            <span class="way__text">{d.text}</span>
            <span class="way__btn">{d.cta} <Fragment set:html={arrow} /></span>
            <span class="way__arrow h-arrow" aria-hidden="true"><Fragment set:html={arrow} /></span>
          </a>
        ))}
      </nav>
    </div>

    <ul class="tiles" role="list">
      <li>
        <a href="/portfolio/" class="h-tile h-tile--signal tile tile--works">
          <img class="tile__door" src={WORKS_DOOR} alt="" width="323" height="720" loading="lazy" decoding="async" onerror="this.hidden=true" />
          <span class="h-tile__corner h-tile__corner--left h-arrow h-arrow--white" aria-hidden="true"><Fragment set:html={arrow} /></span>
          <span class="h-tile__title">Наши работы</span>
          <span class="h-cap"><span class="tile__more">двери и&nbsp;перегородки </span>на&nbsp;объектах клиентов</span>
        </a>
      </li>
      <li>
        <a href="#video" class="h-tile h-tile--dark tile tile--video">
          <img class="tile__person" src={SITE.contactPhoto} alt="" width="640" height="640" loading="lazy" decoding="async" onerror="this.hidden=true" />
          <span class="h-tile__corner h-tile__corner--left tile__play" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14"><path d="M5 3.5v9l7.5-4.5z" fill="currentColor"/></svg>
          </span>
          <span class="h-tile__title">Видео о&nbsp;дверях<br />и&nbsp;фурнитуре</span>
          <span class="h-cap">{SITE.contactPerson}<span class="tile__more">, {SITE.contactRole}</span></span>
        </a>
      </li>
      <li>
        <a href={SITE.address.mapUrl} target="_blank" rel="noopener" class="h-tile h-tile--photo tile tile--place" aria-label={`${SITE.address.full} — открыть на Яндекс Картах`}>
          <img src={SITE.address.photo} alt="" loading="lazy" decoding="async" />
          <span class="h-tile__corner h-arrow h-arrow--white" aria-hidden="true"><Fragment set:html={arrow} /></span>
          <span class="h-tile__title">{SITE.address.mall}, {SITE.address.floor}</span>
          <span class="h-cap place__street">{SITE.address.street}</span>
          <dl class="metro">
            {SITE.address.metro.map((m) => (
              <div class="metro__row">
                <dt class="metro__station">{m.station}{m.line && <span class="metro__line">{m.line}</span>}</dt>
                <dd class="metro__time">{m.time}</dd>
              </div>
            ))}
          </dl>
        </a>
      </li>
    </ul>
  </div>
</section>

<script>
  /* Слайдер сцены. Таймер — цепочка setTimeout (после ручной смены кадр
     показывается полный интервал). Пауза: наведение или фокус на
     направлении, сцена вне экрана, скрытая вкладка, reduced motion. */
  document.querySelectorAll<HTMLElement>('[data-stage]').forEach((stage) => {
    const layers = [...stage.querySelectorAll<HTMLImageElement>('[data-layer]')]
    const ways = [...stage.querySelectorAll<HTMLAnchorElement>('.way[data-way]')]
    const interval = Number(stage.dataset.interval)
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    stage.style.setProperty('--slide-ms', `${interval}ms`)

    let slide = 0
    let timer: number | undefined
    let holding = false
    let onScreen = true

    // Подсветка направления текущего кадра; повторная — перезапускает полоску
    const mark = (way: string) => {
      for (const w of ways) {
        const on = w.dataset.way === way
        if (on && w.classList.contains('is-current')) {
          w.classList.remove('is-current')
          void w.offsetWidth
        }
        w.classList.toggle('is-current', on)
      }
    }
    const goTo = (i: number) => {
      slide = i
      layers.forEach((l, j) => l.classList.toggle('is-on', j === i))
      mark(layers[i].dataset.way ?? '')
    }
    const play = () => {
      clearTimeout(timer)
      const paused = still || holding || !onScreen || document.hidden
      stage.classList.toggle('is-paused', paused)
      if (paused) return
      timer = window.setTimeout(() => { goTo((slide + 1) % layers.length); play() }, interval)
    }

    for (const w of ways) {
      const hold = () => {
        holding = true
        const first = layers.findIndex((l) => l.dataset.way === w.dataset.way)
        if (layers[slide].dataset.way !== w.dataset.way && first >= 0) goTo(first)
        play()
      }
      const release = () => { holding = false; play() }
      w.addEventListener('mouseenter', hold)
      w.addEventListener('focus', hold)
      w.addEventListener('mouseleave', release)
      w.addEventListener('blur', release)
    }

    // Телефон: свайп по фото листает кадры (вертикальная прокрутка не мешает)
    let x0 = 0, y0 = 0
    stage.addEventListener('touchstart', (e) => {
      x0 = e.touches[0].clientX
      y0 = e.touches[0].clientY
    }, { passive: true })
    stage.addEventListener('touchend', (e) => {
      if ((e.target as Element).closest('.ways')) return
      const dx = e.changedTouches[0].clientX - x0
      const dy = e.changedTouches[0].clientY - y0
      if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return
      goTo((slide + (dx < 0 ? 1 : layers.length - 1)) % layers.length)
      play()
    }, { passive: true })

    new IntersectionObserver(([entry]) => { onScreen = entry.isIntersecting; play() }).observe(stage)
    document.addEventListener('visibilitychange', play)
    play()
  })
</script>

<style>
  .hero { padding-top: clamp(0.5rem, 1.5vw, 1rem); }

  /* ── Сцена ───────────────────────────────────────────── */
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(36rem, 46vw, 41rem);
    overflow: hidden;
    border-radius: 1.75rem;
    background: var(--color-slate-800);
    isolation: isolate;
  }
  .stage__media { position: absolute; inset: 0; z-index: -2; }
  .stage__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    color: transparent; /* alt не проступает текстом, если фото не загрузилось */
    opacity: 0;
    transition: opacity 1200ms var(--ease-out);
  }
  .stage__img.is-on { opacity: 1; }
  /* Затемнение только под текстом (слева сверху) — для контраста белого
     заголовка; правая часть кадра остаётся чистой. */
  .stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, color-mix(in srgb, var(--color-slate-950) 66%, transparent) 0%, color-mix(in srgb, var(--color-slate-950) 38%, transparent) 40%, transparent 68%),
      linear-gradient(180deg, color-mix(in srgb, var(--color-slate-950) 20%, transparent) 0%, transparent 40%);
  }

  .stage__copy {
    max-width: 42rem;
    padding: clamp(1.75rem, 4vw, 3.5rem);
    color: var(--color-white);
  }
  .stage__title {
    margin: 0;
    font-family: var(--h-font);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: var(--h-weight-display);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-white);
    text-wrap: balance;
  }
  /* Опыт — отдельной строкой с красной чертой: главный аргумент салона */
  .stage__since {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    font-weight: 600;
    color: var(--color-white);
  }
  .stage__since::before {
    content: '';
    flex: none;
    width: 1.5rem;
    height: 0.125rem;
    border-radius: 0.125rem;
    background: var(--h-signal);
  }
  .stage__lead {
    margin: 0.75rem 0 0;
    max-width: 27rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-white) 82%, transparent);
  }

  /* ── Панель направлений ──────────────────────────────── */
  .ways {
    display: grid;
    margin: 0 clamp(0.75rem, 2.5vw, 2.5rem) clamp(0.75rem, 2.5vw, 2.5rem);
    padding: 0.25rem clamp(1rem, 2vw, 1.25rem);
    border-radius: 1.25rem;
    background: var(--color-white);
    color: var(--h-ink);
  }
  .way {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.125rem 0.75rem;
    padding: 0.875rem 0;
    color: inherit;
    text-decoration: none;
  }
  .way + .way { border-top: 0.0625rem solid var(--h-rule); }
  .way__title { grid-column: 1; font-size: clamp(0.9375rem, 4.4vw, 1.0625rem); font-weight: 600; letter-spacing: -0.01em; }
  .way__text { grid-column: 1; font-size: 0.8125rem; line-height: 1.4; color: var(--h-muted); }
  .way__arrow { grid-column: 2; grid-row: 1 / span 2; }
  .way__btn { display: none; }
  .way:hover .way__arrow, .way.is-current .way__arrow { background: var(--h-signal); }

  /* Полоска прогресса текущего кадра — по нижней линии строки (на
     десктопе — по верхнему краю панели над колонкой). Заполняется за
     время показа кадра; на паузе — стоит заполненной. */
  .way__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.0625rem;
    height: 0.125rem;
    overflow: hidden;
    pointer-events: none;
  }
  .way__progress::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--h-signal);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .way.is-current .way__progress::after { animation: way-fill var(--slide-ms, 6s) linear forwards; }
  .stage.is-paused .way.is-current .way__progress::after { animation: none; transform: scaleX(1); }
  @keyframes way-fill { to { transform: scaleX(1); } }

  @media (min-width: 56.25rem) {
    .ways {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding: 1.5rem 0;
    }
    .way {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 0 clamp(1.25rem, 2vw, 1.75rem);
    }
    .way + .way { border-top: 0; border-left: 0.0625rem solid var(--h-rule); }
    .way__progress {
      top: -1.5rem;
      bottom: auto;
      left: clamp(1.25rem, 2vw, 1.75rem);
      right: clamp(1.25rem, 2vw, 1.75rem);
      height: 0.1875rem;
      border-radius: 0 0 0.1875rem 0.1875rem;
    }
    .way__title { font-size: 1.1875rem; }
    .way__text { margin-top: 0.25rem; font-size: 0.875rem; }
    .way__arrow { display: none; }
    .way__btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1.125rem;
      padding: 0.6875rem 1.125rem;
      border-radius: 999rem;
      background: var(--h-ink);
      color: var(--color-white);
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1;
      white-space: nowrap;
      transition: background-color 180ms var(--ease-out);
    }
    .way:hover .way__btn, .way:focus-visible .way__btn { background: var(--h-signal); }
  }
  .way:focus-visible { outline: 0.125rem solid var(--color-secondary-500); outline-offset: 0.125rem; border-radius: 0.5rem; }

  /* ── Плитки ──────────────────────────────────────────── */
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* Телефон, планшет и небольшой ноутбук: две плитки в ряд, «где мы» —
     на всю ширину. Три в ряд — только с 80rem, когда расширяется
     контейнер: на плитке уже ~22rem название, метро и текст рядом
     с картинкой не помещаются */
  .tiles > li:last-child { grid-column: 1 / -1; }
  @media (min-width: 47.5rem) {
    .tiles { gap: var(--h-tile-gap); margin-top: var(--h-tile-gap); }
  }
  @media (min-width: 80rem) {
    .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tiles > li:last-child { grid-column: auto; }
  }
  .tile { min-height: 10.5rem; }
  @media (min-width: 47.5rem) { .tile { min-height: 14rem; } }

  /* Красный круг с «плей» — плитка ведёт к блоку видео. Слева: правую
     половину плитки занимает фигура руководителя, лицо не перекрывается. */
  .tile__play {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding-left: 0.125rem;
    border-radius: 50%;
    background: var(--h-signal);
    color: var(--color-white);
    transition: transform 220ms var(--ease-out);
  }
  .tile:hover .tile__play { transform: scale(1.08); }

  /* ── Плитка «Наши работы»: белая дверь ВФД стоит в правой части и
     уходит за нижний край — видна верхняя половина с ручкой. Тень —
     тёмно-красная, в тон плитки, а не серая. На наведение дверь
     приоткрывается на петлях (петли справа — ось вращения там же). ── */
  .tile__door {
    position: absolute;
    top: 1.5rem;
    right: 1.75rem;
    z-index: -1;
    width: auto;
    height: 118%;
    max-width: none;
    filter: drop-shadow(-0.75rem 1rem 1.25rem color-mix(in srgb, var(--color-accent-900) 45%, transparent));
    transform: perspective(60rem) rotateY(0deg);
    transform-origin: 91% 50%;
    transition: transform 600ms var(--ease-out);
  }
  .tile--works:hover .tile__door { transform: perspective(60rem) rotateY(14deg); }
  .tile--works :global(.h-tile__title),
  .tile--works :global(.h-cap) { max-width: 52%; }

  /* ── Плитка «Видео»: руководитель — вырезанный силуэт, стоит справа и
     выходит из нижнего края плитки, как из-за рамки кадра. Дверь на его
     плече уходит в графит градиентом — под текстом всегда тёмный фон. ── */
  .tile--video::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg,
      var(--color-slate-900) 32%,
      color-mix(in srgb, var(--color-slate-900) 55%, transparent) 52%,
      transparent 72%);
  }
  .tile__person {
    position: absolute;
    right: -0.5rem;
    bottom: 0;
    z-index: -2;
    width: auto;
    height: 112%;
    max-width: none;
    transform-origin: 60% 100%;
    transition: transform 700ms var(--ease-out);
  }
  .tile--video:hover .tile__person { transform: scale(1.03); }
  /* Текст — слева от фигуры. Название — ровно в две строки: перенос
     задан в разметке, внутри строк переносов нет (на узкой плитке
     строка может зайти на плечо фигуры — под ней затемнение) */
  .tile--video :global(.h-tile__title) { white-space: nowrap; }
  .tile--video :global(.h-cap) { max-width: 55%; }

  /* ── Плитка «Где мы»: фото здания ТЦ — чтобы узнать его с улицы;
     ниже — метро. Затемнение плотнее обычного: текста на фото больше. ── */
  .tile--place::before {
    background: linear-gradient(0deg, color-mix(in srgb, var(--color-slate-950) 86%, transparent) 0%, color-mix(in srgb, var(--color-slate-950) 60%, transparent) 55%, color-mix(in srgb, var(--color-slate-950) 10%, transparent) 100%);
  }
  .place__street { margin-top: 0.25rem; }

  /* Метро — две колонки: станция и время, как табличка с направлениями */
  .metro { margin: 0.875rem 0 0; border-top: 0.0625rem solid color-mix(in srgb, var(--color-white) 18%, transparent); }
  .metro__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .metro__station {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--color-white);
  }
  /* Значок метро — красная «М», как на московских указателях */
  .metro__station::before {
    content: 'М';
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: var(--h-signal);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1;
  }
  .metro__line { margin-inline-start: 0.375em; font-weight: 500; color: color-mix(in srgb, var(--color-white) 70%, transparent); }
  .metro__time { margin: 0; color: color-mix(in srgb, var(--color-white) 78%, transparent); text-align: right; font-variant-numeric: tabular-nums; }

  /* ── Телефон ── */
  @media (max-width: 47.4375rem) {
    /* Две плитки в ряд: сверху место под угловую кнопку (её отступ +
       размер + зазор) — текст не наезжает на неё при любой длине */
    .tile { min-height: 9.5rem; padding: calc(0.75rem + 2.25rem + 0.5rem) 1rem 1rem; }
    /* «Работы» и «Видео» — вытянутые 4:5: картинке есть где развернуться */
    .tiles > li:not(:last-child) { aspect-ratio: 4 / 5; }
    .tile :global(.h-tile__corner) { top: 0.75rem; right: 0.75rem; }
