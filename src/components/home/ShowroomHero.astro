---
/**
 * Первый экран главной.
 *
 * Сцена — интерьеры на скруглённой подложке, плавно сменяются (слайдер);
 * поверх — H1 и белая панель с тремя направлениями салона. Наведение
 * (или фокус) на направление показывает его фон и останавливает слайдер,
 * уход — возвращает слайдер. Каждое направление — ссылка на свой раздел:
 * посетитель выбирает тип двери, а не незнакомые ему серии.
 * Под сценой три плитки: работы, видео руководителя, где мы.
 *
 * H1 — единственный на странице и несёт ключевой запрос.
 */
import { SITE } from '../../config/site'
import { HERO_SLIDES } from '../../data/hero-image'

/* Слои фона: слайды + кадр перегородок — он показывается только при
   наведении на «Перегородки». */
const layers = [
  ...HERO_SLIDES,
  { src: 'https://storage.yandexcloud.net/catalog-vfd/catalog_preview/catalog-preview3.webp', position: '50% 55%', alt: 'Алюминиевая перегородка со стеклом' },
]
const SLIDE_COUNT = HERO_SLIDES.length

const directions = [
  { title: 'Межкомнатные двери',      text: 'Покрытия Эмалекс, эмаль, ПЭТ, экошпон',      cta: 'Каталог дверей',       href: '/catalog/',               layer: 2 },
  { title: 'Скрытые двери',           text: 'Заподлицо со стеной, без наличников', cta: 'Смотреть скрытые',     href: '/catalog/skrytye-dveri/', layer: 1 },
  { title: 'Алюминиевые перегородки', text: 'Стекло в алюминиевом профиле',   cta: 'Смотреть перегородки', href: '/partitions/',            layer: 3 },
]

const arrow = '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="stage" data-stage data-slides={SLIDE_COUNT}>
      <div class="stage__media">
        {layers.map((l, i) => (
          <img
            class:list={['stage__img', { 'is-on': i === 0 }]}
            data-layer={i}
            src={l.src}
            alt={i === 0 ? l.alt : ''}
            width="1672"
            height="941"
            style={`object-position: ${l.position}`}
            fetchpriority={i === 0 ? 'high' : undefined}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        ))}
      </div>

      <div class="stage__copy">
        <h1 id="hero-heading" class="stage__title">
          Шоурум дверей ВФД в&nbsp;Москве, ТЦ&nbsp;«Компас»
        </h1>
        <p class="stage__since">{SITE.experience}</p>
        <p class="stage__lead">
          Официальный дилер Владимирской фабрики дверей. Межкомнатные и&nbsp;скрытые
          двери, алюминиевые перегородки — с&nbsp;замером и&nbsp;установкой.
        </p>
      </div>

      <div class="dots" role="group" aria-label="Фото интерьеров">
        {Array.from({ length: SLIDE_COUNT }, (_, i) => (
          <button type="button" class:list={['dots__dot', { 'is-on': i === 0 }]} data-dot={i} aria-label={`Фото ${i + 1} из ${SLIDE_COUNT}`} aria-pressed={i === 0 ? 'true' : 'false'}></button>
        ))}
      </div>

      <nav class="ways" aria-label="Направления салона">
        {directions.map((d) => (
          <a href={d.href} class="way" data-way={d.layer}>
            <span class="way__title">{d.title}</span>
            <span class="way__text">{d.text}</span>
            <span class="way__btn">{d.cta} <Fragment set:html={arrow} /></span>
            <span class="way__arrow h-arrow" aria-hidden="true"><Fragment set:html={arrow} /></span>
          </a>
        ))}
      </nav>
    </div>

    <ul class="tiles" role="list">
      <li>
        <a href="/portfolio/" class="h-tile h-tile--signal tile">
          <span class="h-tile__corner h-arrow h-arrow--white" aria-hidden="true"><Fragment set:html={arrow} /></span>
          <span class="h-tile__title">Наши работы</span>
          <span class="h-cap">двери и&nbsp;перегородки на&nbsp;объектах клиентов</span>
        </a>
      </li>
      <li>
        <a href="#video" class="h-tile h-tile--dark tile tile--video">
          <img class="tile__person" src={SITE.contactPhoto} alt="" width="640" height="640" loading="lazy" decoding="async" onerror="this.hidden=true" />
          <span class="h-tile__corner h-tile__corner--left tile__play" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14"><path d="M5 3.5v9l7.5-4.5z" fill="currentColor"/></svg>
          </span>
          <span class="h-tile__title">Видео о&nbsp;дверях</span>
          <span class="h-cap">{SITE.contactPerson}<span class="tile__role">, {SITE.contactRole}</span></span>
        </a>
      </li>
      <li>
        <a href={SITE.address.mapUrl} target="_blank" rel="noopener" class="h-tile h-tile--photo tile tile--place" aria-label={`${SITE.address.full} — открыть на Яндекс Картах`}>
          {SITE.address.photos.map((src, i) => (
            <img src={src} alt="" loading="lazy" decoding="async" class="place__img" style={`--i:${i}`} />
          ))}
          <span class="h-tile__corner h-arrow h-arrow--white" aria-hidden="true"><Fragment set:html={arrow} /></span>
          <span class="h-tile__title">{SITE.address.mall}, {SITE.address.floor}</span>
          <span class="h-cap place__street">{SITE.address.street}</span>
          <dl class="metro">
            {SITE.address.metro.map((m) => (
              <div class="metro__row">
                <dt class="metro__station">{m.station}</dt>
                <dd class="metro__time">{m.time}</dd>
              </div>
            ))}
          </dl>
        </a>
      </li>
    </ul>
  </div>
</section>

<script>
  /* Слайдер сцены: смена каждые 6 с, пауза при наведении на направление
     (показывает его фон), при скрытой вкладке и при reduced motion. */
  document.querySelectorAll<HTMLElement>('[data-stage]').forEach((stage) => {
    const layers = [...stage.querySelectorAll<HTMLImageElement>('[data-layer]')]
    const dots = [...stage.querySelectorAll<HTMLButtonElement>('[data-dot]')]
    const ways = [...stage.querySelectorAll<HTMLAnchorElement>('[data-way]')]
    const slides = Number(stage.dataset.slides)
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    let slide = 0
    let timer: number | undefined

    const show = (i: number) => layers.forEach((l, j) => l.classList.toggle('is-on', j === i))
    const goTo = (i: number) => {
      slide = i
      show(i)
      dots.forEach((d, j) => {
        d.classList.toggle('is-on', j === i)
        d.setAttribute('aria-pressed', String(j === i))
      })
    }
    const stop = () => { clearInterval(timer); timer = undefined }
    const play = () => {
      stop()
      if (still || document.hidden) return
      timer = window.setInterval(() => goTo((slide + 1) % slides), 6000)
    }

    dots.forEach((d, i) => d.addEventListener('click', () => { goTo(i); play() }))

    // Телефон: свайп по фото листает слайды (вертикальная прокрутка не мешает)
    let x0 = 0, y0 = 0
    stage.addEventListener('touchstart', (e) => {
      x0 = e.touches[0].clientX
      y0 = e.touches[0].clientY
    }, { passive: true })
    stage.addEventListener('touchend', (e) => {
      if ((e.target as Element).closest('.ways')) return
      const dx = e.changedTouches[0].clientX - x0
      const dy = e.changedTouches[0].clientY - y0
      if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return
      goTo((slide + (dx < 0 ? 1 : slides - 1)) % slides)
      play()
    }, { passive: true })

    for (const w of ways) {
      const enter = () => {
        stop()
        show(Number(w.dataset.way))
        ways.forEach((x) => x.classList.toggle('is-active', x === w))
      }
      const leave = () => {
        ways.forEach((x) => x.classList.remove('is-active'))
        goTo(slide)
        play()
      }
      w.addEventListener('mouseenter', enter)
      w.addEventListener('focus', enter)
      w.addEventListener('mouseleave', leave)
      w.addEventListener('blur', leave)
    }

    document.addEventListener('visibilitychange', play)
    play()
  })
</script>

<style>
  .hero { padding-top: clamp(0.5rem, 1.5vw, 1rem); }

  /* ── Сцена ───────────────────────────────────────────── */
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(36rem, 46vw, 41rem);
    overflow: hidden;
    border-radius: 1.75rem;
    background: var(--color-slate-800);
    isolation: isolate;
  }
  .stage__media { position: absolute; inset: 0; z-index: -2; }
  .stage__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    color: transparent; /* alt не проступает текстом, если фото не загрузилось */
    opacity: 0;
    transition: opacity 1200ms var(--ease-out);
  }
  .stage__img.is-on { opacity: 1; }
  /* Затемнение только под текстом (слева сверху) — для контраста белого
     заголовка; правая часть кадра остаётся чистой. */
  .stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, rgb(19 19 22 / 0.66) 0%, rgb(19 19 22 / 0.38) 40%, rgb(19 19 22 / 0) 68%),
      linear-gradient(180deg, rgb(19 19 22 / 0.2) 0%, rgb(19 19 22 / 0) 40%);
  }

  .stage__copy {
    max-width: 42rem;
    padding: clamp(1.75rem, 4vw, 3.5rem);
    color: #fff;
  }
  .stage__title {
    margin: 0;
    font-family: var(--h-font);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
  }
  /* Опыт — отдельной строкой с красной чертой: главный аргумент салона */
  .stage__since {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    font-weight: 600;
    color: #fff;
  }
  .stage__since::before {
    content: '';
    flex: none;
    width: 1.5rem;
    height: 2px;
    border-radius: 2px;
    background: var(--h-signal);
  }
  .stage__lead {
    margin: 0.75rem 0 0;
    max-width: 27rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.82);
  }

  /* ── Переключатель фото — справа сверху ── */
  /* Кнопка выше видимой черты (44px) — чтобы попадать пальцем */
  .dots {
    position: absolute;
    top: calc(clamp(1.25rem, 2.5vw, 2rem) - 0.625rem);
    right: clamp(1.25rem, 2.5vw, 2rem);
    display: flex;
    gap: 0.375rem;
  }
  .dots__dot {
    width: 1.25rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: linear-gradient(rgb(255 255 255 / 0.45), rgb(255 255 255 / 0.45)) center / 100% 3px no-repeat;
    cursor: pointer;
    transition: width 300ms var(--ease-out);
  }
  .dots__dot.is-on {
    width: 2.25rem;
    background-image: linear-gradient(var(--h-signal), var(--h-signal));
  }

  /* ── Панель направлений ──────────────────────────────── */
  .ways {
    display: grid;
    margin: 0 clamp(0.75rem, 2.5vw, 2.5rem) clamp(0.75rem, 2.5vw, 2.5rem);
    padding: 0.25rem clamp(1rem, 2vw, 1.25rem);
    border-radius: 1.25rem;
    background: #fff;
    color: var(--h-ink);
  }
  .way {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.125rem 0.75rem;
    padding: 0.875rem 0;
    color: inherit;
    text-decoration: none;
  }
  .way + .way { border-top: 1px solid var(--h-rule); }
  .way__title { grid-column: 1; font-size: clamp(0.9375rem, 4.4vw, 1.0625rem); font-weight: 600; letter-spacing: -0.01em; }
  .way__text { grid-column: 1; font-size: 0.8125rem; line-height: 1.4; color: var(--h-muted); }
  .way__arrow { grid-column: 2; grid-row: 1 / span 2; }
  .way__btn { display: none; }
  .way:hover .way__arrow, .way.is-active .way__arrow { background: var(--h-signal); }

  @media (min-width: 900px) {
    .ways {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding: 1.5rem 0;
    }
    .way {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 0 clamp(1.25rem, 2vw, 1.75rem);
    }
    .way + .way { border-top: 0; border-left: 1px solid var(--h-rule); }
    /* Красная метка у верхнего края панели над активным направлением —
       та же, что у активного пункта меню */
    .way::before {
      content: '';
      position: absolute;
      top: -1.5rem;
      left: clamp(1.25rem, 2vw, 1.75rem);
      width: 1.5rem;
      height: 3px;
      border-radius: 0 0 3px 3px;
      background: var(--h-signal);
      opacity: 0;
      transition: opacity 180ms var(--ease-out);
    }
    .way:hover::before, .way.is-active::before { opacity: 1; }
    .way__title { font-size: 1.1875rem; }
    .way__text { margin-top: 0.25rem; font-size: 0.875rem; }
    .way__arrow { display: none; }
    .way__btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1.125rem;
      padding: 0.6875rem 1.125rem;
      border-radius: 999px;
      background: var(--h-ink);
      color: #fff;
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1;
      white-space: nowrap;
      transition: background-color 180ms var(--ease-out);
    }
    .way:hover .way__btn, .way.is-active .way__btn { background: var(--h-signal); }
  }
  .way:focus-visible { outline: 2px solid var(--color-secondary-500); outline-offset: 2px; border-radius: 0.5rem; }

  /* ── Плитки ──────────────────────────────────────────── */
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* Телефон: две плитки в ряд, «где мы» — на всю ширину */
  .tiles > li:last-child { grid-column: 1 / -1; }
  @media (min-width: 760px) {
    .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--h-tile-gap); margin-top: var(--h-tile-gap); }
    .tiles > li:last-child { grid-column: auto; }
  }
  .tile { min-height: 10.5rem; }
  @media (min-width: 760px) { .tile { min-height: 14rem; } }

  /* Красный круг с «плей» — плитка ведёт к блоку видео. Слева: правую
     половину плитки занимает фигура руководителя, лицо не перекрывается. */
  .tile__play {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding-left: 2px;
    border-radius: 50%;
    background: var(--h-signal);
    color: #fff;
    transition: transform 220ms var(--ease-out);
  }
  .tile:hover .tile__play { transform: scale(1.08); }

  /* ── Плитка «Видео»: руководитель — вырезанный силуэт, стоит справа и
     выходит из нижнего края плитки, как из-за рамки кадра. Дверь на его
     плече уходит в графит градиентом — под текстом всегда тёмный фон. ── */
  .tile--video::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg,
      var(--color-slate-900) 32%,
      color-mix(in srgb, var(--color-slate-900) 55%, transparent) 52%,
      transparent 72%);
  }
  .tile__person {
    position: absolute;
    right: -0.5rem;
    bottom: 0;
    z-index: -2;
    width: auto;
    height: 112%;
    max-width: none;
    transform-origin: 60% 100%;
    transition: transform 700ms var(--ease-out);
  }
  .tile--video:hover .tile__person { transform: scale(1.03); }
  .tile--video :global(.h-tile__title),
  .tile--video :global(.h-cap) { max-width: 55%; }

  /* ── Плитка «Где мы»: фото здания ТЦ сменяются по кругу (фасад,
     парковка, вход) — чтобы узнать его с улицы; ниже — метро. ── */
  .tile--place::before {
    background: linear-gradient(0deg, rgb(19 19 22 / 0.86) 0%, rgb(19 19 22 / 0.6) 55%, rgb(19 19 22 / 0.1) 100%);
  }
  .tile--place .place__img { opacity: 0; animation: place-fade 18s infinite; animation-delay: calc(var(--i) * 6s - 1s); }
  .tile--place .place__img:first-of-type { opacity: 1; }
  @keyframes place-fade {
    0%     { opacity: 0; }
    5.5%   { opacity: 1; }
    33.3%  { opacity: 1; }
    38.8%  { opacity: 0; }
    100%   { opacity: 0; }
  }
  .place__street { margin-top: 0.25rem; }

  /* Метро — две колонки: станция и время, как табличка с направлениями */
  .metro { margin: 0.875rem 0 0; border-top: 1px solid rgb(255 255 255 / 0.18); }
  .metro__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .metro__station {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: #fff;
  }
  /* Значок метро — красная «М», как на московских указателях */
  .metro__station::before {
    content: 'М';
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: var(--h-signal);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1;
  }
  .metro__time { margin: 0; color: rgb(255 255 255 / 0.78); text-align: right; font-variant-numeric: tabular-nums; }

  /* ── Телефон ── */
  @media (max-width: 759px) {
    /* Две плитки в ряд: сверху место под угловую кнопку (её отступ +
       размер + зазор) — текст не наезжает на неё при любой длине */
    .tile { min-height: 9.5rem; padding: calc(0.75rem + 2.25rem + 0.5rem) 1rem 1rem; }
    .tile :global(.h-tile__corner) { top: 0.75rem; right: 0.75rem; }
    .tile :global(.h-tile__corner--left) { right: auto; left: 0.75rem; }
    .tile :global(.h-tile__title) { font-size: 1.1875rem; }
    .tile :global(.h-cap) { margin-top: 0.375rem; font-size: 0.8125rem; }
    .tile__role { display: none; }
    /* Узкая плитка: фигура — в верхней части, текст внизу на графите */
    .tile--video::before {
      background: linear-gradient(0deg,
        var(--color-slate-900) 38%,
        color-mix(in srgb, var(--color-slate-900) 60%, transparent) 55%,
        transparent 78%);
    }
    /* Размер — от ширины плитки, привязка к верху: лицо стоит на одном
       месте, даже если текст на узком экране перенёсся и плитка выросла */
    .tile__person { top: -1rem; right: -1.25rem; bottom: auto; width: 105%; height: auto; }
    .tile--video :global(.h-tile__title),
    .tile--video :global(.h-cap) { max-width: none; }
    .tiles > li:last-child .tile { min-height: 15rem; }
  }
  @media (max-width: 899px) {
    .stage { min-height: 0; border-radius: 1.25rem; }
    /* Переключатель — над заголовком слева, чтобы не наезжать на него */
    .stage__copy { padding-top: 3.5rem; padding-bottom: 6rem; }
    .dots { right: auto; left: clamp(1.75rem, 4vw, 3.5rem); }
    .stage::before {
      background: linear-gradient(180deg, rgb(19 19 22 / 0.62) 0%, rgb(19 19 22 / 0.32) 50%, rgb(19 19 22 / 0.05) 75%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__img, .dots__dot, .way::before, .way__btn, .tile__play { transition: none; }
    .tile--place .place__img { animation: none; }
    .tile__person { transition: none; }
    .tile--video:hover .tile__person { transform: none; }
  }
</style>
