---
/**
 * Четыре направления салона — бенто-сетка из фото-плиток (система .h-tile
 * из src/styles/home.css, та же, что у плиток первого экрана).
 *
 * Межкомнатные — главная плитка на три строки слева; скрытые двери,
 * перегородки и стеновые панели — друг под другом справа. Плашка —
 * короткий факт о направлении (цены и число моделей на главной не
 * показываем). Фото стеновых панелей — рендер места «home» или фото с
 * объекта из Strapi (src/data/wall-panels-page.ts → PANEL_HOME_TILE).
 */

import { DIRECTION_PHOTOS } from '../../data/direction-photos'
import { PANEL_HOME_TILE, WALL_PANELS_PAGE } from '../../data/wall-panels-page'
import { shownVisual } from '../../lib/wall-panels'
import { getWorks } from '../../lib/works'

const wallsPhoto = shownVisual(PANEL_HOME_TILE.visual, await getWorks())
if (!wallsPhoto) throw new Error('Главная: у плитки «Стеновые панели» нет ни рендера, ни фото работы — src/data/wall-panels-page.ts')

const items = [
  {
    key: 'interior',
    title: 'Межкомнатные двери',
    text: 'Покрытия Эмалекс, эмаль, ПЭТ и экошпон, цвета и фурнитура под любой интерьер',
    chip: 'в наличии и под заказ',
    photo: DIRECTION_PHOTOS.interior,
    position: '72% 50%',   // открытая белая дверь — в правой части кадра
    href: '/catalog/',
  },
  {
    key: 'hidden',
    title: 'Скрытые двери',
    text: 'Полотно заподлицо со стеной, алюминиевый короб без наличников',
    chip: 'под покраску или обои',
    photo: DIRECTION_PHOTOS.hidden,
    position: '56% 50%',   // скрытая дверь — чуть правее центра
    href: '/catalog/skrytye-dveri/',
  },
  {
    key: 'partitions',
    title: 'Алюминиевые перегородки',
    text: 'Стекло в алюминиевом профиле — проект, изготовление и монтаж под ключ',
    chip: 'изготовление 45 дней',
    photo: DIRECTION_PHOTOS.partitions,
    position: '50% 50%',
    href: '/partitions/',
  },
  {
    key: 'walls',
    title: PANEL_HOME_TILE.title,
    text: PANEL_HOME_TILE.text,
    chip: PANEL_HOME_TILE.chip,
    /* Фото портретное, плитка широкая — кадр по стене с дверями */
    photo: { ...wallsPhoto.image, sizes: '(min-width: 62.5rem) 40vw, (min-width: 40rem) 100vw, 82vw' },
    position: '50% 55%',
    href: WALL_PANELS_PAGE.path,
  },
]
---

<section class="h-sec" aria-labelledby="dir-heading">
  <div class="container">
    <header class="dir-head">
      <div>
        <h2 id="dir-heading" class="h-h2">Двери, перегородки и&nbsp;стеновые панели в&nbsp;одном стиле</h2>
        <p class="h-lead dir-head__lead">
          Подберём межкомнатные и&nbsp;скрытые двери, алюминиевые перегородки
          и&nbsp;стеновые панели под один интерьер: покрытия, цвета
          и&nbsp;фурнитура будут сочетаться между собой.
        </p>
      </div>
      <a href="/catalog/" class="h-pill h-pill--line">
        Весь каталог
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </header>

    <ul class="bento" role="list">
      {items.map((it) => (
        <li class={`bento__cell bento__cell--${it.key}`}>
          <a href={it.href} class="h-tile h-tile--photo dir">
            <img src={it.photo.src} srcset={'srcset' in it.photo ? it.photo.srcset : undefined} sizes={'sizes' in it.photo ? it.photo.sizes : undefined} alt={it.photo.alt} loading="lazy" decoding="async" style={`object-position: ${it.position}`} />
            {it.chip && <span class="h-tile__corner h-tile__corner--left h-chip">{it.chip}</span>}
            <span class="h-tile__corner h-arrow h-arrow--white" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <h3 class="h-tile__title">{it.title}</h3>
            <span class="h-cap">{it.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .dir-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .dir-head__lead { margin-top: 0.875rem; max-width: 32rem; }

  /* ── Бенто ──
     Десктоп: 12 колонок × 3 строки. Межкомнатные — 7 колонок на все
     строки; скрытые двери, перегородки и стеновые панели — по 5 колонок
     друг под другом. Планшет: межкомнатные и стеновые панели — во всю
     ширину, скрытые двери и перегородки — парой. */
  .bento {
    display: grid;
    gap: var(--h-tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bento__cell { display: grid; min-height: 13.5rem; }
  .bento__cell--interior { min-height: 20rem; }

  @media (min-width: 40rem) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bento__cell--interior { grid-column: 1 / -1; min-height: 26rem; }
    .bento__cell--walls { grid-column: 1 / -1; min-height: 18rem; }
  }
  @media (min-width: 62.5rem) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: repeat(3, clamp(13rem, 17vw, 15rem));
    }
    .bento__cell { min-height: 0; }
    .bento__cell--interior   { grid-column: 1 / span 7; grid-row: 1 / span 3; min-height: 0; }
    .bento__cell--hidden     { grid-column: 8 / span 5; grid-row: 1; }
    .bento__cell--partitions { grid-column: 8 / span 5; grid-row: 2; }
    .bento__cell--walls      { grid-column: 8 / span 5; grid-row: 3; min-height: 0; }
  }

  /* Главная плитка — заголовок крупнее, на ступень заголовка секции */
  .bento__cell--interior .h-tile__title { font-size: clamp(1.625rem, 2.8vw, 2.25rem); }
  .bento__cell--interior .h-cap { max-width: 24rem; }

  /* Телефон: направления — лентой с прокруткой вбок, а не столбиком
     в три экрана */
  @media (max-width: 39.9375rem) {
    .bento {
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      gap: 0.75rem;
      margin-inline: calc(-1 * var(--h-pad));
      padding-inline: var(--h-pad);
      scroll-padding-inline: var(--h-pad);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .bento::-webkit-scrollbar { display: none; }
    .bento__cell, .bento__cell--interior, .bento__cell--walls { min-height: 21rem; scroll-snap-align: start; }
    .bento__cell--interior .h-tile__title { font-size: clamp(1.375rem, 2.2vw, 1.75rem); }
  }
</style>
