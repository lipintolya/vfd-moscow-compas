---
/**
 * «Как к нам добраться» — адрес, часы, телефон, маршрут и карта.
 *
 * Карта своя, векторная (src/data/visit-map.json, scripts/gen-visit-map.mjs,
 * данные OpenStreetMap): цвета слоёв — токены дизайн-системы, без тайлов
 * и JS карт. Подписи улиц и метка салона — HTML поверх SVG, чтобы текст
 * оставался читаемым на телефоне, когда карта уменьшается.
 *
 * Действия — две кнопки: маршрут в Яндекс Картах и копирование адреса.
 *
 * Появление карты — один раз, когда она доходит до экрана: карта мягко
 * «наезжает», проявляются кварталы, прорисовываются улицы (pathLength=1 +
 * stroke-dashoffset), подсвечивается здание ТЦ, падает метка и выезжает
 * её карточка; пульс метки — три раза и затихает. Только opacity,
 * transform и прорисовка линий. Без JS и при reduced-motion — сразу
 * готовая карта.
 *
 * Под картой — фото ТЦ с улицы (src/data/mall-photos.ts), чтобы здание
 * узнавали на месте: на ПК ряд из четырёх, на телефоне — лента со свайпом.
 * Подписи с адресом — для поиска по картинкам; те же фото — в
 * LocalBusiness.image. Грузятся лениво — первый экран не тяжелеют.
 */
import { SITE, PHONE } from '../../config/site'
import { companyLegalInfo } from '../../lib/contacts-data'
import { ROUTE_URL } from '../../lib/map-links'
import { typograph } from '../../lib/typograph'
import map from '../../data/visit-map.json'
import { MALL_PHOTOS } from '../../data/mall-photos'

interface Props {
  /** Пояснение под заголовком — у каждой страницы своё */
  lead?: string
  /** Ряд фото ТЦ под картой */
  mallPhotos?: boolean
}
const {
  mallPhotos = true,
  lead = 'У нас можно рассмотреть покрытия вблизи, сравнить цвета и фурнитуру и рассчитать комплект вместе с менеджером.',
} = Astro.props

const hours = companyLegalInfo.workingHours

const L = map.layers
---

<section id="visit" class="h-sec" aria-labelledby="visit-heading">
  <div class="container visit">
    <div class="visit__info">
      <h2 id="visit-heading" class="h-h2">Как к&nbsp;нам добраться</h2>
      <p class="h-lead visit__lead">{typograph(lead)}</p>

      <dl class="visit__data">
        <div>
          <dt class="h-meta">Адрес</dt>
          <dd>{SITE.address.street}<br />{SITE.address.mall}, {SITE.address.floor}</dd>
        </div>
        <div>
          <dt class="h-meta">Метро</dt>
          <dd>
            <ul class="visit__metro" role="list">
              {SITE.address.metro.map((m) => (
                <li>{m.station}{'line' in m && ` (${m.line})`} <span class="visit__metro-time">{m.time}</span></li>
              ))}
            </ul>
          </dd>
        </div>
        <div>
          <dt class="h-meta">Часы работы</dt>
          <dd>{hours.shortDisplay}</dd>
        </div>
        <div>
          <dt class="h-meta">Телефон</dt>
          <dd><a href={`tel:${PHONE.raw}`} class="h-link">{PHONE.label}</a></dd>
        </div>
      </dl>

      <div class="route" data-route>
        <a href={ROUTE_URL} target="_blank" rel="noopener" class="h-btn h-btn--signal route__go">
          Построить маршрут
        </a>
        <button type="button" class="h-btn h-btn--quiet route__copy" data-copy={SITE.address.full}>
          <span data-copy-label>Скопировать адрес</span>
        </button>
      </div>
    </div>

    <figure class="h-media visit__map" data-map>
      <svg class="map" viewBox={`0 0 ${map.width} ${map.height}`} aria-hidden="true" focusable="false">
        <path class="map__green" d={L.green} />
        <path class="map__water" d={L.water} />
        <path class="map__river" d={L.river} />
        <path class="map__building" d={L.building} />
        <path class="map__minor map__road" d={L.minor} pathLength="1" />
        <path class="map__rail" d={L.rail} />
        <path class="map__major-case map__road" d={L.major} pathLength="1" />
        <path class="map__major map__road" d={L.major} pathLength="1" />
        <path class="map__mall" d={L.mall} />
      </svg>

      {map.labels.map((l) => (
        <span
          class:list={['map__label', { 'map__label--minor': !l.major }]}
          style={`--x: ${l.x}%; --y: ${l.y}%; --a: ${l.angle}deg`}
          aria-hidden="true"
        >{l.text}</span>
      ))}

      <span class="map__pin" aria-hidden="true">
        <span class="map__dot"></span>
        <span class="map__card">
          <strong>{SITE.address.mall}</strong>
          <span>{SITE.address.floor}</span>
        </span>
      </span>

      <figcaption class="map__foot">
        <a href={SITE.address.mapUrl} target="_blank" rel="noopener" class="map__open">Открыть в&nbsp;Яндекс Картах</a>
        <span class="map__credit">{map.attribution}</span>
      </figcaption>
    </figure>

    {mallPhotos && (
      <figure class="mall">
        <figcaption class="mall__head">
          <h3 class="h-h3">{typograph(`${SITE.address.mallFull} ${SITE.city.in}`)}</h3>
          <p class="h-meta">{typograph(`Как здание выглядит с улицы. Салон — ${SITE.address.floorIn}.`)}</p>
        </figcaption>
        <ul
          class="mall__list h-rail"
          role="list"
          data-lightbox
          data-lightbox-images={JSON.stringify(MALL_PHOTOS.map((p) => ({ src: p.large, alt: p.alt })))}
        >
          {MALL_PHOTOS.map((p, i) => (
            <li class="mall__item">
              <button type="button" class="h-media mall__zoom" aria-label={`Открыть фото: ${p.alt}`} data-lightbox-index={i}>
              <img
                src={p.src}
                srcset={p.srcset}
                sizes="(min-width: 80rem) 18.5rem, (min-width: 62.5rem) 25vw, (min-width: 43.75rem) 50vw, 82vw"
                alt={p.alt}
                width={p.width}
                height={p.height}
                loading="lazy"
                decoding="async"
              />
              </button>
            </li>
          ))}
        </ul>
      </figure>
    )}
  </div>
</section>

<script>
  import { initLightboxGroups } from '../../lib/lightbox'

  /* Появление карты: прячем, если на экране не больше краешка карты
     (верх ниже 70% высоты окна). Если её уже заметно видно — якорь,
     возврат назад — показываем сразу, без анимации. Дальше один раз по
     IntersectionObserver. Сам сценарий — CSS-переходы с задержками. */
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
      if (map.getBoundingClientRect().top < innerHeight * 0.7) return
      map.dataset.map = 'hidden'
      const io = new IntersectionObserver(([e]) => {
        if (!e?.isIntersecting) return
        map.dataset.map = 'shown'
        io.disconnect()
      }, { rootMargin: '0px 0px -20% 0px' })
      io.observe(map)
    })
  }

  /* Фото ТЦ — открываются крупно в общем окне просмотра */
  initLightboxGroups()

  document.querySelectorAll<HTMLElement>('[data-route]').forEach((root) => {
    const copy = root.querySelector<HTMLButtonElement>('[data-copy]')
    const label = copy?.querySelector<HTMLElement>('[data-copy-label]')
    copy?.addEventListener('click', async () => {
      if (!label) return
      const initial = label.textContent
      try {
        await navigator.clipboard.writeText(copy.dataset.copy ?? '')
        label.textContent = 'Адрес скопирован'
      } catch {
        label.textContent = 'Не получилось — выделите адрес'
      }
      setTimeout(() => { label.textContent = initial }, 2500)
    })
  })
</script>

<style>
  .visit {
    display: grid;
    gap: 3rem var(--h-gutter);
    align-items: center;
  }
  @media (min-width: 62.5rem) {
    .visit { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .visit__info { grid-column: 1 / span 5; }
    .visit__map { grid-column: 7 / span 6; }
  }
  .visit__lead { margin-top: 1.25rem; }

  /* ── Фото ТЦ: ряд во всю ширину под колонками ── */
  .mall { margin: 0; }
  @media (min-width: 62.5rem) { .mall { grid-column: 1 / -1; } }
  .mall__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  .mall__head p { margin: 0; }
  .mall__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--h-tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 62.5rem) { .mall__list { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  /* Кадры чуть разной высоты — к одной пропорции 3:2, ряд ровный */
  .mall__item { aspect-ratio: 3 / 2; }
  .mall__zoom {
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: zoom-in;
  }
  .mall__zoom img { transition: transform 700ms var(--ease-out); }
  .mall__zoom:hover img { transform: scale(1.025); }
  .mall__zoom:focus-visible { outline: 0.125rem solid var(--color-secondary-500); outline-offset: 0.1875rem; }
  @media (prefers-reduced-motion: reduce) {
    .mall__zoom img { transition: none; }
    .mall__zoom:hover img { transform: none; }
  }

  .visit__data { margin: 2.5rem 0 0; border-top: 0.0625rem solid var(--h-rule); }
  .visit__data > div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: var(--h-gutter);
    padding-block: 1rem;
    border-bottom: 0.0625rem solid var(--h-rule);
  }
  .visit__data dt { padding-top: 0.125rem; }
  .visit__data dd {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
  }
  .visit__metro { margin: 0; padding: 0; list-style: none; }
  .visit__metro-time { margin-left: 0.375rem; font-size: 0.9375rem; font-weight: 500; color: var(--h-muted); }

  /* ── Маршрут ── */
  .route { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  @media (max-width: 29.9375rem) {
    .visit__data > div { grid-template-columns: 1fr; gap: 0.25rem; }
    .route__go, .route__copy { width: 100%; }
  }

  /* ── Карта: слои — токены, толщины — в единицах viewBox ── */
  .visit__map { position: relative; margin: 0; aspect-ratio: 1000 / 720; background: var(--h-wall); }
  .map { display: block; width: 100%; height: 100%; }
  .map path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .map .map__green { fill: color-mix(in oklab, var(--color-secondary-500) 7%, var(--h-wall)); }
  .map .map__water { fill: var(--color-secondary-100); }
  .map .map__river { stroke: var(--color-secondary-100); stroke-width: 5; }
  .map .map__building { fill: var(--color-slate-200); }
  .map .map__minor { stroke: var(--color-white); stroke-width: 6; }
  .map .map__rail { stroke: var(--color-slate-300); stroke-width: 2; stroke-dasharray: 10 6; }
  .map .map__major-case { stroke: var(--color-slate-300); stroke-width: 16; }
  .map .map__major { stroke: var(--color-white); stroke-width: 13; }
  .map .map__mall { fill: var(--h-ink); }

  .map__label {
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% -50%;
    rotate: var(--a);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--h-muted);
    white-space: nowrap;
    pointer-events: none;
    text-shadow: 0 0 0.25rem var(--color-white), 0 0 0.25rem var(--color-white);
  }
  .map__label--minor { font-weight: 500; }

  /* Метка салона — в центре карты (карта строится вокруг координат салона) */
  .map__pin { position: absolute; left: 50%; top: 50%; pointer-events: none; }
  .map__dot {
    position: absolute;
    width: 1rem;
    height: 1rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--h-signal);
    box-shadow: 0 0 0 0.25rem var(--color-white);
  }
  .map__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--h-signal);
    /* Три волны и тишина — без бесконечного мигания */
    animation: pin-pulse 2400ms var(--ease-out) 1.8s 3 both;
  }
  @keyframes pin-pulse {
    from { opacity: 0.45; scale: 1; }
    to   { opacity: 0; scale: 3.2; }
  }
  .map__card {
    position: absolute;
    left: 1.25rem;
    bottom: 0.75rem;
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.75rem;
    border-radius: 0.625rem;
    background: var(--color-white);
    box-shadow: 0 0.25rem 1rem rgb(from var(--color-slate-900) r g b / 0.12);
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--h-muted);
    white-space: nowrap;
  }
  .map__card strong { font-size: 0.9375rem; font-weight: 600; color: var(--h-ink); }

  .map__foot {
    position: absolute;
    inset: auto 0.75rem 0.75rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    pointer-events: none;
  }
  .map__open {
    pointer-events: auto;
    padding: 0.5rem 0.875rem;
    border-radius: 999rem;
    background: var(--color-white);
    box-shadow: 0 0.125rem 0.5rem rgb(from var(--color-slate-900) r g b / 0.1);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--h-ink);
    text-decoration: none;
  }
  .map__open:hover { color: var(--h-signal); }
  .map__credit { font-size: 0.625rem; color: var(--h-muted); }

  @media (max-width: 29.9375rem) {
    .map__label { font-size: 0.625rem; }
    .map__label--minor { display: none; }
  }
  /* ── Появление карты ([data-map] — скрипт выше) ──
     Порядок: «камера» и кварталы → улицы → здание ТЦ и подписи → метка →
     карточка. Скрытое состояние — только у [data-map='hidden']; показ —
     те же свойства без задержки отката. */
  .map { transition: scale 1600ms var(--ease-out); transform-origin: 50% 50%; }
  .map .map__green,
  .map .map__building,
  .map .map__river,
  .map .map__rail { transition: opacity 800ms var(--ease-out); }
  .map .map__building { transition-delay: 120ms; }
  .map .map__rail { transition-delay: 300ms; }
  /* Улица — штрих длиной во весь путь (pathLength=1): сдвиг 1 → 0 прорисовывает её */
  .map .map__road {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1400ms var(--ease-out) 250ms;
  }
  .map .map__minor { transition-delay: 450ms; }
  .map .map__mall {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transition: opacity 500ms var(--ease-out) 1000ms, scale 700ms var(--ease-out) 1000ms;
  }
  .map__label { transition: opacity 600ms var(--ease-out) 1000ms; }
  .map__pin > * { transition: opacity 400ms var(--ease-out) 1300ms, translate 600ms cubic-bezier(0.34, 1.4, 0.64, 1) 1300ms; }
  .map__card { transition-delay: 1550ms; }

  [data-map='hidden'] .map { scale: 1.08; }
  [data-map='hidden'] .map :is(.map__green, .map__building, .map__river, .map__rail) { opacity: 0; }
  [data-map='hidden'] .map .map__road { stroke-dashoffset: 1; }
  [data-map='hidden'] .map .map__mall { opacity: 0; scale: 0.6; }
  [data-map='hidden'] .map__label { opacity: 0; }
  [data-map='hidden'] .map__dot { opacity: 0; translate: -50% -180%; }
  [data-map='hidden'] .map__card { opacity: 0; translate: -0.5rem 0; }
  /* Пульс — только после появления метки */
  [data-map='hidden'] .map__dot::after { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) {
    .map__dot::after { animation: none; opacity: 0; }
    .map, .map path, .map__label, .map__pin > * { transition: none; }
  }
</style>
