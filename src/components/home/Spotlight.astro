---
/**
 * Блок-новинка на главной — перед «Статьями и публикациями». Всё — из
 * статьи с полем spotlight (src/content.config.ts): плашка, заголовок,
 * лид, 2–4 факта, вертикальное фото (ссылка на статью) и ролик с кнопкой
 * «плей» без автозапуска. Нет такой статьи — нет блока. Новая новинка —
 * новая статья со spotlight, компонент не меняется.
 */
import InlineVideo from '../articles/InlineVideo.astro'
import { getSpotlight, articleHref, articleAuthor } from '../../lib/articles'
import { articleImg } from '../../lib/article-images'
import { KIND_LABEL } from '../../data/article-kinds'
import { typograph } from '../../lib/typograph'

const article = await getSpotlight()
const spot = article?.data.spotlight
const href = article ? articleHref(article.id) : ''
const author = article ? articleAuthor(article) : undefined
---

{article && spot && (
  <section class="h-sec spot" aria-labelledby="spot-heading">
    <div class="container spot__grid">
      <div class="spot__text">
        <p class="spot__meta">
          <span class="h-status h-meta" data-status="new">{spot.label}</span>
          <span class="h-meta">{KIND_LABEL[article.data.kind]}{author && ` ${author.name}`}</span>
        </p>
        <h2 id="spot-heading" class="h-h2 spot__title">
          <a href={href}>{typograph(article.data.title)}</a>
        </h2>
        <p class="h-lead spot__lead">{typograph(spot.lead ?? article.data.description)}</p>
        {spot.points && spot.points.length > 0 && (
          <ul class="spot__points" role="list">
            {spot.points.map((p) => <li class="h-body">{typograph(p)}</li>)}
          </ul>
        )}
        <a href={href} class="h-btn h-btn--ink spot__cta">Читать публикацию</a>
      </div>

      <div class="spot__media">
        <a href={href} class="h-media spot__tile" aria-label={`Читать: ${article.data.title}`}>
          <img {...articleImg(spot.image)} sizes="(min-width: 62.5rem) 25vw, 46vw" alt={spot.imageAlt} loading="lazy" decoding="async" />
        </a>
        {spot.video && spot.poster && (
          <div class="spot__tile spot__tile--video">
            <InlineVideo src={spot.video} poster={spot.poster} title={spot.videoTitle ?? article.data.title} />
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .spot__grid { display: grid; gap: clamp(1.75rem, 4vw, 3rem); }
  @media (min-width: 62.5rem) {
    .spot__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: center; }
    .spot__text  { grid-column: 1 / span 5; }
    .spot__media { grid-column: 7 / span 6; }
  }

  .spot__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.875rem; margin: 0; color: var(--h-muted); }
  .spot__title { margin-top: 1rem; }
  .spot__title a { color: inherit; text-decoration: none; }
  .spot__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--h-signal);
    text-decoration-thickness: 0.0625rem;
    text-underline-offset: 0.15em;
  }
  .spot__lead { margin-top: 1rem; }

  /* Факты — строками под линейками */
  .spot__points { margin: 1.5rem 0 0; padding: 0; list-style: none; border-top: 0.0625rem solid var(--h-rule); }
  .spot__points li { margin: 0; padding: 0.75rem 0; border-bottom: 0.0625rem solid var(--h-rule); color: var(--h-ink); }

  .spot__cta { margin-top: 1.75rem; }
  @media (max-width: 43.6875rem) {
    .spot__cta { display: flex; width: 100%; justify-content: center; min-height: 3.25rem; }
  }

  /* Фото и ролик рядом, одной высоты — вертикальные 9:16 */
  .spot__media { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--h-tile-gap); }
  .spot__tile { aspect-ratio: 9 / 16; border-radius: var(--h-tile-radius); }
  .spot__tile--video :global(.ivideo) { margin: 0; height: 100%; }
  .spot__tile--video :global(.ivideo__frame) { height: 100%; aspect-ratio: auto; border-radius: var(--h-tile-radius); }
</style>
