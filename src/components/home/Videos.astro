---
/**
 * «Видео о дверях и фурнитуре» на главной — первые HOME_VIDEOS роликов руководителя
 * шоурума (src/data/videos.ts) и ссылка на страницу со всеми, /video/.
 * Карточки — VideoList/VideoCard, просмотр и листание — VideoPlayer.
 */
import { SITE } from '../../config/site'
import { VIDEOS, HOME_VIDEOS } from '../../data/videos'
import VideoList from '../video/VideoList.astro'
import VideoPlayer from '../video/VideoPlayer.astro'
---

<section id="video" class="h-sec h-sec--tight-top" aria-labelledby="video-heading">
  <div class="container">
    <header class="h-head">
      <h2 id="video-heading" class="h-h2">Видео о&nbsp;дверях и&nbsp;фурнитуре</h2>
      <div>
        <p class="h-lead">{SITE.contactPerson}, {SITE.contactRole}, делится в&nbsp;видео полезными советами о&nbsp;выборе дверей и&nbsp;перегородок.</p>
        <a href="/video/" class="h-pill h-pill--line video-head__all">
          Все видео
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </header>

    <VideoList videos={VIDEOS.slice(0, HOME_VIDEOS)} rail />
  </div>

  <VideoPlayer />
</section>

<style>
  .video-head__all { margin-top: 1.25rem; }
</style>
