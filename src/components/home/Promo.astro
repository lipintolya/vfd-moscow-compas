---
/* Блок акций — главная (сразу под первым экраном) и страница /offers/ (page).

   Устройство: шапка как у соседних блоков главной — заголовок и срок слева,
   кнопка «Все акции» справа. Первая акция списка («Порядок на сайте» в
   Strapi) — разворотом: баннер слева, справа предложение, графитовая кнопка
   акции и «Написать в MAX» с готовым текстом. Остальные — ряд карточек.
   Баннер — ссылка: при наведении он чуть приближается, а круглая стрелка в
   углу краснеет и поворачивается (тот же отклик, что у плиток главной), на
   телефоне стрелка видна сразу — подсказывает, что баннер нажимается.
   С главной карточка ведёт к полным условиям на /offers/#<адрес акции>, на
   /offers/ — туда, куда ведёт кнопка акции. Внизу — плашка «подскажем,
   какая акция выгоднее»: MAX, Telegram, телефон.

   Баннер показывается целиком, по своим пропорциям: текст акции — на самой
   картинке, обрезка недопустима. Без баннера карточка — графитовая плашка со
   «Скидкой» крупно.

   Статический HTML, без островов: срок и число оставшихся дней дописывает
   короткий скрипт внизу — он же прячет акцию, истёкшую уже после сборки.
   MAX не принимает текст в ссылке — текст копируется по клику
   (data-copy-text, src/lib/copy-on-click.ts). */
import type { Promo } from '../../data/promos'
import { PHONE, SITE } from '../../config/site'
import { telegramWithText, maxWithText, maxChatUrl, TELEGRAM_CHAT, MAX_CHAT } from '../../lib/messengers'
import { formatDate, timeLeft } from '../../lib/promo-dates'
import { pluralRu } from '../../lib/plural'
import MaxIcon from '../ui/MaxIcon.vue'
import TelegramIcon from '../ui/TelegramIcon.vue'

interface Props {
  /** Действующие акции в порядке показа — activePromos() на странице */
  promos: Promo[]
  /** Страница /offers/: заголовок h1, условия раскрыты */
  page?: boolean
}
const { promos, page = false } = Astro.props

/** Карточек в ряд на широком экране: не меньше трёх (иначе плакаты гигантские),
    не больше пяти (иначе текст на баннере не прочесть) */
const ROW_MIN = 3
const ROW_MAX = 5

const [lead, ...rest] = promos
/* Карточки всегда мельче первой акции: она — главная. На /offers/ под
   карточкой ещё условия, поэтому в ряд не больше четырёх */
const cols = Math.min(page ? 4 : ROW_MAX, Math.max(ROW_MIN, rest.length))

/* Срок один на все акции — он в шапке блока; разные — у каждой свой */
const lastDay = promos.map((p) => p.validUntil).sort().at(-1)
const oneDeadline = promos.length > 0 && promos.every((p) => p.validUntil === lastDay)
/* Отсчёт в шапке — на момент сборки; в браузере скрипт сразу ставит точное
   время и тикает. Без JS видно только число дней */
const left = oneDeadline ? timeLeft(lastDay!) : null
const pad = (n: number) => String(n).padStart(2, '0')
const TIMER_UNITS = [
  { key: 'hours',   label: 'ч' },
  { key: 'minutes', label: 'мин' },
  { key: 'seconds', label: 'сек' },
] as const

/* Заголовки карточек ниже — явными тегами: у динамического тега Astro не
   ставит атрибут scoped-стилей, и оформление не применяется */
const Title = page ? 'h1' : 'h2'
/** Куда ведёт баннер карточки: с главной — к условиям акции, на /offers/ — по кнопке акции */
const cardHref = (p: Promo) => (page ? p.ctaLink : undefined) ?? `/offers/#${p.slug}`
/** «31 декабря 2026 года» не рвётся переносом посреди даты */
const nowrap = (s: string) => s.replaceAll(' ', ' ')
/** Готовый текст менеджеру про конкретную акцию */
const aboutPromo = (p: Promo) => `Хочу воспользоваться акцией «${p.title}».`
const ASK = 'Хочу узнать, какие акции подойдут для моего заказа.'
/** «Все 5 акций» — число из данных; одна акция — «Подробнее об акции» */
const allLabel = promos.length > 1
  ? `Все ${promos.length} ${pluralRu(promos.length, ['акция', 'акции', 'акций'])}`
  : 'Подробнее об акции'

const LEAD_SIZES = '(max-width: 43.6875rem) 92vw, (max-width: 80rem) 39vw, 31rem'
const CARD_SIZES = page
  ? `(max-width: 43.6875rem) 82vw, (max-width: 68.6875rem) 31vw, ${Math.round(76 / cols)}rem`
  : `(max-width: 43.6875rem) 62vw, (max-width: 68.6875rem) 31vw, ${Math.round(76 / cols)}rem`
---

{(promos.length > 0 || page) && (
<section id="promo" class="h-sec promo" aria-labelledby="promo-heading" data-promo data-promo-page={page ? '' : undefined}>
  <div class="container">
    <header class="phead">
      <div>
        <Title id="promo-heading" class={page ? 'h-h1' : 'h-h2'}>Акции салона</Title>
        {promos.length > 0 && (
          <p class="h-lead phead__lead" data-promo-live>
            {oneDeadline
              ? <>Действуют в&nbsp;салоне в&nbsp;{SITE.address.mall} до&nbsp;{nowrap(formatDate(lastDay!))}.</>
              : <>Действуют в&nbsp;салоне в&nbsp;{SITE.address.mall}. Срок — у&nbsp;каждой акции.</>}
          </p>
        )}
        {left && (
          <div class="ptimer" data-timer={lastDay} data-promo-live>
            <p class="ptimer__label"><span class="ptimer__dot" aria-hidden="true"></span>До конца акций</p>
            <p class="ptimer__cells" role="timer" aria-label={`До конца акций: ${left.days} ${pluralRu(left.days, ['день', 'дня', 'дней'])}`}>
              <span class="ptimer__cell ptimer__cell--days">
                <b class="ptimer__num" data-t="days" data-count={left.days}>{left.days}</b>
                <span class="ptimer__unit" data-t-word>{pluralRu(left.days, ['день', 'дня', 'дней'])}</span>
              </span>
              {TIMER_UNITS.map((u) => (
                <span class="ptimer__cell ptimer__cell--hms" aria-hidden="true">
                  <b class="ptimer__num" data-t={u.key}>{pad(left[u.key])}</b>
                  <span class="ptimer__unit">{u.label}</span>
                </span>
              ))}
            </p>
          </div>
        )}
        <p class="h-lead phead__lead" data-promo-empty hidden={promos.length > 0}>
          Сейчас действующих акций нет. Новые появятся здесь, завершённые — в&nbsp;<a href="/offers/archive/" class="h-link">архиве</a>.
        </p>
      </div>
      {!page && promos.length > 0 && (
        <a href="/offers/" class="h-btn h-btn--ink pall" data-promo-live>
          {allLabel}
          <span class="pall__arrow" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14" fill="none"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
      )}
    </header>

    {lead && (
      <article id={lead.slug} class="plead" data-until={lead.validUntil}>
        {/* Баннер повторяет кнопку акции — для клавиатуры и экранного диктора
            ссылка одна, кнопка; описание баннера диктору — абзацем ниже,
            alt оставлен для поиска по картинкам и карты сайта */}
        <a href={lead.ctaLink ?? `/offers/#${lead.slug}`} class:list={['h-media', 'pban', 'plead__media', { pposter: !lead.image }]} tabindex="-1" aria-hidden="true">
          {lead.image
            ? <img src={lead.image} srcset={lead.imageSrcset} sizes={LEAD_SIZES} alt={lead.imageAlt ?? lead.title}
                width={lead.imageWidth} height={lead.imageHeight} loading={page ? 'eager' : 'lazy'} fetchpriority={page ? 'high' : undefined} decoding="async" />
            : <span class="pposter__text">{lead.discount || lead.title}</span>}
          <span class="h-arrow h-arrow--white pban__arrow"><svg viewBox="0 0 16 16" width="14" height="14" fill="none"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <div class="plead__body">
          {!oneDeadline && <p class="h-meta"><time datetime={lead.validUntil}>до {formatDate(lead.validUntil)}</time></p>}
          {page ? <h2 class="plead__title">{lead.title}</h2> : <h3 class="plead__title">{lead.title}</h3>}
          <p class="plead__sub">{lead.subtitle}</p>
          {lead.description && <p class="h-body plead__desc">{lead.description}</p>}
          {lead.image && <p class="sr-only">На баннере: {lead.imageAlt ?? lead.title}</p>}
          <div class="plead__actions">
            {lead.ctaText && lead.ctaLink && <a href={lead.ctaLink} class="h-btn h-btn--ink">{lead.ctaText}</a>}
            {MAX_CHAT && (
              <a href={maxChatUrl()} target="_blank" rel="noopener" class="h-btn h-btn--quiet pbtn" data-copy-text={maxWithText(aboutPromo(lead))} aria-label="Написать в MAX (текст скопируется)">
                <MaxIcon class="pbtn__ico" />Написать в MAX
              </a>
            )}
          </div>
          <p class="plead__phone">или позвоните: <a href={`tel:${PHONE.raw}`} class="h-link">{PHONE.label}</a></p>
        </div>
      </article>
    )}

    {rest.length > 0 && (
      <ul class="pcards" style={`--cols: ${cols}`} role="list">
        {rest.map((promo) => (
          <li id={promo.slug} class="pcard" data-until={promo.validUntil}>
            <a href={cardHref(promo)} class:list={['h-media', 'pban', 'pcard__media', { pposter: !promo.image }]} tabindex="-1" aria-hidden="true">
              {/* Баннер не квадратный — целиком в квадрате, по бокам размытая
                  подложка из того же кадра: низ карточек в ряду ровный */}
              {promo.image && promo.imageWidth && promo.imageHeight && promo.imageWidth !== promo.imageHeight && (
                <span class="pban__fill" style={`background-image: url('${promo.image}')`}></span>
              )}
              {promo.image
                ? <img src={promo.image} srcset={promo.imageSrcset} sizes={CARD_SIZES} alt={promo.imageAlt ?? promo.title}
                    width={promo.imageWidth} height={promo.imageHeight} loading="lazy" decoding="async" />
                : <span class="pposter__text">{promo.discount || promo.title}</span>}
              <span class="h-arrow h-arrow--white pban__arrow"><svg viewBox="0 0 16 16" width="14" height="14" fill="none"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </a>
            {page
              ? <h2 class="pcard__title">{promo.title}</h2>
              : <h3 class="pcard__title"><a href={cardHref(promo)} class="pcard__link">{promo.title}</a></h3>}
            <p class="pcard__sub">{promo.subtitle}</p>
            {!oneDeadline && <p class="h-meta pcard__until"><time datetime={promo.validUntil}>до {formatDate(promo.validUntil)}</time></p>}
            {promo.image && <p class="sr-only">На баннере: {promo.imageAlt ?? promo.title}</p>}
            {page && promo.description && <p class="h-body pcard__desc">{promo.description}</p>}
            {page && (
              <p class="pcard__more">
                {promo.ctaText && promo.ctaLink && <a href={promo.ctaLink} class="h-link">{promo.ctaText}</a>}
                {MAX_CHAT && (
                  <a href={maxChatUrl()} target="_blank" rel="noopener" class="h-link pcard__max" data-copy-text={maxWithText(aboutPromo(promo))} aria-label={`Спросить про акцию «${promo.title}» в MAX (текст скопируется)`}>
                    <MaxIcon class="pcard__max-ico" />Спросить в MAX
                  </a>
                )}
              </p>
            )}
          </li>
        ))}
      </ul>
    )}

    {promos.length > 0 && (
      <div class="pask" data-promo-live>
        <div class="pask__text">
          <p class="pask__title">Подскажем, какая акция выгоднее для вашего заказа</p>
          <p class="pask__sub">Напишите или позвоните — посчитаем заказ с&nbsp;учётом акций.{page && <> Завершённые акции — в&nbsp;<a href="/offers/archive/" class="h-link">архиве</a>.</>}</p>
        </div>
        <div class="pask__actions">
          {MAX_CHAT && (
            <a href={maxChatUrl()} target="_blank" rel="noopener" class="h-btn h-btn--ink pbtn" data-copy-text={maxWithText(ASK)} aria-label="Написать в MAX (текст скопируется)">
              <MaxIcon class="pbtn__ico" tone="dark" />Написать в MAX
            </a>
          )}
          {TELEGRAM_CHAT && (
            <a href={telegramWithText(ASK)} target="_blank" rel="noopener" class="h-btn h-btn--quiet pbtn" aria-label={`Написать в Telegram: @${TELEGRAM_CHAT}`}>
              <TelegramIcon class="pbtn__ico" />Telegram
            </a>
          )}
          <a href={`tel:${PHONE.raw}`} class="h-btn h-btn--quiet">{PHONE.label}</a>
        </div>
      </div>
    )}
  </div>
</section>
)}

<script>
  /* Страница собрана заранее, а срок акции идёт: «осталось N дней» считаем
     в браузере (по московскому дню), истёкшую после сборки акцию прячем.
     Если истекли все — на главной блок исчезает, на /offers/ остаётся
     заголовок и «акций нет». */
  import { moscowToday, daysLeft, daysLeftLabel, timeLeft } from '../../lib/promo-dates'
  import { countUp } from '../../lib/count-up'
  import { pluralRu } from '../../lib/plural'

  const today = moscowToday()
  for (const block of document.querySelectorAll<HTMLElement>('[data-promo]')) {
    let alive = 0
    for (const el of block.querySelectorAll<HTMLElement>('[data-until]')) {
      if (daysLeft(el.dataset.until!, today) < 0) el.hidden = true
      else alive++
    }
    for (const el of block.querySelectorAll<HTMLElement>('[data-left]')) {
      const label = daysLeftLabel(el.dataset.left!, today)
      el.textContent = label ? ` ${label}.` : ''
      el.hidden = !label
    }
    if (alive) { startTimer(block); continue }
    if (!('promoPage' in block.dataset)) { block.hidden = true; continue }
    for (const el of block.querySelectorAll<HTMLElement>('[data-promo-live]')) el.hidden = true
    block.querySelector<HTMLElement>('[data-promo-empty]')!.hidden = false
  }

  /* Живой отсчёт до конца акций: дни при появлении досчитывают от нуля
     (countUp), часы-минуты-секунды тикают раз в секунду; сменившаяся цифра
     коротко «выезжает» сверху. При reduced-motion — те же числа без движения */
  function startTimer(block: HTMLElement) {
    const timer = block.querySelector<HTMLElement>('[data-timer]')
    if (!timer) return
    const until = timer.dataset.timer!
    const num = (k: string) => timer.querySelector<HTMLElement>(`[data-t="${k}"]`)!
    const days = num('days')
    const word = timer.querySelector<HTMLElement>('[data-t-word]')!
    const cells = timer.querySelector<HTMLElement>('[role="timer"]')!
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    const pad = (n: number) => String(n).padStart(2, '0')
    const write = (el: HTMLElement, text: string) => {
      if (el.textContent === text) return
      el.textContent = text
      if (!still) el.animate([{ transform: 'translateY(-40%)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 260, easing: 'cubic-bezier(.2,.7,.2,1)' })
    }
    const sayDays = (n: number) => {
      const w = pluralRu(n, ['день', 'дня', 'дней'])
      word.textContent = w
      cells.setAttribute('aria-label', `До конца акций: ${n} ${w}`)
    }
    /* Точное число дней — до счёта: в собранной странице оно на момент сборки */
    const first = timeLeft(until)
    if (!first) { timer.hidden = true; return }
    days.textContent = String(first.days)
    days.dataset.count = String(first.days)
    sayDays(first.days)
    timer.classList.add('is-live')
    countUp([days], 1600)
    let shownDays = first.days
    const tick = () => {
      const t = timeLeft(until)
      if (!t) { timer.hidden = true; return }
      /* Дни меняем только после досчёта, чтобы не сбить его */
      if (t.days !== shownDays && (!days.dataset.final || 'counted' in days.dataset)) {
        shownDays = t.days
        write(days, String(t.days))
        sayDays(t.days)
      }
      write(num('hours'), pad(t.hours))
      write(num('minutes'), pad(t.minutes))
      write(num('seconds'), pad(t.seconds))
      setTimeout(tick, 1000 - (Date.now() % 1000))
    }
    tick()
  }
</script>

<style>
[hidden] { display: none !important; }
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

/* ── Шапка — как у «Направлений»: текст слева, «Все акции» справа ── */
.phead {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1.25rem 2rem;
  margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
}
.phead__lead { margin-top: 0.875rem; max-width: 34rem; }
/* «Все N акций» — полноразмерная графитовая кнопка, как кнопки акции ниже:
   белая стрелка в круге поворачивается при наведении (отклик плиток главной) */
.pall { gap: 1rem; min-height: 3.5rem; padding: 0 0.5rem 0 1.75rem; font-size: 1.0625rem; }
.pall__arrow {
  display: grid;
  place-items: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  background: var(--color-white);
  color: var(--h-ink);
  transition: transform 220ms var(--ease-out), background-color 220ms var(--ease-out), color 220ms var(--ease-out);
}
.pall:hover .pall__arrow { transform: rotate(45deg); background: var(--h-signal); color: var(--color-white); }
@media (prefers-reduced-motion: reduce) { .pall__arrow { transition: none; } }
@media (max-width: 43.6875rem) { .pall { width: 100%; justify-content: space-between; padding-left: 1.5rem; } }
/* ── Отсчёт до конца акций — срок здесь главный довод ── */
.ptimer {
  display: inline-flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem 1.5rem;
  margin-top: 1.25rem;
  padding: 0.875rem 1.25rem 0.875rem 1.125rem;
  border-radius: var(--h-tile-radius);
  background: var(--h-ink);
  color: var(--color-white);
}
.ptimer__label {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  margin: 0;
  font-size: 0.9375rem;
  font-weight: 600;
  letter-spacing: -0.005em;
}
/* Красная точка «идёт» — мягкая пульсация */
.ptimer__dot { position: relative; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--h-signal); }
.ptimer__dot::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: var(--h-signal);
  animation: ptimer-pulse 2s var(--ease-out) infinite;
}
@keyframes ptimer-pulse {
  0%   { transform: scale(1); opacity: 0.7; }
  100% { transform: scale(3); opacity: 0; }
}
.ptimer__cells { display: flex; align-items: baseline; gap: 0.25rem 1rem; margin: 0; }
.ptimer__cell { display: inline-flex; align-items: baseline; gap: 0.3125rem; }
.ptimer__num {
  display: inline-block;
  font-family: var(--h-font);
  font-size: clamp(1.5rem, 2.6vw, 2rem);
  font-weight: var(--h-weight-display);
  line-height: 1;
  letter-spacing: -0.03em;
  font-variant-numeric: tabular-nums;
}
.ptimer__cell--days .ptimer__num { color: var(--color-white); }
.ptimer__unit { font-size: 0.875rem; color: color-mix(in srgb, var(--color-white) 62%, transparent); }
/* Без JS — только дни: часы и секунды на момент сборки были бы неправдой */
.ptimer:not(.is-live) .ptimer__cell--hms { display: none; }
@media (max-width: 43.6875rem) {
  .ptimer { display: flex; }
  .ptimer__cells { gap: 0.25rem 0.75rem; }
}
/* Узкий телефон (320–359 px): четыре числа в строку, не шире колонки */
@media (max-width: 22.4375rem) {
  .ptimer { padding-inline: 0.875rem; }
  .ptimer__cells { gap: 0.25rem 0.5rem; }
  .ptimer__num { font-size: 1.375rem; }
  .ptimer__unit { font-size: 0.8125rem; }
}
@media (prefers-reduced-motion: reduce) { .ptimer__dot::after { animation: none; opacity: 0; } }

/* ── Баннер-ссылка ─────────────────────────────────────── */
/* Баннер — целиком: высота по картинке, а не по рамке */
.pban { position: relative; isolation: isolate; }
.pban > img {
  height: auto;
  object-fit: contain;
  transition: transform 500ms var(--ease-out);
}
.pban:hover > img { transform: scale(1.03); }
.pban__arrow {
  position: absolute;
  right: clamp(0.625rem, 3%, 1rem);
