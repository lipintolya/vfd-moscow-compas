---
/**
 * «Новинки и двери в наличии» — витрина. Данные — src/data/in-salon.ts.
 *
 * Компьютер: слева сцена с фото, справа позиции под линейками (статус,
 * название, описание — у всех сразу, чтобы строки не сдвигались под
 * курсором). Наведение или фокус открывают позицию на сцене: фото мягко
 * сменяется (opacity, CSS), над активной позицией прорисовывается красный
 * отрезок, название темнеет, появляется стрелка. Клик — страница модели;
 * сцена ведёт туда же. Скрипт только переключает классы.
 *
 * Планшет — сетка 2×2, телефон — лента карточек вбок (.h-rail): у каждой
 * позиции своё фото, сцены нет.
 */
import { PHONE } from '../../config/site'
import { IN_SALON, STATUS_LABEL, type InSalonItem } from '../../data/in-salon'
import { typograph } from '../../lib/typograph'

interface Props {
  /** Адрес страницы модели по id из каталога (index.astro) */
  modelHref: (id: string) => string | null
}
const { modelHref } = Astro.props

const resolve = (item: InSalonItem) => ({
  ...item,
  title: typograph(item.title),
  text: typograph(item.text),
  href: item.modelId ? modelHref(item.modelId) : item.href ?? null,
})
// Модель пропала из каталога — позицию не показываем, а не ведём в никуда
const items = IN_SALON.map(resolve).filter((r): r is typeof r & { href: string } => !!r.href)

const arrow = '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
---

<section class="h-sec h-sec--wall" aria-labelledby="insalon-heading">
  <div class="container">
    <header class="h-head">
      <h2 id="insalon-heading" class="h-h2">Новинки и&nbsp;двери в&nbsp;наличии</h2>
      <p class="h-lead">Новые модели фабрики и&nbsp;двери в&nbsp;наличии&nbsp;— их&nbsp;не&nbsp;нужно ждать с&nbsp;производства, привезём за&nbsp;несколько дней.</p>
    </header>

    <div class="vitrine" data-vitrine>
      <!-- Сцена дублирует фото списка крупно — для экранных читалок скрыта,
           с клавиатуры недоступна (те же ссылки есть в списке) -->
      <a class="stage" href={items[0]?.href} tabindex="-1" aria-hidden="true">
        {items.map((it, i) => (
          <span class:list={['stage__slide', { 'is-on': i === 0 }]}>
            <img
              src={it.image.src}
              alt=""
              width={it.image.width}
              height={it.image.height}
              style={`object-position: ${it.image.position}`}
              loading="lazy"
              decoding="async"
            />
            <span class="h-chip stage__chip"><span class="h-status" data-status={it.status}>{STATUS_LABEL[it.status]}</span></span>
          </span>
        ))}
      </a>

      <div class="side">
        <ul class="items h-rail" role="list">
          {items.map((it, i) => (
            <li class:list={['item', { 'is-active': i === 0 }]}>
              <a href={it.href} class="item__link" data-item={i}>
                <span class="h-media item__media">
                  <img
                    src={it.image.src}
                    alt={it.image.alt}
                    width={it.image.width}
                    height={it.image.height}
                    style={`object-position: ${it.image.position}`}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="item__head">
                  <span class="h-status h-meta" data-status={it.status}>{STATUS_LABEL[it.status]}</span>
                  <span class="item__title">{it.title}</span>
                </span>
                <span class="h-arrow item__arrow" aria-hidden="true"><Fragment set:html={arrow} /></span>
                <span class="h-body item__text">{it.text}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="h-body side__note">
          Наличие на&nbsp;складе меняется&nbsp;— перед визитом уточните по&nbsp;телефону{' '}
          <a href={`tel:${PHONE.raw}`} class="h-link side__phone">{PHONE.label}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  /* Позиция под курсором или в фокусе — на сцену. Мышь — с короткой
     задержкой: курсор, пролетающий по списку к сцене, не перелистывает
     всё подряд. На планшете и телефоне сцены нет — ничего не делаем. */
  const root = document.querySelector<HTMLElement>('[data-vitrine]')
  if (root) {
    const wide = matchMedia('(min-width: 62.5rem)')
    const stage = root.querySelector<HTMLAnchorElement>('.stage')!
    const slides = [...stage.querySelectorAll<HTMLElement>('.stage__slide')]
    const items = [...root.querySelectorAll<HTMLElement>('.item')]
    const links = items.map((it) => it.querySelector<HTMLAnchorElement>('.item__link')!)
    let cur = 0

    const activate = (i: number) => {
      if (i === cur || !wide.matches) return
      slides[cur]!.classList.remove('is-on')
      items[cur]!.classList.remove('is-active')
      slides[i]!.classList.add('is-on')
      items[i]!.classList.add('is-active')
      stage.href = links[i]!.href
      cur = i
    }

    links.forEach((a, i) => {
      let t: number | undefined
      a.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') t = window.setTimeout(() => activate(i), 70)
      })
      a.addEventListener('pointerleave', () => clearTimeout(t))
      a.addEventListener('focus', () => activate(i))
    })
  }
</script>

<style>
  /* minmax(0, …) и min-width: 0 — лента на телефоне не должна распирать
     колонку шире экрана */
  .vitrine { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem var(--h-gutter); }
  @media (min-width: 62.5rem) {
    .vitrine { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .stage { grid-column: 1 / span 7; }
    .side  { grid-column: 8 / span 5; }
  }

  /* ── Сцена: высота — по списку справа (фото режется по object-position);
     кадры стопкой, виден .is-on — смена мягким перетеканием ── */
  .stage {
    position: relative;
    display: none;
    min-height: 32rem;
    overflow: hidden;
    border-radius: var(--h-radius);
    background: var(--h-media-bg);
  }
  @media (min-width: 62.5rem) { .stage { display: block; } }
  .stage__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 450ms var(--ease-out), scale 900ms var(--ease-out);
  }
  .stage__slide.is-on { opacity: 1; }
  .stage__slide img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Наведение на сцену (она — ссылка) — кадр чуть приближается */
  .stage:hover .stage__slide.is-on { scale: 1.02; }
  .stage__chip { position: absolute; left: clamp(0.875rem, 1.6vw, 1.25rem); bottom: clamp(0.875rem, 1.6vw, 1.25rem); }

  /* ── Список ── */
  .side { display: flex; flex-direction: column; min-width: 0; }
  .items { margin: 0; padding: 0; list-style: none; }
  .side__note { margin: auto 0 0; padding-top: 1.5rem; font-size: 0.9375rem; }
  .side__phone { white-space: nowrap; }
  .item__link { color: inherit; text-decoration: none; }
  .item__text { display: block; }
  .item__title {
    font-family: var(--h-font);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--h-ink);
    text-wrap: balance;
  }

  /* Компьютер: позиции под линейками; красный отрезок поверх линейки —
     у активной (как у шагов StepsRow) */
  @media (min-width: 62.5rem) {
    .item { position: relative; border-top: 0.0625rem solid var(--h-rule); }
    .item:last-child { border-bottom: 0.0625rem solid var(--h-rule); }
    .item::before {
      content: '';
      position: absolute;
      top: -0.0625rem;
      left: 0;
      right: 0;
      height: 0.125rem;
      background: var(--h-signal);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 500ms var(--ease-out);
    }
    .item.is-active::before { transform: scaleX(1); }

    .item__link {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 1rem;
      padding-block: clamp(1rem, 1.4vw, 1.375rem);
    }
    .item__media { display: none; }
    .item__head { display: flex; flex-direction: column; gap: 0.375rem; }
    .item__title {
      font-size: clamp(1.25rem, 1.7vw, 1.5rem);
      line-height: 1.2;
      color: var(--h-soft);
      transition: color 250ms var(--ease-out);
    }
    .item.is-active .item__title { color: var(--h-ink); }
    .item__arrow {
      align-self: center;
      grid-row: 1 / span 2;
      grid-column: 2;
      opacity: 0;
      transition: opacity 250ms var(--ease-out), transform 220ms var(--ease-out), background-color 220ms var(--ease-out);
    }
    .item.is-active .item__arrow { opacity: 1; }
    .item__link:hover .item__arrow { background: var(--h-signal); transform: rotate(45deg); }
    .item__text { grid-column: 1; margin-top: 0.5rem; max-width: 26rem; font-size: 0.9375rem; line-height: 1.5; }
  }

  /* ── Планшет и телефон: карточки с фото (телефон — лента вбок) ── */
  @media (max-width: 62.4375rem) {
    .items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem var(--h-tile-gap); }
    .item__link { display: flex; flex-direction: column; height: 100%; }
    .item__media { aspect-ratio: 4 / 5; }
    .item__media img { transition: transform 700ms var(--ease-out); }
    .item__link:hover .item__media img { transform: scale(1.025); }
    .item__head { display: flex; flex-direction: column; gap: 0.375rem; margin-top: 1rem; }
    .item__title { font-size: 1.3125rem; line-height: 1.25; }
    .item__arrow { display: none; }
    .item__text { margin-top: 0.375rem; font-size: 0.9375rem; }
    .side__note { margin-top: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__slide, .item::before, .item__title, .item__arrow, .item__media img { transition: none; }
    .stage:hover .stage__slide.is-on { scale: none; }
    .item__link:hover .item__media img { transform: none; }
  }
</style>
