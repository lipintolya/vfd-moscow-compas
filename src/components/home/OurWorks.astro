---
/**
 * «Наши работы» на главной — превью свежих объектов (src/data/portfolio-works.ts)
 * и переход на /portfolio/ со всеми работами. Сюда ведёт плитка «Наши работы»
 * первого экрана (якорь #works).
 *
 * Превью — облегчённые копии обложек (scripts/gen-portfolio-thumbs.mjs —
 * запускать после добавления работы). Пока работ нет, вместо карточек —
 * направления с подписью «Фотоотчёт появится позже»: чужие объекты
 * (челябинского салона) сюда не подставлять.
 */
import { PORTFOLIO_WORKS, CATEGORY_LABELS, OBJECT_TYPE_LABELS, type WorkCategory } from '../../data/portfolio-works'
import { typograph } from '../../lib/typograph'

const HOME_WORKS = 3

const works = [...PORTFOLIO_WORKS]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, HOME_WORKS)

// Пока работ меньше HOME_WORKS, ряд добирают направления, по которым
// фотоотчётов ещё нет, — чтобы сетка не стояла полупустой
const placeholders = (Object.keys(CATEGORY_LABELS) as WorkCategory[])
  .filter((c) => !works.some((w) => w.category === c))
  .slice(0, HOME_WORKS - works.length)
---

<section id="works" class="h-sec" aria-labelledby="works-heading">
  <div class="container">
    <header class="h-head">
      <h2 id="works-heading" class="h-h2">Наши работы</h2>
      <div>
        <p class="h-lead">
          Двери и&nbsp;перегородки на&nbsp;объектах клиентов&nbsp;— как модели выглядят
          в&nbsp;интерьере после монтажа.
        </p>
        <a href="/portfolio/" class="h-pill h-pill--line works-head__all">
          Все работы
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </header>

    <ul class="works" role="list">
      {works.map((w) => (
        <li>
          <a href={`/portfolio/${w.id}/`} class="work">
            <span class="h-media work__media">
              <img src={`/renders/portfolio/${w.id}.webp`} alt={w.title} loading="lazy" decoding="async" />
            </span>
            <p class="h-meta work__meta">
              <span class="work__kind">{CATEGORY_LABELS[w.category]}</span>
              <span>{OBJECT_TYPE_LABELS[w.objectType]}</span>
            </p>
            <h3 class="h-h3 work__title">{typograph(w.title)}</h3>
            <p class="h-body work__place">{typograph(w.location)}</p>
          </a>
        </li>
      ))}
      {placeholders.map((c) => (
        <li>
          <a href="/portfolio/" class="work">
            <span class="h-media work__media work__media--empty">
              <span class="work__noimg">Фотоотчёт появится позже</span>
            </span>
            <p class="h-meta work__meta">
              <span class="work__kind">{CATEGORY_LABELS[c]}</span>
            </p>
            <p class="h-h3 work__title">Объект появится позже</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .works-head__all { margin-top: 1.25rem; }

  .works {
    display: grid;
    gap: 3rem var(--h-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 56.25rem) { .works { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* Телефон: лента с прокруткой вбок — край следующей карточки
     подсказывает, что ряд листается */
  @media (max-width: 43.6875rem) {
    .works {
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      gap: 0.75rem;
      margin-inline: calc(-1 * var(--h-pad));
      padding-inline: var(--h-pad);
      scroll-padding-inline: var(--h-pad);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .works::-webkit-scrollbar { display: none; }
    .works > li { scroll-snap-align: start; }
  }

  .work { display: flex; flex-direction: column; color: inherit; text-decoration: none; }
  /* Дверь — вертикальный кадр, поэтому карточка выше, чем у статей */
  .work__media { aspect-ratio: 4 / 5; }
  .work__media--empty { display: grid; place-items: center; }
  .work__noimg { font-size: 0.875rem; font-weight: 500; color: var(--h-muted); }

  /* Направление — тёмным, тип объекта — приглушённым */
  .work__meta { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; margin: 1.25rem 0 0; }
  .work__kind { font-weight: 600; color: var(--h-ink); }
  .work__title { margin-top: 0.375rem; }
  .work__place { margin-top: 0.5rem; font-size: 0.9375rem; }

  /* Наведение — красное подчёркивание названия (принцип 4 home.css) */
  .work__media img { transition: transform 700ms var(--ease-out); }
  .work:hover .work__media img { transform: scale(1.025); }
  .work:hover .work__title {
    text-decoration: underline;
    text-decoration-color: var(--h-signal);
    text-decoration-thickness: 0.0625rem;
    text-underline-offset: 0.2em;
  }
  @media (prefers-reduced-motion: reduce) {
    .work__media img { transition: none; }
    .work:hover .work__media img { transform: none; }
  }
</style>
