---
/**
 * «Наши работы» на главной — превью свежих объектов (коллекция works из
 * Strapi, раздел «Портфолио») и переход на /portfolio/ со всеми работами.
 * Сюда ведёт плитка «Наши работы» первого экрана (якорь #works).
 *
 * Пока работ нет, вместо карточек —
 * направления с подписью «Фотоотчёт появится позже»: чужие объекты
 * (челябинского салона) сюда не подставлять.
 */
import WorkCard from '../portfolio/WorkCard.astro'
import { CATEGORY_LABELS, type WorkCategory } from '../../data/portfolio-works'
import { getWorks } from '../../lib/works'

const HOME_WORKS = 4

const works = (await getWorks()).slice(0, HOME_WORKS)

// Пока работ меньше HOME_WORKS, ряд добирают направления, по которым
// фотоотчётов ещё нет, — чтобы сетка не стояла полупустой
const placeholders = (Object.keys(CATEGORY_LABELS) as WorkCategory[])
  .filter((c) => !works.some((w) => w.category === c))
  .slice(0, HOME_WORKS - works.length)
---

<section id="works" class="h-sec" aria-labelledby="works-heading">
  <div class="container">
    <header class="h-head">
      <h2 id="works-heading" class="h-h2">Наши работы</h2>
      <div>
        <p class="h-lead">
          Двери и&nbsp;перегородки на&nbsp;объектах клиентов&nbsp;— как модели выглядят
          в&nbsp;интерьере после монтажа.
        </p>
        <a href="/portfolio/" class="h-btn h-btn--ink works-head__all">
          Смотреть все работы
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </header>

    <ul class="works h-rail" role="list">
      {works.map((w) => <li><WorkCard work={w} sizes="(min-width: 80rem) 25vw, (min-width: 43.75rem) 50vw, 85vw" /></li>)}
      {placeholders.map((c) => <li><WorkCard category={c} /></li>)}
    </ul>
  </div>
</section>

<style>
  .works-head__all { gap: 0.625rem; margin-top: 1.5rem; }

  .works {
    display: grid;
    gap: 3rem var(--h-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Четыре работы: две колонки на планшете (от 700 px, ниже — лента на телефоне),
     четыре в ряд на компьютере (от 1280 px) */
  @media (min-width: 43.75rem) { .works { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 80rem) { .works { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

</style>
