---
/**
 * Превью входных дверей на главной — между «Направлениями» и видео: слева
 * фото-плитка (система .h-tile, как у направлений) с рендером двери на
 * доме, справа по одной модели из каждой группы каталога (DoorCard — та же
 * карточка, что в /catalog/vhodnye-dveri/) и ссылка на весь раздел.
 * Модели — DOOR_GROUPS[].cover: новая группа появится сама. Тексты — ENTRANCE_HOME_TILE
 * (src/data/entrance-doors.ts), фото — HOME_SCENE (src/data/entrance-scenes.ts).
 *
 * Компьютер: плитка 4 колонки + 4 карточки в ряд (8 колонок). Планшет: плитка
 * во всю ширину, карточки под ней в ряд. Телефон: плитка, под ней лента
 * карточек вбок.
 */
import DoorCard from '../entrance-doors/DoorCard.astro'
import { DOOR_GROUPS, doorById, ENTRANCE_HOME_TILE } from '../../data/entrance-doors'
import { HOME_SCENE } from '../../lib/entrance-scenes'
import { typograph } from '../../lib/typograph'

const doors = DOOR_GROUPS.map((g) => {
  const d = doorById(g.cover)
  if (!d) throw new Error(`Главная: в каталоге входных дверей нет модели «${g.cover}» (DOOR_GROUPS[].cover)`)
  return d
})
const photo = HOME_SCENE
---

<section class="h-sec h-sec--wall" aria-labelledby="entrance-heading">
  <div class="container ent">
    <a href="/catalog/vhodnye-dveri/" class="h-tile h-tile--photo ent__tile">
      <img
        src={photo.src} srcset={photo.srcset} sizes="(min-width: 62.5rem) 30vw, (min-width: 40rem) 92vw, 100vw"
        alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async"
      />
      <span class="h-tile__corner h-tile__corner--left h-chip">{ENTRANCE_HOME_TILE.chip}</span>
      <span class="h-tile__corner h-arrow h-arrow--white" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <h2 id="entrance-heading" class="h-tile__title">{ENTRANCE_HOME_TILE.title}</h2>
      <span class="h-cap">{typograph(ENTRANCE_HOME_TILE.text)}</span>
    </a>

    <div class="ent__main">
      <ul class="ent__cards" role="list">
        {doors.map((d) => <li><DoorCard door={d} /></li>)}
      </ul>
      <a href="/catalog/vhodnye-dveri/" class="h-pill h-pill--line ent__all">
        {ENTRANCE_HOME_TILE.all}
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .ent { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--h-tile-gap) var(--h-gutter); align-items: start; }
  .ent__tile { min-height: 21rem; }
  /* Кадр вертикальный, плитка шире — оставляем дверь в центре по высоте */
  .ent__tile > img { object-position: 50% 54%; }

  .ent__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem var(--h-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ent__all { margin-top: clamp(1.5rem, 3vw, 2rem); }

  /* Планшет: плитка во всю ширину, но достаточно высокая, чтобы в кадр вошла вся дверь (кадр вертикальный) */
  @media (min-width: 40rem) { .ent__tile { min-height: 30rem; } }

  /* Компьютер: плитка слева на всю высоту карточек */
  @media (min-width: 62.5rem) {
    .ent { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: stretch; }
    .ent__tile { grid-column: 1 / span 4; min-height: 0; }
    .ent__main { grid-column: 5 / span 8; align-self: center; }
  }

  /* Телефон: карточки — лентой вбок, как направления выше */
  @media (max-width: 43.6875rem) {
    .ent__cards {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 9rem;
      gap: 0.875rem;
      margin-inline: calc(-1 * var(--h-pad));
      padding-inline: var(--h-pad);
      scroll-padding-inline: var(--h-pad);
      overflow-x: auto;
      scroll-snap-type: x proximity;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .ent__cards::-webkit-scrollbar { display: none; }
    .ent__cards > li { scroll-snap-align: start; }
  }
</style>
