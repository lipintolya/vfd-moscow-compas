---
/**
 * src/components/articles/Photo.astro
 * Одна плитка внутри {% photogrid %} — квадратная ячейка (у сетки doors —
 * вытянутая), object-fit:cover: без искажений, только обрезка.
 * Нажатие на фото — оригинал во весь экран (ArticleLightbox, data-zoom);
 * href — подпись становится ссылкой (напр. на страницу модели или серии).
 */
import { articleImg } from '../../lib/article-images'

interface Props {
  src:     string
  alt?:    string
  caption?: string
  href?:   string
}
const { src, alt = '', caption, href } = Astro.props
---

<figure class="dphoto">
  <button type="button" class="dphoto__frame" data-zoom={src} data-zoom-caption={caption} aria-label={`Открыть фото на весь экран${alt ? `: ${alt}` : ''}`}>
    <img {...articleImg(src)} sizes="(min-width: 40rem) 33vw, 50vw" alt={alt} loading="lazy" decoding="async" />
  </button>
  {caption && (
    <figcaption class="dphoto__caption">
      {href
        ? <a href={href} class="dphoto__link">{caption}</a>
        : caption}
    </figcaption>
  )}
</figure>

<style>
/* Дизайн-система: подложка как у .h-media, скругление --h-radius; подпись
   слева. Подпись-ссылка — тёмная, с тонким подчёркиванием, при наведении
   красным (как ссылки в тексте статьи) */
.dphoto { margin: 0; }
.dphoto .dphoto__frame {
  aspect-ratio: var(--dphoto-ratio, 1 / 1);
  border-radius: var(--h-radius);
  overflow: hidden;
  background: var(--h-media-bg);
}
.dphoto__frame img { display: block; width: 100%; height: 100%; margin: 0; border-radius: 0; object-fit: cover; }
.dphoto .dphoto__caption { margin: 0.75rem 0 0; font-size: 0.875rem; line-height: 1.4; color: var(--h-soft); }
.dphoto .dphoto__link {
  font-weight: 600;
  color: var(--h-ink);
  text-decoration: underline;
  text-decoration-color: var(--color-slate-300);
  text-decoration-thickness: 0.0625rem;
  text-underline-offset: 0.2em;
  transition: text-decoration-color 180ms var(--ease-out);
}
.dphoto .dphoto__link:hover { text-decoration-color: var(--h-signal); }
@media (prefers-reduced-motion: reduce) {
  .dphoto .dphoto__link { transition: none; }
}
</style>
