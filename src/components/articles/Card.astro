---
import { articleImg } from '../../lib/article-images'

interface Props {
  title: string
  image?: string
  imageAlt?: string
  tags?: string   // через запятую или «•»
  /** Для предметных фото на белом фоне (фурнитура и т.п.): ландшафтная
      область 4:3 и object-fit:contain вместо кропа 3:4 — предмет виден
      целиком и не «взорван» зумом. */
  contain?: boolean
}
const { title, image, imageAlt, tags, contain = false } = Astro.props
const tagList = tags ? tags.split(/[,•]/).map((t) => t.trim()).filter(Boolean) : []
---

<article class="dcard">
  <div class:list={['dcard__media', contain && 'dcard__media--contain']}>
    {image ? (
      <button type="button" class="dcard__zoom" data-zoom={image} data-zoom-caption={title} aria-label={`Открыть фото на весь экран: ${imageAlt ?? title}`}>
        <img {...articleImg(image)} sizes="(min-width: 640px) 50vw, 100vw" alt={imageAlt ?? title} loading="lazy" decoding="async" />
      </button>
    ) : (
      <div class="dcard__ph" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <rect x="4" y="3" width="13" height="18" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
          <circle cx="13.5" cy="12" r="1" fill="currentColor"/>
          <path d="M17 21h3M20 3v18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <span>Фото скоро</span>
      </div>
    )}
  </div>

  <div class="dcard__body">
    <h3 class="dcard__title">{title}</h3>
    {tagList.length > 0 && (
      <ul class="dcard__tags">
        {tagList.map((t) => <li>{t}</li>)}
      </ul>
    )}
    <div class="dcard__text"><slot /></div>
  </div>
</article>

<style>
.dcard {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--color-slate-200);
  border-radius: 1rem;
  overflow: hidden;
  background: #fff;
  transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
}
.dcard:hover {
  border-color: var(--color-slate-300);
  box-shadow: 0 10px 30px color-mix(in srgb, var(--color-slate-900) 8%, transparent);
  transform: translateY(-3px);
}

.dcard__media {
  aspect-ratio: 3 / 4;
  background: var(--color-slate-50);
  overflow: hidden;
}
.dcard__media .dcard__zoom { height: 100%; }
.dcard__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  margin: 0 !important;
  border-radius: 0 !important;
  transition: transform 400ms ease;
}
.dcard:hover .dcard__media img { transform: scale(1.04); }

.dcard__media--contain {
  aspect-ratio: 4 / 3;
  background: #fff;
  border-bottom: 1px solid var(--color-slate-100);
}
.dcard__media--contain img {
  object-fit: contain;
  padding: 1.25rem;
}

.dcard__ph {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  color: var(--color-slate-300);
  background: linear-gradient(135deg, var(--color-slate-50), var(--color-slate-100));
}
.dcard__ph svg { width: 2.25rem; height: 2.25rem; }
.dcard__ph span {
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-slate-400);
}

.dcard__body {
  padding: 1.125rem 1.25rem 1.375rem;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}
.dcard__title {
  margin: 0;
  font-size: 1.0625rem;
  font-weight: 500;
  letter-spacing: -0.01em;
  color: var(--color-ink, var(--color-slate-900));
}
.dcard__tags {
  list-style: none !important;
  margin: 0;
  padding: 0 !important;
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
}
.dcard__tags li::marker { content: ''; }
.dcard__tags li {
  list-style: none !important;
  margin: 0 !important;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-accent-600);
  background: var(--color-accent-50);
  border: 1px solid var(--color-accent-200);
  padding: 0.2rem 0.6rem;
  border-radius: 9999px;
  white-space: nowrap;
}
.dcard__text {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--color-slate-500);
}
.dcard__text :global(p) { margin: 0; }
.dcard__text :global(p + p) { margin-top: 0.5rem; }
</style>
