---
/**
 * Выделенный блок в статье — {% callout type="tip" title="…" %}…{% /callout %}.
 * Дизайн-система: серая подложка (--h-wall) и тонкая линейка слева —
 * цвет по смыслу: tip — красная (сигнал), info — графит, warning — тёмно-
 * красная. Без значков: тип читается по заголовку.
 */
interface Props {
  type?: 'tip' | 'warning' | 'info'
  title?: string
}
const { type = 'tip', title } = Astro.props
const DEFAULT_TITLE = { tip: 'Совет', info: 'Важно', warning: 'Обратите внимание' } as const
---

<aside class:list={['callout', `callout--${type}`]}>
  <p class="callout__title">{title ?? DEFAULT_TITLE[type]}</p>
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    --rule: var(--h-signal);
    margin: 2rem 0;
    padding: clamp(1.125rem, 2vw, 1.5rem) clamp(1.25rem, 2.4vw, 1.75rem);
    border-left: 0.1875rem solid var(--rule);
    border-radius: 0 var(--h-radius) var(--h-radius) 0;
    background: var(--h-wall);
  }
  .callout--info    { --rule: var(--h-ink); }
  .callout--warning { --rule: var(--color-accent-700); }
  .callout .callout__title {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--h-ink);
  }
  .callout .callout__body :global(p) { margin: 0; font-size: 1rem; line-height: 1.65; color: var(--h-soft); }
  .callout .callout__body :global(p + p) { margin-top: 0.75rem; }
</style>
