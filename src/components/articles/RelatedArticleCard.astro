---
/**
 * «Статья по теме» — перелинковка каталог → статьи: страницы моделей,
 * лендинги покрытий и стилей, входные двери. Какая статья — решает
 * relatedArticle() из src/lib/articles.ts. Карточка — ArticleCard (compact),
 * та же, что в разделе статей и на главной: обложка слева, справа тип,
 * дата, заголовок и описание; наведение — красное подчёркивание заголовка.
 * Лежит в обёртке .home, чтобы работала и на страницах не в дизайн-системе главной.
 */
import '../../styles/home.css'
import ArticleCard from './ArticleCard.astro'
import type { Article } from '../../lib/articles'

interface Props {
  article: Article
}
const { article } = Astro.props
---

<section class="section" aria-label="Статья по теме">
  <div class="container">
    <div class="home related-article">
      <ArticleCard article={article} compact heading="h2" />
    </div>
  </div>
</section>

<style>
  /* .home красит фон страницы белым — здесь он нужен только для токенов */
  .related-article { background: none; }
</style>
