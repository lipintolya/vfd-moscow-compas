---
import { articleCoverImg } from '../../lib/article-images'

interface Props {
  href: string
  title: string
  description: string
  publishDate: Date
  coverImage?: string
  coverImageAlt?: string
  loading?: 'lazy' | 'eager'
}

const {
  href,
  title,
  description,
  publishDate,
  coverImage,
  coverImageAlt,
  loading = 'lazy',
} = Astro.props

const dateStr = publishDate.toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
---

<a
  href={href}
  class="group flex flex-col h-full rounded-2xl border border-slate-200 bg-white overflow-hidden hover:border-accent-400 hover:shadow-lg transition-[border-color,box-shadow] duration-200 focus-visible:outline-2 focus-visible:outline-accent-500 focus-visible:outline-offset-2"
>
  <!-- Cover image — 16:9 (1920×1080) -->
  <div class="relative aspect-video overflow-hidden bg-slate-100 shrink-0">
    {coverImage ? (
      <img
        {...articleCoverImg(coverImage, 'card')}
        sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
        width="800"
        height="450"
        alt={coverImageAlt ?? ''}
        {loading}
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04] motion-reduce:transition-none"
      />
    ) : (
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-linear-to-br from-slate-100 to-slate-200">
        <svg class="w-10 h-10 text-slate-300" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/>
          <path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Обложка скоро</span>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5 sm:p-6">
    <time
      datetime={publishDate.toISOString()}
      class="text-xs text-slate-400 mb-3 block tabular-nums"
    >
      {dateStr}
    </time>

    <h2 class="text-base font-medium leading-snug text-slate-900 mb-2 group-hover:text-accent-600 transition-colors duration-200 line-clamp-3">
      {title}
    </h2>

    <p class="text-sm leading-relaxed text-slate-500 line-clamp-2 flex-1">
      {description}
    </p>

    <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-accent-600 group-hover:gap-2 transition-[gap] duration-200" aria-hidden="true">
      Читать
      <svg viewBox="0 0 16 16" fill="none" class="w-3.5 h-3.5 shrink-0" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </div>
</a>
