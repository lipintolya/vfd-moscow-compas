---
/**
 * Карточка статьи — одна на все места: главная (LatestArticles), раздел
 * /articles/, «Читайте также» в статье. Дизайн-система главной: фото без
 * текста поверх, над заголовком — тип, дата и время чтения; наведение —
 * красное подчёркивание заголовка.
 *
 * feature — крупная: фото и текст рядом (на телефоне — друг под другом);
 * для единственной статьи на главной и первой в разделе.
 */
import { articleCoverImg } from '../../lib/article-images'
import { articleHref, formatArticleDate, readingMinutes, type Article } from '../../lib/articles'
import { KIND_LABEL } from '../../data/article-kinds'
import { typograph } from '../../lib/typograph'

interface Props {
  article: Article
  feature?: boolean
  loading?: 'lazy' | 'eager'
  /** Уровень заголовка карточки — по месту на странице */
  heading?: 'h2' | 'h3'
}
const { article, feature = false, loading = 'lazy', heading = 'h3' } = Astro.props
const { data } = article
const Heading = heading
const sizes = feature ? '(min-width: 56.25rem) 58vw, 100vw' : '(min-width: 56.25rem) 33vw, (min-width: 43.75rem) 50vw, 82vw'
---

<a href={articleHref(article.id)} class:list={['acard', { 'acard--feature': feature }]}>
  <span class="h-media acard__media">
    {data.coverImage
      ? <img
          {...articleCoverImg(data.coverImage, feature ? 'hero' : 'card')}
          {sizes}
          width="800"
          height="450"
          alt={data.coverImageAlt ?? ''}
          {loading}
          decoding="async"
        />
      : <span class="acard__noimg">Обложка появится позже</span>}
  </span>
  <span class="acard__body">
    <span class="h-meta acard__meta">
      <span class="acard__kind">{KIND_LABEL[data.kind]}</span>
      <time datetime={data.publishDate.toISOString()}>{formatArticleDate(data.publishDate)}</time>
      <span>{readingMinutes(article.body)}&nbsp;мин чтения</span>
    </span>
    <Heading class="acard__title">{typograph(data.title)}</Heading>
    <span class="h-body acard__desc">{typograph(data.description)}</span>
    {feature && (
      <span class="acard__more">
        Читать статью
        <span class="h-arrow" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </span>
    )}
  </span>
</a>

<style>
  .acard { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .acard__media { display: grid; place-items: center; aspect-ratio: 3 / 2; }
  .acard__noimg { font-size: 0.875rem; font-weight: 500; color: var(--h-muted); }
  .acard__body { display: flex; flex-direction: column; }

  /* Тип — тёмным, дата и время чтения — приглушённо */
  .acard__meta { display: flex; flex-wrap: wrap; gap: 0.25rem 0.875rem; margin-top: 1.25rem; color: var(--h-muted); }
  .acard__kind { font-weight: 600; color: var(--h-ink); }

  .acard__title {
    margin: 0.5rem 0 0;
    font-family: var(--h-font);
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--h-ink);
    text-wrap: balance;
  }
  .acard__desc {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Крупная: фото 7 колонок, текст — 5, по нижнему краю фото */
  @media (min-width: 56.25rem) {
    .acard--feature {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--h-gutter);
      align-items: end;
    }
    .acard--feature .acard__media { grid-column: 1 / span 7; aspect-ratio: 16 / 10; }
    .acard--feature .acard__body { grid-column: 8 / span 5; }
    .acard--feature .acard__meta { margin-top: 0; }
  }
  .acard--feature .acard__title { font-size: clamp(1.5rem, 2.6vw, 2.25rem); font-weight: var(--h-weight-display); line-height: 1.1; letter-spacing: -0.03em; }
  .acard--feature .acard__desc { -webkit-line-clamp: 4; font-size: 1rem; }
  .acard__more { display: inline-flex; align-items: center; gap: 0.75rem; margin-top: 1.5rem; font-size: 0.9375rem; font-weight: 600; color: var(--h-ink); }
  .acard__more .h-arrow { transition: transform 220ms var(--ease-out), background-color 220ms var(--ease-out); }

  /* Наведение — красное подчёркивание заголовка, стрелка поворачивается */
  .acard:hover .acard__title {
    text-decoration: underline;
    text-decoration-color: var(--h-signal);
    text-decoration-thickness: 0.0625rem;
    text-underline-offset: 0.2em;
  }
  .acard:hover .acard__more .h-arrow { transform: rotate(45deg); background: var(--h-signal); }
  @media (prefers-reduced-motion: reduce) {
    .acard__more .h-arrow { transition: none; }
    .acard:hover .acard__more .h-arrow { transform: none; }
  }
</style>
