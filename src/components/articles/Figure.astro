---
import { articleImg } from '../../lib/article-images'

interface Props {
  /** Не обязателен — без src рендерится плейсхолдер «Фото скоро» (тот же
      приём, что в Card.astro), чтобы можно было заранее разметить в статье
      место под фото и добавить снимок позже без правки текста. */
  src?: string
  alt?: string
  caption?: string
  /** @deprecated фото больше не выходит за пределы колонки текста — проп оставлен,
      чтобы не трогать существующий контент статей, но ни на что не влияет. */
  wide?: boolean
  /** Компактный вариант для схем/чертежей: без кропа 21:9 (естественные
      пропорции картинки) и с ограниченной шириной по центру колонки. */
  narrow?: boolean
  /** Естественные пропорции во всю ширину колонки (без кропа 21:9) —
      палитры, картинки с текстом, которые нельзя резать. */
  natural?: boolean
}

const { src, alt = '', caption, narrow = false, natural = false } = Astro.props

/* В тексте — облегчённый вариант по ширине экрана (колонка статьи до 80rem,
   narrow — до 26rem); по нажатию оригинал открывается во весь экран
   (ArticleLightbox на странице статьи — по data-zoom). */
const inline = src ? articleImg(src) : undefined
const sizes  = narrow ? '(min-width: 448px) 416px, calc(100vw - 32px)' : '(min-width: 1312px) 1280px, calc(100vw - 32px)'
---

<figure class:list={['article-figure', narrow && 'article-figure--narrow']}>
  {src ? (
    <button type="button" data-zoom={src} data-zoom-caption={caption} aria-label={`Открыть фото на весь экран${alt ? `: ${alt}` : ''}`}>
      <img
        src={inline?.src ?? src}
        srcset={inline?.srcset}
        sizes={inline?.srcset ? sizes : undefined}
        alt={alt}
        loading="lazy"
        decoding="async"
        class:list={['article-figure__img', (narrow || natural) && 'article-figure__img--natural']}
      />
    </button>
  ) : (
    <div class="article-figure__placeholder" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <rect x="4" y="3" width="16" height="18" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
        <circle cx="9.5" cy="9" r="1.5" fill="currentColor"/>
        <path d="M4 16l4.5-4.5a1.5 1.5 0 0 1 2.12 0L15 16M13.5 14.5 15.5 12.5a1.5 1.5 0 0 1 2.12 0L20 15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Фото скоро{alt ? `: ${alt}` : ''}</span>
    </div>
  )}
  {caption && (
    <figcaption class="article-figure__caption">{caption}</figcaption>
  )}
</figure>

<style>
.article-figure {
  margin: 2rem 0;
}
.article-figure__img {
  display: block;
  width: 100%;
  aspect-ratio: 21 / 9;
  border-radius: var(--h-radius, 0.75rem);
  object-fit: cover;
}
/* Схемы, палитры, картинки с текстом — целиком, без кропа */
.article-figure__img--natural {
  aspect-ratio: auto;
  object-fit: contain;
  background: var(--color-white);
  border: 0.0625rem solid var(--h-rule, var(--color-slate-200));
}
.article-figure__caption {
  margin-top: 0.75rem;
  font-size: 0.8125rem;
  line-height: 1.45;
  color: var(--h-muted, var(--color-slate-500));
}
.article-figure--narrow {
  max-width: 26rem;
  margin-left: auto;
  margin-right: auto;
}
.article-figure__placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.625rem;
  aspect-ratio: 21 / 9;
  width: 100%;
  border-radius: 0.75rem;
  background: linear-gradient(135deg, var(--color-slate-50), var(--color-slate-100));
  color: var(--color-slate-300);
}
.article-figure__placeholder svg {
  width: 2.5rem;
  height: 2.5rem;
}
.article-figure__placeholder span {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--color-slate-400);
  text-align: center;
  padding: 0 1rem;
}
</style>
