---
/**
 * «Каталог и контакты» — две плитки-ссылки в конце статьи и раздела
 * статей: из текста — в каталог (/catalog/) и к контактам салона
 * (/contacts/). Перелинковка статьи → коммерческие страницы. Плитки —
 * .h-tile дизайн-системы главной; адрес и часы — из конфига.
 */
import { SITE } from '../../config/site'
import { companyLegalInfo } from '../../lib/contacts-data'
import { typograph } from '../../lib/typograph'

const arrow = '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
const { street, mall, floor } = SITE.address
---

<nav class="anav" aria-label="Каталог и контакты">
  <a href="/catalog/" class="h-tile h-tile--dark anav__tile">
    <span class="h-tile__corner h-arrow h-arrow--white"><Fragment set:html={arrow} /></span>
    <span class="anav__title">Каталог межкомнатных дверей</span>
    <span class="anav__text">{typograph('Серии, покрытия и цвета с ценами — от эмали и Эмалекса до экошпона, скрытых дверей и перегородок.')}</span>
  </a>
  <a href="/contacts/" class="h-tile h-tile--light anav__tile">
    <span class="h-tile__corner h-arrow"><Fragment set:html={arrow} /></span>
    <span class="anav__title">Контакты салона</span>
    <span class="anav__text">{typograph(`${street}, ${mall}, ${floor}. ${companyLegalInfo.workingHours.shortDisplay}.`)}</span>
  </a>
</nav>

<style>
  .anav {
    display: grid;
    gap: var(--h-tile-gap);
  }
  @media (min-width: 40rem) {
    .anav { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .anav__tile { min-height: 11rem; gap: 0.5rem; padding-right: 4rem; }
  .anav__title {
    font-family: var(--h-font);
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .anav__text { font-size: 0.9375rem; line-height: 1.5; opacity: 0.78; }
  .anav__tile:hover .anav__title {
    text-decoration: underline;
    text-decoration-color: var(--h-signal);
    text-decoration-thickness: 0.0625rem;
    text-underline-offset: 0.2em;
  }
  .anav .h-arrow { transition: transform 220ms var(--ease-out), background-color 220ms var(--ease-out); }
  @media (prefers-reduced-motion: reduce) {
    .anav .h-arrow { transition: none; }
    .anav__tile:hover .h-arrow { transform: none; }
  }
</style>
