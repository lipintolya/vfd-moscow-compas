---
/**
 * src/components/catalog/PlinthSection.astro
 * Полный блок «Плинтус» (описание + таблица цен по всем материалам + фото) —
 * общий для /catalog/decor и карточки товара (модели Эмалекс/Эмаль). Данные
 * и цены только из data/decor-products.ts, здесь не дублируются — если
 * поменяются там, обновятся сразу в обоих местах.
 */
import InfoImageViewer from './InfoImageViewer.vue'
import { IMAGES, MATERIAL_LABELS, PLINTUS_MATERIALS, PLINTUS_ROWS, type Material } from '../../data/decor-products'

interface Props {
  /** Заголовок секции — на /catalog/decor «Плинтус», на карточке товара
      уместнее «Плинтус к дверям» (контекст уже про конкретную дверь). */
  title?: string
}
const { title = 'Плинтус' } = Astro.props

const fmt = (n: number) => n.toLocaleString('ru-RU') + ' ₽'
---

<section class="section" style="padding-bottom: 0">
  <div class="container">
    <div class="dc-section">
      <div class="dc-section__text">
        <h2 class="dc-h2">{title}</h2>
        <p class="dc-p">
          Закрывает стык пола и стены, скрывает зазор и кабель-канал.
          Крепится на клипсы — без видимых саморезов на лицевой стороне.
        </p>
        <p class="dc-p">
          <strong>Область применения:</strong> подбирается в цвет дверного полотна
          для единого ансамбля или в цвет пола/стен — под любой интерьер.
          Высота 70 мм — для стандартных помещений, 100 мм — для высоких потолков
          и просторных комнат.
        </p>
      </div>
    </div>

    <div class="dc-table-wrap">
      <table class="dc-table">
        <thead>
          <tr>
            <th scope="col" class="dc-table__row-head"></th>
            <th scope="col" class="dc-table__row-head"></th>
            {PLINTUS_MATERIALS.map((m: Material) => <th scope="col">{MATERIAL_LABELS[m]}</th>)}
          </tr>
        </thead>
        <tbody>
          {PLINTUS_ROWS.map(row => (
            <tr>
              <th scope="row">{row.name}{row.size && <span class="dc-row-size">{row.size}</span>}</th>
              <td class="dc-table__unit" data-label="Ед.">{row.unit}</td>
              {PLINTUS_MATERIALS.map((m: Material) => (
                <td data-label={MATERIAL_LABELS[m]}>{row.prices[m] != null ? fmt(row.prices[m]!) : '—'}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="dc-table-foot">Длина плинтуса — 2140 мм. Клипсы для монтажа — единая цена для всех покрытий. * Цены ознакомительные — точный расчёт у менеджера салона.</p>

    {IMAGES.plintus && (
      <InfoImageViewer
        client:visible
        variant="photo"
        images={[{
          src: IMAGES.plintus,
          caption: 'Плинтус в интерьере',
          alt: 'Плинтус в цвет дверного полотна — ВФД',
        }]}
      />
    )}
  </div>
</section>

<style>
.dc-h2 {
  margin: 0 0 1rem;
  font-size: clamp(1.625rem, 3vw, 2.125rem);
  font-weight: 500;
  color: #0f172a;
  letter-spacing: -0.02em;
  line-height: 1.15;
}
.dc-p {
  margin: 0 0 1rem;
  color: #64748b;
  font-size: clamp(0.9375rem, 1.4vw, 1.0625rem);
  line-height: 1.75;
}
.dc-p strong { color: #334155; font-weight: 600; }

.dc-section { display: flex; flex-direction: column; margin-bottom: 0; }

.dc-table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border: 1px solid #e5e7eb;
  border-radius: 1rem;
  margin: 1.5rem 0 0.75rem;
}
.dc-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9375rem;
  background: #fff;
}
.dc-table thead tr { border-bottom: 2px solid #0f172a; }
.dc-table thead th {
  padding: 1rem 1.375rem;
  text-align: left;
  font-size: 1rem;
  font-weight: 500;
  color: #0f172a;
  white-space: nowrap;
}
.dc-table thead .dc-table__row-head { color: transparent; }
.dc-table tbody th {
  padding: 0.875rem 1.375rem;
  text-align: left;
  font-size: 0.875rem;
  font-weight: 600;
  color: #334155;
  border-right: 1px solid #f1f5f9;
  max-width: 13rem;
  white-space: normal;
}
.dc-row-size {
  display: block;
  margin-top: 0.125rem;
  font-size: 0.75rem;
  font-weight: 500;
  color: #94a3b8;
  text-transform: none;
  letter-spacing: 0;
  white-space: normal;
}
.dc-table tbody td {
  padding: 0.875rem 1.375rem;
  color: #334155;
  font-weight: 600;
  border-bottom: 1px solid #f8fafc;
  white-space: nowrap;
}
.dc-table__unit {
  color: #94a3b8 !important;
  font-weight: 500 !important;
  font-size: 0.8125rem;
}
.dc-table tbody tr:last-child td,
.dc-table tbody tr:last-child th { border-bottom: none; }

.dc-table-foot {
  margin: 0 0 2.5rem;
  font-size: 0.8125rem;
  color: #94a3b8;
  line-height: 1.6;
}

@media (max-width: 640px) {
  .dc-table-wrap { overflow-x: visible; border: none; border-radius: 0; margin-top: 1.25rem; }
  .dc-table, .dc-table thead, .dc-table tbody, .dc-table tr, .dc-table th, .dc-table td {
    display: block;
    width: 100%;
  }
  .dc-table thead { display: none; }
  .dc-table tbody tr {
    padding: 1rem 1.125rem;
    margin-bottom: 0.75rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.875rem;
    background: #fff;
  }
  .dc-table tbody tr:last-child { margin-bottom: 0; }
  .dc-table tbody th {
    padding: 0 0 0.625rem;
    background: transparent;
    border-right: none;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 0.5rem;
    max-width: none;
  }
  .dc-table tbody td {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.375rem 0;
    border-bottom: none;
    white-space: normal;
  }
  .dc-table tbody td::before {
    content: attr(data-label);
    color: #94a3b8;
    font-weight: 500;
    font-size: 0.8125rem;
    flex-shrink: 0;
  }
  .dc-table__unit { color: #94a3b8 !important; }
}
</style>
