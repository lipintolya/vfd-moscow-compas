---
/**
 * «Плинтус к дверям» на страницах моделей (покрытия, где он есть) — та же
 * секция, что на /catalog/decor/ (DecorSection.astro, данные — decor-page.ts):
 * поменяли цену или текст — обновится в обоих местах. Ссылка ведёт на весь
 * декор: со страницы двери следующий шаг — фальшфрамуга и рейки.
 */
import DecorSection from './DecorSection.astro'
import { decorCategory } from '../../data/decor-page'
import '../../styles/home.css'
---

<div class="home">
  <DecorSection
    category={decorCategory('plintus')}
    title="Плинтус к дверям"
    more={{ href: '/catalog/decor/', label: 'Фальшфрамуга, декоративные рейки и весь декор к дверям' }}
  />
</div>
