---
/**
 * src/components/catalog/ColorCategoryLanding.astro
 *
 * Шаблон SEO-лендингов /catalog/<slug> по цветовой гамме (см.
 * src/data/color-categories.ts — там же объяснение, почему это отдельная
 * категория от door-categories.ts/по покрытию: цвет фильтруется по
 * substring-совпадению colorKeywords, а не точным values фильтра
 * CatalogClient). Карточки под категорию отбираются здесь же (на сборке),
 * дальше в CatalogClient уходит уже готовая, более узкая выборка.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../ui/Breadcrumbs.astro'
import FaqAccordion from '../ui/FaqAccordion.astro'
import CatalogClient from './CatalogClient.vue'
import type { ColorCategory } from '../../data/color-categories'
import type { CatalogCardItem } from './types'

interface Props {
  category: ColorCategory
  cards: CatalogCardItem[]
}

const { category, cards } = Astro.props

const matchesCategory = (name: string) =>
  category.colorKeywords.some(kw => name.toLowerCase().includes(kw.toLowerCase()))

/* CatalogProductCard всегда показывает colorSwatches[0] по умолчанию — если
   модель попала в категорию по НЕ-первому цвету (например, «Иннова» первым
   цветом идёт «Шёлковый белый», а совпал «Шёлковый графит» вторым свотчем),
   превью на этом лендинге показывало бы чужой цвет. Переставляем совпавший
   свотч на первое место (и зеркалим photo/price/colorName/colorHex на
   верхнем уровне карточки, чтобы всё, что читает эти поля напрямую, тоже
   совпадало) — превью всегда показывает именно тот цвет, из-за которого
   карточка попала в подборку. Предпочитаем available:true совпадение (у
   available:false нет фото), но если доступного совпадения нет — берём
   любое, лишь бы не показывать случайный несовпавший цвет. */
const withMatchedColorFirst = (card: CatalogCardItem): CatalogCardItem => {
  const idx = card.colorSwatches.findIndex(s => s.available && matchesCategory(s.name))
  const fallbackIdx = idx !== -1 ? idx : card.colorSwatches.findIndex(s => matchesCategory(s.name))
  if (fallbackIdx <= 0) return card

  const swatch = card.colorSwatches[fallbackIdx]!
  const reordered = [
    swatch,
    ...card.colorSwatches.slice(0, fallbackIdx),
    ...card.colorSwatches.slice(fallbackIdx + 1),
  ]
  return {
    ...card,
    colorSwatches: reordered,
    photo: swatch.photo || card.photo,
    price: swatch.available === false ? card.price : (swatch.price ?? card.price),
    colorName: swatch.name,
    colorHex: swatch.hex,
  }
}

const matchedCards = cards
  .filter(c => c.colorNames.some(matchesCategory))
  .map(withMatchedColorFirst)

/* Фильтры и цветовая полоса — только из уже отобранной подборки, чтобы
   не предлагать серии/покрытия/оттенки, которых в этой категории нет. */
const allSeries = [...new Map(
  matchedCards.filter(c => c.seriesSlug).map(c => [c.seriesSlug, { label: c.series, value: c.seriesSlug }])
).values()]
const allCoatings = [...new Map(
  matchedCards.filter(c => c.coatingSlug).map(c => [c.coatingSlug, { label: c.coating, value: c.coatingSlug }])
).values()]
const allColors = [...new Map(
  matchedCards.flatMap(c => c.colorSwatches.filter(s => s.available && matchesCategory(s.name))
    .map(s => [s.name, { label: s.name, value: s.name, color: s.hex }] as const))
).values()]

const canonicalUrl = Astro.site ? new URL(`/catalog/${category.slug}/`, Astro.site).href : undefined

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог', href: '/catalog/' },
  { label: category.h1 },
]

const structuredData = canonicalUrl ? [
  /* BreadcrumbList в JSON-LD отдаёт сам Breadcrumbs.astro — здесь не дублируем. */
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: category.h1,
    description: category.metaDescription,
    url: canonicalUrl,
    numberOfItems: matchedCards.length,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: category.faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
] : undefined
---

<BaseLayout
  title={category.metaTitle}
  description={category.metaDescription}
  canonical={canonicalUrl}
  structuredData={structuredData}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="section bg-white" style="padding-bottom: 0">
    <div class="container">
      <header class="max-w-2xl mb-8 md:mb-10">
        <p class="t-eyebrow mb-3">{category.eyebrow}</p>
        <h1 class="text-3xl font-medium leading-tight tracking-tight text-slate-900 md:text-5xl">{category.h1}</h1>
        <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">{category.intro}</p>
      </header>

      {allColors.length > 0 && (
        <ul class="mb-8 flex flex-wrap gap-3 md:mb-10" role="list">
          {allColors.map(c => (
            <li class="flex items-center gap-2 rounded-full border border-slate-200 bg-white py-1.5 pl-1.5 pr-3.5">
              <span class="h-6 w-6 shrink-0 rounded-full ring-1 ring-black/10" style={`background:${c.color}`} aria-hidden="true"></span>
              <span class="text-sm font-medium text-slate-700">{c.label}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <div class="section bg-white" id="catalog-title">
    <div class="container">
      <CatalogClient
        client:load
        cards={matchedCards}
        series={allSeries}
        coatings={allCoatings}
        colors={allColors}
        initialSeries=""
        initialCoating=""
        initialColor=""
      />
    </div>
  </div>

  <section class="section">
    <div class="container">
      <FaqAccordion items={category.faq} />
    </div>
  </section>
</BaseLayout>
