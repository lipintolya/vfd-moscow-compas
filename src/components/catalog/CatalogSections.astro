---
/**
 * Другие разделы каталога — ряд фото-плиток под сеткой межкомнатных дверей
 * на /catalog/: входные двери, скрытые, стеновые панели, декор и плинтус.
 * Под сеткой, а не над ней: человек, пришедший за межкомнатной дверью, сначала
 * видит её и не уходит со страницы.
 * Плитки те же, что на главной (.h-tile--photo из styles/home.css): фото во
 * всю плитку, название и строка-пояснение внизу. Человек, пришедший за
 * входной дверью или панелью, находит её сразу, не открывая меню.
 * Новый раздел — строка в items.
 */
import { ENTRANCE_DOORS, ENTRANCE_PAGE, ENTRANCE_MIN_PRICE } from '../../data/entrance-doors'
import { rub } from '../../data/services'
import { DIRECTION_PHOTOS } from '../../data/direction-photos'
import { PANEL_HOME_TILE, WALL_PANELS_PAGE } from '../../data/wall-panels-page'
import { PLINTUS_PAGE } from '../../data/plintus'
import { shownVisual } from '../../lib/wall-panels'
import { getWorks } from '../../lib/works'
import { pluralRu } from '../../lib/plural'

const walls = shownVisual(PANEL_HOME_TILE.visual, await getWorks())
if (!walls) throw new Error('Каталог: у плитки «Стеновые панели» нет ни рендера, ни фото работы')
const hero = ENTRANCE_PAGE.hero

const items = [
  {
    title: 'Входные двери',
    note: `${ENTRANCE_DOORS.length} ${pluralRu(ENTRANCE_DOORS.length, ['модель', 'модели', 'моделей'])}, от ${rub(ENTRANCE_MIN_PRICE)}`,
    href: '/catalog/vhodnye-dveri/',
    src: hero.src, srcset: hero.srcset, alt: hero.alt, position: '25% 0%',
  },
  {
    title: 'Скрытые двери',
    note: 'Заподлицо со стеной, калькулятор цены',
    href: '/catalog/skrytye-dveri/',
    src: DIRECTION_PHOTOS.hidden.src, alt: DIRECTION_PHOTOS.hidden.alt, position: '56% 50%',
  },
  {
    title: 'Стеновые панели',
    note: 'Шпон и покрытия дверей',
    href: WALL_PANELS_PAGE.path,
    src: walls.image.src, srcset: walls.image.srcset, alt: walls.image.alt, position: '50% 55%',
  },
  {
    title: 'Плинтус и декор',
    note: 'Напольный, скрытый, с подсветкой',
    href: '/catalog/plintus/',
    src: PLINTUS_PAGE.hero.src, alt: PLINTUS_PAGE.hero.alt, position: '50% 100%',
  },
]
---

<nav class="cs" aria-label="Другие разделы каталога">
  <ul class="cs__list" role="list">
    {items.map((it) => (
      <li>
        <a href={it.href} class="h-tile h-tile--photo cs__tile">
          <img src={it.src} srcset={it.srcset} sizes="(min-width: 62.5rem) 25vw, 50vw" alt="" role="presentation" style={`object-position: ${it.position}`} loading="lazy" decoding="async" />
          <span class="h-tile__corner h-arrow h-arrow--white" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="h-tile__title">{it.title}</span>
          <span class="h-cap">{it.note}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .cs { margin: clamp(2.5rem, 5vw, 4rem) 0 0; }
  .cs__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .cs__tile { min-height: 12.5rem; padding: clamp(0.875rem, 1.6vw, 1.25rem); }
  .cs__tile .h-tile__title { font-size: 1.0625rem; line-height: 1.2; }
  .cs__tile .h-cap { margin-top: 0.25rem; max-width: none; font-size: 0.8125rem; line-height: 1.35; }
  @media (min-width: 62.5rem) {
    .cs__list { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--h-tile-gap); }
    .cs__tile { min-height: 16rem; }
    .cs__tile .h-tile__title { font-size: clamp(1.25rem, 1.7vw, 1.5rem); }
    .cs__tile .h-cap { font-size: 0.875rem; }
  }
</style>
