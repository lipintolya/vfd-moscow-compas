---
/* Кнопка «воспроизвести снова» поверх видео — появляется, когда ролик
   закончился (скрипт страницы, [data-replay]) */
---
<button class="replay" type="button" aria-label="Воспроизвести снова" data-replay>
  <span class="replay__btn">
    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M5 3.5v9l7.5-4.5z" fill="currentColor"/></svg>
  </span>
</button>

<style>
  .replay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: rgb(from var(--color-slate-950) r g b / 0.3);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms var(--ease-out);
  }
  .replay.is-visible { opacity: 1; pointer-events: auto; }
  /* Та же красная круглая кнопка, что у карточек видео на главной */
  .replay__btn {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--h-signal);
    color: var(--color-white);
    transition: scale 200ms var(--ease-out);
  }
  .replay:hover .replay__btn { scale: 1.06; }
</style>
