---
/* Оверлей-кнопка «воспроизвести снова» поверх видео */
---
<button class="pt-pivot-replay" type="button" aria-label="Воспроизвести снова">
  <span class="pt-pivot-play-btn">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <polygon points="7,4 20,12 7,20" fill="white" />
    </svg>
  </span>
</button>
