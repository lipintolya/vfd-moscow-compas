---
/**
 * Плавающая пилюля-навигация по секциям страницы — появляется после
 * прокрутки, подсвечивает активный раздел, сворачивается в сессии.
 * Изначально писалась только под /partitions/, теперь принимает `items`
 * снаружи, чтобы тот же паттерн переиспользовать на /catalog/ (Серии/Каталог)
 * без копипасты компонента.
 *
 * Плашка по ширине равна своему содержимому (fit-content), а не всему .container —
 * с 2 пунктами (/catalog/) полноширинный бар выглядел пустым посередине.
 */
interface Props {
  items?: { id: string; label: string }[]
}

const {
  items = [
    { id: 'pt-profiles', label: 'Профили' },
    { id: 'pt-colors',   label: 'Цвета' },
    { id: 'pt-glass',    label: 'Остекление' },
    { id: 'pt-benefits', label: 'Преимущества' },
    { id: 'pt-process',  label: 'Процесс' },
    { id: 'pt-projects', label: 'Проекты' },
  ],
} = Astro.props
---

<nav id="pt-snav" class="snav" aria-label="Разделы страницы" aria-hidden="true">
  <div class="container">
    <div class="snav__bar">
      <ul class="snav__list" role="list">
        {items.map((it) => (
          <li>
            <a href={`#${it.id}`} class="snav__link" data-snav={it.id}>{it.label}</a>
          </li>
        ))}
      </ul>
      <button id="pt-snav-close" class="snav__close" type="button" aria-label="Скрыть меню разделов" title="Скрыть меню разделов">
        <svg viewBox="0 0 14 14" width="12" height="12" fill="none" aria-hidden="true">
          <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<style>
  /* Якоря останавливаются ниже шапки и меню (≈3.5rem) */
  :global(html:has(#pt-snav)) { scroll-padding-top: calc(var(--header-height) + 4rem); }

  .snav {
    position: fixed;
    inset-inline: 0;
    top: calc(var(--header-height) + 0.75rem);
    z-index: 45;
    opacity: 0;
    translate: 0 -0.5rem;
    pointer-events: none;
    transition: opacity 200ms var(--ease-out), translate 200ms var(--ease-out);
  }
  .snav.snav--visible { opacity: 1; translate: 0; pointer-events: auto; }

  /* Плашка по ширине содержимого; на узком экране — во всю ширину
     контейнера, пункты листаются вбок одной строкой */
  .snav__bar {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    padding: 0.3125rem;
    border: 0.0625rem solid var(--color-slate-200);
    border-radius: 999rem;
    background: rgb(from var(--color-white) r g b / 0.86);
    -webkit-backdrop-filter: blur(1rem) saturate(1.6);
    backdrop-filter: blur(1rem) saturate(1.6);
  }
  .snav__list {
    display: flex;
    gap: 0.125rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    /* край ленты гаснет — видно, что пункты листаются */
    mask-image: linear-gradient(90deg, transparent 0, var(--color-slate-900) 0.75rem, var(--color-slate-900) calc(100% - 0.75rem), transparent 100%);
  }
  .snav__list::-webkit-scrollbar { display: none; }
  @media (min-width: 48rem) { .snav__list { mask-image: none; } }

  .snav__link {
    display: block;
    padding: 0.625rem 1rem;
    border-radius: 999rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    color: var(--color-slate-600);
    transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out);
  }
  .snav__link:hover { color: var(--color-accent-500); }
  .snav__link.snav--active { background: var(--color-slate-900); color: var(--color-white); }

  .snav__close {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-slate-400);
    cursor: pointer;
    transition: color 150ms var(--ease-out);
  }
  .snav__close:hover { color: var(--color-slate-900); }

  .snav :is(a, button):focus-visible { outline: 0.125rem solid var(--color-secondary-500); outline-offset: 0.125rem; }

  @media (prefers-reduced-motion: reduce) { .snav { transition: none; } }
</style>

<script>
  ;(function () {
    const nav = document.getElementById('pt-snav')
    if (!(nav instanceof HTMLElement)) return

    let dismissed = sessionStorage.getItem('pt-snav-dismissed') === '1'

    const onScroll = () => {
      if (dismissed) return
      const show = window.scrollY > 380
      nav.classList.toggle('snav--visible', show)
      nav.setAttribute('aria-hidden', show ? 'false' : 'true')
    }
    window.addEventListener('scroll', onScroll, { passive: true })

    const closeBtn = document.getElementById('pt-snav-close')
    if (closeBtn instanceof HTMLElement) {
      closeBtn.addEventListener('click', () => {
        dismissed = true
        sessionStorage.setItem('pt-snav-dismissed', '1')
        nav.classList.remove('snav--visible')
        nav.setAttribute('aria-hidden', 'true')
      })
    }

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-snav]'))
    const ids = links.map((l) => l.dataset.snav).filter((id): id is string => Boolean(id))

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return
            links.forEach((l) => {
              l.classList.toggle('snav--active', l.dataset.snav === e.target.id)
            })
            // Активный пункт — в видимую часть ленты (на телефоне она листается)
            const active = nav.querySelector<HTMLElement>('.snav--active')
            const list = active?.parentElement?.parentElement
            if (active && list) list.scrollTo({ left: active.offsetLeft - list.clientWidth / 2 + active.clientWidth / 2, behavior: 'smooth' })
          })
        },
        { rootMargin: '-15% 0px -75% 0px' },
      )
      ids.forEach((id) => {
        const el = document.getElementById(id)
        if (el) io.observe(el)
      })
    }

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault()
        const target = document.getElementById(link.dataset.snav ?? '')
        if (!target) return
        // Отступ сверху (шапка + меню) — scroll-padding в стилях выше
        target.scrollIntoView({ behavior: 'smooth', block: 'start' })
      })
    })
  })()
</script>
