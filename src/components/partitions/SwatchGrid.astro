---
/**
 * Сетка образцов — цвета профиля и остекление. Клик открывает образец
 * в лайтбоксе с листанием по всей сетке (скрипт страницы, [data-lightbox]).
 * 7 в ряд на широком экране, неполный нижний ряд — по центру.
 */
interface SwatchItem { src: string; alt: string; name: string; hex?: string }
interface Props {
  items:    SwatchItem[]
  /** square — цвета профиля; portrait — остекление */
  variant?: 'square' | 'portrait'
}
const { items, variant = 'square' } = Astro.props
const [w, h] = variant === 'portrait' ? [300, 400] : [300, 300]
---

<ul class:list={['swatches', `swatches--${variant}`]} role="list" data-lightbox>
  {items.map((item, i) => (
    <li>
      <button class="swatch" type="button" aria-label={`Рассмотреть: ${item.name}`} data-lightbox-index={i}>
        {/* Цвет образца — данные (partitions.ts), видны, пока грузится фото */}
        <span class="swatch__media" style={item.hex ? `background: ${item.hex}` : undefined}>
          <img src={item.src} alt={item.alt} loading="lazy" decoding="async" width={w} height={h} />
        </span>
        <span class="swatch__name">{item.name}</span>
      </button>
    </li>
  ))}
</ul>

<style>
  .swatches {
    --gap: clamp(0.75rem, 1.5vw, 1rem);
    --cols: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 24rem) { .swatches { --cols: 3; } }
  @media (min-width: 33rem) { .swatches { --cols: 4; } }
  @media (min-width: 48rem) { .swatches { --cols: 5; } }
  @media (min-width: 64rem) { .swatches { --cols: 7; } }
  .swatches > li { flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols)); }

  .swatch {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: zoom-in;
  }
  .swatch__media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--h-media-bg);
  }
  .swatches--portrait .swatch__media { aspect-ratio: 3 / 4; }
  .swatch__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }
  .swatch:hover .swatch__media img { transform: scale(1.05); }
  .swatch__name { font-size: 0.8125rem; font-weight: 600; line-height: 1.3; color: var(--h-soft); }
  .swatch:hover .swatch__name { color: var(--h-ink); }

  @media (prefers-reduced-motion: reduce) {
    .swatch__media img { transition: none; }
    .swatch:hover .swatch__media img { transform: none; }
  }
</style>
