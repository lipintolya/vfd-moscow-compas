---
/**
 * «Полезные материалы» — PDF для подготовки к замеру. Строки списка
 * разделены линейками, как адрес и часы в «Как к нам добраться».
 */
const files = [
  {
    href:  '/pdf/blank-zamera-peregorodki.pdf',
    title: 'Бланк замера по перегородкам',
    desc:  'Форма для самостоятельного снятия размеров перед заказом',
    meta:  'PDF, 1,6 МБ',
  },
  {
    href:  '/pdf/trebovaniya-k-proemu.pdf',
    title: 'Требования к проёму',
    desc:  'Как подготовить проём, чтобы монтаж прошёл без переделок',
    meta:  'PDF, 2 страницы',
  },
]
---

<ul class="dl" role="list">
  {files.map((f) => (
    <li>
      <a class="dl__row" href={f.href} target="_blank" rel="noopener" download>
        <span class="dl__body">
          <span class="dl__title">{f.title}</span>
          <span class="h-meta">{f.desc}</span>
        </span>
        <span class="h-meta dl__meta">{f.meta}</span>
        <span class="h-arrow dl__arrow" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><path d="M8 3v9M4 8.5 8 12.5l4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .dl { margin: 0; padding: 0; list-style: none; border-top: 0.0625rem solid var(--h-rule); }
  .dl li { border-bottom: 0.0625rem solid var(--h-rule); }
  .dl__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.25rem;
    color: inherit;
    text-decoration: none;
  }
  .dl__body { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .dl__title { font-size: 1.0625rem; font-weight: 600; color: var(--h-ink); }
  .dl__row:hover .dl__title { text-decoration: underline; text-decoration-color: var(--h-signal); text-underline-offset: 0.2em; }
  .dl__row:hover .dl__arrow { background: var(--h-signal); }
  @media (max-width: 29.9375rem) {
    .dl__row { grid-template-columns: minmax(0, 1fr) auto; }
    .dl__meta { display: none; }
  }
</style>
