---
/**
 * «Преимущества алюминиевых перегородок» — сетка 1/2/3 колонки.
 * Без карточек и теней: линейка сверху, иконка, заголовок, текст —
 * тот же язык, что у шагов и списков главной.
 */
import type { Benefit } from '../../data/partitions'
import { typograph } from '../../lib/typograph'

interface Props { items: Benefit[] }
const { items } = Astro.props

// Карта иконок — внутренняя разметка <svg> (stroke, currentColor)
const icons: Record<Benefit['icon'], string> = {
  shield: '<path d="M12 3l7 2.6v5.1c0 4.3-2.9 7.5-7 8.9-4.1-1.4-7-4.6-7-8.9V5.6L12 3z"/><path d="M12 8.6c1.2 1.6 2 2.8 2 3.9a2 2 0 1 1-4 0c0-1.1.8-2.3 2-3.9z"/>',
  design: '<path d="M12 3l1.7 4.6L18 9l-4.3 1.4L12 15l-1.7-4.6L6 9l4.3-1.4L12 3z"/><path d="M18 14l.6 1.7 1.9.3-1.9.6-.6 1.4-.6-1.4-1.9-.6 1.9-.3.6-1.7z"/>',
  uv:     '<circle cx="12" cy="12" r="3.6"/><path d="M12 2v2.4M12 19.6V22M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2 12h2.4M19.6 12H22M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"/>',
  wear:   '<path d="M12 3l7 2.6v5.1c0 4.3-2.9 7.5-7 8.9-4.1-1.4-7-4.6-7-8.9V5.6L12 3z"/><path d="M8.8 12l2.1 2.1L15.4 9.5"/>',
  light:  '<path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/>',
  eco:    '<path d="M5 20c0-8 6-14.5 15-15 0 9-5 16.5-15 15z"/><path d="M5.5 19.5c4-4.5 7.2-6.8 11.5-8"/>',
}
---

<ul class="benefits" role="list">
  {items.map((b) => (
    <li class="benefit">
      <svg class="benefit__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[b.icon]} />
      <h3 class="h-h3 benefit__title">{typograph(b.title)}</h3>
      <p class="h-body benefit__text">{typograph(b.text)}</p>
    </li>
  ))}
</ul>

<style>
  .benefits {
    display: grid;
    gap: 2.5rem var(--h-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 43.75rem) { .benefits { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 68.75rem) { .benefits { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .benefit { padding-top: 1.25rem; border-top: 0.0625rem solid var(--h-rule); }
  .benefit__icon { display: block; width: 1.75rem; height: 1.75rem; color: var(--h-signal); }
  .benefit__title { margin-top: 1.25rem; text-wrap: balance; }
  .benefit__text { margin-top: 0.75rem; font-size: 0.9375rem; }
</style>
