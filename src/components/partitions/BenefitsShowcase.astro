---
import type { Benefit } from '../../data/partitions'

interface Props { items: Benefit[] }
const { items } = Astro.props

// Карта иконок — внутренняя разметка <svg> (stroke, currentColor)
const icons: Record<Benefit['icon'], string> = {
  shield: '<path d="M12 3l7 2.6v5.1c0 4.3-2.9 7.5-7 8.9-4.1-1.4-7-4.6-7-8.9V5.6L12 3z"/><path d="M12 8.6c1.2 1.6 2 2.8 2 3.9a2 2 0 1 1-4 0c0-1.1.8-2.3 2-3.9z"/>',
  design: '<path d="M12 3l1.7 4.6L18 9l-4.3 1.4L12 15l-1.7-4.6L6 9l4.3-1.4L12 3z"/><path d="M18 14l.6 1.7 1.9.3-1.9.6-.6 1.4-.6-1.4-1.9-.6 1.9-.3.6-1.7z"/>',
  uv:     '<circle cx="12" cy="12" r="3.6"/><path d="M12 2v2.4M12 19.6V22M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2 12h2.4M19.6 12H22M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"/>',
  wear:   '<path d="M12 3l7 2.6v5.1c0 4.3-2.9 7.5-7 8.9-4.1-1.4-7-4.6-7-8.9V5.6L12 3z"/><path d="M8.8 12l2.1 2.1L15.4 9.5"/>',
  light:  '<path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/>',
  eco:    '<path d="M5 20c0-8 6-14.5 15-15 0 9-5 16.5-15 15z"/><path d="M5.5 19.5c4-4.5 7.2-6.8 11.5-8"/>',
}
---

<!-- Карточная сетка вместо фото-зигзага: без изображений премиум ощущение
     держит крупная иконка + большой ghost-номер, тот же язык, что в
     ProcessSteps «Как мы работаем». Мобайл-фёрст: 1 колонка на узком
     экране, 2 от sm, 3 от lg (6 карточек делятся ровно, без нечётного
     остатка). Убраны 7 remote-изображений — прямой выигрыш по переданным
     байтам и числу запросов на этой секции. -->
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
  {items.map((b, i) => (
    <article
      class="group relative overflow-hidden rounded-[1.75rem] bg-white p-1.5 shadow-[0_1px_2px_rgba(15,23,42,0.06),0_12px_32px_-8px_rgba(15,23,42,0.16)] ring-1 ring-slate-900/5 transition-shadow duration-300 hover:shadow-[0_1px_2px_rgba(15,23,42,0.08),0_20px_44px_-10px_rgba(15,23,42,0.24)]"
      data-reveal
    >
      <div class="relative h-full overflow-hidden rounded-[1.375rem] bg-slate-50 p-6 sm:p-7">

        <span class="pointer-events-none absolute -right-2 -top-4 text-7xl font-medium leading-none tracking-tight text-teal-600/8 select-none" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>

        <div class="relative mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-graphite text-white transition-transform duration-300 group-hover:scale-105">
          <svg class="h-6.5 w-6.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} />
        </div>

        <div class="relative">
          <h3 class="m-0 mb-2 text-lg font-medium leading-snug text-ink">{b.title}</h3>
          <p class="m-0 text-sm leading-relaxed text-slate-600">{b.text}</p>
        </div>

      </div>
    </article>
  ))}
</div>

<style>
  /* ── Scroll-reveal (включается только при JS; иначе всё видно) ── */
  [data-reveal] {
    opacity: 1;
    transform: none;
  }
  .js-reveal [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 600ms ease, transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity, transform;
  }
  .js-reveal [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .js-reveal [data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // Лёгкий scroll-reveal: один IntersectionObserver, unobserve после показа.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  document.querySelectorAll('[data-reveal]').forEach((el) => {
    const wrap = el.parentElement
    if (!wrap) return
    if (reduce || !('IntersectionObserver' in window)) return
    wrap.classList.add('js-reveal')
  })
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible')
            io.unobserve(e.target)
          }
        })
      },
      { threshold: 0.18, rootMargin: '0px 0px -8% 0px' },
    )
    document.querySelectorAll('[data-reveal]').forEach((r) => io.observe(r))
  }
</script>
