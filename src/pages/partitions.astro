  <!-- CTA -->
  <section class="section">
    <div class="container">
      <QuoteCta
        image="https://storage.yandexcloud.net/catalog-vfd/alum/rener-2.webp"
        primaryHref={SITE.social.telegram}
        secondaryHref="/contacts/"
        secondaryLabel="Написать нам"
      />
