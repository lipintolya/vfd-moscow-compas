---
/**
 * /partitions/ — алюминиевые перегородки GRAFIA в Москве.
 *
 * Дизайн-система главной (src/styles/home.css, обёртка .home): шапки
 * секций .h-head, линейки у данных, фото без рамок и теней, красный —
 * только главное действие. Общие с главной блоки: «Как мы работаем»
 * (StepsRow с шагами перегородок) и «Как к нам добраться» (VisitBand).
 *
 * Контент — src/data/partitions.ts, данные салона — src/config/site.ts.
 * Скорость: первый экран — одно фото (LCP, preload), видео ниже по
 * странице грузятся, только когда до них докрутили, и не играют за кадром.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../components/ui/FaqAccordion.astro'
import DoorLeafViewer from '../components/partitions/DoorLeafViewer.vue'
import SectionNav from '../components/partitions/SectionNav.astro'
import PhotoSlider from '../components/partitions/PhotoSlider.astro'
import ProjectCase from '../components/partitions/ProjectCase.astro'
import SwatchGrid from '../components/partitions/SwatchGrid.astro'
import BenefitsShowcase from '../components/partitions/BenefitsShowcase.astro'
import Downloads from '../components/partitions/Downloads.astro'
import ReplayButton from '../components/partitions/ReplayButton.astro'
import StepsRow from '../components/home/StepsRow.astro'
import VisitBand from '../components/home/VisitBand.astro'
import LandingHero from '../components/ui/LandingHero.astro'
import '../styles/home.css'

import {
  imgs, heroImages, heroFacts, pageVideos, tracks, mountings, colorSwatches, glassSwatches, partitionBenefits,
  steps, sectionalModels, sectionalDecor, overlayModels, overlayDecor, cases, aspenCase,
  renderGallery, partitionsFaq,
} from '../data/partitions'
import { PHONE, SITE } from '../config/site'
import { localBusinessSchema, LOCAL_BUSINESS_ID } from '../lib/local-business-schema'
import { typograph } from '../lib/typograph'

/* ── SEO ── */
const title = `Алюминиевые перегородки ${SITE.city.in} на заказ — ${SITE.name}, ${SITE.address.mall}`
// ~160 символов — длиннее поисковики обрезают
const description =
  `Алюминиевые перегородки GRAFIA на заказ ${SITE.city.in}: раздвижные, распашные, стационарные. ` +
  `${colorSwatches.length} цветов профиля, стекло 4–8 мм, замер и монтаж. Салон ${SITE.name} в ${SITE.address.mall}.`
const pageUrl = new URL('/partitions/', SITE.url).href
const abs = (src: string) => new URL(src, SITE.url).href

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: `Алюминиевые перегородки GRAFIA ${SITE.city.in}`,
  serviceType: 'Изготовление и монтаж алюминиевых перегородок',
  description,
  url: pageUrl,
  image: [imgs.hero, ...renderGallery.slice(0, 6).map((r) => abs(r.src))],
  brand: { '@type': 'Brand', name: 'GRAFIA' },
  provider: { '@id': LOCAL_BUSINESS_ID },
  areaServed: [
    { '@type': 'City', name: SITE.city.name },
    { '@type': 'AdministrativeArea', name: 'Московская область' },
  ],
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: partitionsFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Перегородки' },
]

const navItems = [
  { id: 'pt-sliding',  label: 'Системы' },
  { id: 'pt-profiles', label: 'Створки' },
  { id: 'pt-colors',   label: 'Цвета' },
  { id: 'pt-glass',    label: 'Стекло' },
  { id: 'pt-projects', label: 'Проекты' },
  { id: 'process',     label: 'Процесс' },
  { id: 'pt-faq',      label: 'Вопросы' },
]

/* Три плитки галереи — облегчённые превью (public/renders/alum-covers/
   N-preview.webp); лайтбокс листает всю галерею в полном размере */
const renderPreviews = renderGallery.slice(0, 3).map((img) => ({
  src: img.src.replace(/\.webp$/, '-preview.webp'),
  alt: img.alt,
}))
const moreRenders = renderGallery.length - renderPreviews.length
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage={imgs.hero}
  structuredData={[localBusinessSchema({ url: SITE.url }), serviceSchema, faqSchema]}
>
  <SectionNav items={navItems} />

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="home">

    <LandingHero
      title={`Алюминиевые перегородки ${SITE.city.in}`}
      lead="Раздвижные, распашные и стационарные системы из профиля GRAFIA: тонкая рама, закалённое стекло, изготовление по вашим размерам. Замер и монтаж по Москве и области."
      image={heroImages}
      facts={heroFacts}
    >
      <Fragment slot="actions">
        <a href={`tel:${PHONE.raw}`} class="h-btn h-btn--signal">Рассчитать стоимость</a>
        <a href="#visit" class="h-btn h-btn--quiet">Приехать в&nbsp;салон</a>
      </Fragment>
    </LandingHero>

    <!-- ── Система Aspen ── -->
    <section class="h-sec h-sec--wall" aria-label="Система Aspen">
      <div class="container">
        <ProjectCase data={aspenCase} />
      </div>
    </section>

    <!-- ── О системе GRAFIA ── -->
    <section class="h-sec" aria-labelledby="pt-system-title">
      <div class="container">
        <header class="h-head">
          <h2 id="pt-system-title" class="h-h2">Зонирование без&nbsp;сноса стен</h2>
          <p class="h-lead">
            Перегородки на&nbsp;профиле GRAFIA ставят без капитального ремонта, а&nbsp;при перепланировке
            снимают без следов. Профиль сертифицирован и&nbsp;прочен при минимальной ширине рамы.
          </p>
        </header>

        <div class="pt-split">
          <ul class="pt-rules" role="list">
            <li>Раздвижные, распашные и&nbsp;стационарные системы под любой проём</li>
            <li>Закалённое стекло 4, 6 и&nbsp;8&nbsp;мм, зеркало, сатин</li>
            <li>Полотна высотой до&nbsp;5&nbsp;м с&nbsp;секционным декором</li>
            <li>Сборно-разборная конструкция: демонтаж без следов</li>
            <li>Окраска профиля по&nbsp;RAL и&nbsp;NCS</li>
          </ul>
          <div class="h-media pt-video pt-video--wide" data-video>
            <video
              class="pt-video__el"
              muted
              playsinline
              preload="none"
              poster={pageVideos.animation.poster}
              aria-label={pageVideos.animation.label}
              data-autoplay
            >
              <source data-src={pageVideos.animation.src} type="video/mp4" />
            </video>
            <ReplayButton />
          </div>
        </div>
      </div>
    </section>

    <!-- ── Раздвижные системы: направляющие и крепление ── -->
    <section id="pt-sliding" class="h-sec h-sec--wall" aria-labelledby="pt-sliding-title">
      <div class="container">
        <header class="h-head">
          <h2 id="pt-sliding-title" class="h-h2">Раздвижные системы</h2>
          <p class="h-lead">Число направляющих определяет, сколько полотен будет в&nbsp;перегородке и&nbsp;как они откроются.</p>
        </header>

        <ul class="pt-cols" role="list">
          {tracks.map((t) => (
            <li class="pt-item">
              <PhotoSlider images={t.imgs} ratio="4 / 3" />
              <p class="h-meta pt-item__meta">{t.num}, {t.stat} {t.statLbl}</p>
              <h3 class="h-h3 pt-item__title">{t.title}</h3>
              <p class="h-body pt-item__text">{typograph(t.desc)}</p>
              <ul class="pt-rules pt-rules--sm" role="list">
                {t.items.map((v) => <li>{typograph(v)}</li>)}
              </ul>
            </li>
          ))}
        </ul>

        <h3 class="pt-subhead">Крепление направляющей</h3>
        <ul class="pt-cols pt-cols--rail" role="list" data-lightbox>
          {mountings.map((m, i) => (
            <li class="pt-item">
              <button type="button" class="h-media pt-zoom" aria-label={`Открыть фото: ${m.title}`} data-lightbox-index={i}>
                <img src={m.img} alt={m.title} width="800" height="800" loading="lazy" decoding="async" />
              </button>
              <h4 class="h-h3 pt-item__title">{m.title}</h4>
              <p class="h-body pt-item__text">{typograph(m.desc)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Система PIVOT ── -->
    <section class="h-sec" aria-labelledby="pt-pivot-title">
      <div class="container pt-pivot">
        <div class="pt-pivot__media">
          <div class="h-media pt-video pt-video--tall" data-video>
            <video
              class="pt-video__el"
              muted
              playsinline
              preload="none"
              poster={pageVideos.pivot.poster}
              aria-label={pageVideos.pivot.label}
              data-autoplay
            >
              <source data-src={pageVideos.pivot.src} type="video/mp4" />
            </video>
            <ReplayButton />
          </div>
          <a href="https://t.me/VFD_Design" target="_blank" rel="noopener noreferrer" class="h-meta pt-credit">Видео: ВФД Дизайн</a>
        </div>
        <div class="pt-pivot__body">
          <h2 id="pt-pivot-title" class="h-h2">Дверь на&nbsp;системе PIVOT</h2>
          <p class="h-lead pt-pivot__lead">
            Алюминиевая дверь с&nbsp;осью вращения вместо петель — современное и&nbsp;практичное решение
            для квартиры, дома или офиса.
          </p>
          <ul class="pt-rules" role="list">
            <li>Открывается легко и&nbsp;плавно, экономит место</li>
            <li>Закалённое стекло безопасно и&nbsp;не&nbsp;крадёт дневной свет</li>
          </ul>
          <a href="https://crm.vfd.ru/~ogWix" target="_blank" rel="noopener noreferrer" class="h-pill h-pill--line pt-pivot__pdf">
            Каталог решений, PDF
            <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ── Модельный ряд створок ── -->
    <section id="pt-profiles" class="h-sec h-sec--wall" aria-labelledby="pt-profiles-title">
      <div class="container">
        <header class="h-head">
          <h2 id="pt-profiles-title" class="h-h2">Модельный ряд створок</h2>
          <p class="h-lead">Секционный и&nbsp;накладной декор&nbsp;— варианты разбивки и&nbsp;оформления стекла.</p>
        </header>
        <DoorLeafViewer client:visible models={sectionalModels} decor={sectionalDecor} />
        <div class="pt-gap">
          <DoorLeafViewer client:visible models={overlayModels} decor={overlayDecor} />
        </div>
      </div>
    </section>

    <!-- ── Цвета профиля ── -->
    <section id="pt-colors" class="h-sec" aria-labelledby="pt-colors-title">
      <div class="container">
        <header class="h-head">
          <h2 id="pt-colors-title" class="h-h2">Цвета профиля</h2>
          <p class="h-lead">
            Порошковая полимерная окраска&nbsp;— ровный цвет и&nbsp;стойкое покрытие.
            Кроме {colorSwatches.length} готовых цветов, профиль можно покрасить по&nbsp;RAL
            или&nbsp;NCS под&nbsp;ваш интерьер.
          </p>
        </header>
        <SwatchGrid items={colorSwatches} variant="square" />
      </div>
    </section>

    <!-- ── Остекление ── -->
    <section id="pt-glass" class="h-sec h-sec--wall" aria-labelledby="pt-glass-title">
      <div class="container">
        <header class="h-head">
          <h2 id="pt-glass-title" class="h-h2">Стекло и&nbsp;зеркало</h2>
          <p class="h-lead">Закалённое стекло 4, 6 и&nbsp;8&nbsp;мм повышенной прочности. Можно поставить зеркало.</p>
        </header>
        <SwatchGrid items={glassSwatches} variant="portrait" />
        <p class="h-meta pt-note">Наличие отдельных цветов и&nbsp;фактур стекла уточняйте у&nbsp;менеджера.</p>
      </div>
    </section>

    <!-- ── Проекты и решения ── -->
    <section id="pt-projects" class="h-sec" aria-labelledby="pt-projects-title">
      <div class="container">
        <header class="h-head">
          <h2 id="pt-projects-title" class="h-h2">Проекты и&nbsp;решения</h2>
          <p class="h-lead">Перегородки ВФД в&nbsp;квартирах, гардеробных, душевых и&nbsp;отелях&nbsp;— с&nbsp;профилем, стеклом и&nbsp;декором.</p>
        </header>

        <div class="pt-cases">
          {cases.map((c) => <ProjectCase data={c} />)}
        </div>

        <h3 class="pt-subhead">Перегородки и&nbsp;двери в&nbsp;интерьере</h3>
        <p class="h-body pt-subhead__lead">{renderGallery.length} дизайн-визуализаций для разных стилей интерьера.</p>
        <div class="pt-renders" data-lightbox data-lightbox-images={JSON.stringify(renderGallery)}>
          {renderPreviews.map((img, i) => (
            <button
              type="button"
              class="h-media pt-renders__tile"
              data-lightbox-index={i}
              aria-label={i === renderPreviews.length - 1 ? `Открыть все визуализации (${renderGallery.length})` : `Открыть крупнее: ${img.alt}`}
            >
              <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
              {i === renderPreviews.length - 1 && (
                <span class="pt-renders__more" aria-hidden="true">+{moreRenders}</span>
              )}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Преимущества ── -->
    <section id="pt-benefits" class="h-sec h-sec--wall" aria-labelledby="pt-benefits-title">
      <div class="container">
        <header class="h-head">
          <h2 id="pt-benefits-title" class="h-h2">Почему алюминий</h2>
          <p class="h-lead">Прочность, долговечность и&nbsp;аккуратный внешний вид без&nbsp;компромиссов.</p>
        </header>
        <BenefitsShowcase items={partitionBenefits} />
      </div>
    </section>

    <StepsRow
      steps={steps}
      lead="От консультации в салоне до готовой перегородки — с чертежами, точной сметой и собственным монтажом."
    />

    <!-- ── Подготовка к замеру ── -->
    <section class="h-sec" aria-labelledby="pt-dl-title">
      <div class="container">
        <header class="h-head">
          <h2 id="pt-dl-title" class="h-h2">Подготовка к&nbsp;замеру</h2>
          <p class="h-lead">Скачайте бланк замера и&nbsp;требования к&nbsp;проёму&nbsp;— так расчёт будет точнее.</p>
        </header>
        <Downloads />
      </div>
    </section>

    <!-- ── Частые вопросы ── -->
    <section id="pt-faq" class="h-sec h-sec--wall" aria-labelledby="pt-faq-title">
      <div class="container pt-faq">
        <h2 id="pt-faq-title" class="h-h2">Частые вопросы о&nbsp;перегородках</h2>
        <div class="pt-faq__list">
          <FaqAccordion items={partitionsFaq} title={false} />
        </div>
      </div>
    </section>

    <VisitBand lead="Приезжайте обсудить проект: подберём профиль, стекло и систему открывания и рассчитаем перегородку по вашим размерам." />
  </div>

</BaseLayout>

<script>
  import { initLightboxGroups, openLightbox, toImg } from '../lib/lightbox'

  /* ── Кейсы: на телефоне длинный текст свёрнут под «Подробнее»
     (без JS остаётся раскрытым) ── */
  if (matchMedia('(max-width: 56.1875rem)').matches) {
    document.querySelectorAll<HTMLDetailsElement>('[data-case-more]').forEach((d) => { d.open = false })
  }

  /* ── Лайтбокс для групп фото [data-lightbox] (src/lib/lightbox.ts) ── */
  initLightboxGroups()

  /* ── Слайдеры: стрелки, свайп, клик по фото — лайтбокс ── */
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-slider-track]')
    if (!track) return
    const imgs = [...track.querySelectorAll('img')]
    const counter = root.querySelector('[data-slider-current]')
    let cur = 0
    const go = (i: number) => {
      cur = (i + imgs.length) % imgs.length
      track.style.transform = `translateX(${-cur * 100}%)`
      if (counter) counter.textContent = String(cur + 1)
    }
    root.querySelector('[data-slider-prev]')?.addEventListener('click', (e) => { e.stopPropagation(); go(cur - 1) })
    root.querySelector('[data-slider-next]')?.addEventListener('click', (e) => { e.stopPropagation(); go(cur + 1) })

    let startX = 0
    root.addEventListener('touchstart', (e) => { startX = e.touches[0]?.clientX ?? 0 }, { passive: true })
    root.addEventListener('touchend', (e) => {
      const dx = (e.changedTouches[0]?.clientX ?? startX) - startX
      if (imgs.length > 1 && Math.abs(dx) > 40) go(dx < 0 ? cur + 1 : cur - 1)
    }, { passive: true })

    root.addEventListener('click', (e) => {
      if ((e.target as Element).closest('button')) return
      openLightbox(imgs.map(toImg), cur)
    })
  })

  /* ── Видео: файл начинает качаться заранее (за ~50 экранов до кадра
     не нужно — за 50rem хватает), играет только в кадре, после конца —
     кнопка повтора. При prefers-reduced-motion сами не запускаются ── */
  const videos = [...document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]')]
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches
  if (videos.length && 'IntersectionObserver' in window) {
    const load = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        if (!isIntersecting) return
        const v = target as HTMLVideoElement
        const source = v.querySelector<HTMLSourceElement>('source[data-src]')
        if (source?.dataset.src) {
          source.src = source.dataset.src
          v.load()
        }
        load.unobserve(v)
      })
    }, { rootMargin: '50% 0px' })

    const play = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        const v = target as HTMLVideoElement
        if (v.ended) return
        if (isIntersecting && !still) v.play().catch(() => {})
        else v.pause()
      })
    }, { threshold: 0.4 })

    videos.forEach((v) => {
      const wrap = v.closest<HTMLElement>('[data-video]')
      const replay = wrap?.querySelector<HTMLElement>('[data-replay]')
      v.addEventListener('ended', () => replay?.classList.add('is-visible'))
      replay?.addEventListener('click', () => {
        replay.classList.remove('is-visible')
        v.currentTime = 0
        v.play().catch(() => {})
      })
      // Без автозапуска (reduced motion) — повтор работает как «Смотреть»
      if (still) replay?.classList.add('is-visible')
      load.observe(v)
      play.observe(v)
    })
  }
</script>

<style>
  /* ── Список-характеристики под линейками ── */
  .pt-rules { margin: 0; padding: 0; list-style: none; border-top: 0.0625rem solid var(--h-rule); }
  .pt-rules li {
    padding-block: 0.875rem;
    border-bottom: 0.0625rem solid var(--h-rule);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--h-ink);
  }
  .pt-rules--sm { margin-top: 1.25rem; }
  .pt-rules--sm li { padding-block: 0.625rem; font-size: 0.9375rem; }

  /* ── Текст | видео ── */
  .pt-split { display: grid; gap: 2rem var(--h-gutter); align-items: center; }
  @media (min-width: 56.25rem) {
    .pt-split { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .pt-split > :first-child { grid-column: 1 / span 5; }
    .pt-split > :last-child  { grid-column: 7 / span 6; }
  }

  .pt-video { position: relative; background: var(--color-slate-900); }
  .pt-video--wide { aspect-ratio: 9 / 4; }   /* пропорции самого ролика */
  .pt-video--tall { aspect-ratio: 9 / 16; }
  .pt-video__el { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* ── Три колонки: направляющие, крепление ── */
  .pt-cols { display: grid; gap: 3rem var(--h-gutter); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 56.25rem) { .pt-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  /* Телефон и планшет: крепления — лентой вбок (у направляющих внутри
     свои слайдеры со свайпом, поэтому они остаются столбиком) */
  @media (max-width: 56.1875rem) {
    .pt-cols--rail {
      grid-auto-flow: column;
      grid-auto-columns: min(78%, 20rem);
      gap: 0.75rem;
      margin-inline: calc(-1 * var(--h-pad));
      padding-inline: var(--h-pad);
