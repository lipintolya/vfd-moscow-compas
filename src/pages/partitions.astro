  <!-- ПРЕИМУЩЕСТВА АЛЮМИНИЕВЫХ ПЕРЕГОРОДОК -->
  <section id="pt-benefits" class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Преимущества"
        title="Преимущества алюминиевых перегородок"
        subtitle="Почему алюминий — оптимальный материал для современных перегородок: прочность, долговечность и эстетика без компромиссов."
