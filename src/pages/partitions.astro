<script is:inline>
  // ── Hero-видео: грузим только после полной загрузки страницы (не спорит
  // за полосу с критичными ресурсами) и только если пользователь не просил
  // сократить анимации — тогда просто остаётся статичная картинка. ──
  (function () {
    var heroVideo = document.getElementById('pt-hero-video')
    if (!heroVideo) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    function startHeroVideo() {
      var source = heroVideo.querySelector('source[data-src]')
      if (!source) return
      source.setAttribute('src', source.getAttribute('data-src'))
      heroVideo.addEventListener('loadeddata', function () {
        heroVideo.classList.remove('opacity-0')
      }, { once: true })
      heroVideo.load()
      heroVideo.play().catch(function () {})
    }

    if (document.readyState === 'complete') {
      startHeroVideo()
    } else {
      window.addEventListener('load', startHeroVideo)
    }
  })()

  ;(function () {
    var videos = document.querySelectorAll('.pt-autoplay-video')
    if (!videos.length || !('IntersectionObserver' in window)) return

    // Плавное появление контейнера — как только первый кадр готов
    videos.forEach(function (v) {
      v.addEventListener('loadeddata', function () {
        var wrap = v.closest('.pt-video-wrap')
        if (wrap) wrap.classList.add('pt-video-ready')
      }, { once: true })
    })

    // Кнопка повтора: показывается после окончания, скрывается при клике
    videos.forEach(function (v) {
      var btn = v.parentElement && v.parentElement.querySelector('.pt-pivot-replay')
      if (!btn) return
      v.addEventListener('ended', function () { btn.classList.add('is-visible') })
      btn.addEventListener('click', function () {
        btn.classList.remove('is-visible')
        v.currentTime = 0
        v.play().catch(function () {})
      })
    })

    // Ранний префетч: начинаем качать файл задолго до того, как видео
    // реально попадёт в кадр — на медленном канале успевает добуфериться
    // к моменту скролла, вместо стопора «чёрный экран, пока грузится».
    var ioPrefetch = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var v = entry.target
        var source = v.querySelector('source[data-src]')
        if (source && !source.getAttribute('src')) {
          source.setAttribute('src', source.getAttribute('data-src'))
          v.load()
        }
        ioPrefetch.unobserve(v)
      })
    }, { rootMargin: '800px 0px' })

    // Реальная видимость: play/pause, не тратим ресурс на видео за кадром
    var ioPlay = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var v = entry.target
        if (entry.isIntersecting) {
          if (!v.ended) v.play().catch(function () {})
        } else {
          if (!v.ended) v.pause()
        }
      })
    }, { threshold: 0.4 })

    videos.forEach(function (v) { ioPrefetch.observe(v); ioPlay.observe(v) })
  })()

  // ── Лайтбокс: открыть через custom event ──
  function openLightbox(images, index) {
    window.dispatchEvent(new CustomEvent('open-lightbox', { detail: { images: images, index: index } }))
  }

  // ── Слайдеры (общая функция) ──
  function initSlider(container, withLightbox) {
    if (!container) return
    var slides  = container.querySelector('.pt-stat-slides')
    var dots    = container.querySelectorAll('.pt-stat-dot')
    var counter = container.querySelector('.pt-hotel-cur')
    var prev    = container.querySelector('.pt-stat-prev')
    var next    = container.querySelector('.pt-stat-next')
    var total   = counter
      ? container.querySelectorAll('.pt-stat-slide').length
      : dots.length
    var cur     = 0

    function goTo(idx) {
      cur = (idx + total) % total
      slides.style.transform = 'translateX(' + (-cur * 100) + '%)'
      if (dots.length) dots.forEach(function (d, i) { d.classList.toggle('is-active', i === cur) })
      if (counter) counter.textContent = cur + 1
    }

    if (prev) prev.addEventListener('click', function (e) { e.stopPropagation(); goTo(cur - 1) })
    if (next) next.addEventListener('click', function (e) { e.stopPropagation(); goTo(cur + 1) })
    dots.forEach(function (d, i) {
      d.addEventListener('click', function (e) { e.stopPropagation(); goTo(i) })
    })

    var startX = 0
    container.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX }, { passive: true })
    container.addEventListener('touchend', function (e) {
      var dx = e.changedTouches[0].clientX - startX
      if (Math.abs(dx) > 40) goTo(dx < 0 ? cur + 1 : cur - 1)
    }, { passive: true })

    if (withLightbox) {
      var slideImgs = container.querySelectorAll('.pt-stat-slide')
      container.addEventListener('click', function (e) {
        if (e.target.closest('.pt-stat-dot, .pt-stat-prev, .pt-stat-next')) return
        var imgs = Array.from(slideImgs).map(function (img) { return { src: img.src, alt: img.alt } })
        openLightbox(imgs, cur)
      })
    }
  }

  // Слайдеры проектов и треки — оба с лайтбоксом (клик по фото открывает
  // крупный просмотр). Перебор по классу: новый кейс/слайдер подхватывается
  // автоматически, без правки этого скрипта.
  document.querySelectorAll('.pt-stat-slider').forEach(function (s) { initSlider(s, true) })
  document.querySelectorAll('.pt-track-slider').forEach(function (s) { initSlider(s, true) })

  // ── Лайтбокс для одиночных фото (крепления) ──
  document.querySelectorAll('[data-lb-src]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      openLightbox([{ src: btn.dataset.lbSrc, alt: btn.dataset.lbAlt }], 0)
    })
  })

  // ── Лайтбокс-галереи для swatch-сеток (цвета профиля, остекление) ──
  document.querySelectorAll('.pt-swatch-grid').forEach(function (grid) {
    var cards  = grid.querySelectorAll('.pt-swatch-card')
    var images = Array.prototype.map.call(cards, function (card) {
      var img = card.querySelector('img')
      return { src: img.src, alt: img.alt }
    })
    cards.forEach(function (card, i) {
      card.addEventListener('click', function () { openLightbox(images, i) })
    })
  })
</script>

  <PhotoLightbox client:only="vue" />
</BaseLayout>
