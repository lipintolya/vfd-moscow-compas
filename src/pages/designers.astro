---
/**
 * /designers/ — сотрудничество с дизайнерами и архитекторами. Для салона
 * в Москве — ключевая аудитория: дизайнер приводит заказчика в шоурум.
 *
 * Дизайн-система главной (home.css): первый экран LandingHero со
 * счётчиком проектов, манифест крупным набором, плиточная сетка выгод
 * (у каждой плитки своё наполнение: бонусы — красная, схема высоты
 * двери, высоты на складе, ссылки на каталог, рендер, дорожка этапов),
 * шаги работы (StepsRow), графитовая сцена шоурума, ассортимент
 * карточками «фото + подпись», визуализации перегородок и дверей,
 * материалы фабрики, FAQ, карта.
 *
 * Тексты и факты — src/data/designers-page.ts (только от владельца).
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import LandingHero from '../components/ui/LandingHero.astro'
import StepsRow from '../components/home/StepsRow.astro'
import VisitBand from '../components/home/VisitBand.astro'
import FaqAccordion from '../components/ui/FaqAccordion.astro'
import {
  DESIGNERS_HERO, DESIGNERS_INTRO, DESIGNER_BENEFITS, DESIGNERS_SHOWROOM, DESIGNER_STEPS,
  DESIGNER_RANGE, DESIGNER_RANGE_MORE, DESIGNER_RESOURCES, DESIGNER_RENDERS, DESIGNER_RENDERS_FEATURED,
  DESIGNERS_FAQ,
} from '../data/designers-page'
import { SITE, PHONE } from '../config/site'
import { localBusinessSchema, LOCAL_BUSINESS_ID } from '../lib/local-business-schema'
import { typograph } from '../lib/typograph'
import { pluralRu } from '../lib/plural'
import '../styles/home.css'

const CALL = `tel:${PHONE.raw}`
const pageUrl = new URL('/designers/', SITE.url).href
const title = `Дизайнерам и архитекторам — сотрудничество и шоурум ${SITE.name} ${SITE.city.in}`
const description =
  `Для дизайнеров и архитекторов: двери до 3 м под заказ, скрытые двери в наличии, ` +
  `образцы и шоурум в ${SITE.address.mall} для встреч с заказчиками. Бонусы партнёрам.`
const heroCover = DESIGNERS_HERO.images[0]!
const ogImage = new URL(heroCover.wide.srcset.split(', ').at(-1)!.split(' ')[0]!, SITE.url).href

const { bonus, size, stock, range, approach, help } = DESIGNER_BENEFITS
/* Схема высоты: доля стандартной высоты от предельной */
const sizeRatio = +(size.standard / size.max).toFixed(4)

/* Визуализации: в сетке — превью 900 px (крупная плитка берёт и 1920),
   окно просмотра — вся галерея в 1920 px. На последней плитке — «+N» */
const renderCount = DESIGNER_RENDERS.length
const renderWord = pluralRu(renderCount, ['визуализация', 'визуализации', 'визуализаций'])
const renderTiles = DESIGNER_RENDERS_FEATURED.map((index) => {
  const r = DESIGNER_RENDERS[index]!
  const preview = r.src.replace(/\.webp$/, '-preview.webp')
  return { index, alt: r.alt, src: preview, srcset: `${preview} 900w, ${r.src} 1920w` }
})
const moreRenders = renderCount - renderTiles.length

const structuredData = [
  localBusinessSchema({ url: SITE.url }),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    name: `Сотрудничество с дизайнерами интерьера и архитекторами ${SITE.city.in}`,
    serviceType: 'Подбор, расчёт, поставка и монтаж дверей по дизайн-проекту',
    description,
    url: pageUrl,
    provider: { '@id': LOCAL_BUSINESS_ID },
    image: renderTiles.map((r) => new URL(DESIGNER_RENDERS[r.index]!.src, SITE.url).href),
    audience: { '@type': 'BusinessAudience', audienceType: 'Дизайнеры интерьера, архитекторы, студии дизайна' },
    areaServed: [
      { '@type': 'City', name: SITE.city.name },
      { '@type': 'AdministrativeArea', name: 'Московская область' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: DESIGNERS_FAQ.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
]

const arrow = '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Дизайнерам' },
]
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage={ogImage}
  ogImageMeta={{ width: heroCover.wide.width, height: heroCover.wide.height, alt: heroCover.alt }}
  structuredData={structuredData}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="home">
    <LandingHero title={DESIGNERS_HERO.title} lead={DESIGNERS_HERO.lead} image={DESIGNERS_HERO.images} facts={DESIGNERS_HERO.facts}>
      <a slot="actions" href={CALL} class="h-btn h-btn--signal">Обсудить проект</a>
      <a slot="actions" href="#showroom" class="h-btn h-btn--quiet">Шоурум для встреч</a>
    </LandingHero>

    <!-- Манифест — главный текст страницы, набран крупно -->
    <section class="h-sec h-sec--wall" aria-labelledby="ds-intro-title">
      <div class="container ds-split">
        <h2 id="ds-intro-title" class="h-h2 ds-split__head">{typograph(DESIGNERS_INTRO.title)}</h2>
        <div class="ds-split__body ds-manifest">
          {DESIGNERS_INTRO.paragraphs.map((p) => <p>{typograph(p)}</p>)}
        </div>
      </div>
    </section>

    <!-- Что получает дизайнер: шесть плиток, у каждой своё наполнение.
         Порядок в разметке — порядок чтения на телефоне -->
    <section class="h-sec" aria-labelledby="ds-benefits-title">
      <div class="container">
        <header class="h-head">
          <h2 id="ds-benefits-title" class="h-h2">Что получает дизайнер</h2>
          <p class="h-lead">Индивидуальные условия, двери любых размеров и&nbsp;помощь на&nbsp;всех этапах проекта.</p>
        </header>
        <ul class="ds-bento" role="list">
          <li class="ds-tile ds-tile--bonus" data-reveal>
            <h3 class="ds-bonus__title">{typograph(bonus.title)}</h3>
            <div class="ds-bonus__foot">
              <p class="ds-bonus__text">{typograph(bonus.text)}</p>
              <a href={CALL} class="h-btn ds-bonus__cta">{bonus.action}</a>
            </div>
          </li>

          <li class="ds-tile ds-tile--size" data-reveal>
            <h3 class="ds-tile__title">{typograph(size.title)}</h3>
            <div class="ds-size" aria-hidden="true">
              <div class="ds-size__scale" style={`--ratio: ${sizeRatio}`}>
                <span class="ds-size__mark ds-size__mark--max"><span class="ds-size__label"><b>{size.max}</b>&nbsp;мм</span></span>
                <span class="ds-size__mark ds-size__mark--std"><span class="ds-size__label"><b>{size.standard}</b>&nbsp;мм&nbsp;— стандарт</span></span>
                <span class="ds-size__door"></span>
                <span class="ds-size__handle"></span>
              </div>
            </div>
            <p class="ds-tile__text">{typograph(size.text)}</p>
          </li>

          <li class="ds-tile ds-tile--stock" data-reveal>
            <h3 class="ds-tile__title">{typograph(stock.title)}</h3>
            <p class="ds-tile__text ds-tile__text--top">{typograph(stock.text)}</p>
            <div class="ds-stock">
              <ul class="ds-stock__list" role="list">
                {stock.heights.map((h) => <li>{h}</li>)}
              </ul>
              <p class="ds-stock__caption">{stock.caption}</p>
            </div>
          </li>

          <li class="ds-tile ds-tile--range" data-reveal>
            <h3 class="ds-tile__title">{typograph(range.title)}</h3>
            <p class="ds-tile__text ds-tile__text--top">{typograph(range.text)}</p>
            <ul class="ds-chips" role="list" aria-label="Разделы каталога">
              {range.links.map((l) => (
                <li><a href={l.href} class="h-pill h-pill--line">{l.label}</a></li>
              ))}
            </ul>
          </li>

          <li class="ds-tile ds-tile--photo" data-reveal>
            <span class="h-media ds-tile__media">
              <img
                src={approach.photo.src}
                srcset={approach.photo.srcset}
                sizes="(min-width: 62.5rem) 34vw, 100vw"
                alt={approach.photo.alt}
                width={approach.photo.width}
                height={approach.photo.height}
                loading="lazy"
                decoding="async"
              />
            </span>
            <div class="ds-tile__body">
              <h3 class="ds-tile__title">{typograph(approach.title)}</h3>
              <p class="ds-tile__text">{typograph(approach.text)}</p>
            </div>
          </li>

          <li class="ds-tile ds-tile--help" data-reveal>
            <div class="ds-help__head">
              <h3 class="ds-tile__title">{typograph(help.title)}</h3>
              <p class="ds-tile__text">{typograph(help.text)}</p>
            </div>
            <ol class="ds-track" role="list">
              {help.stages.map((st, k) => <li style={`--k: ${k}`}>{st}</li>)}
            </ol>
          </li>
        </ul>
      </div>
    </section>

    <StepsRow
      id="ds-process"
      title="Как мы работаем с дизайнером"
      lead="Подключаемся на любом этапе — от идеи до монтажа."
      steps={DESIGNER_STEPS}
    />

    <!-- Шоурум — графитовая сцена: текст слева, фото консультации справа -->
    <section class="h-sec" id="showroom" aria-labelledby="ds-showroom-title">
      <div class="container">
        <div class="ds-room">
          <div class="ds-room__text">
            <h2 id="ds-showroom-title" class="h-h2 ds-room__title">{typograph(DESIGNERS_SHOWROOM.title)}</h2>
            <p class="ds-room__lead">{typograph(DESIGNERS_SHOWROOM.text)}</p>
            <dl class="ds-room__facts">
              {DESIGNERS_SHOWROOM.facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{typograph(f.value)}</dd>
                </div>
              ))}
            </dl>
            <div class="ds-room__actions">
              <a href={CALL} class="h-btn h-btn--signal">Договориться о встрече</a>
              <a href="#visit" class="h-btn ds-room__ghost">Как добраться</a>
            </div>
          </div>
          <div class="ds-room__photo">
            <img
              src={DESIGNERS_SHOWROOM.photo.src}
              srcset={DESIGNERS_SHOWROOM.photo.srcset}
              sizes="(min-width: 62.5rem) 45vw, 100vw"
              alt={DESIGNERS_SHOWROOM.photo.alt}
              width={DESIGNERS_SHOWROOM.photo.width}
              height={DESIGNERS_SHOWROOM.photo.height}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Ассортимент — карточки разделов (фото + подпись) и ссылки дальше -->
    <section class="h-sec h-sec--wall" aria-labelledby="ds-range-title">
      <div class="container">
        <header class="h-head">
          <h2 id="ds-range-title" class="h-h2">Ассортимент для ваших проектов</h2>
          <p class="h-lead">Всё можно посмотреть в&nbsp;шоуруме и&nbsp;заказать под проект — в&nbsp;том числе нестандартных размеров.</p>
        </header>
        <ul class="ds-range h-rail" role="list">
          {DESIGNER_RANGE.map((r) => (
            <li>
              <a href={r.href} class="ds-range__card">
                <span class="h-media ds-range__media">
                  <img src={r.image} alt="" loading="lazy" decoding="async" width="1672" height="941" style={`object-position: ${r.position}`} />
                </span>
                <span class="ds-range__row">
                  <span class="h-h3 ds-range__title">{r.title}</span>
                  <span class="h-arrow" aria-hidden="true"><Fragment set:html={arrow} /></span>
                </span>
                <span class="h-body ds-range__text">{typograph(r.text)}</span>
              </a>
            </li>
          ))}
        </ul>
        <ul class="ds-more" role="list" aria-label="Ещё разделы">
          {DESIGNER_RANGE_MORE.map((m) => (
            <li><a href={m.href} class="h-pill h-pill--line">{m.label}</a></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Визуализации: крупный кадр и четыре поменьше (на телефоне — лента
         вбок); окно просмотра листает всю галерею -->
    <section class="h-sec" id="ds-renders" aria-labelledby="ds-renders-title">
      <div class="container">
        <header class="h-head">
          <h2 id="ds-renders-title" class="h-h2">Перегородки и&nbsp;алюминиевые двери в&nbsp;интерьере</h2>
          <p class="h-lead">{renderCount}&nbsp;{renderWord} {SITE.manufacturerOf}&nbsp;— идеи для ваших проектов. Профили, стекло и&nbsp;системы открывания подберём в&nbsp;шоуруме.</p>
        </header>
        <ul
          class="ds-renders h-rail"
          role="list"
          data-lightbox
          data-lightbox-images={JSON.stringify(DESIGNER_RENDERS)}
        >
          {renderTiles.map((r, i) => {
            const last = i === renderTiles.length - 1
            return (
              <li class:list={['ds-renders__cell', { 'ds-renders__cell--lead': i === 0 }]}>
                <button
                  type="button"
                  class="h-media ds-renders__item"
                  data-lightbox-index={r.index}
                  aria-label={last ? `Открыть все визуализации (${renderCount})` : `Открыть крупнее: ${r.alt}`}
                >
                  <img
                    src={r.src}
                    srcset={r.srcset}
                    sizes={i === 0 ? '(min-width: 62.5rem) 50vw, (min-width: 43.75rem) 100vw, 82vw' : '(min-width: 62.5rem) 25vw, (min-width: 43.75rem) 50vw, 82vw'}
                    alt={r.alt}
                    width="900"
                    height="674"
                    loading="lazy"
                    decoding="async"
                  />
                  {last && moreRenders > 0 && <span class="ds-renders__more" aria-hidden="true">+{moreRenders}</span>}
                </button>
              </li>
            )
          })}
        </ul>
        <p class="ds-renders__foot">
          <a href="/partitions/" class="h-link">Алюминиевые перегородки: системы, профили и&nbsp;стекло</a>
        </p>
      </div>
    </section>

    <!-- Материалы для проектирования — ресурсы фабрики -->
    <section class="h-sec" aria-labelledby="ds-res-title">
      <div class="container ds-split">
        <header class="ds-split__head">
          <h2 id="ds-res-title" class="h-h2">Материалы для проектирования</h2>
          <p class="h-lead ds-res__lead">3D-модели, каталоги и&nbsp;чертежи {SITE.manufacturerOf} — откроются на&nbsp;её сайте.</p>
        </header>
        <ul class="ds-split__body ds-res" role="list">
          {DESIGNER_RESOURCES.map((r) => (
            <li>
              <a href={r.href} target="_blank" rel="noopener" class="ds-res__link">
                <span class="ds-res__kind">{r.kind}</span>
                <span class="ds-res__title">{r.title}</span>
                <span class="ds-res__ext" aria-hidden="true"><Fragment set:html={arrow} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="h-sec h-sec--wall" aria-labelledby="ds-faq-title">
      <div class="container">
        <header class="h-head">
          <h2 id="ds-faq-title" class="h-h2">Частые вопросы</h2>
        </header>
        <FaqAccordion items={DESIGNERS_FAQ} title={false} />
      </div>
    </section>

    <VisitBand lead="Приезжайте с заказчиком: покажем двери, покрытия и фурнитуру вживую и сразу посчитаем проект." />
  </div>
</BaseLayout>

<script>
  import { initLightboxGroups } from '../lib/lightbox'
  initLightboxGroups()

  /* Плитки выгод — появляются один раз, когда доходят до экрана; ряд —
     по очереди. Скрываем только то, что ниже экрана: без JS, при
     reduced-motion и переходе по якорю всё сразу видно. */
  const tiles = [...document.querySelectorAll<HTMLElement>('[data-reveal]')]
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches
  if (!still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.filter((e) => e.isIntersecting).forEach((e, k) => {
        const el = e.target as HTMLElement
        el.style.setProperty('--t', `${k * 110}ms`)
        el.dataset.reveal = 'shown'
        io.unobserve(el)
      })
    }, { rootMargin: '0px 0px -12% 0px' })
    for (const el of tiles) {
      if (el.getBoundingClientRect().top < innerHeight * 0.88) continue
      el.dataset.reveal = 'hidden'
      io.observe(el)
    }
  }
</script>

<style>
  /* ── Заголовок слева (5 колонок), содержимое справа (с 7-й) ── */
  .ds-split { display: grid; gap: 1.5rem var(--h-gutter); }
  @media (min-width: 56.25rem) {
    .ds-split { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; }
    .ds-split__head { grid-column: 1 / span 5; position: sticky; top: calc(var(--header-height) + 1.5rem); }
    .ds-split__body { grid-column: 7 / span 6; }
  }

  /* Манифест — крупный текст, как «фамильный бренд» на «О нас» */
  .ds-manifest p {
    margin: 0;
    font-size: clamp(1.25rem, 2.1vw, 1.75rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--h-ink);
    text-wrap: pretty;
  }
  .ds-manifest p + p { margin-top: 1em; color: var(--h-soft); }

  /* ── Выгоды: плитки разной роли ──
     Телефон — столбик в порядке разметки; планшет — 2 колонки; ПК — 3:
       бонусы  бонусы  размеры
       наличие выбор   размеры
       подход  этапы   этапы
     Плитка размеров — в две строки, чтобы в высоту поместилась схема. */
  .ds-bento {
    display: grid;
    gap: var(--h-tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Области — только при раскладке в колонки: без шаблона областей
     именованные grid-area сложили бы все плитки в одну ячейку */
  @media (min-width: 43.75rem) {
    .ds-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas: 'bonus bonus' 'size stock' 'size range' 'photo photo' 'help help';
    }
    .ds-tile--bonus { grid-area: bonus; }
    .ds-tile--size  { grid-area: size; }
    .ds-tile--stock { grid-area: stock; }
    .ds-tile--range { grid-area: range; }
    .ds-tile--photo { grid-area: photo; }
    .ds-tile--help  { grid-area: help; }
  }
  @media (min-width: 62.5rem) {
    .ds-bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-areas: 'bonus bonus size' 'stock range size' 'photo help help';
    }
  }

  .ds-tile {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border-radius: var(--h-tile-radius);
    background: var(--h-wall);
  }
  .ds-tile__title {
    margin: 0;
    font-family: var(--h-font);
    font-size: clamp(1.1875rem, 1.7vw, 1.375rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--h-ink);
  }
  /* Текст прижат к низу плитки — строки соседних плиток на одной линии */
  .ds-tile__text { margin: auto 0 0; max-width: 30rem; font-size: 0.9375rem; line-height: 1.55; color: var(--h-soft); text-wrap: pretty; }
  .ds-tile__text--top { margin-top: 0; }

  /* Бонусы — красная плитка (главная выгода): крупный заголовок сверху,
     текст и кнопка — снизу */
  .ds-tile--bonus { justify-content: space-between; gap: 2rem; background: var(--h-signal); color: var(--color-white); }
  @media (min-width: 43.75rem) { .ds-tile--bonus { min-height: clamp(16rem, 24vw, 19rem); } }
  .ds-bonus__title {
    margin: 0;
    max-width: 12em;
    font-family: var(--h-font);
    font-size: clamp(1.875rem, 3.6vw, 3.25rem);
    font-weight: var(--h-weight-display);
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .ds-bonus__foot { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.25rem 2rem; }
  .ds-bonus__text {
    flex: 1 1 18rem;
    margin: 0;
    max-width: 32rem;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-white) 88%, transparent);
    text-wrap: pretty;
  }
  .ds-bonus__cta { flex: none; background: var(--color-white); color: var(--h-ink); }
