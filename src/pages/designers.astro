  /* Штриховка — часть полотна выше стандарта, как на чертеже: видна,
     только когда дверь выросла выше линии стандарта */
  .ds-size__door::before {
    content: '';
    position: absolute;
    inset: 0 0 calc(100cqh * var(--ratio));
    background: repeating-linear-gradient(-45deg, var(--color-slate-300) 0 0.0625rem, transparent 0.0625rem 0.4375rem);
  }
  .ds-size__handle {
