  .ds-size__mark { position: absolute; left: 0; right: 0; height: 0; border-top: 0.0625rem solid var(--color-slate-300); }
  .ds-size__mark--max { top: 0; }
  .ds-size__mark--std { top: calc(100% * (1 - var(--ratio))); border-top: 0.0625rem dashed var(--color-slate-400); }
  /* Подпись — над своей линией */
  .ds-size__label {
    position: absolute;
    left: 0;
    bottom: 0.4375rem;
