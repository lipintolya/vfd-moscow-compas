---
import BaseLayout from '../layouts/BaseLayout.astro'
import AboutSection from '../components/about/AboutSection.vue'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../components/ui/FaqAccordion.astro'
import { companyLegalInfo } from '../lib/contacts-data'
import { localBusinessSchema as buildLocalBusiness, LOCAL_BUSINESS_ID } from '../lib/local-business-schema'
import { SITE } from '../config/site'

const title       = 'О салоне дверей ВФД в Москве — ТЦ «Компас»'
const description = 'Салон дверей ВФД в ТЦ «Компас» — официальный дилер Владимирской фабрики дверей в Москве. 60+ моделей в выставочном зале, замер и монтаж.'
const canonicalUrl = Astro.site ? new URL('/about/', Astro.site).href : undefined

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'О нас' },
]

const faq = [
  {
    q: 'Вы официальный дилер Владимирской фабрики дверей?',
    a: 'Да. Салон ВФД в ТЦ «Компас» — фирменный салон, который работает с фабрикой напрямую, без посредников. Подробнее о самом производителе — на странице «О фабрике».',
  },
  ...(companyLegalInfo.activity.founded ? [{
    q: 'С какого года работает салон?',
    a: `Салон работает в Москве с ${companyLegalInfo.activity.founded} года.`,
  }] : []),
  {
    q: 'Можно ли посмотреть двери вживую?',
    a: `Да, в выставочном зале представлено более 60 моделей дверей, образцы покрытий и профилей перегородок. Адрес: ${SITE.address.full}. Работаем без выходных: ${companyLegalInfo.workingHours.shortDisplay}.`,
  },
  {
    q: 'Какая гарантия на двери и монтаж?',
    a: 'На монтажные работы — 12 месяцев, на сами двери и перегородки — по условиям производителя. С гарантийными вопросами обращайтесь напрямую в салон.',
  },
  {
    q: 'Работаете ли вы с дизайнерами и юридическими лицами?',
    a: 'Да. Для дизайнеров и архитекторов есть партнёрская программа, для юридических лиц и ИП — оплата по счёту безналичным расчётом.',
  },
]

const storeSchema = buildLocalBusiness()

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  description,
  url: canonicalUrl,
  about: { '@id': LOCAL_BUSINESS_ID },
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={`${SITE.url}/renders/about/vfd-out-900.webp`}
  structuredData={[storeSchema, aboutPageSchema, faqSchema]}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <AboutSection client:visible />

  <section class="section">
    <div class="container">
      <FaqAccordion items={faq} />
      <p class="mt-6 text-sm text-slate-600">
        Ещё по теме: <a href="/o-fabrike/" class="font-semibold text-teal-700 hover:text-teal-800">о фабрике-производителе</a>,
        <a href="/designers/" class="font-semibold text-teal-700 hover:text-teal-800">партнёрская программа для дизайнеров</a>,
        <a href="/contacts/" class="font-semibold text-teal-700 hover:text-teal-800">контакты и схема проезда</a>.
      </p>
    </div>
  </section>
</BaseLayout>
