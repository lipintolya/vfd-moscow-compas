---
/**
 * /about/ — «О нас». Письмо основателя разложено по блокам, чтобы
 * страница не читалась лонгридом: тёмная обложка (портрет + приветствие),
 * таймлайн истории, выводы о рынке списком, фамильный бренд, «семейный
 * бизнес» (тот же тёмный блок, что «Как мы работаем» на главной)
 * и «Как к нам добраться».
 *
 * Тексты — src/data/about-page.ts, данные салона — src/config/site.ts.
 * Фото салона (ABOUT_PHOTOS) пришлёт владелец: пока массив пуст,
 * полоса фотографий не выводится.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import StepsRow from '../components/home/StepsRow.astro'
import VisitBand from '../components/home/VisitBand.astro'
import {
  FOUNDER, FOUNDER_QUOTE, MILESTONES, MARKET, FAMILY_BRAND, FACTORY, FAMILY_BUSINESS,
} from '../data/about-page'
import { SITE } from '../config/site'
import { VFD_DEALER, VFD_PHOTOS, VFD_ORG_ID, vfdOrganizationSchema } from '../data/vfd-factory'
import { localBusinessSchema, LOCAL_BUSINESS_ID } from '../lib/local-business-schema'
import { typograph } from '../lib/typograph'
import '../styles/home.css'

const title       = `О нас — ${SITE.studioName}, официальный дилер ${SITE.name} ${SITE.city.in}`
const description =
  `${SITE.studioName} — официальный дилер ${SITE.manufacturerOf} ${SITE.city.in}. ` +
  `Семейный бизнес: межкомнатные двери с 2014 года, салон в ${SITE.address.mall}.`
const pageUrl = new URL('/about/', SITE.url).href
/* Превью ссылки в соцсетях и мессенджерах — scripts/gen-og-about.mjs */
const OG_IMAGE = new URL('/og/about.jpg', SITE.url).href

const structuredData = [
  localBusinessSchema(),
  vfdOrganizationSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    url: pageUrl,
    name: title,
    description,
    about: { '@id': LOCAL_BUSINESS_ID },
    mentions: { '@id': VFD_ORG_ID },
    mainEntity: {
      '@type': 'Person',
      name: FOUNDER.name,
      jobTitle: 'Основатель',
      image: new URL(FOUNDER.photo.src, SITE.url).href,
      worksFor: { '@id': LOCAL_BUSINESS_ID },
    },
  },
]

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'О нас' },
]
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage={OG_IMAGE}
  ogImageMeta={{ width: 1200, height: 630, alt: `${SITE.studioName} × VFD — ${FOUNDER.name}` }}
  structuredData={structuredData}
  preloadImage={FOUNDER.photo.src}
  preloadImageSrcset={FOUNDER.photo.srcset}
  preloadImageSizes={FOUNDER.photo.sizes}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="home">
    <!-- Обложка: тёмная плитка, портрет справа — его тёмный студийный фон
         продолжает плитку, левый край кадра растворяется в ней -->
    <section class="about-intro" aria-labelledby="about-title">
      <div class="container">
        <div class="cover">
          <div class="cover__text">
            <!-- Знак коллаборации: «Студия Зизевского × VFD» -->
            <h1 id="about-title" class="collab">
              <span>{SITE.studioName}</span>{' '}
              <!-- «× VFD» не разрывается: крестик не повисает в конце строки -->
              <span class="collab__pair"><span class="collab__x">×</span> VFD</span>
            </h1>

            <!-- Цитата основателя: blockquote + подпись в figcaption -->
            <figure class="quote">
              <div class="quote__body">
                <p class="quote__greeting">{typograph(FOUNDER_QUOTE.greeting)}</p>
                <blockquote class="quote__quote">
                  <p class="quote__text">{typograph(FOUNDER_QUOTE.text.join(' '))}</p>
                </blockquote>
              </div>
              <!-- Печать цитаты — один раз. Скрипт стоит сразу за цитатой и
                   выполняется до первой отрисовки, поэтому полный текст не
                   мелькает перед анимацией. Весь текст всё время в DOM (ещё
                   не «напечатанная» часть прозрачная) — вёрстка не прыгает,
                   поиск и экранные читалки видят цитату целиком. За кадр
                   меняются два текстовых узла; по окончании разметка
                   анимации снимается. Без JS и при reduced-motion — текст
                   сразу. -->
              <script is:inline>
                (() => {
                  const quote = document.currentScript.previousElementSibling
                  if (!quote || matchMedia('(prefers-reduced-motion: reduce)').matches) return
                  // Скорость: приветствие медленнее, основной текст быстрее (мс на знак)
                  const parts = [...quote.querySelectorAll('p')].map((p, i) => {
                    const full = p.textContent
                    const on = document.createElement('span')
                    const off = document.createElement('span')
                    on.className = 'tw-on'
                    off.className = 'tw-off'
                    off.textContent = full
                    p.replaceChildren(on, off)
                    return { p, full, on, off, ms: i === 0 ? 45 : 11, pause: i === 0 ? 0 : 280 }
                  })
                  let t0 = 0
                  const plan = []
                  for (const part of parts) {
                    t0 += part.pause
                    plan.push({ ...part, start: t0 })
                    t0 += part.full.length * part.ms
                  }
                  const finish = () => plan.forEach(({ p, full }) => { p.textContent = full })
                  const run = () => {
                    const begin = performance.now()
                    const frame = (now) => {
                      const el = now - begin
                      for (const part of plan) {
                        const n = Math.max(0, Math.min(part.full.length, Math.floor((el - part.start) / part.ms)))
                        if (part.on.textContent.length !== n) {
                          part.on.textContent = part.full.slice(0, n)
                          part.off.textContent = part.full.slice(n)
                        }
                        part.on.classList.toggle('tw-caret', el >= part.start && n < part.full.length)
                      }
                      if (el < t0) requestAnimationFrame(frame)
                      else finish()
                    }
                    requestAnimationFrame(frame)
                  }
                  // Старт — когда цитата на экране (и после короткой паузы,
                  // чтобы не совпасть с появлением шапки)
                  if (!('IntersectionObserver' in window)) return finish()
                  const io = new IntersectionObserver(([e]) => {
                    if (!e?.isIntersecting) return
                    io.disconnect()
                    setTimeout(run, 350)
                  })
                  io.observe(quote)
                })()
              </script>
              <figcaption class="quote__sign">
                <span class="quote__name">{FOUNDER.name}</span>
                <span>{FOUNDER.role}</span>
              </figcaption>
            </figure>
          </div>

          <div class="cover__photo">
            <img
              src={FOUNDER.photo.src}
              srcset={FOUNDER.photo.srcset}
              sizes={FOUNDER.photo.sizes}
              alt={`${FOUNDER.name}, ${FOUNDER.role}`}
              width={FOUNDER.photo.width}
              height={FOUNDER.photo.height}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- История — годы идут по порядку. Красная линия прорисовывается
         один раз, когда блок доходит до экрана -->
    <section class="h-sec h-sec--wall" aria-labelledby="history-title">
      <div class="container">
        <h2 id="history-title" class="h-h2 history__title">Наша история</h2>
        <ol class="tl" role="list" data-tl>
          {MILESTONES.map((m, i) => (
            <li class="tl__item" style={`--i: ${i}`}>
              <span class="tl__value">{m.value}</span>
              <p class="tl__text">{typograph(m.text)}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Выводы о рынке — пункты под линейками вместо сплошного абзаца -->
    <section class="h-sec" aria-labelledby="market-title">
      <div class="container split">
        <header class="split__head">
          <h2 id="market-title" class="h-h2">{typograph(MARKET.title)}</h2>
          <p class="h-lead split__lead">{typograph(MARKET.lead)}</p>
        </header>
        <ul class="market" role="list">
          {MARKET.points.map((p) => <li>{typograph(p)}</li>)}
        </ul>
      </div>
    </section>

    <!-- Фамильный бренд — главный текст страницы, набран крупно -->
    <section class="h-sec h-sec--wall" aria-labelledby="brand-title">
      <div class="container split">
        <h2 id="brand-title" class="h-h2 split__head">{typograph(FAMILY_BRAND.title)}</h2>
        <div class="brand__text">
          {FAMILY_BRAND.paragraphs.map((p) => <p>{typograph(p)}</p>)}
        </div>
      </div>
    </section>

    <!-- Официальный дилер ВФД — о производителе: факты по данным фабрики,
         фото и как устроено производство -->
    <section class="h-sec" id="vfd" aria-labelledby="vfd-title">
      <div class="container">
        <header class="h-head">
          <h2 id="vfd-title" class="h-h2">{typograph(VFD_DEALER.title)}</h2>
          <p class="h-lead">{typograph(VFD_DEALER.lead)}</p>
        </header>

        <dl class="vfd-facts">
          {VFD_DEALER.facts.map((f) => (
            <div>
              <dt class="vfd-facts__value">{f.value}</dt>
              <dd class="h-meta">{typograph(f.label)}</dd>
            </div>
          ))}
        </dl>
        <p class="h-meta vfd-source">{VFD_DEALER.source}</p>

        <!-- Фото фабрики: ПК — сетка 2×2 слева от пунктов, планшет — ряд из
             четырёх, телефон — лента со свайпом (.h-rail). Клик — окно
             просмотра с крупными кадрами -->
        <div class:list={['vfd', { 'vfd--photos': VFD_PHOTOS.length > 0 }]}>
          {VFD_PHOTOS.length > 0 && (
            <div class="vfd__gallery">
              <ul
                class="vfd__photos h-rail"
                role="list"
                data-lightbox
                data-lightbox-images={JSON.stringify(VFD_PHOTOS.map((p) => ({ src: p.large, alt: p.alt })))}
              >
                {VFD_PHOTOS.map((ph, i) => (
                  <li class="vfd__photo">
                    <button type="button" class="h-media vfd__zoom" aria-label={`Открыть фото: ${ph.alt}`} data-lightbox-index={i}>
                      <img
                        src={ph.src}
                        srcset={ph.srcset}
                        sizes="(min-width: 80rem) 18rem, (min-width: 62.5rem) 24vw, (min-width: 43.75rem) 25vw, 82vw"
                        alt={ph.alt}
                        width={ph.width}
                        height={ph.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </button>
                  </li>
                ))}
              </ul>
              <p class="h-meta vfd__hint" aria-hidden="true">{VFD_PHOTOS.length} фото — листайте</p>
            </div>
          )}

          <ul class="vfd__features" role="list">
            {VFD_DEALER.features.map((f) => (
              <li>
                <h3 class="h-h3 vfd__feature-title">{f.title}</h3>
                <p class="h-body">{typograph(f.text)}</p>
              </li>
            ))}
          </ul>
        </div>

        <a href={VFD_DEALER.cta.href} class="h-btn h-btn--ink vfd__cta">{VFD_DEALER.cta.label}</a>
      </div>
    </section>

    <!-- Собственное производство: на ПК — сетка (широкий кадр на две колонки),
         на телефоне — лента со свайпом (.h-rail). Клик — лайтбокс
         с крупными версиями кадров -->
    <section class="h-sec h-sec--wall" aria-labelledby="factory-title">
      <div class="container">
        <header class="h-head">
          <h2 id="factory-title" class="h-h2">{FACTORY.title}</h2>
          <p class="h-lead">{typograph(FACTORY.lead)}</p>
        </header>

        <ul
          id="factory-list"
          class="factory h-rail"
          role="list"
          data-lightbox
          data-lightbox-images={JSON.stringify(FACTORY.photos.map((p) => ({ src: p.large, alt: p.alt })))}
        >
          {FACTORY.photos.map((p, i) => (
            <li class:list={['factory__item', { 'factory__item--wide': p.wide }]}>
              <button type="button" class="h-media factory__zoom" aria-label={`Открыть фото: ${p.alt}`} data-lightbox-index={i}>
                <img
                  src={p.src}
                  srcset={p.srcset}
                  sizes={p.wide
                    ? '(min-width: 80rem) 37rem, (min-width: 62.5rem) 50vw, (min-width: 43.75rem) 66vw, 82vw'
                    : '(min-width: 80rem) 18rem, (min-width: 62.5rem) 25vw, (min-width: 43.75rem) 33vw, 82vw'}
                  alt={p.alt}
                  width={p.width}
                  height={p.height}
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </li>
          ))}
        </ul>
        <p class="h-meta factory__hint" aria-hidden="true">{FACTORY.photos.length} фото — листайте</p>
        <!-- На ПК видны два ряда, остальное — по кнопке. Кнопку показывает
             скрипт: без JS сетка просто раскрыта целиком -->
        <button type="button" class="h-btn h-btn--quiet factory__more" aria-controls="factory-list" data-factory-more hidden>
          Смотреть все {FACTORY.photos.length} фото
        </button>
      </div>
    </section>

    <StepsRow id="family" title={FAMILY_BUSINESS.title} lead={FAMILY_BUSINESS.lead} steps={FAMILY_BUSINESS.points} />

    <VisitBand lead="Приходите в салон: покажем двери вживую, подберём модель и цвет под ваш интерьер." />
  </div>
</BaseLayout>

<script>
  import { initLightboxGroups } from '../lib/lightbox'

  initLightboxGroups()

  /* Производство: на ПК сетка свёрнута до двух рядов (лишние кадры
     скрыты CSS и, раз loading="lazy", даже не скачиваются), кнопка
     раскрывает остальные */
  const factory = document.querySelector<HTMLElement>('.factory')
  const more = document.querySelector<HTMLButtonElement>('[data-factory-more]')
  if (factory && more) {
    factory.dataset.collapsed = ''
    more.hidden = false
    more.setAttribute('aria-expanded', 'false')
    more.addEventListener('click', () => {
      delete factory.dataset.collapsed
      more.hidden = true
      more.setAttribute('aria-expanded', 'true')
    })
  }

  const tl = document.querySelector<HTMLElement>('[data-tl]')
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches
  if (tl && !still && 'IntersectionObserver' in window && tl.getBoundingClientRect().top > innerHeight) {
    tl.dataset.tl = 'hidden'
    const io = new IntersectionObserver(([e]) => {
      if (!e?.isIntersecting) return
      tl.dataset.tl = 'shown'
      io.disconnect()
    }, { rootMargin: '0px 0px -20% 0px' })
    io.observe(tl)
  }
</script>

<style>
  .about-intro { padding-block: clamp(1rem, 2vw, 1.5rem) var(--h-sec); }

  /* ── Обложка ──
     Тёмная плитка: текст слева, квадратный портрет справа во всю высоту.
     Фон портрета — тёмная студийная стена, поэтому плитка тёмная, а левый
     край кадра уходит в прозрачность маской — шва между фото и плиткой нет. */
  .cover {
    display: grid;
    overflow: hidden;
    border-radius: 1.75rem;
    background: var(--color-slate-950);
    color: var(--color-white);
  }
  @media (min-width: 56.25rem) {
    .cover { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); min-height: 34rem; }
  }
  .cover__text {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }
  .cover__photo { position: relative; }
  .cover__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    mask-image: linear-gradient(90deg, transparent 0%, var(--color-white) 38%);
  }

  /* «Студия Зизевского × VFD»: крестик — тонкий и приглушённый,
     как в подписях коллабораций */
  .collab {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.3em;
    margin: 0;
    font-family: var(--h-font);
    font-size: clamp(2.25rem, 4.4vw, 3.75rem);
    font-weight: var(--h-weight-display);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--color-white);
  }
  .collab__x { font-weight: 200; color: var(--color-slate-500); }
  .collab__pair { white-space: nowrap; }

  /* ── Цитата основателя ──
     Приветствие — строкой над цитатой; кавычки — в самом тексте цитаты.
     Открывающая вынесена за левый край (висячая пунктуация), чтобы буквы
     цитаты стояли ровно по одной линии с приветствием и заголовком.
     Подпись — под линейкой, как в письме. */
  .quote { margin: auto 0 0; }
  .quote__body { margin: 0; }
  .quote__quote { margin: 0; }

  /* Печать (скрипт в разметке): ещё не напечатанное — прозрачное, место
     занимает; курсор — тонкая красная черта без ширины в вёрстке
     (отрицательный отступ), мигает только пока идёт печать */
  .quote__body :global(.tw-off) { color: transparent; }
  .quote__body :global(.tw-caret)::after {
    content: '';
    display: inline-block;
    width: 0.08em;
    height: 1em;
    margin-right: -0.08em;
    vertical-align: -0.12em;
    background: var(--color-accent-500);
    animation: tw-blink 900ms steps(1) infinite;
  }
  @keyframes tw-blink { 50% { opacity: 0; } }
  .quote__greeting {
    margin: 0;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: var(--h-weight-display);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .quote__text {
    margin: 0.875rem 0 0;
    text-indent: -0.5em;
    max-width: 30em;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-slate-300);
    text-wrap: pretty;
  }
  .quote__sign {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: 0.0625rem solid var(--color-slate-700);
    font-size: 0.875rem;
    color: var(--color-slate-400);
  }
  .quote__name { font-size: 1rem; font-weight: 600; color: var(--color-white); }

  /* Телефон и планшет: портрет сверху, его низ растворяется в плитке */
  @media (max-width: 56.1875rem) {
    .cover__photo { order: -1; aspect-ratio: 1; max-height: 28rem; }
    .cover__photo img { mask-image: linear-gradient(180deg, var(--color-white) 62%, transparent 100%); }
    .cover__text { padding-top: 0; }
    .quote { margin-top: 0; }
  }

  /* Шапка секции слева (5 колонок), содержимое справа (с 7-й) —
     «Что мы поняли о рынке» и «Что значит фамильный бренд?» */
  .split { display: grid; gap: 1.5rem var(--h-gutter); }
  @media (min-width: 56.25rem) {
    .split { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; }
    .split > :first-child { grid-column: 1 / span 5; }
    .split > :last-child  { grid-column: 7 / span 6; }
  }
  .split__lead { margin-top: 1rem; }

  /* Выводы о рынке: пункты под линейками, текст крупнее основного */
  .market { margin: 0; padding: 0; list-style: none; border-bottom: 0.0625rem solid var(--h-rule); }
  .market li {
    padding-block: 1.25rem;
    border-top: 0.0625rem solid var(--h-rule);
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--h-ink);
    text-wrap: pretty;
  }
  /* Последний пункт — вывод, к которому ведёт список: следующий блок */
  .market li:last-child { font-weight: 600; }

  .history__title { margin-bottom: clamp(2.5rem, 5vw, 4rem); }

  /* ── Таймлайн ──
     Линейка через все вехи; поверх — красная линия, которая один раз
     прорисовывается слева направо (на телефоне — сверху вниз).
     Отметка вехи — короткий вертикальный штрих, не точка. */
  .tl {
    position: relative;
    display: grid;
    gap: 2.5rem var(--h-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tl::before,
  .tl::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 0.0625rem;
    background: var(--h-rule);
  }
  .tl::after {
    height: 0.125rem;
    top: -0.03125rem;
    background: var(--h-signal);
    transform-origin: left;
    transition: transform 1800ms var(--ease-out);
  }
  [data-tl='hidden'].tl::after { transform: scaleX(0); }

  .tl__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
  }
  .tl__item::before {
