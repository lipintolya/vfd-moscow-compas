---
/**
 * /about/ — «О салоне».
 *
 * PLACEHOLDER: прежние тексты и фото были другого салона и удалены (см.
 * историю git). Пока здесь заглушки текста и фото + реальные контакты из
 * конфига. Страница закрыта noindex — снять вместе с наполнением.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import { companyLegalInfo } from '../lib/contacts-data'
import { SITE, PHONE } from '../config/site'

const title       = `О салоне — ${SITE.studioName}, ВФД в ТЦ «Компас»`
const description = `${SITE.studioName} — шоу-рум Владимирской фабрики дверей в Москве: ${SITE.address.full}.`

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'О салоне' },
]

const photoSlots = [1, 2, 3]
---

<BaseLayout title={title} description={description} noIndex>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <section class="section">
    <div class="container">
      <header class="max-w-3xl">
        <h1 class="t-h1 m-0">О салоне</h1>
        <p class="t-lead mt-4 mb-0">{`${SITE.studioName} — шоу-рум Владимирской фабрики дверей в Москве, ${SITE.address.mall}, ${SITE.address.floor}.`}</p>
      </header>

      <!-- PLACEHOLDER: текст о салоне -->
      <div class="about-ph about-ph--text mt-10">
        <p class="m-0">Текст о салоне появится позже.</p>
      </div>

      <!-- PLACEHOLDER: фото салона -->
      <ul class="about-photos" role="list">
        {photoSlots.map(() => (
          <li class="about-ph about-ph--photo">Фото салона</li>
        ))}
      </ul>

      <!-- Реальные контакты — из src/config/site.ts и contacts-data.ts -->
      <dl class="about-facts">
        <div>
          <dt>Адрес</dt>
          <dd>
            {SITE.address.street}<br />{SITE.address.mall}, {SITE.address.floor}
            <a href={SITE.address.mapUrl} target="_blank" rel="noopener" class="about-link">Построить маршрут</a>
          </dd>
        </div>
        <div>
          <dt>Часы работы</dt>
          <dd>{companyLegalInfo.workingHours.shortDisplay}</dd>
        </div>
        <div>
          <dt>Телефон</dt>
          <dd>
            <a href={`tel:${PHONE.raw}`} class="about-link about-link--strong">{PHONE.label}</a>
            <span class="about-note">{SITE.contactPerson}</span>
          </dd>
        </div>
        <div>
          <dt>Telegram-канал</dt>
          <dd>
            <a href={SITE.social.telegram} target="_blank" rel="noopener" class="about-link about-link--strong">{SITE.social.telegramHandle}</a>
          </dd>
        </div>
      </dl>

      <p class="mt-10 mb-0 text-sm text-slate-600">
        Ещё по теме: <a href="/o-fabrike/" class="about-link">о фабрике-производителе</a>,{' '}<a href="/contacts/" class="about-link">контакты и схема проезда</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about-ph {
    display: grid;
    place-items: center;
    border-radius: 1.25rem;
    background: var(--color-slate-100);
    color: var(--color-slate-500);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .about-ph--text { min-height: 10rem; padding: 2rem; }
  .about-photos {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .about-photos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .about-ph--photo { aspect-ratio: 4 / 3; }

  .about-facts {
    display: grid;
    gap: 0;
    margin: 3rem 0 0;
    border-top: 1px solid var(--color-slate-200);
  }
  @media (min-width: 900px) {
    .about-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 0; }
    .about-facts > div + div { border-left: 1px solid var(--color-slate-200); padding-left: 1.5rem; }
  }
  .about-facts > div {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-slate-200);
  }
  @media (min-width: 900px) {
    .about-facts > div { padding-block: 0; border-bottom: 0; }
  }
  .about-facts dt { font-size: 0.8125rem; color: var(--color-slate-500); }
  .about-facts dd {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0.375rem 0 0;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-ink);
  }
  .about-note { font-size: 0.875rem; font-weight: 400; color: var(--color-slate-500); }
  .about-link {
    width: fit-content;
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-slate-300);
    text-underline-offset: 0.25em;
  }
  .about-link:hover { text-decoration-color: currentColor; }
  .about-link--strong { font-size: 1.0625rem; font-weight: 500; text-decoration: none; }
  .about-link--strong:hover { text-decoration: underline; }
</style>
