---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { brandTitle } from '../../lib/seo-title'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import PortfolioGrid from '../../components/portfolio/PortfolioGrid.vue'
import Videos from '../../components/home/Videos.astro'
import QuoteCta from '../../components/ui/QuoteCta.astro'
import { getWorks } from '../../lib/works'
import { PHONE, SITE } from '../../config/site'
import { HERO_COVER_IMAGE } from '../../data/hero-image'
import { WORK_VIDEOS } from '../../data/videos'
import { typograph } from '../../lib/typograph'
import '../../styles/home.css'

const works = await getWorks()

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Наши работы', item: `${SITE.url}/portfolio/` },
  ],
}

const lead = 'Реальные объекты наших клиентов — монтаж дверей и перегородок по Москве и области.'
---

<BaseLayout
  title={brandTitle('Наши работы — фотоотчёты монтажей дверей в Москве')}
  description="Фотоотчёты установки межкомнатных и скрытых дверей и алюминиевых перегородок — реальные объекты Студии Зизевского по Москве и области."
  structuredData={[breadcrumbSchema]}
  noIndex={!SITE.features.portfolio}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Наши работы' }]} />
    </div>
  </div>

  <div class="home">
    <section class="pfh" aria-labelledby="portfolio-title">
      <div class="container">
        <header class="pfh__head">
          <h1 id="portfolio-title" class="h-h1 pfh__title">Наши работы — фотоотчёты с&nbsp;объектов</h1>
          <p class="h-lead pfh__lead">{typograph(lead)}</p>
        </header>

        <PortfolioGrid works={works} client:visible />
      </div>
    </section>

    {/* Ролики с объектов — тот же блок и окно просмотра, что на главной
         (components/home/Videos.astro) */}
    <Videos
      id="works-video"
      videos={WORK_VIDEOS}
      heading="Видео с объектов"
      lead="Короткие ролики с наших работ: двери и проёмы в интерьере."
      allHref={null}
      tightTop={false}
      cols={WORK_VIDEOS.length}
    />

    <section class="h-sec h-sec--tight-top" aria-label="Заказать">
      <div class="container">
        <QuoteCta
          image={works[0]?.images[0] ?? HERO_COVER_IMAGE}
          title="Понравился результат?"
          description="Все модели, которые видите на фото, в наличии в шоуруме — выбирайте по каталогу или приезжайте посмотреть вживую"
          primaryHref={`tel:${PHONE.raw}`}
          primaryLabel="Позвонить"
          primaryExternal={false}
          secondaryHref="/catalog/"
          secondaryLabel="Смотреть каталог"
        />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Шапка раздела — та же сетка, что у статей и отзывов: заголовок слева
     (7 колонок), пояснение справа (4 колонки) */
  /* Низ — без отступа: следующий блок сам даёт верхнее поле */
  .pfh { padding-top: clamp(1rem, 2vw, 1.5rem); }
  .pfh__head {
    display: grid;
    gap: 1.25rem var(--h-gutter);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 62.5rem) {
    .pfh__head { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .pfh__title { grid-column: 1 / span 7; }
    .pfh__lead { grid-column: 9 / span 4; }
  }
</style>
