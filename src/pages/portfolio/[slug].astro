---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProjectSlider from '../../components/portfolio/ProjectSlider.vue'
import { PORTFOLIO_WORKS, CATEGORY_LABELS, CATEGORY_BADGE_COLORS, OBJECT_TYPE_LABELS } from '../../data/portfolio-works'
import { companyLegalInfo } from '../../lib/contacts-data'
import { SITE } from '../../config/site'
import { typograph } from '../../lib/typograph'

export async function getStaticPaths() {
  return PORTFOLIO_WORKS.map((work) => ({
    params: { slug: work.id },
    props:  { work },
  }))
}

const { work } = Astro.props
const canonicalUrl = `${SITE.url}/portfolio/${work.id}/`
const phone = companyLegalInfo.contacts.phone[0]!

/* ── <title> с местом объекта ─────────────────────────────────────────
   Название ЖК/посёлка/района — отдельный локальный запрос с низкой
   конкуренцией («двери ЖК НИКС Сити»), а в заголовке работы его часто нет.
   Место и город берутся из location и дописываются, только если в
   заголовке их ещё нет. Сравнение по основам слов (первые 5 букв):
   «в Калининском районе» уже покрывает «Калининский район». */
const stems = (s: string) =>
  s.toLowerCase().replaceAll('ё', 'е').replace(/[«»"().,]/g, ' ')
    .split(/\s+/).filter(w => w.length > 2).map(w => w.slice(0, 5))
const GENERIC_PLACE_WORDS = new Set(['жк', 'котте', 'посел', 'мкр', 'район', 'набер', 'центр'])
const isInTitle = (place: string) => {
  const titleStems = new Set(stems(work.title))
  const key = stems(place).filter(w => !GENERIC_PLACE_WORDS.has(w))
  return (key.length ? key : stems(place)).every(w => titleStems.has(w))
}
const [city = '', ...placeParts] = work.location.split(',').map(p => p.trim())
/* «частный объект», «салон ВФД…» — не топоним, в title не несём. */
const place = placeParts.find(p => p && !/частный объект|салон вфд/i.test(p)) ?? ''
const titleSuffix = [
  place && !isInTitle(place) ? place : '',
  city && !isInTitle(city) ? city : '',
].filter(Boolean).join(', ')
// Второе тире подряд читается плохо: если в заголовке уже есть « — », место — через запятую.
const pageTitle = `${work.title}${titleSuffix ? `${work.title.includes(' — ') ? ', ' : ' — '}${titleSuffix}` : ''} | ВФД`

const doorWord = (n: number) =>
  n === 1 ? 'дверь' : n < 5 ? 'двери' : 'дверей'

const imageGallerySchema = {
  '@context':      'https://schema.org',
  '@type':         'ImageGallery',
  name:            work.title,
  description:     work.description,
  dateCreated:     work.date,
  image:           work.images,
  contentLocation: { '@type': 'Place', name: work.location },
  author: {
    '@type': 'Organization',
    name:    'ВФД — Салон дверей в Москве',
    url:     SITE.url,
  },
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type':    'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная',     item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Наши работы', item: `${SITE.url}/portfolio/` },
    { '@type': 'ListItem', position: 3, name: work.title,    item: canonicalUrl },
  ],
}
---

<BaseLayout
  title={pageTitle}
  description={work.description}
  ogImage={work.images[0]}
  structuredData={[imageGallerySchema, breadcrumbSchema]}
>
  <article class="section">
    <div class="container">

      <!-- Breadcrumb -->
      <nav aria-label="Хлебные крошки" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-slate-500 flex-wrap">
          <li><a href="/" class="hover:text-secondary-600 transition-colors">Главная</a></li>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li><a href="/portfolio/" class="hover:text-secondary-600 transition-colors">Наши работы</a></li>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li class="text-slate-700 font-medium truncate max-w-64">{work.title}</li>
        </ol>
      </nav>

      <div class="lg:grid lg:grid-cols-[1.5fr_1fr] lg:items-start lg:gap-10 xl:gap-14">

        <!-- Photo slider -->
        <div class="lg:sticky lg:top-24">
          <ProjectSlider images={work.images} client:load />
        </div>

        <div>
          <!-- Header -->
          <header class="mt-8 mb-6 lg:mt-0">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">
              <span class="inline-flex items-center gap-1.5">
                <span class:list={['h-1.5 w-1.5 rounded-full', CATEGORY_BADGE_COLORS[work.category]]} aria-hidden="true" />
                {CATEGORY_LABELS[work.category]}
              </span>
              <span class="text-slate-300" aria-hidden="true">·</span>
              <span class="normal-case tracking-normal">{OBJECT_TYPE_LABELS[work.objectType]}</span>
              <span class="text-slate-300" aria-hidden="true">·</span>
              <time datetime={work.date} class="tabular-nums normal-case tracking-normal">{work.label}</time>
            </div>
            <h1 class="text-2xl font-medium leading-tight tracking-tight text-slate-900 md:text-3xl">
              {work.title}
            </h1>
            <p class="mt-2 flex items-center gap-1.5 text-sm text-slate-500">
              <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5 shrink-0" aria-hidden="true">
                <path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.8"/>
              </svg>
              {work.location}{work.doorCount ? ` · ${work.doorCount} ${doorWord(work.doorCount)}` : ''}
            </p>
          </header>

          <!-- Story -->
          {work.story && (
            <div class="mb-7 space-y-4 text-base leading-relaxed text-slate-700">
              {work.story.split(/\n\s*\n/).map((p) => <p>{typograph(p)}</p>)}
            </div>
          )}

          <!-- Спецификация — строки с разделителями, как в паспорте изделия,
               не суп из одинаковых серых чипов. -->
          {(work.model || (work.features && work.features.length > 0)) && (
            <ul class="pw-specs" role="list">
              {work.model && (
                <li class="pw-specs__row pw-specs__row--model">
                  <span class="pw-specs__label">Модель / серия</span>
                  <span class="pw-specs__value">{work.model}</span>
                </li>
              )}
              {work.features?.map(f => (
                <li class="pw-specs__row">{f}</li>
              ))}
            </ul>
          )}

          {work.relatedLink && (
            <a
              href={work.relatedLink.href}
              class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-secondary-700 hover:text-secondary-600"
            >
              {work.relatedLink.label}
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          )}
        </div>
      </div>

        <!-- CTA — сплошная тёмная плашка var(--color-fg), тот же тон, что у всех
             остальных CTA-панелей сайта (HeroSlider «О компании», ContactsSection,
             CTA на /catalog/skrytye-dveri/, /catalog/decor/, /catalog/series/[slug]/).
             Раньше здесь была bg-ink (var(--color-slate-900), синеватый slate) и кнопки на голых
             Tailwind-цветах — выбивались из фирменной палитры. Кнопки — общие
             .btn/.btn-ghost/.btn-icon, как в той же CTA-плашке на skrytye-dveri.astro. -->
        <div class="pw-cta mt-12 overflow-hidden rounded-2xl p-6 sm:p-8">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-lg font-semibold text-white">Хотите такой же результат?</p>
              <p class="mt-1 text-sm leading-relaxed text-white/60 max-w-md">
                Приедем на замер, точно рассчитаем стоимость и подберём модель под ваш интерьер.
              </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-none sm:flex-row">
              <a href={`tel:${phone.raw}`} class="btn pw-cta__phone">
                {phone.label}
              </a>
            </div>
          </div>
          <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 border-t border-white/10 pt-5 text-xs font-semibold text-white/70">
            <span class="inline-flex items-center gap-1.5">
              <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5 text-accent-400" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Собственная монтажная бригада
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5 text-accent-400" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Гарантия на монтаж
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5 text-accent-400" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Работаем по Москве и области
            </span>
          </div>
        </div>

        <!-- Back link -->
        <div class="mt-8">
          <a href="/portfolio/" class="inline-flex items-center gap-2 text-sm font-semibold text-secondary-700 hover:text-secondary-600 transition-colors">
            <svg viewBox="0 0 16 16" fill="none" class="w-4 h-4" aria-hidden="true">
              <path d="M13 8H3M7 4l-4 4 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Все работы
          </a>
        </div>

    </div>
  </article>
</BaseLayout>

<style>
  .pw-cta {
    background: var(--color-fg);
  }
  /* Телефон — единственная сплошная кнопка в блоке (акцент на главном
     действии), берёт токен --color-accent, а не голый Tailwind accent-500 —
     тот же цвет, что и везде в фирменной палитре, hover темнее, а не светлее. */
  .pw-cta__phone {
    background: var(--color-accent);
    color: #fff;
  }
  .pw-cta__phone:hover {
    background: var(--color-accent-hover);
  }

  .pw-specs {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .pw-specs__row {
    padding: 0.75rem 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-body);
    border-bottom: 1px solid var(--color-border);
  }
  .pw-specs__row--model {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .pw-specs__label {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-fg-subtle);
  }
  .pw-specs__value {
    font-weight: 600;
    color: var(--color-ink);
    text-align: right;
  }
</style>
