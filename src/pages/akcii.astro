---
import BaseLayout from '../layouts/BaseLayout.astro'
import Promo from '../components/home/Promo.vue'
import '../styles/home.css'
import { brandTitle } from '../lib/seo-title'
import { SITE } from '../config/site'
import { getCollection } from 'astro:content'
import { activePromos, formatDate } from '../lib/promo-dates'

/* Акции — из Strapi (раздел «Акции»): действующие на момент сборки; истёкшую
   после загрузки страницы уберёт сам блок. Оформление и тексты карточек — те
   же, что на главной (Promo.vue, режим page). */
const promos = activePromos((await getCollection('promos')).map((e) => e.data))
const lastDay = promos.map((p) => p.validUntil).sort().at(-1)
---

<BaseLayout
  title={brandTitle(`Акции на двери ${SITE.name} ${SITE.city.in}`)}
  description={`Акции салона ${SITE.studioNameOf} в ${SITE.address.mall}${lastDay ? ` до ${formatDate(lastDay)}` : ''}: ${promos.length ? promos.slice(0, 3).map((p) => p.title.toLowerCase()).join(', ') + ' и другие' : 'скидки и подарки на двери'}.`}
  noIndex={promos.length === 0}
>
  <div class="home">
    <Promo client:load page promos={promos} />
  </div>
</BaseLayout>
