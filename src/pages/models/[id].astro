---
import { relatedArticle as relatedArticleFor } from '../../lib/articles'
import RelatedArticleCard from '../../components/articles/RelatedArticleCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { sellerRef } from '../../lib/local-business-schema'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import ProductColorPicker from '../../components/catalog/ProductColorPicker.vue'
import PlinthSection from '../../components/catalog/PlinthSection.astro'
import { getSeriesSpec } from '../../data/series-descriptions'
import { accessoriesByCoating, CATEGORY_LABELS, CATEGORY_NOTES, PRICE_LIST_UPDATED } from '../../data/accessories'
import type { AccessoryCategory, CoatingSlug } from '../../data/accessories'
import InfoImageViewer from '../../components/catalog/InfoImageViewer.vue'
import { describeTrim } from '../../lib/trim-labels'
import { merchantPolicy } from '../../lib/contacts-data'
import { getModelEntries, getModelTitles } from '../../lib/model-entries'
import { DOOR_CATEGORIES } from '../../data/door-categories'
import type { ModelEntry } from '../../lib/model-entries'
import CatalogGrid from '../../components/catalog/CatalogGrid.vue'
import { getCatalogCards, getSeriesCards } from '../../lib/catalog-data'
import { pluralRu } from '../../lib/plural'
import '../../styles/home.css'
import {
  DOOR_TYPE, BRAND, cleanModelName,
  productName, productTitle, productMetaDescription, productDescription,
} from '../../lib/product-text'

export async function getStaticPaths() {
  /* Данные моделей — в lib/model-entries.ts: их же берёт товарный фид
     /feed/yandex.xml, цена и фото в фиде обязаны совпадать со страницей. */
  const entries = await getModelEntries()

  /* ── Каждая модель доступна по двум путям: новому слагу (канонический)
     и старому UUID (чтобы не 404'ить уже проиндексированные Яндексом ссылки) ── */
  return [
    ...entries.map(entry => ({ params: { id: entry.slug },     props: entry })),
    ...entries.map(entry => ({ params: { id: entry.model.id }, props: entry })),
  ]
}

const entry = Astro.props as ModelEntry
/* Старый адрес по UUID (12 Nov 2026) — мгновенный переход на адрес-слаг:
   страница с meta refresh 0, canonical и noindex, которую Яндекс и Google
   считают постоянным редиректом. Раньше здесь была полная копия карточки
   с noindex и canonical на слаг — противоречивые сигналы и 174 дубля в
   сборке. Настоящий 301 — когда сервер начнёт отдавать редиректы по карте */
if (Astro.params.id !== entry.slug) return Astro.redirect(`/models/${entry.slug}/`, 301)
const { model, slug, colors, minPrice, seriesName, seriesSlug, coatingName, coatingSlug, extraColors } = entry

const spec        = getSeriesSpec(seriesSlug, coatingSlug)
const accessories = accessoriesByCoating[coatingSlug as CoatingSlug] ?? []
const hasPlinth   = accessories.some(item => item.category === 'plinth')

/* Статья по теме — перелинковка каталог → блог: самая свежая
   опубликованная статья о серии или покрытии модели
   (relatedSeriesSlugs / relatedCoatings, src/lib/articles.ts). */
const relatedArticle = await relatedArticleFor({ seriesSlugs: [seriesSlug], coatingSlugs: [coatingSlug] })

const CATEGORY_ORDER: AccessoryCategory[] = ['kit', 'box', 'nalichnik', 'kapitel', 'dobor', 'plinth', 'decorative']

const accessoryGroups: [AccessoryCategory, typeof accessories][] = Object.entries(
  accessories.reduce<Record<string, typeof accessories>>((acc, item) => {
    ;(acc[item.category] ??= []).push(item)
    return acc
  }, {})
)
  .sort(([a], [b]) => CATEGORY_ORDER.indexOf(a as AccessoryCategory) - CATEGORY_ORDER.indexOf(b as AccessoryCategory))
  .map(([category, items]) => [category as AccessoryCategory, items])

const canonicalUrl  = Astro.site ? new URL(`/models/${slug}/`, Astro.site).href : undefined
/* Имя модели для показа: без лишних пробелов и латинских букв-двойников
   внутри кириллических слов (см. cleanModelName). */
const displayName = cleanModelName(model.name)

/* Кромка/остекление — у некоторых моделей это единственное отличие между
   SKU (4 «Урбан 1» — золото/серебро/чёрная). describeTrim() убирает мусорные
   коды поставщика и битые записи ("true") и отличает остекление серии Некст,
   которое в базе лежит в том же поле, от кромки. */
const trim = describeTrim(model.trim)

/* Перелинковка карточка → SEO-лендинг покрытия (/catalog/dveri-emal/ и т.п.).
   Раньше с карточки вела только ссылка на серию, а лендинги под главные
   запросы («двери эмаль москва») не получали ни одной ссылки из сотен
   карточек. Анкор — H1 лендинга, т.е. сам целевой запрос. */
const coatingLanding = DOOR_CATEGORIES.find(c => c.coatingSlug === coatingSlug)

/* Title/description/название в schema — из lib/product-text.ts, те же
   формулировки, что в товарном фиде. Тип товара («Межкомнатная дверь»)
   первым словом: по нему ищут, а в имени модели («Иннова 02СТ», «ЕР1»)
   его нет. Meta description — уникальная по модели (не spec.description:
   это текст серии, общий на десятки моделей). */
/* Заголовок — из набора всех моделей: совпавшим добавляется отличие (productTitles) */
const pageTitle = (await getModelTitles()).get(entry.slug) ?? productTitle(entry)
const pageDesc  = productMetaDescription(entry)

/* BreadcrumbList в JSON-LD отдаёт сам Breadcrumbs.astro — здесь не дублируем. */
const breadcrumbs = [
  { label: 'Главная',  href: '/' },
  { label: 'Каталог',  href: '/catalog/' },
  ...(seriesName ? [{ label: seriesName, href: `/catalog/series/${seriesSlug}/` }] : []),
  { label: displayName },
]

/* Другие модели той же серии — ряд карточек каталога под характеристиками:
   соседние модели серии по цене, без текущей. Четыре — один ряд на компьютере,
   два на телефоне. */
const RELATED_LIMIT = 4
const seriesCards   = getSeriesCards((await getCatalogCards()).cards, seriesSlug)
const relatedCards  = seriesCards.filter(c => c.id !== model.id).slice(0, RELATED_LIMIT)

/* Короткие характеристики рядом с ценой — только то, что пишется в два-три
   слова; длинные описания серии — в разделе «Характеристики» ниже. */
const facts = [
  ...(seriesName ? [{ label: 'Серия', value: seriesName, href: `/catalog/series/${seriesSlug}/` }] : []),
  ...(coatingName ? [{ label: 'Покрытие', value: coatingName }] : []),
  ...(trim ? [{ label: trim.kind === 'glass' ? 'Остекление' : 'Кромка', value: trim.label }] : []),
  ...(spec.thickness ? [{ label: 'Толщина полотна', value: `${spec.thickness} мм` }] : []),
]

const specRows: { label: string; value?: string; list?: string[] }[] = [
  ...(spec.description ? [{ label: 'О серии', value: spec.description }] : []),
  ...(spec.features.length ? [{ label: 'Особенности', list: spec.features }] : []),
  ...(spec.coating  ? [{ label: 'Покрытие и отделка', value: spec.coating }] : []),
  ...(spec.material ? [{ label: 'Материал и конструкция', value: spec.material }] : []),
  ...(spec.edge     ? [{ label: 'Кромка', value: spec.edge }] : []),
  ...(spec.thickness ? [{ label: 'Толщина полотна', value: `${spec.thickness} мм` }] : []),
]

/* Короткое значение («37 мм») на телефоне видно сразу, длинные тексты свёрнуты */
const SHORT_SPEC = 40

const productImages = [...new Set(colors.map(c => c.photo).filter(Boolean))]

const structuredData = [{
  '@context': 'https://schema.org',
  '@type':    'Product',
  name:        productName(entry),
  description: productDescription(entry),
  url:         canonicalUrl,
  image:       productImages,
  brand:       { '@type': 'Brand', name: BRAND },
  /* Offer требует price+priceCurrency вместе — без цены (price_rrp пуст
     в Supabase) Google считает Offer невалидным и не даёт rich snippet
     вообще. Без цены честнее не публиковать offers, чем отдавать
     заведомо неполную/невалидную схему. */
  ...(minPrice
    ? {
        offers: {
          '@type':                  'Offer',
          priceCurrency:            'RUB',
          availability:             'https://schema.org/InStoreOnly',
          seller:                   sellerRef(),
          price:                    minPrice,
          priceValidUntil:          new Date(Date.now() + 90 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
          hasMerchantReturnPolicy:  merchantPolicy.returnPolicy,
        },
      }
    : {}),
}]
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={canonicalUrl}
  ogImage={colors[0]?.photo || undefined}
  structuredData={structuredData}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </div>

  <div class="home">
    <section class="mp" aria-labelledby="model-title">
      <div class="container">
        {/* Фото, цена, цвет, покупка — Vue-остров; заголовок и короткие
            характеристики — статичный HTML в его слотах */}
        <ProductColorPicker
          client:load
          colors={colors}
          extraColors={extraColors}
          modelName={displayName}
          modelId={model.id}
          seriesSlug={seriesSlug}
          isNew={model.isNew}
        >
          <h1 slot="head" id="model-title" class="mp__title">
            <span class="mp__type">{`${DOOR_TYPE} `}</span>{displayName}{coatingName && <span class="mp__muted"> — {coatingName}</span>}{trim && <span class="mp__muted">, {trim.phrase}</span>}
          </h1>

          <div slot="facts">
            {facts.length > 0 && (
              <dl class="mp__facts">
                {facts.map((f) => (
                  <div class="mp__fact">
                    <dt>{f.label}</dt>
                    <dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {/* Перелинковка на лендинг покрытия: анкор — его H1, т.е. целевой запрос */}
            {coatingLanding && (
              <p class="mp__landing">
                <a href={`/catalog/${coatingLanding.slug}/`}>Все {coatingLanding.h1.charAt(0).toLowerCase() + coatingLanding.h1.slice(1)}</a>
              </p>
            )}
          </div>
        </ProductColorPicker>
      </div>
    </section>

    {/* ── Характеристики: описание серии слева, параметры справа ── */}
    {specRows.length > 0 && (
      <section class="h-sec h-sec--wall" aria-labelledby="model-spec">
        <div class="container mp-spec">
          <div class="mp-spec__intro">
            <h2 id="model-spec" class="h-h2">Характеристики</h2>
            {seriesName && <p class="h-body mp-spec__note">Общие для моделей серии {seriesName} в покрытии {coatingName}.</p>}
          </div>
          {/* Строки — <details>: на компьютере раскрыты и стоят таблицей, на
              телефоне свёрнуты под названия (скрипт ниже), без JS — раскрыты */}
          <div class="mp-spec__list">
            {specRows.map((row) => row.list || (row.value?.length ?? 0) > SHORT_SPEC ? (
              <details class="mp-spec__row" open data-collapse-mobile>
                <summary class="mp-spec__label">{row.label}</summary>
                <div class="mp-spec__value">
                  {row.list
                    ? <ul class="mp-spec__features" role="list">{row.list.map((f) => <li>{f}</li>)}</ul>
                    : <p>{row.value}</p>}
                </div>
              </details>
            ) : (
              <div class="mp-spec__row mp-spec__row--short">
                <p class="mp-spec__label">{row.label}</p>
                <div class="mp-spec__value"><p>{row.value}</p></div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ── Погонажные изделия: прайс по покрытию ── */}
    {accessories.length > 0 && (
      <section class="h-sec" aria-labelledby="model-acc">
        <div class="container mp-acc">
          <div class="mp-acc__intro">
            <h2 id="model-acc" class="h-h2">Погонажные изделия</h2>
            <p class="h-body mp-acc__note">
              Короб, наличники и доборы под покрытие {coatingName}. Цены актуальны на {PRICE_LIST_UPDATED}, точный прайс уточняйте у менеджера салона в ТЦ «Компас».
            </p>
          </div>
          <div class="mp-acc__groups">
            {accessoryGroups.map(([category, items], i) => (
              <details class="mp-acc__group" open={i === 0}>
                <summary class="mp-acc__label">
                  <span>{CATEGORY_LABELS[category] ?? category}</span>
                  <span class="mp-acc__count">{items.length}</span>
                </summary>
                <ul class="mp-acc__list" role="list">
                  {items.map(item => (
                    <li class="mp-acc__item">
                      <div class="mp-acc__line">
                        <span class="mp-acc__name">{item.name}</span>
                        <span class="h-price mp-acc__price">
                          {item.price ? `${item.price.toLocaleString('ru-RU')} ₽ / ${item.unit}` : 'Цена уточняется'}
                        </span>
                      </div>
                      {(item.image || item.scheme) && (
                        <div class="mp-acc__media">
                          <InfoImageViewer
                            client:visible
                            variant="wide"
                            aspectRatio={item.mediaAspect ?? '2 / 1'}
                            images={[
                              ...(item.image  ? [{ src: item.image,  caption: 'Фото',  alt: `Фото: ${item.name}` }]  : []),
                              ...(item.scheme ? [{ src: item.scheme, caption: 'Схема', alt: `Схема с размерами: ${item.name}` }] : []),
                            ]}
                          />
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
                {CATEGORY_NOTES[category] && (
                  <p class="mp-acc__group-note">{CATEGORY_NOTES[category]}</p>
                )}
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ── Другие модели серии ── */}
    {relatedCards.length > 0 && (
      <section class="h-sec h-sec--tight-top" aria-labelledby="model-related">
        <div class="container">
          <div class="mp-rel__head">
            <h2 id="model-related" class="h-h2">Другие модели серии {seriesName}</h2>
            <a class="h-btn h-btn--quiet" href={`/catalog/series/${seriesSlug}/`}>
              Вся серия: {seriesCards.length} {pluralRu(seriesCards.length, ['модель', 'модели', 'моделей'])}
            </a>
          </div>
          <CatalogGrid client:visible cards={relatedCards} />
        </div>
      </section>
    )}
  </div>

  {/* ── Плинтус к дверям (только для покрытий, где он есть — Эмаль/Эмалекс) ── */}
  {hasPlinth && <PlinthSection title="Плинтус к дверям" />}

  {relatedArticle && <RelatedArticleCard article={relatedArticle} />}
</BaseLayout>

<script>
  /* Характеристики на телефоне свёрнуты под названия (без JS — раскрыты).
     Когда сворачивать, решает CSS (--mp-fold), как на /partitions/alum/ */
  document.querySelectorAll<HTMLDetailsElement>('[data-collapse-mobile]').forEach((d) => {
    if (getComputedStyle(d).getPropertyValue('--mp-fold').trim() === 'closed') d.open = false
  })
</script>

<style>
/* Первый экран модели — тот же язык, что у страницы входной двери:
   типографика и цвета из styles/home.css (.home), раскладка — в острове. */
.mp { padding: clamp(1rem, 2vw, 1.5rem) 0 clamp(3rem, 6vw, 5rem); }

/* H1: тип товара — часть заголовка (по нему ищут: «межкомнатная дверь
   иннова 02»), но визуально тихая строка над названием; покрытие и кромка —
   тоже в H1 (модели с коротким кодом — Р1, Е1 — без них неразличимы в
   поиске), приглушённым цветом: вес остаётся на названии модели. */
.mp__title {
  margin: 0;
  font-family: var(--h-font);
  font-size: clamp(2rem, 3.4vw, 3rem);
  font-weight: var(--h-weight-display);
  line-height: 1.04;
  letter-spacing: -0.035em;
  color: var(--h-ink);
  text-wrap: balance;
}
.mp__type {
  display: block;
  margin-bottom: 0.625rem;
  font-size: 0.9375rem;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0;
  color: var(--h-muted);
}
.mp__muted { color: var(--h-muted); }

/* Короткие характеристики — две колонки с волосяными линиями */
.mp__facts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 var(--h-gutter);
  margin: 0;
  border-top: 0.0625rem solid var(--h-rule);
}
.mp__fact { padding: 0.75rem 0; border-bottom: 0.0625rem solid var(--h-rule); }
.mp__fact dt { font-size: 0.8125rem; color: var(--h-muted); }
.mp__fact dd { margin: 0.125rem 0 0; font-size: 1.0625rem; font-weight: 600; line-height: 1.3; color: var(--h-ink); }
.mp__fact a { color: inherit; text-decoration: underline; text-decoration-color: var(--color-slate-300); text-underline-offset: 0.2em; }
.mp__fact a:hover { color: var(--h-signal); text-decoration-color: currentColor; }
.mp__landing { margin: 1rem 0 0; font-size: 0.9375rem; }
.mp__landing a { color: var(--h-ink); font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-slate-300); text-underline-offset: 0.25em; }
.mp__landing a:hover { color: var(--h-signal); text-decoration-color: currentColor; }

/* ── Характеристики ── */
.mp-spec { display: grid; gap: 1.5rem var(--h-gutter); align-items: start; }
.mp-spec__note { margin-top: 1rem; max-width: 26em; }
.mp-spec__list { border-top: 0.0625rem solid var(--h-rule); }
.mp-spec__row { --mp-fold: open; display: flow-root; border-bottom: 0.0625rem solid var(--h-rule); }
.mp-spec__label { color: var(--h-muted); list-style: none; }
.mp-spec__label::-webkit-details-marker { display: none; }
.mp-spec__value { color: var(--h-ink); line-height: 1.6; }
.mp-spec__value p { margin: 0; }
.mp-spec__features { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
.mp-spec__features li { position: relative; padding-left: 1rem; }
.mp-spec__features li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.8em;
  width: 0.375rem;
  height: 0.0625rem;
  background: currentColor;
}
/* Компьютер и планшет: название слева, текст справа — таблица */
@media (min-width: 43.75rem) {
  .mp-spec__row { padding: 1rem 0; }
  .mp-spec__label { float: left; width: 28%; padding-right: 1.5rem; pointer-events: none; }
  .mp-spec__value { margin-left: 28%; }
}
/* Телефон: свёрнутые строки с шевроном, как погонаж ниже */
@media (max-width: 43.6875rem) {
  .mp-spec__row { --mp-fold: closed; }
  .mp-spec__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    font-weight: 600;
    color: var(--h-ink);
    cursor: pointer;
  }
  .mp-spec__label::after {
    content: '';
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 0.125rem solid currentColor;
    border-bottom: 0.125rem solid currentColor;
    transform: translateY(-0.125rem) rotate(45deg);
  }
  .mp-spec__row[open] > .mp-spec__label::after { transform: translateY(0.125rem) rotate(-135deg); }
  .mp-spec__value { padding-bottom: 1.125rem; color: var(--h-soft); }
  .mp-spec__row--short { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .mp-spec__row--short .mp-spec__label { margin: 0; cursor: default; }
  .mp-spec__row--short .mp-spec__label::after { content: none; }
  .mp-spec__row--short .mp-spec__value { padding-bottom: 0; color: var(--h-ink); }
}
.mp-spec__row--short .mp-spec__label { margin: 0; }
.mp-spec__label:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.25rem; border-radius: 0.25rem; }
@media (min-width: 56.25rem) {
  .mp-spec { grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .mp-spec__intro { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-height) + 1.5rem); }
  .mp-spec__list { grid-column: 6 / span 7; }
}

/* ── Погонаж: аккордеон с волосяными линиями, как частые вопросы ── */
.mp-acc { display: grid; gap: 1.5rem var(--h-gutter); align-items: start; }
.mp-acc__note { margin-top: 1rem; max-width: 34em; }
.mp-acc__groups { border-top: 0.0625rem solid var(--h-rule); }
.mp-acc__group { border-bottom: 0.0625rem solid var(--h-rule); }
.mp-acc__label {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1.125rem 0;
  font-size: 1.1875rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--h-ink);
  cursor: pointer;
  list-style: none;
}
.mp-acc__label::-webkit-details-marker { display: none; }
.mp-acc__label:hover { color: var(--h-signal); }
.mp-acc__label:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.25rem; border-radius: 0.25rem; }
.mp-acc__count { font-size: 0.875rem; font-weight: 500; color: var(--h-muted); font-variant-numeric: tabular-nums; }
.mp-acc__label::after {
  content: '';
  flex-shrink: 0;
  width: 0.5625rem;
  height: 0.5625rem;
  margin-left: auto;
