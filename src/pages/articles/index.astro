---
/**
 * /articles/ — «Статьи и публикации». Дизайн-система главной: шапка как
 * у LandingHero без фото, первая (свежая) статья — крупной карточкой,
 * остальные — сеткой. Только опубликованные (src/lib/articles.ts);
 * пока их нет — раздел закрыт noindex.
 *
 * Разметка: CollectionPage + ItemList статей; хлебные крошки — Breadcrumbs.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import ArticleCard from '../../components/articles/ArticleCard.astro'
import { getArticles, articleHref } from '../../lib/articles'
import { ARTICLES_SECTION } from '../../data/article-kinds'
import { SITE } from '../../config/site'
import { typograph } from '../../lib/typograph'
import '../../styles/home.css'

const articles = await getArticles()
const [first, ...rest] = articles
const pageUrl = new URL('/articles/', SITE.url).href

const title = `${ARTICLES_SECTION} о дверях | ${SITE.name} ${SITE.city.in}`
const description =
  `Статьи о выборе межкомнатных дверей, покрытиях и монтаже, новости и новинки салона ${SITE.studioName} в ${SITE.address.mall}, ${SITE.city.name}.`
const lead = 'Разбираем выбор дверей, покрытия и монтаж, рассказываем о новинках фабрики и событиях салона.'

const structuredData = articles.length ? [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#page`,
  name: ARTICLES_SECTION,
  description,
  url: pageUrl,
  inLanguage: 'ru-RU',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(articleHref(a.id), SITE.url).href,
      name: a.data.title,
    })),
  },
}] : []
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  structuredData={structuredData}
  noIndex={articles.length === 0}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: ARTICLES_SECTION }]} />
    </div>
  </div>

  <div class="home">
    <section class="ah" aria-labelledby="articles-title">
      <div class="container">
        <header class="ah__head">
          <h1 id="articles-title" class="ah__title">{ARTICLES_SECTION}</h1>
          <p class="h-lead ah__lead">{typograph(lead)}</p>
        </header>

        {first ? (
          <>
            <ArticleCard article={first} feature loading="eager" heading="h2" />
            {rest.length > 0 && (
              <ul class="ah__list h-rail" role="list">
                {rest.map((a) => <li><ArticleCard article={a} heading="h2" /></li>)}
              </ul>
            )}
          </>
        ) : (
          <p class="h-body">Материалы появятся совсем скоро.</p>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .ah { padding-block: clamp(1rem, 2vw, 1.5rem) var(--h-sec); }
  .ah__head {
    display: grid;
    gap: 1.25rem var(--h-gutter);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 62.5rem) {
    .ah__head { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .ah__title { grid-column: 1 / span 7; }
    .ah__lead  { grid-column: 9 / span 4; }
  }
  .ah__title {
    margin: 0;
    font-family: var(--h-font);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--h-weight-display);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--h-ink);
    text-wrap: balance;
  }
  .ah__list {
    display: grid;
    gap: 3rem var(--h-gutter);
    margin: clamp(3rem, 5vw, 4.5rem) 0 0;
    padding: clamp(2rem, 4vw, 3rem) 0 0;
    list-style: none;
    border-top: 0.0625rem solid var(--h-rule);
  }
  @media (min-width: 43.75rem) { .ah__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 62.5rem) { .ah__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
