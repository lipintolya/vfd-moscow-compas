---
/**
 * /contacts/ — контакты салона в дизайн-системе главной (home.css):
 * первый экран с тремя плитками (звонок, адрес, Telegram-канал),
 * «Что вы получаете», способы оплаты, частые вопросы и в конце
 * «Как к нам добраться» (VisitBand — своя карта и фото ТЦ).
 * Реквизиты юрлица не публикуются: владелец сайта — физлицо
 * (src/lib/contacts-data.ts). Тексты — src/data/contacts-page.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import { brandTitle } from '../lib/seo-title'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../components/ui/FaqAccordion.astro'
import VisitBand from '../components/home/VisitBand.astro'
import PaymentMethods from '../components/contacts/PaymentMethods.astro'
import { companyLegalInfo, HAS_EMAIL } from '../lib/contacts-data'
import { localBusinessSchema, LOCAL_BUSINESS_ID } from '../lib/local-business-schema'
import { CONTACTS_INTRO, BENEFITS, CONTACTS_FAQ, SALON } from '../data/contacts-page'
import { PRICES_DATE_LABEL } from '../data/services'
import { SITE, PHONE } from '../config/site'
import { WHATSAPP, whatsappUrl, TELEGRAM_CHAT, telegramChatUrl } from '../lib/messengers'
import WhatsAppIcon from '../components/ui/WhatsAppIcon.vue'
import TelegramIcon from '../components/ui/TelegramIcon.vue'
import { typograph } from '../lib/typograph'
import '../styles/home.css'

const title = brandTitle(`Контакты — салон дверей ${SITE.name} в ${SITE.address.mall}, ${SITE.city.name}`)
const description =
  `Салон дверей ${SITE.name} в ${SITE.address.mall}: ${SITE.address.street}, ${SITE.address.floor}. ` +
  `${companyLegalInfo.workingHours.shortDisplay}. Схема проезда, замер и монтаж по Москве и области.`
const pageUrl = new URL('/contacts/', SITE.url).href

const hours = companyLegalInfo.workingHours

const structuredData = [
  localBusinessSchema({ url: pageUrl }),
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    url: pageUrl,
    name: title,
    about: { '@id': LOCAL_BUSINESS_ID },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: CONTACTS_FAQ.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
]

/* Фото «Что вы получаете»: пока их нет — на сайте карточки без фото,
   в режиме разработки на их месте рамки */
const showPhotoSlots = import.meta.env.DEV
const hasPrices = BENEFITS.some((b) => b.price)

const arrow = '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Контакты' },
]
---

<BaseLayout title={title} description={description} canonical={pageUrl} structuredData={structuredData}>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="home">
    {/* Первый экран: заголовок и три способа связаться. Красная плитка —
         главное действие (звонок), она одна на экране */}
    <section class="ct-intro" aria-labelledby="ct-title">
      <div class="container">
        <header class="h-head ct-head">
          <h1 id="ct-title" class="ct-title">{typograph(CONTACTS_INTRO.title)}</h1>
          <p class="h-lead">{typograph(CONTACTS_INTRO.lead)}</p>
        </header>

        <ul class="ct-tiles" role="list">
          <li>
            <a href={`tel:${PHONE.raw}`} class="h-tile h-tile--signal ct-tile">
              <span class="h-tile__corner h-arrow h-arrow--white" aria-hidden="true"><Fragment set:html={arrow} /></span>
              <span class="ct-tile__label">Позвонить</span>
              <span class="ct-tile__phone">{PHONE.label}</span>
              <span class="h-cap">Городской номер салона</span>
            </a>
          </li>
          {WHATSAPP && (
            <li>
              <a href={whatsappUrl()} target="_blank" rel="noopener" class="h-tile h-tile--light ct-tile ct-tile--half" aria-label={`Написать в WhatsApp на ${WHATSAPP.label}`}>
                <span class="h-tile__corner h-arrow" aria-hidden="true"><Fragment set:html={arrow} /></span>
                <span class="ct-tile__label ct-tile__label--icon"><WhatsAppIcon class="ct-tile__ico" />WhatsApp</span>
                <span class="h-tile__title">Написать</span>
                <span class="h-cap">{WHATSAPP.label}</span>
              </a>
            </li>
          )}
          {TELEGRAM_CHAT && (
            <li>
              <a href={telegramChatUrl()} target="_blank" rel="noopener" class="h-tile h-tile--light ct-tile ct-tile--half" aria-label={`Написать в Telegram: @${TELEGRAM_CHAT}`}>
                <span class="h-tile__corner h-arrow" aria-hidden="true"><Fragment set:html={arrow} /></span>
                <span class="ct-tile__label ct-tile__label--icon"><TelegramIcon class="ct-tile__ico" />Telegram</span>
                <span class="h-tile__title">Написать</span>
                <span class="h-cap">@{TELEGRAM_CHAT}</span>
              </a>
            </li>
          )}
          <li class="ct-tiles__salon">
            <a href="#visit" class="h-tile h-tile--dark ct-tile">
              <span class="h-tile__corner h-arrow h-arrow--white" aria-hidden="true"><Fragment set:html={arrow} /></span>
              <span class="ct-tile__label">Салон</span>
              <span class="h-tile__title">{typograph(`${SITE.address.mall}, ${SITE.address.floor}`)}</span>
              {/* Адрес и часы — отдельными строками: время не разрывается */}
              <span class="h-cap ct-tile__cap">
                <span>{SITE.address.street}</span>
                <span class="ct-tile__hours">{hours.shortDisplay}</span>
              </span>
            </a>
          </li>
        </ul>
        {/* Канал — читать, не писать: отдельной строкой под плитками */}
        <p class="h-body ct-channel">
          Новинки, работы и&nbsp;акции салона&nbsp;— в&nbsp;Telegram-канале{' '}
          <a href={SITE.social.telegram} target="_blank" rel="noopener" class="h-link">{SITE.social.telegramHandle}</a>
        </p>
        {HAS_EMAIL && (
          <p class="h-body ct-channel">
            Письма — на почту{' '}
            <a href={`mailto:${SITE.email}`} class="h-link">{SITE.email}</a>
          </p>
        )}
      </div>
    </section>

    {/* Как выглядит салон — сразу под способами связаться: продолжает
         первый экран (тот же фон, без отступа сверху). ПК — вход крупно
         2×2, рядом колонка «вход» и колонка «консультация»; телефон —
         лента со свайпом. Клик — окно просмотра со всеми кадрами */}
    <section class="h-sec h-sec--tight-top" id="salon" aria-labelledby="ct-salon-title">
      <div class="container">
        <header class="h-head">
          <h2 id="ct-salon-title" class="h-h2">{SALON.title}</h2>
          <p class="h-lead">{typograph(SALON.lead)}</p>
        </header>
        <div data-lightbox data-lightbox-images={JSON.stringify(SALON.photos.map((p) => ({ src: p.large, alt: p.alt })))}>
          <ul class="ct-salon h-rail" role="list">
            {SALON.preview.map((n, i) => {
              const index = SALON.photos.findIndex((p) => p.n === n)
              const p = SALON.photos[index]!
              return (
                <li class="ct-salon__item">
                  <button type="button" class="h-media ct-salon__zoom" aria-label={`Открыть фото: ${p.alt}`} data-lightbox-index={index}>
                    <img
                      src={p.src}
                      srcset={p.srcset}
                      sizes={i === 0
                        ? '(min-width: 80rem) 37rem, (min-width: 43.75rem) 50vw, 82vw'
                        : '(min-width: 80rem) 18rem, (min-width: 43.75rem) 25vw, 82vw'}
                      alt={p.alt}
                      width={p.width}
                      height={p.height}
                      loading="lazy"
                      decoding="async"
                    />
                    {p.chip && <span class="h-chip ct-salon__chip" aria-hidden="true">{p.chip}</span>}
                  </button>
                </li>
              )
            })}
          </ul>
          <button type="button" class="h-btn h-btn--quiet ct-salon__all" data-lightbox-index="0">
            Смотреть все {SALON.photos.length} фото
          </button>
        </div>
      </div>
    </section>

    {/* Что вы получаете: подпись под фото, как табличка у образца */}
    <section class="h-sec h-sec--wall" aria-labelledby="ct-benefits-title">
      <div class="container">
        <header class="h-head">
          <h2 id="ct-benefits-title" class="h-h2">Что вы получаете</h2>
          <p class="h-lead">От первой консультации до гарантии — без посредников и субподрядчиков.</p>
        </header>

        <ul class="ct-benefits" role="list">
          {BENEFITS.map((b, i) => (
            <li class="ct-benefit" data-benefit>
              {b.photo ? (
                <span class="h-media ct-benefit__photo">
                  <img
                    src={b.photo.src}
                    srcset={b.photo.srcset}
                    sizes="(min-width: 56.25rem) 46vw, 100vw"
                    alt={b.photo.alt}
                    width={b.photo.width}
                    height={b.photo.height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              ) : showPhotoSlots && (
                <span class="ct-benefit__photo ct-benefit__photo--slot" aria-hidden="true">Фото {i + 1}</span>
              )}
              <h3 class="h-h3 ct-benefit__title">{b.title}</h3>
              <p class="h-body ct-benefit__text">{typograph(b.text)}</p>
              {b.price && (
                <p class="ct-benefit__price">
                  <span class="ct-benefit__value">{b.price.value}<a href="#ct-prices-note" class="ct-benefit__mark" aria-label="Примечание о ценах">*</a></span>
                  <span class="h-meta">{typograph(b.price.note)}</span>
                </p>
              )}
            </li>
          ))}
        </ul>

        {hasPrices && (
          <p id="ct-prices-note" class="h-meta ct-note">
            * Цены на&nbsp;услуги актуальны на&nbsp;{typograph(PRICES_DATE_LABEL)} Точную стоимость
            рассчитаем на&nbsp;консультации в&nbsp;салоне.
          </p>
        )}

        {(SITE.features.portfolio || SITE.features.reviews) && (
          <div class="ct-links">
            {SITE.features.portfolio && <a href="/portfolio/" class="h-btn h-btn--quiet">Смотреть наши работы</a>}
            {SITE.features.reviews && <a href="/reviews/" class="h-btn h-btn--quiet">Читать отзывы</a>}
          </div>
        )}
      </div>
    </section>

    {/* Способы оплаты — только названия, с анимированными иконками */}
    <section class="h-sec" aria-labelledby="ct-pay-title">
      <div class="container">
        <header class="h-head">
          <h2 id="ct-pay-title" class="h-h2">Способы оплаты</h2>
        </header>
        <PaymentMethods />
      </div>
    </section>

    <section class="h-sec h-sec--wall" aria-labelledby="ct-faq-title">
      <div class="container">
        <header class="h-head">
          <h2 id="ct-faq-title" class="h-h2">Частые вопросы</h2>
        </header>
        <FaqAccordion items={CONTACTS_FAQ} title={false} />
      </div>
    </section>

    {/* Как к нам добраться — в конце страницы, как на остальных страницах;
         на него ведёт тёмная плитка «Салон» в первом экране (#visit) */}
    <VisitBand lead="Приходите без записи — салон работает без выходных. Если нужны образцы под ваш проект, предупредите заранее по телефону." />
  </div>
</BaseLayout>

<script>
  import { initLightboxGroups } from '../lib/lightbox'

  /* Фото входа и места консультации — окно просмотра */
  initLightboxGroups()

  /* «Что вы получаете» — каждая карточка появляется один раз, когда сама
     доходит до экрана: на телефоне они идут одна под другой, и общий
     запуск проигрывал бы нижние карточки за пределами экрана. Карточки,
     вошедшие в экран вместе (ряд на ПК), идут по очереди — задержка по
     порядку внутри пачки (--t). Скрываем только то, что ниже экрана:
     без JS, при reduced-motion и при переходе по якорю всё сразу видно. */
  const cards = [...document.querySelectorAll<HTMLElement>('[data-benefit]')]
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches
  if (!still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries
        .filter((e) => e.isIntersecting)
        .forEach((e, k) => {
          const card = e.target as HTMLElement
          card.style.setProperty('--t', `${k * 160}ms`)
          card.dataset.benefit = 'shown'
          io.unobserve(card)
        })
    }, { rootMargin: '0px 0px -15% 0px' })
    for (const card of cards) {
      if (card.getBoundingClientRect().top < innerHeight * 0.85) continue
      card.dataset.benefit = 'hidden'
      io.observe(card)
    }
  }
</script>

<style>
  .ct-intro { padding-block: clamp(1rem, 2vw, 1.5rem) var(--h-sec); }
  .ct-head { margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem); }
  .ct-title {
    margin: 0;
    font-family: var(--h-font);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--h-weight-display);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--h-ink);
    text-wrap: balance;
  }

  /* ── Плитки связи: телефон — две колонки, адрес и канал — по одной ── */
  .ct-tiles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--h-tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Телефон: «Позвонить» во всю ширину, WhatsApp и Telegram — рядом
     (написать — короткие плитки), «Салон» — во всю ширину.
     Планшет — 2×2, компьютер — в ряд, «Позвонить» шире */
  .ct-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ct-tiles > li:first-child, .ct-tiles__salon { grid-column: 1 / -1; }
  @media (min-width: 47.5rem) {
    .ct-tiles > li:first-child, .ct-tiles__salon { grid-column: auto; }
  }
  .ct-channel { margin-top: 1.25rem; font-size: 0.9375rem; }
  @media (min-width: 68.75rem) { .ct-tiles { grid-template-columns: 1.5fr repeat(3, minmax(0, 1fr)); } }
  .ct-tile { min-height: clamp(11rem, 18vw, 15rem); }
  .ct-tile__label--icon { display: inline-flex; align-items: center; gap: 0.4375rem; }
  :global(.ct-tile__ico) { width: 1.25rem; height: 1.25rem; flex: none; }
  @media (max-width: 47.4375rem) {
    /* Мессенджеры на телефоне — две плитки рядом: ниже, без угловой
       стрелки (вся плитка — ссылка, стрелке места нет) */
    .ct-tile--half { min-height: 9rem; }
    .ct-tile--half .h-tile__corner { display: none; }
  }
  .ct-tile__cap { display: flex; flex-direction: column; gap: 0.125rem; }
  .ct-tile__hours { white-space: nowrap; }
  .ct-tile__label {
    margin-bottom: auto;
    font-size: 0.875rem;
    font-weight: 600;
    opacity: 0.8;
  }
  /* Номер — крупная цифра: вес 300, табличные цифры (принцип 5) */
  .ct-tile__phone {
    font-size: clamp(1.75rem, 4.2vw, 3.25rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* ── Что вы получаете ── */
  /* ── Как выглядит салон ──
     ПК и планшет: 4 колонки × 2 ряда, кадры 3:4. Вход (1-й) — 2×2 слева;
     колонка 3 — дверь входа (2-й, внизу) и вид внутрь (3-й, вверху),
     колонка 4 — место консультации (4-й и 5-й). Телефон — лента (.h-rail) */
  .ct-salon {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--h-tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ct-salon__item { aspect-ratio: 3 / 4; }
  @media (min-width: 43.75rem) {
    .ct-salon__item:nth-child(1) { position: relative; grid-area: 1 / 1 / span 2 / span 2; aspect-ratio: auto; }
    .ct-salon__item:nth-child(1) .ct-salon__zoom { position: absolute; inset: 0; }
    .ct-salon__item:nth-child(2) { grid-area: 2 / 3; }
    .ct-salon__item:nth-child(3) { grid-area: 1 / 3; }
    .ct-salon__item:nth-child(4) { grid-area: 1 / 4; }
    .ct-salon__item:nth-child(5) { grid-area: 2 / 4; }
  }
  .ct-salon__zoom {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: zoom-in;
  }
  .ct-salon__zoom img { transition: transform 700ms var(--ease-out); }
  .ct-salon__zoom:hover img { transform: scale(1.025); }
  .ct-salon__zoom:focus-visible { outline: 0.125rem solid var(--color-secondary-500); outline-offset: 0.1875rem; }
  /* Плашка на фото — что это за место */
  .ct-salon__chip { position: absolute; left: clamp(0.75rem, 1.4vw, 1rem); bottom: clamp(0.75rem, 1.4vw, 1rem); max-width: calc(100% - 1.5rem); overflow: hidden; text-overflow: ellipsis; }
  .ct-salon__all { margin-top: 1.5rem; background: none; font-family: inherit; cursor: pointer; }
  @media (max-width: 43.6875rem) {
    .ct-salon__all { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ct-salon__zoom img { transition: none; }
    .ct-salon__zoom:hover img { transform: none; }
  }

  .ct-benefits {
    display: grid;
    gap: 2.5rem var(--h-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Четыре карточки — две колонки: без пустой строки из одной карточки */
  @media (min-width: 56.25rem) { .ct-benefits { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .ct-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; margin-top: 2.5rem; }
  /* Карточка «фото + подпись», как табличка у образца: фото сверху,
     заголовок и текст под ним; цена прижата к низу — у соседних карточек
     на одной линии. Без фото — линейка сверху вместо него. */
  .ct-benefit { display: flex; flex-direction: column; }
  .ct-benefit:not(:has(.ct-benefit__photo)) { padding-top: 1.25rem; border-top: 0.0625rem solid var(--h-rule); }
  .ct-benefit__photo { display: block; aspect-ratio: 4 / 3; margin-bottom: 1.125rem; }
  .ct-benefit__photo img { width: 100%; height: 100%; object-fit: cover; }
  /* Рамка-заглушка — только в режиме разработки */
  .ct-benefit__photo--slot {
    display: grid;
    place-items: center;
    border: 0.125rem dashed var(--h-rule);
    border-radius: var(--h-radius);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--h-muted);
  }
  .ct-benefit__text { margin-top: 0.75rem; font-size: 0.9375rem; max-width: 26rem; }

  /* ── Появление карточек ──
     Фото открывается шторкой снизу вверх (clip-path со скруглением как
     у подложки) и одновременно «садится» из лёгкого увеличения; подпись
     поднимается следом. Ряд карточек — по очереди (--t ставит скрипт).
     Только clip-path,
     opacity и transform — без пересчёта вёрстки. */
  .ct-benefit { --t: 0ms; }
  .ct-benefit__photo {
    clip-path: inset(0 0 0 0 round var(--h-radius));
    transition: clip-path 900ms var(--ease-out) var(--t);
  }
  .ct-benefit__photo img { transition: scale 1300ms var(--ease-out) var(--t); }
  .ct-benefit > :not(.ct-benefit__photo) {
    transition:
      opacity 600ms var(--ease-out) calc(var(--t) + 350ms),
      translate 600ms var(--ease-out) calc(var(--t) + 350ms);
  }
  [data-benefit='hidden'] .ct-benefit__photo { clip-path: inset(100% 0 0 0 round var(--h-radius)); }
  [data-benefit='hidden'] .ct-benefit__photo img { scale: 1.08; }
  .ct-benefit[data-benefit='hidden'] > :not(.ct-benefit__photo) { opacity: 0; translate: 0 0.75rem; }

  @media (prefers-reduced-motion: reduce) {
    .ct-benefit__photo, .ct-benefit__photo img, .ct-benefit > :not(.ct-benefit__photo) { transition: none; }
  }
  /* Планшет (одна колонка карточек): фото во всю ширину было бы огромным —
     карточка горизонтальная, фото слева, подпись справа */
  @media (min-width: 43.75rem) and (max-width: 56.1875rem) {
    .ct-benefit {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-rows: auto auto 1fr;
      column-gap: var(--h-gutter);
      align-content: start;
