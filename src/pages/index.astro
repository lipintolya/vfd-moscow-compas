---
/**
 * src/pages/index.astro — Главная страница
 * Header больше не нужен здесь — он подключён в BaseLayout.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/home.css'
import { HERO_COVER_IMAGE } from '../data/hero-image'
import ShowroomHero from '../components/home/ShowroomHero.astro'
import Directions from '../components/home/Directions.astro'
import Videos from '../components/home/Videos.astro'
import InSalon from '../components/home/InSalon.astro'
import StepsRow from '../components/home/StepsRow.astro'
import VisitBand from '../components/home/VisitBand.astro'
import Promo from '../components/home/Promo.vue'
import OurWorks from '../components/home/OurWorks.astro'
import LatestArticles from '../components/home/LatestArticles.astro'
import FaqAccordion from '../components/ui/FaqAccordion.astro'
import { faqs } from '../components/home/faq-data'
import { howToSchema } from '../data/how-it-works'
import { getCatalogCards } from '../lib/catalog-data'
import { localBusinessSchema as buildLocalBusiness } from '../lib/local-business-schema'
import { PHONE, SITE } from '../config/site'

const faqItems = faqs.map(f => ({ q: f.question, a: f.answer }))

/* Адрес страницы модели по её id — из того же Supabase-каталога, что
   /catalog/. Нужен блоку «Новинки и двери в наличии» (src/data/in-salon.ts) */
const { cards: catalogCards } = await getCatalogCards()
const modelHref = (id: string) => {
  const card = catalogCards.find(c => c.id === id)
  return card ? `/models/${card.slug}/` : null
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
}

const localBusinessSchema = buildLocalBusiness()
---

<BaseLayout
  title={`Шоурум дверей ${SITE.name} ${SITE.city.in}, ${SITE.address.okrug} — межкомнатные и скрытые двери`}
  description={`Официальный дилер ${SITE.manufacturerOf} ${SITE.city.in}: шоурум в ${SITE.address.mall}, ${SITE.address.street}. Межкомнатные и скрытые двери, перегородки, замер и монтаж.`}
  structuredData={[faqSchema, localBusinessSchema, howToSchema]}
  preloadImage={HERO_COVER_IMAGE}
  ogImage={HERO_COVER_IMAGE}
>
  <div class="home">
    <ShowroomHero />
    <Directions />
    <Videos />
    <InSalon modelHref={modelHref} />
    <StepsRow />
    <LatestArticles />
    <VisitBand />
    <Promo client:idle />
    <OurWorks />

    <section class="h-sec h-sec--tight-top" aria-label="Частые вопросы">
      <div class="container">
        <div class="faq">
          <FaqAccordion items={faqItems} />
        </div>

        <div class="ask">
          <div>
            <h3 class="h-h3">Не нашли ответ?</h3>
            <p class="h-body ask__text">Позвоните: {SITE.contactPerson} ответит на&nbsp;вопросы о&nbsp;моделях, размерах и&nbsp;сроках.</p>
          </div>
          <div class="ask__actions">
            <a href={`tel:${PHONE.raw}`} class="h-btn h-btn--signal">Позвонить {PHONE.label}</a>
            <a href={SITE.social.telegram} target="_blank" rel="noopener" class="h-btn h-btn--quiet">Telegram-канал</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* FAQ — журнальная раскладка: заголовок в левых 4 колонках,
     вопросы — в правых 8. FaqAccordion отдаёт h2 и список соседями,
     поэтому они сами становятся ячейками сетки. */
  .faq {
    display: grid;
    gap: 1.5rem var(--h-gutter);
    padding-top: var(--h-sec);
    border-top: 0.0625rem solid var(--h-rule);
  }
  @media (min-width: 62.5rem) {
    .faq { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; }
    .faq > :global(.faq-h2) { grid-column: 1 / span 4; }
    .faq > :global(.faq-list) { grid-column: 5 / span 8; }
  }
  .faq > :global(.faq-h2) {
    margin: 0;
    font-family: var(--h-font);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--h-ink);
  }

  .ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 2rem;
    border-top: 0.0625rem solid var(--h-rule);
  }
  @media (min-width: 62.5rem) {
    .ask { margin-left: calc((100% + var(--h-gutter)) / 3); }
  }
  .ask__text { margin-top: 0.375rem; }
  .ask__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (max-width: 29.9375rem) {
    .ask__actions { width: 100%; }
    .ask__actions > a { flex: 1 1 100%; }
  }
</style>
