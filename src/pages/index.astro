---
/**
 * src/pages/index.astro — Главная страница
 * Header больше не нужен здесь — он подключён в BaseLayout.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/home.css'
import { HERO_COVER_IMAGE } from '../data/hero-image'
import { buildFinder } from '../data/home-finder'
import ShowroomHero from '../components/home/ShowroomHero.astro'
import Directions from '../components/home/Directions.astro'
import InSalon from '../components/home/InSalon.astro'
import StepsRow from '../components/home/StepsRow.astro'
import VisitBand from '../components/home/VisitBand.astro'
import Promo from '../components/home/Promo.vue'
import LatestArticles from '../components/home/LatestArticles.astro'
import FaqAccordion from '../components/ui/FaqAccordion.astro'
import { faqs } from '../components/home/faq-data'
import { howToSchema } from '../data/how-it-works'
import { getCatalogCards } from '../lib/catalog-data'
import { calcKitPrice } from '../data/accessories'
import { localBusinessSchema as buildLocalBusiness } from '../lib/local-business-schema'
import { PHONE, SITE } from '../config/site'

const faqItems = faqs.map(f => ({ q: f.question, a: f.answer }))

/* Цена промо-плитки «Техно» — живой запрос к тому же Supabase-каталогу,
   что и /catalog/ (getCatalogCards), а не число в коде: обложка карточки
   у "Техно 1" уже переставлена на цвет из наличия (см. withInStockFirst
   в catalog-data.ts), так что card.price/card.colorName здесь — это именно
   белый. Комплект считаем той же формулой, что везде (calcKitPrice). */
const { cards: catalogCards } = await getCatalogCards()
const tehnoCard = catalogCards.find(c => c.seriesSlug === 'tehno' && c.name === 'Техно 1')
const tehnoBladePrice = tehnoCard?.price ?? null
const tehnoKitPrice = tehnoCard?.price
  ? tehnoCard.price + calcKitPrice(tehnoCard.coatingSlug, tehnoCard.colorName)
  : null

/* Промо «Урбан Штрих 2А» (бежевый, чёрный молдинг — в наличии) — та же схема.
   Ищем по id модели: записей «Штрих 2А» две (чёрный и золотой молдинг).
   Обложка карточки уже переставлена на бежевый из наличия (IN_STOCK_OVERRIDE
   в made-to-order.ts), поэтому card.price/colorName — именно он. */
const SHTRIH_2A_ID = '7434f55c-b2a8-4f12-b0c6-56c7c57888eb'
const shtrihCard = catalogCards.find(c => c.id === SHTRIH_2A_ID)
const shtrihBladePrice = shtrihCard?.price ?? null
const shtrihKitPrice = shtrihCard?.price
  ? shtrihCard.price + calcKitPrice(shtrihCard.coatingSlug, shtrihCard.colorName)
  : null
const shtrihHref = shtrihCard ? `/models/${shtrihCard.slug}/` : null

/* Первый экран: панель подбора (см. home-finder.ts), число моделей и
   минимальная цена межкомнатных — из того же запроса каталога. */
const finder = buildFinder(catalogCards)
const interiorPrices = catalogCards.map(c => c.price).filter((p): p is number => p != null)
const interiorMinPrice = interiorPrices.length ? Math.min(...interiorPrices) : null

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
}

const localBusinessSchema = buildLocalBusiness()
---

<BaseLayout
  title="ВФД Москва — салон дверей в ТЦ «Компас»"
  description="ВФД Москва — фирменный салон в ТЦ «Компас» (ул. Красная Сосна, 2А): межкомнатные и скрытые двери, алюминиевые перегородки. Каталог и цены, бесплатный замер межкомнатных дверей при заказе, установка."
  structuredData={[faqSchema, localBusinessSchema, howToSchema]}
  preloadImage="/renders/hero/designers-hero.webp"
  preloadImageSrcset="/renders/hero/designers-hero-960.webp 960w, /renders/hero/designers-hero.webp 1672w"
  preloadImageSizes="(min-width: 1280px) 1216px, 100vw"
  ogImage={HERO_COVER_IMAGE}
>
  <div class="home">
    <ShowroomHero finder={finder} modelCount={catalogCards.length} minPrice={interiorMinPrice} />
    <Directions interiorMinPrice={interiorMinPrice} modelCount={catalogCards.length} />
    <InSalon
      tehnoBlade={tehnoBladePrice}
      tehnoKit={tehnoKitPrice}
      shtrihHref={shtrihHref}
      shtrihBlade={shtrihBladePrice}
    />
    <StepsRow />
    <VisitBand />
    <Promo client:idle />
    <LatestArticles />

    <section class="h-sec h-sec--tight-top" aria-label="Частые вопросы">
      <div class="container">
        <div class="faq">
          <FaqAccordion items={faqItems} />
        </div>

        <div class="ask">
          <div>
            <h2 class="h-h3">Не нашли ответ?</h2>
            <p class="h-body ask__text">Позвоните — {SITE.contactPerson} подскажет по моделям, размерам и срокам.</p>
          </div>
          <div class="ask__actions">
            <a href={`tel:${PHONE.raw}`} class="h-btn h-btn--ink">Позвонить {PHONE.label}</a>
            <a href={SITE.social.telegram} target="_blank" rel="noopener" class="h-btn h-btn--quiet">Telegram-канал</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* FAQ — журнальная раскладка: заголовок в левых 4 колонках,
     вопросы — в правых 8. FaqAccordion отдаёт h2 и список соседями,
     поэтому они сами становятся ячейками сетки. */
  .faq {
    display: grid;
    gap: 1.5rem var(--h-gutter);
    padding-top: var(--h-sec);
    border-top: 1px solid var(--h-rule);
  }
  @media (min-width: 1000px) {
    .faq { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; }
    .faq > :global(.faq-h2) { grid-column: 1 / span 4; }
    .faq > :global(.faq-list) { grid-column: 5 / span 8; }
  }
  .faq > :global(.faq-h2) {
    margin: 0;
    font-family: var(--h-font);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--h-ink);
  }

  .ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--h-rule);
  }
  @media (min-width: 1000px) {
    .ask { margin-left: calc((100% + var(--h-gutter)) / 3); }
  }
  .ask__text { margin-top: 0.375rem; }
  .ask__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
