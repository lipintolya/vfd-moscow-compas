---
/**
 * /partitions/oniks-alum/ — перегородки ALUM фабрики ОНИКС, коллаборация
 * со Студией Зизевского. Отдельно от /partitions/ (системы GRAFIA), но в
 * дизайн-системе главной (home.css).
 *
 * Порядок: первый экран (кто делает перегородки и кто их рассчитывает —
 * словами во вводке) → конструктор (раскладка, профиль, стекло —
 * OniksBuilder) → фото фабрики лентой, «Собрать такую» подставляет
 * отделку в конструктор → характеристики и материалы фабрики → как
 * заказать (StepsRow) → статьи по теме → вопросы → как добраться.
 *
 * Тексты, цифры и фото — src/data/oniks-alum.ts (в разметке — только
 * подписи кнопок), исходники фото — assets/oniks-alum/ (README там же)
 * → npm run gen:oniks. Салон — из src/config/site.ts.
 *
 * Для поисковиков: Service с брендом ОНИКС и салоном-исполнителем,
 * FAQPage, хлебные крошки, LocalBusiness. Все фото открываются во весь
 * экран (ArticleLightbox, data-zoom).
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../../components/ui/FaqAccordion.astro'
import SectionNav from '../../components/partitions/SectionNav.astro'
import OniksBuilder from '../../components/partitions/OniksBuilder.astro'
import StepsRow from '../../components/home/StepsRow.astro'
import VisitBand from '../../components/home/VisitBand.astro'
import ArticleCard from '../../components/articles/ArticleCard.astro'
import ArticleNav from '../../components/articles/ArticleNav.astro'
import ArticleLightbox from '../../components/articles/ArticleLightbox.astro'
import '../../styles/home.css'
import {
  ONIKS, ONIKS_PAGE, ONIKS_FACTS, ONIKS_LAYOUT_COUNT, ONIKS_HERO, ONIKS_SECTIONS as SEC,
  ONIKS_MODELS, ONIKS_MODEL_IMAGE, ONIKS_SPECS, ONIKS_KIT, ONIKS_COMPONENTS, ONIKS_OPTI_WHITE,
  ONIKS_REFERENCES, ONIKS_STEPS, ONIKS_ARTICLES, ONIKS_VISIT_LEAD, ONIKS_FAQ,
} from '../../data/oniks-alum'
import { getArticles } from '../../lib/articles'
import { PHONE, SITE } from '../../config/site'
import { localBusinessSchema, LOCAL_BUSINESS_ID } from '../../lib/local-business-schema'
import { typograph, upperFirst } from '../../lib/typograph'

/* ── SEO ── Перегородки другой фабрики: в заголовке — салон, а не бренд ВФД */
const title = `${ONIKS_PAGE.name} ${SITE.city.in} — ${SITE.studioName}, ${SITE.address.mall}`
// ~160 символов — длиннее поисковики обрезают
const description =
  `Раздвижные алюминиевые перегородки ${ONIKS.system} фабрики ${ONIKS.brand} ${SITE.city.in}: ${ONIKS_LAYOUT_COUNT}, ` +
  `${ONIKS_FACTS.glass}, высота ${ONIKS_FACTS.height}. Подбор и расчёт в ${SITE.studioNameOf}.`
const pageUrl = new URL(ONIKS_PAGE.path, SITE.url).href
const abs = (src: string) => new URL(src, SITE.url).href

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: `Алюминиевые перегородки ${ONIKS.system} фабрики ${ONIKS.brand} ${SITE.city.in}`,
  serviceType: 'Подбор и заказ раздвижных алюминиевых перегородок',
  description,
  url: pageUrl,
  image: [abs(ONIKS_HERO.image.src), ...ONIKS_MODELS.slice(0, 4).map((m) => abs(m.image))],
  brand: { '@type': 'Brand', name: ONIKS.brand },
  provider: { '@id': LOCAL_BUSINESS_ID },
  areaServed: [
    { '@type': 'City', name: SITE.city.name },
    { '@type': 'AdministrativeArea', name: 'Московская область' },
  ],
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: ONIKS_FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Перегородки', href: '/partitions/' },
  { label: ONIKS_PAGE.name },
]

const navItems = [
  { id: 'oa-builder', label: SEC.builder.nav },
  { id: 'oa-photos',  label: SEC.photos.nav },
  { id: 'oa-specs',   label: SEC.specs.nav },
  { id: 'oa-order',   label: SEC.order.nav },
  { id: 'oa-faq',     label: SEC.faq.nav },
]

/* Статьи по теме — по списку из данных; опечатка в имени — ошибка сборки */
const articles = await getArticles()
const related = ONIKS_ARTICLES.map((id) => {
  const article = articles.find((a) => a.id === id)
  if (!article) throw new Error(`ОНИКС: нет статьи «${id}» — поправьте ONIKS_ARTICLES в src/data/oniks-alum.ts`)
  return article
})

const zoom = (alt: string) => `Открыть фото на весь экран: ${alt}`
const arrow = '<svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
const chevron = (d: string) => `<svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="${d}" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage={abs(ONIKS_HERO.image.src)}
  structuredData={[localBusinessSchema({ url: SITE.url }), serviceSchema, faqSchema]}
  preloadImage={ONIKS_HERO.image.src}
  preloadImageSrcset={ONIKS_HERO.image.srcset}
  preloadImageSizes="(min-width: 62.5rem) 52vw, 100vw"
>
  <SectionNav items={navItems} />

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="home">
    <!-- ── Первый экран ── -->
    <section class="oa-hero" aria-labelledby="oa-title">
      <div class="container oa-hero__grid">
        <div>
          <h1 id="oa-title" class="oa-hero__title">{typograph(ONIKS_HERO.title)}</h1>
          <p class="h-lead oa-hero__lead">{typograph(ONIKS_HERO.lead)}</p>
          <div class="oa-hero__actions">
            <a href="#oa-builder" class="h-btn h-btn--signal">Собрать перегородку</a>
            <a href={`tel:${PHONE.raw}`} class="h-btn h-btn--quiet">Рассчитать по&nbsp;телефону</a>
          </div>
        </div>
        <figure class="h-media oa-hero__media">
          <button type="button" data-zoom={ONIKS_HERO.image.src} data-zoom-caption={ONIKS_HERO.image.alt} aria-label={zoom(ONIKS_HERO.image.alt)}>
            <img
              src={ONIKS_HERO.image.src}
              srcset={ONIKS_HERO.image.srcset}
              sizes="(min-width: 62.5rem) 52vw, 100vw"
              width={ONIKS_HERO.image.width}
              height={ONIKS_HERO.image.height}
              alt={ONIKS_HERO.image.alt}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </button>
        </figure>
      </div>
    </section>

    <!-- ── Конструктор ── -->
    <section id="oa-builder" class="h-sec" aria-labelledby="oa-builder-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-builder-title" class="h-h2">{typograph(SEC.builder.title)}</h2>
          <div>
            <p class="h-lead">{typograph(SEC.builder.lead)}</p>
          </div>
        </header>
        <OniksBuilder />
      </div>
    </section>

    <!-- ── Фото фабрики ── -->
    <section id="oa-photos" class="h-sec h-sec--wall" aria-labelledby="oa-photos-title">
      <div class="container">
        <header class="h-head oa-photos__head">
          <h2 id="oa-photos-title" class="h-h2">{typograph(SEC.photos.title)}</h2>
          <div>
            <p class="h-lead">{typograph(SEC.photos.lead)}</p>
            <div class="oa-rail__nav">
              <button type="button" class="oa-rail__btn" data-oa-rail-prev aria-label="Предыдущие раскладки" set:html={chevron('M10 4 6 8l4 4')} />
              <button type="button" class="oa-rail__btn" data-oa-rail-next aria-label="Следующие раскладки" set:html={chevron('m6 4 4 4-4 4')} />
            </div>
          </div>
        </header>

        <ul class="oa-rail" role="list" data-oa-rail>
          {ONIKS_MODELS.map((m) => (
            <li class="oa-card">
              <figure class="h-media oa-card__media">
                <button
                  type="button"
                  data-zoom={m.image}
                  data-oa-model-photo={m.num}
                  data-zoom-caption={`${m.name}: ${m.layout.toLowerCase()}. ${m.shown}`}
                  aria-label={zoom(`${m.name}, ${m.shown.toLowerCase()}`)}
                >
                  <img src={m.image} width={ONIKS_MODEL_IMAGE.width} height={ONIKS_MODEL_IMAGE.height} alt={`Перегородка ${m.name}: ${m.layout.toLowerCase()}, ${m.shown.toLowerCase()}`} loading="lazy" decoding="async" />
                </button>
              </figure>
              <h3 class="oa-card__name">{m.name}</h3>
              <p class="oa-card__layout">{typograph(m.layout)}</p>
              <p class="h-meta oa-card__shown">{typograph(`На фото: ${m.shown.toLowerCase()}`)}</p>
              <button type="button" class="h-pill h-pill--line oa-card__apply" data-oa-apply={`${m.num},${m.profile},${m.glass}`}>Собрать такую</button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Характеристики ── -->
    <section id="oa-specs" class="h-sec" aria-labelledby="oa-specs-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-specs-title" class="h-h2">{typograph(SEC.specs.title)}</h2>
          <div>
            <p class="h-lead">{typograph(SEC.specs.lead)}</p>
          </div>
        </header>

        <div class="oa-specs-grid">
          <dl class="oa-specs">
            {ONIKS_SPECS.map((s) => (
              <div class="oa-specs__row">
                <dt class="h-meta">{s.label}</dt>
                <dd class="h-body">{typograph(upperFirst(s.value))}</dd>
              </div>
            ))}
          </dl>
          <div class="oa-kit">
            {Object.values(ONIKS_KIT).map((group) => (
              <div>
                <h3 class="oa-subhead">{group.title}</h3>
                <ul class="oa-rules" role="list">
                  {group.items.map((k) => <li class="h-body">{typograph(upperFirst(k))}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="oa-specs-grid oa-specs-grid--more">
          <details class="oa-fold" open data-collapse-mobile>
            <summary class="oa-subhead">{ONIKS_COMPONENTS.title}</summary>
            <ul class="oa-rules" role="list">
              {ONIKS_COMPONENTS.items.map((c) => <li class="h-body">{typograph(c)}</li>)}
            </ul>
          </details>
          <details class="oa-fold" open data-collapse-mobile>
            <summary class="oa-subhead">{ONIKS_OPTI_WHITE.title}</summary>
            <p class="h-body oa-opti">{typograph(ONIKS_OPTI_WHITE.text)}</p>
          </details>
        </div>

        <h3 class="oa-subhead oa-refs__title">{ONIKS_REFERENCES.title}</h3>
        <ul class="oa-refs" role="list">
          {ONIKS_REFERENCES.items.map((r) => (
            <li>
              <figure class="oa-ref">
                <button type="button" class="oa-ref__media" data-zoom={r.image.src} data-zoom-caption={r.caption} aria-label={zoom(r.image.alt)}>
                  <img src={r.image.src} srcset={r.image.srcset} sizes="(min-width: 62.5rem) 22vw, 46vw" width={r.image.width} height={r.image.height} alt={r.image.alt} loading="lazy" decoding="async" />
                </button>
                <figcaption class="h-meta oa-ref__caption">{r.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Как заказать ── -->
    <StepsRow id="oa-order" title={SEC.order.title} lead={SEC.order.lead} steps={ONIKS_STEPS}>
      <p class="oa-order__call">
        <a href={`tel:${PHONE.raw}`} class="h-btn h-btn--signal">Рассчитать по&nbsp;телефону</a>
      </p>
    </StepsRow>

    <!-- ── Статьи по теме + каталог и контакты ── -->
    <section class="h-sec" aria-labelledby="oa-articles-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-articles-title" class="h-h2">{typograph(SEC.articles.title)}</h2>
          <div>
            <p class="h-lead">{typograph(SEC.articles.lead)}</p>
            <a href={SEC.articles.more.href} class="h-pill h-pill--line oa-articles__more">{SEC.articles.more.label} <Fragment set:html={arrow} /></a>
          </div>
        </header>
        <ul class="oa-posts h-rail" role="list" style={`--cols: ${related.length}`}>
          {related.map((a) => <li><ArticleCard article={a} /></li>)}
        </ul>
        <div class="oa-articles__nav">
          <ArticleNav />
        </div>
      </div>
    </section>

    <!-- ── Частые вопросы ── -->
    <section id="oa-faq" class="h-sec h-sec--wall" aria-labelledby="oa-faq-title">
      <div class="container oa-faq">
        <h2 id="oa-faq-title" class="h-h2">{typograph(SEC.faq.title)}</h2>
        <div class="oa-faq__list">
          <FaqAccordion items={ONIKS_FAQ} title={false} />
        </div>
      </div>
    </section>

    <VisitBand lead={ONIKS_VISIT_LEAD} />

    <ArticleLightbox />
  </div>
</BaseLayout>

<script>
  /* Справочные списки на телефоне свёрнуты под заголовки (без JS —
     раскрыты). Когда сворачивать, решает CSS (--oa-fold), а не второй
     брейкпоинт в скрипте */
  document.querySelectorAll<HTMLDetailsElement>('[data-collapse-mobile]').forEach((d) => {
    if (getComputedStyle(d).getPropertyValue('--oa-fold').trim() === 'closed') d.open = false
  })

  /* Лента фото: стрелки на компьютере, гаснут у краёв ленты */
  const rail = document.querySelector<HTMLElement>('[data-oa-rail]')
  const prev = document.querySelector<HTMLButtonElement>('[data-oa-rail-prev]')
  const next = document.querySelector<HTMLButtonElement>('[data-oa-rail-next]')
  if (rail && prev && next) {
    const step = () => rail.clientWidth * 0.8
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    const update = () => {
      prev.disabled = rail.scrollLeft <= 4
      next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4
    }
    prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' }))
    next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' }))
    rail.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)
    update()
  }
</script>

<style>
  /* ── Первый экран: снизу без отступа — его даёт следующая секция ── */
  .oa-hero { padding-top: clamp(1.5rem, 3vw, 2.5rem); }
  .oa-hero__grid { display: grid; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  @media (min-width: 62.5rem) {
    .oa-hero__grid { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.2fr); }
  }
  .oa-hero__title {
    margin: 0;
    font-family: var(--h-font);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--h-weight-display);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--h-ink);
    text-wrap: balance;
  }
  .oa-hero__lead { margin-top: 1.25rem; }
  .oa-hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .oa-hero__media { aspect-ratio: 1000 / 743; border-radius: var(--h-tile-radius); }
  .oa-hero__media > button { height: 100%; }

  /* ── Лента фото фабрики ── */
  .oa-photos__head .oa-rail__nav { display: none; gap: 0.5rem; margin-top: 1.25rem; }
  @media (hover: hover) and (min-width: 62.5rem) {
    .oa-photos__head .oa-rail__nav { display: flex; }
  }
  .oa-rail__btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0.0625rem solid var(--h-rule);
    border-radius: 50%;
    background: var(--h-paper);
    color: var(--h-ink);
    cursor: pointer;
    transition: border-color 150ms var(--ease-out), color 150ms var(--ease-out);
  }
  .oa-rail__btn:hover:not(:disabled) { border-color: var(--h-signal); color: var(--h-signal); }
  .oa-rail__btn:disabled { opacity: 0.35; cursor: default; }

  .oa-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(10.5rem, 17vw, 13.25rem);
    gap: var(--h-tile-gap);
    margin: 0 calc(-1 * var(--h-pad));
    padding: 0.25rem var(--h-pad) 0.5rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--h-pad);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .oa-rail::-webkit-scrollbar { display: none; }
  .oa-card { display: flex; flex-direction: column; margin: 0; scroll-snap-align: start; }
  .oa-card__media { aspect-ratio: 402 / 1000; background: var(--h-paper); }
  .oa-card__media > button { height: 100%; }
  .oa-card__name { margin: 0.875rem 0 0; font-family: var(--h-font); font-size: 1.125rem; font-weight: 600; letter-spacing: -0.01em; color: var(--h-ink); }
  .oa-card__layout { margin: 0.25rem 0 0; font-size: 0.9375rem; line-height: 1.4; color: var(--h-ink); }
  .oa-card__shown { margin: 0.25rem 0 0.875rem; color: var(--h-muted); }
  .oa-card__apply { align-self: flex-start; margin-top: auto; cursor: pointer; font: inherit; font-size: 0.875rem; }

  /* ── Характеристики ── */
  .oa-specs-grid { display: grid; gap: clamp(1.75rem, 4vw, 3rem); }
  @media (min-width: 62.5rem) { .oa-specs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; } }
  .oa-specs-grid--more { margin-top: clamp(2.5rem, 5vw, 4rem); }

  .oa-specs { margin: 0; border-top: 0.0625rem solid var(--h-rule); }
  .oa-specs__row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 1rem; padding: 0.875rem 0; border-bottom: 0.0625rem solid var(--h-rule); }
  .oa-specs__row dt { color: var(--h-muted); }
  .oa-specs__row dd { margin: 0; color: var(--h-ink); }

  /* «В комплекте» и «Отдельно» — короткие списки, рядом и на телефоне;
     уже 9rem колонки не бывает (на 320 px — друг под другом), иначе
     длинные слова («от комплектации») вылезают из колонки */
  .oa-kit { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr)); gap: 1rem var(--h-gutter); }

  /* Комплектующие и Opti White: на компьютере — заголовок и список,
     на телефоне — свёрнуты под заголовок (--oa-fold читает скрипт выше) */
  .oa-fold { margin: 0; }
  summary.oa-subhead { list-style: none; pointer-events: none; }
  summary.oa-subhead::-webkit-details-marker { display: none; }
  @media (max-width: 43.6875rem) {
    .oa-fold { --oa-fold: closed; }
    .oa-specs-grid--more { gap: 0; }
    summary.oa-subhead {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin: 0;
      padding-block: 1rem;
      border-top: 0.0625rem solid var(--h-rule);
      pointer-events: auto;
      cursor: pointer;
    }
    .oa-fold:last-child { border-bottom: 0.0625rem solid var(--h-rule); }
    /* Уголок — повёрнутый квадрат: его углы выступают за габарит на
       ~0.1rem, отступ справа держит их внутри строки */
    summary.oa-subhead::after {
      content: '';
      flex: none;
      width: 0.5rem;
      height: 0.5rem;
      margin-right: 0.125rem;
      border-right: 0.125rem solid currentColor;
      border-bottom: 0.125rem solid currentColor;
      rotate: 45deg;
      translate: 0 -0.125rem;
      transition: rotate 200ms var(--ease-out);
    }
    .oa-fold[open] > summary.oa-subhead { margin-bottom: 0.25rem; }
    .oa-fold[open] > summary.oa-subhead::after { rotate: 225deg; translate: 0 0.125rem; }
    .oa-fold[open] { padding-bottom: 1rem; }
    .oa-fold .oa-rules li:last-child { border-bottom: 0; }
  }

  .oa-subhead { margin: 0 0 0.75rem; font-family: var(--h-font); font-size: 1.125rem; font-weight: 600; letter-spacing: -0.01em; color: var(--h-ink); }
  .oa-rules { margin: 0; padding: 0; list-style: none; border-top: 0.0625rem solid var(--h-rule); }
  .oa-rules li { margin: 0; padding: 0.75rem 0; border-bottom: 0.0625rem solid var(--h-rule); color: var(--h-ink); }
  .oa-opti { margin: 0; max-width: 34rem; color: var(--h-soft); }

  .oa-refs__title { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .oa-refs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--h-tile-gap); margin: 0; padding: 0; list-style: none; }
