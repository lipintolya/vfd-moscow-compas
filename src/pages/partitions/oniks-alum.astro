---
/**
 * /partitions/oniks-alum/ — перегородки ALUM фабрики ОНИКС, коллаборация
 * со Студией Зизевского. Отдельно от /partitions/ (системы GRAFIA), но в
 * дизайн-системе главной (home.css).
 *
 * Данные и тексты — src/data/oniks-alum.ts, фото — assets/oniks-alum/
 * (README там же) → npm run gen:oniks. Салон — из src/config/site.ts.
 *
 * Для поисковиков: Service с брендом ОНИКС и салоном-исполнителем,
 * FAQPage, хлебные крошки (Breadcrumbs), LocalBusiness. Все фото
 * открываются во весь экран (ArticleLightbox, data-zoom).
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../../components/ui/FaqAccordion.astro'
import SectionNav from '../../components/partitions/SectionNav.astro'
import VisitBand from '../../components/home/VisitBand.astro'
import ArticleNav from '../../components/articles/ArticleNav.astro'
import ArticleLightbox from '../../components/articles/ArticleLightbox.astro'
import '../../styles/home.css'
import {
  ONIKS, ONIKS_PAGE, ONIKS_HERO, ONIKS_FACTS, ONIKS_MODELS, ONIKS_MODEL_IMAGE, ONIKS_LAYOUTS_IMAGE,
  ONIKS_PROFILE_COLORS, ONIKS_PROFILE_COLORS_IMAGE, ONIKS_GLASS, ONIKS_OPTI_WHITE_IMAGE,
  ONIKS_SPECS, ONIKS_KIT, ONIKS_COMPONENTS, ONIKS_COMPONENTS_IMAGE, ONIKS_FAQ,
} from '../../data/oniks-alum'
import { PHONE, SITE } from '../../config/site'
import { localBusinessSchema, LOCAL_BUSINESS_ID } from '../../lib/local-business-schema'
import { typograph } from '../../lib/typograph'

/* ── SEO ── */
const title = `Перегородки ОНИКС ALUM ${SITE.city.in} — ${SITE.name}, ${SITE.address.mall}`
// ~160 символов — длиннее поисковики обрезают
const description =
  `Раздвижные алюминиевые перегородки ALUM фабрики ОНИКС ${SITE.city.in}: ${ONIKS_MODELS.length} раскладок, ` +
  `стекло 4 мм или триплекс 8 мм, высота до 3 м. Подбор в салоне в ${SITE.address.mall}.`
const pageUrl = new URL(ONIKS_PAGE.path, SITE.url).href
const abs = (src: string) => new URL(src, SITE.url).href

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: `Алюминиевые перегородки ${ONIKS.system} фабрики ${ONIKS.brand} ${SITE.city.in}`,
  serviceType: 'Подбор и заказ раздвижных алюминиевых перегородок',
  description,
  url: pageUrl,
  image: [abs(ONIKS_HERO.image.src), ...ONIKS_MODELS.slice(0, 4).map((m) => abs(m.image))],
  brand: { '@type': 'Brand', name: ONIKS.brand },
  provider: { '@id': LOCAL_BUSINESS_ID },
  areaServed: [
    { '@type': 'City', name: SITE.city.name },
    { '@type': 'AdministrativeArea', name: 'Московская область' },
  ],
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: ONIKS_FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Перегородки', href: '/partitions/' },
  { label: ONIKS_PAGE.name },
]

const navItems = [
  { id: 'oa-models',  label: 'Раскладки' },
  { id: 'oa-profile', label: 'Профиль' },
  { id: 'oa-glass',   label: 'Стекло' },
  { id: 'oa-specs',   label: 'Размеры' },
  { id: 'oa-order',   label: 'Заказ' },
  { id: 'oa-faq',     label: 'Вопросы' },
]

const zoom = (alt: string) => `Открыть фото на весь экран: ${alt}`
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage={abs(ONIKS_HERO.image.src)}
  structuredData={[localBusinessSchema({ url: SITE.url }), serviceSchema, faqSchema]}
  preloadImage={ONIKS_HERO.image.src}
  preloadImageSrcset={ONIKS_HERO.image.srcset}
  preloadImageSizes="(min-width: 62.5rem) 46vw, 100vw"
>
  <SectionNav items={navItems} />

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="home">
    <!-- ── Первый экран: коллаборация ── -->
    <section class="oa-hero" aria-labelledby="oa-title">
      <div class="container oa-hero__grid">
        <div class="oa-hero__text">
          <p class="h-meta oa-hero__collab">{SITE.studioName} × {ONIKS.factory}</p>
          <h1 id="oa-title" class="oa-hero__title">Перегородки {ONIKS.system} фабрики {ONIKS.brand}</h1>
          <p class="h-lead oa-hero__lead">
            {typograph('Раздвижные перегородки из алюминиевого профиля и стекла: одно движение — и из просторной комнаты получаются две. Подберём раскладку, цвет профиля и стекло и рассчитаем перегородку под ваш проём.')}
          </p>
          <div class="oa-hero__actions">
            <a href={`tel:${PHONE.raw}`} class="h-btn h-btn--signal">Рассчитать стоимость</a>
            <a href="#oa-models" class="h-btn h-btn--quiet">Смотреть раскладки</a>
          </div>
        </div>
        <figure class="h-media oa-hero__media">
          <button type="button" data-zoom={ONIKS_HERO.image.src} data-zoom-caption={ONIKS_HERO.image.alt} aria-label={zoom(ONIKS_HERO.image.alt)}>
            <img
              src={ONIKS_HERO.image.src}
              srcset={ONIKS_HERO.image.srcset}
              sizes="(min-width: 62.5rem) 46vw, 100vw"
              width={ONIKS_HERO.image.width}
              height={ONIKS_HERO.image.height}
              alt={ONIKS_HERO.image.alt}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </button>
        </figure>
      </div>
      <div class="container">
        <dl class="oa-facts">
          {ONIKS_FACTS.map((f) => (
            <div class="oa-facts__item">
              <dt class="oa-facts__value">{f.value}</dt>
              <dd class="h-meta oa-facts__label">{typograph(f.label)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ── О коллаборации: кто что делает ── -->
    <section class="h-sec h-sec--wall" aria-labelledby="oa-collab-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-collab-title" class="h-h2">{SITE.studioName} и&nbsp;{ONIKS.factory}</h2>
          <div>
            <p class="h-lead">{typograph(`Коллаборация салона и фабрики: перегородки ALUM можно подобрать и заказать ${SITE.city.in}, не разбираясь в профилях и стёклах самостоятельно.`)}</p>
          </div>
        </header>
        <ul class="oa-collab" role="list">
          <li class="oa-collab__tile">
            <p class="h-meta oa-collab__who">Фабрика {ONIKS.brand}</p>
            <p class="oa-collab__what">{typograph(`Производит перегородки ALUM: ${ONIKS_MODELS.length} раскладок, профиль — ${ONIKS_PROFILE_COLORS.join(', ')} или цвета эмали фабрики, стекло и триплекс. Срок изготовления — от 10 рабочих дней.`)}</p>
          </li>
          <li class="oa-collab__tile">
            <p class="h-meta oa-collab__who">{SITE.studioName}</p>
            <p class="oa-collab__what">{typograph(`Помогает выбрать раскладку, профиль и стекло и рассчитывает перегородку под ваш проём — в салоне в ${SITE.address.mall} и по телефону.`)}</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- ── Раскладки ── -->
    <section id="oa-models" class="h-sec" aria-labelledby="oa-models-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-models-title" class="h-h2">{ONIKS_MODELS.length} раскладок ALUM</h2>
          <div>
            <p class="h-lead">{typograph('Модель перегородки — это раскладка: как профиль делит стекло. Цвет профиля и стекло подбираются отдельно — на фото показан один из вариантов.')}</p>
          </div>
        </header>

        <ul class="oa-models" role="list">
          {ONIKS_MODELS.map((m, i) => (
            <li class="oa-model">
              <figure class="h-media oa-model__media">
                <button type="button" data-zoom={m.image} data-zoom-caption={`${m.name}: ${m.layout.toLowerCase()}. ${m.shown}`} aria-label={zoom(`${m.name}, ${m.shown.toLowerCase()}`)}>
                  <img src={m.image} width={ONIKS_MODEL_IMAGE.width} height={ONIKS_MODEL_IMAGE.height} alt={`Перегородка ${m.name}: ${m.layout.toLowerCase()}, ${m.shown.toLowerCase()}`} loading={i < 5 ? 'eager' : 'lazy'} decoding="async" />
                </button>
              </figure>
              <h3 class="oa-model__name">{m.name}</h3>
              <p class="oa-model__layout">{typograph(m.layout)}</p>
              <p class="h-meta oa-model__shown">{typograph(m.shown)}</p>
            </li>
          ))}
        </ul>

        <figure class="oa-scheme">
          <button type="button" data-zoom={ONIKS_LAYOUTS_IMAGE.src} data-zoom-caption="Схема раскладок ALUM №1–10" aria-label={zoom(ONIKS_LAYOUTS_IMAGE.alt)}>
            <img src={ONIKS_LAYOUTS_IMAGE.src} srcset={ONIKS_LAYOUTS_IMAGE.srcset} sizes="(min-width: 80rem) 76rem, 100vw" width={ONIKS_LAYOUTS_IMAGE.width} height={ONIKS_LAYOUTS_IMAGE.height} alt={ONIKS_LAYOUTS_IMAGE.alt} loading="lazy" decoding="async" />
          </button>
          <figcaption class="h-meta oa-caption">Схема раскладок №1–10</figcaption>
        </figure>
      </div>
    </section>

    <!-- ── Профиль и комплектующие ── -->
    <section id="oa-profile" class="h-sec h-sec--wall" aria-labelledby="oa-profile-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-profile-title" class="h-h2">Профиль и&nbsp;комплектующие</h2>
          <div>
            <p class="h-lead">{typograph(`Цвета профиля — ${ONIKS_PROFILE_COLORS.join(', ')}, а также цвета эмали фабрики.`)}</p>
          </div>
        </header>
        <div class="oa-split">
          <figure class="oa-figure">
            <button type="button" data-zoom={ONIKS_PROFILE_COLORS_IMAGE.src} data-zoom-caption="Цвета профиля ALUM" aria-label={zoom(ONIKS_PROFILE_COLORS_IMAGE.alt)}>
              <img src={ONIKS_PROFILE_COLORS_IMAGE.src} srcset={ONIKS_PROFILE_COLORS_IMAGE.srcset} sizes="(min-width: 62.5rem) 38vw, 100vw" width={ONIKS_PROFILE_COLORS_IMAGE.width} height={ONIKS_PROFILE_COLORS_IMAGE.height} alt={ONIKS_PROFILE_COLORS_IMAGE.alt} loading="lazy" decoding="async" />
            </button>
            <figcaption class="h-meta oa-caption">Цвета профиля</figcaption>
          </figure>
          <figure class="oa-figure">
            <button type="button" data-zoom={ONIKS_COMPONENTS_IMAGE.src} data-zoom-caption="Комплектующие перегородок ALUM" aria-label={zoom(ONIKS_COMPONENTS_IMAGE.alt)}>
              <img src={ONIKS_COMPONENTS_IMAGE.src} srcset={ONIKS_COMPONENTS_IMAGE.srcset} sizes="(min-width: 62.5rem) 38vw, 100vw" width={ONIKS_COMPONENTS_IMAGE.width} height={ONIKS_COMPONENTS_IMAGE.height} alt={ONIKS_COMPONENTS_IMAGE.alt} loading="lazy" decoding="async" />
            </button>
            <figcaption class="h-meta oa-caption">Комплектующие</figcaption>
          </figure>
        </div>
        <ul class="oa-rules" role="list">
          {ONIKS_COMPONENTS.map((c) => <li class="h-body">{typograph(c)}</li>)}
        </ul>
      </div>
    </section>

    <!-- ── Стекло ── -->
    <section id="oa-glass" class="h-sec" aria-labelledby="oa-glass-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-glass-title" class="h-h2">Стекло</h2>
          <div>
            <p class="h-lead">{typograph('Обычное стекло 4 мм или триплекс 8 мм — прозрачное, матовое, тонированное, зеркальное и цветное.')}</p>
          </div>
        </header>
        <div class="oa-glass">
          {ONIKS_GLASS.map((g) => (
            <div>
              <h3 class="oa-glass__title">{g.title}</h3>
              <ul class="oa-rules" role="list">
                {g.items.map((it) => <li class="h-body">{typograph(it[0]!.toUpperCase() + it.slice(1))}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="oa-split oa-split--note">
          <div>
            <h3 class="oa-glass__title">Стекло Opti White</h3>
            <p class="h-body">
              {typograph('У обычного прозрачного стекла лёгкий зеленоватый оттенок — он становится заметен, когда стекло окрашивают. Для чистого цвета перегородку можно сделать на стекле Opti White: у него такого оттенка нет.')}
            </p>
          </div>
          <figure class="oa-figure">
            <button type="button" data-zoom={ONIKS_OPTI_WHITE_IMAGE.src} data-zoom-caption="Opti White и обычное стекло" aria-label={zoom(ONIKS_OPTI_WHITE_IMAGE.alt)}>
              <img src={ONIKS_OPTI_WHITE_IMAGE.src} srcset={ONIKS_OPTI_WHITE_IMAGE.srcset} sizes="(min-width: 62.5rem) 38vw, 100vw" width={ONIKS_OPTI_WHITE_IMAGE.width} height={ONIKS_OPTI_WHITE_IMAGE.height} alt={ONIKS_OPTI_WHITE_IMAGE.alt} loading="lazy" decoding="async" />
            </button>
          </figure>
        </div>
      </div>
    </section>

    <!-- ── Размеры и комплектация ── -->
    <section id="oa-specs" class="h-sec h-sec--wall" aria-labelledby="oa-specs-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-specs-title" class="h-h2">Размеры и&nbsp;комплектация</h2>
          <div>
            <p class="h-lead">{typograph('Перегородку делают под ваш проём: размеры нестандартные, с шагом 1 см.')}</p>
          </div>
        </header>
        <div class="oa-split">
          <dl class="oa-specs">
            {ONIKS_SPECS.map((s) => (
              <div class="oa-specs__row">
                <dt class="h-meta">{s.label}</dt>
                <dd class="h-body">{typograph(s.value)}</dd>
              </div>
            ))}
          </dl>
          <div class="oa-kit">
            <h3 class="oa-glass__title">В комплекте</h3>
            <ul class="oa-rules" role="list">
              {ONIKS_KIT.included.map((k) => <li class="h-body">{typograph(k[0]!.toUpperCase() + k.slice(1))}</li>)}
            </ul>
            <h3 class="oa-glass__title oa-kit__second">Отдельно</h3>
            <ul class="oa-rules" role="list">
              {ONIKS_KIT.separate.map((k) => <li class="h-body">{typograph(k[0]!.toUpperCase() + k.slice(1))}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Как заказать ── -->
    <section id="oa-order" class="h-sec" aria-labelledby="oa-order-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-order-title" class="h-h2">Как заказать перегородку</h2>
          <div>
            <p class="h-lead">Позвоните <a href={`tel:${PHONE.raw}`} class="h-link oa-nowrap">{PHONE.label}</a> или приезжайте в&nbsp;салон&nbsp;— {typograph(SITE.address.full)}.</p>
          </div>
        </header>
        <ol class="oa-steps" role="list">
          <li class="oa-step">
            <span class="oa-step__num" aria-hidden="true">1</span>
            <h3 class="oa-step__title">Выберите раскладку</h3>
            <p class="h-body">{typograph('Одна из десяти — от одной перекладины до сетки 3 × 5.')}</p>
          </li>
          <li class="oa-step">
            <span class="oa-step__num" aria-hidden="true">2</span>
            <h3 class="oa-step__title">Подберите отделку</h3>
            <p class="h-body">{typograph('Цвет профиля и стекло — поможем сочетать с интерьером.')}</p>
          </li>
          <li class="oa-step">
            <span class="oa-step__num" aria-hidden="true">3</span>
            <h3 class="oa-step__title">Расчёт по проёму</h3>
            <p class="h-body">{typograph('Пришлите размеры проёма или приезжайте в салон — рассчитаем стоимость.')}</p>
          </li>
          <li class="oa-step">
            <span class="oa-step__num" aria-hidden="true">4</span>
            <h3 class="oa-step__title">Изготовление</h3>
            <p class="h-body">{typograph('На фабрике — от 10 рабочих дней.')}</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ── Ещё по теме: перелинковка ── -->
    <section class="h-sec h-sec--wall" aria-labelledby="oa-more-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-more-title" class="h-h2">Ещё о&nbsp;перегородках и&nbsp;зонировании</h2>
          <div>
            <ul class="oa-links" role="list">
              <li><a href="/partitions/" class="h-link">Алюминиевые перегородки GRAFIA — раздвижные, распашные, стационарные</a></li>
              <li><a href="/articles/vfd-dizain-dveri-pod-zadachu/" class="h-link">Как зонировать пространство без стен — решения ВФД Дизайн</a></li>
              <li><a href="/articles/dveri-so-steklom-ili-gluhie/" class="h-link">Двери со стеклом или глухие: что выбрать для каждой комнаты</a></li>
              <li><a href="/articles/dver-s-zhalyuzi/" class="h-link">Новинка: дверь с жалюзи для раздвижных систем</a></li>
            </ul>
          </div>
        </header>
        <ArticleNav />
      </div>
    </section>

    <!-- ── Частые вопросы ── -->
    <section id="oa-faq" class="h-sec" aria-labelledby="oa-faq-title">
      <div class="container oa-faq">
        <h2 id="oa-faq-title" class="h-h2">Вопросы о&nbsp;перегородках ALUM</h2>
        <div class="oa-faq__list">
          <FaqAccordion items={ONIKS_FAQ} title={false} />
        </div>
      </div>
    </section>

    <VisitBand lead={`Приезжайте обсудить проект: подберём раскладку, профиль и стекло перегородки ${ONIKS.system} и рассчитаем её по вашим размерам.`} />

    <ArticleLightbox />
  </div>
</BaseLayout>

<style>
  /* ── Первый экран ── */
  .oa-hero { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 4rem); }
  .oa-hero__grid { display: grid; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  @media (min-width: 62.5rem) {
    .oa-hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); }
  }
  .oa-hero__collab { margin: 0; color: var(--h-muted); }
  .oa-hero__title {
    margin: 0.75rem 0 0;
    font-family: var(--h-font);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--h-weight-display);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--h-ink);
    text-wrap: balance;
  }
  .oa-hero__lead { margin-top: 1.25rem; max-width: 34rem; }
  .oa-hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .oa-hero__media { aspect-ratio: 1000 / 743; border-radius: var(--h-tile-radius); }
  .oa-hero__media > button { height: 100%; }

  .oa-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem var(--h-gutter);
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding-top: 1.25rem;
    border-top: 0.0625rem solid var(--h-rule);
  }
  @media (min-width: 62.5rem) { .oa-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .oa-facts__item { margin: 0; }
  .oa-facts__value { font-family: var(--h-font); font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -0.02em; color: var(--h-ink); }
  .oa-facts__label { margin: 0.25rem 0 0; color: var(--h-muted); }

  /* ── Коллаборация: две плитки ── */
  .oa-collab { display: grid; gap: var(--h-tile-gap); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 43.75rem) { .oa-collab { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .oa-collab__tile { margin: 0; padding: clamp(1.25rem, 3vw, 2.25rem); border-radius: var(--h-tile-radius); background: var(--h-paper); }
  .oa-collab__who { margin: 0; color: var(--h-muted); }
  .oa-collab__what { margin: 0.75rem 0 0; font-family: var(--h-font); font-size: clamp(1.125rem, 1.6vw, 1.3125rem); font-weight: 500; line-height: 1.4; letter-spacing: -0.01em; color: var(--h-ink); }
  .oa-nowrap { white-space: nowrap; }

  /* ── Раскладки: вертикальные карточки ── */
  .oa-models {
    display: grid;
