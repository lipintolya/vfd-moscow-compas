---
/**
 * /partitions/oniks-alum/ — перегородки ALUM фабрики ОНИКС, коллаборация
 * со Студией Зизевского. Отдельно от /partitions/ (системы GRAFIA), но в
 * дизайн-системе главной (home.css).
 *
 * Порядок: первый экран → кто что делает в коллаборации → конструктор
 * (раскладка, профиль, стекло — OniksBuilder) → фото фабрики лентой,
 * «Собрать такую» подставляет отделку в конструктор → характеристики и
 * материалы фабрики → как заказать → статьи по теме → вопросы → как
 * добраться.
 *
 * Данные и тексты — src/data/oniks-alum.ts, фото — assets/oniks-alum/
 * (README там же) → npm run gen:oniks. Салон — из src/config/site.ts.
 *
 * Для поисковиков: Service с брендом ОНИКС и салоном-исполнителем,
 * FAQPage, хлебные крошки (Breadcrumbs), LocalBusiness. Все фото
 * открываются во весь экран (ArticleLightbox, data-zoom).
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../../components/ui/FaqAccordion.astro'
import SectionNav from '../../components/partitions/SectionNav.astro'
import OniksBuilder from '../../components/partitions/OniksBuilder.astro'
import VisitBand from '../../components/home/VisitBand.astro'
import ArticleCard from '../../components/articles/ArticleCard.astro'
import ArticleNav from '../../components/articles/ArticleNav.astro'
import ArticleLightbox from '../../components/articles/ArticleLightbox.astro'
import '../../styles/home.css'
import {
  ONIKS, ONIKS_PAGE, ONIKS_HERO, ONIKS_FACTS, ONIKS_MODELS, ONIKS_MODEL_IMAGE, ONIKS_LAYOUTS_IMAGE,
  ONIKS_PROFILE_COLORS, ONIKS_PROFILE_COLORS_IMAGE, ONIKS_OPTI_WHITE_IMAGE,
  ONIKS_SPECS, ONIKS_KIT, ONIKS_COMPONENTS, ONIKS_COMPONENTS_IMAGE, ONIKS_FAQ,
} from '../../data/oniks-alum'
import { getArticles } from '../../lib/articles'
import { PHONE, SITE } from '../../config/site'
import { localBusinessSchema, LOCAL_BUSINESS_ID } from '../../lib/local-business-schema'
import { typograph } from '../../lib/typograph'

/* ── SEO ── */
const title = `Перегородки ОНИКС ALUM ${SITE.city.in} — ${SITE.name}, ${SITE.address.mall}`
// ~160 символов — длиннее поисковики обрезают
const description =
  `Раздвижные алюминиевые перегородки ALUM фабрики ОНИКС ${SITE.city.in}: ${ONIKS_MODELS.length} раскладок, ` +
  `стекло 4 мм или триплекс 8 мм, высота до 3 м. Подбор в салоне в ${SITE.address.mall}.`
const pageUrl = new URL(ONIKS_PAGE.path, SITE.url).href
const abs = (src: string) => new URL(src, SITE.url).href

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: `Алюминиевые перегородки ${ONIKS.system} фабрики ${ONIKS.brand} ${SITE.city.in}`,
  serviceType: 'Подбор и заказ раздвижных алюминиевых перегородок',
  description,
  url: pageUrl,
  image: [abs(ONIKS_HERO.image.src), ...ONIKS_MODELS.slice(0, 4).map((m) => abs(m.image))],
  brand: { '@type': 'Brand', name: ONIKS.brand },
  provider: { '@id': LOCAL_BUSINESS_ID },
  areaServed: [
    { '@type': 'City', name: SITE.city.name },
    { '@type': 'AdministrativeArea', name: 'Московская область' },
  ],
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: ONIKS_FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Перегородки', href: '/partitions/' },
  { label: ONIKS_PAGE.name },
]

const navItems = [
  { id: 'oa-builder', label: 'Конструктор' },
  { id: 'oa-photos',  label: 'Фото' },
  { id: 'oa-specs',   label: 'Характеристики' },
  { id: 'oa-order',   label: 'Заказ' },
  { id: 'oa-faq',     label: 'Вопросы' },
]

/* Статьи по теме — о зонировании, стекле и раздвижных системах */
const RELATED_IDS = ['vfd-dizain-dveri-pod-zadachu', 'dver-s-zhalyuzi', 'dveri-so-steklom-ili-gluhie']
const articles = await getArticles()
const related = RELATED_IDS.map((id) => articles.find((a) => a.id === id)).filter((a) => a !== undefined)

/* Материалы фабрики — справочные картинки, открываются во весь экран */
const references = [
  { image: ONIKS_LAYOUTS_IMAGE,        caption: 'Схема раскладок №1–10' },
  { image: ONIKS_COMPONENTS_IMAGE,     caption: 'Комплектующие' },
  { image: ONIKS_PROFILE_COLORS_IMAGE, caption: 'Цвета профиля вживую' },
  { image: ONIKS_OPTI_WHITE_IMAGE,     caption: 'Opti White и обычное стекло' },
]

const zoom = (alt: string) => `Открыть фото на весь экран: ${alt}`
const cap = (s: string) => `${s[0]!.toUpperCase()}${s.slice(1)}`
const arrow = '<svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
const chevron = (d: string) => `<svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="${d}" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage={abs(ONIKS_HERO.image.src)}
  structuredData={[localBusinessSchema({ url: SITE.url }), serviceSchema, faqSchema]}
  preloadImage={ONIKS_HERO.image.src}
  preloadImageSrcset={ONIKS_HERO.image.srcset}
  preloadImageSizes="(min-width: 62.5rem) 52vw, 100vw"
>
  <SectionNav items={navItems} />

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="home">
    <!-- ── Первый экран ── -->
    <section class="oa-hero" aria-labelledby="oa-title">
      <div class="container oa-hero__grid">
        <div class="oa-hero__text">
          <p class="oa-lockup">
            <img src="/svg/logo.svg" width="32" height="32" alt="" />
            <span>{SITE.studioName}</span>
            <span class="oa-lockup__x" aria-hidden="true">×</span>
            <span class="sr-only">и</span>
            <span>{ONIKS.factory}</span>
          </p>
          <h1 id="oa-title" class="oa-hero__title">Перегородки {ONIKS.system} фабрики {ONIKS.brand}</h1>
          <p class="h-lead oa-hero__lead">
            {typograph('Раздвижные перегородки из алюминиевого профиля и стекла: одно движение — и из просторной комнаты получаются две. Соберите свою в конструкторе — раскладку, профиль и стекло, — а мы рассчитаем её под ваш проём.')}
          </p>
          <div class="oa-hero__actions">
            <a href="#oa-builder" class="h-btn h-btn--signal">Собрать перегородку</a>
            <a href={`tel:${PHONE.raw}`} class="h-btn h-btn--quiet">Рассчитать по&nbsp;телефону</a>
          </div>
        </div>
        <figure class="h-media oa-hero__media">
          <button type="button" data-zoom={ONIKS_HERO.image.src} data-zoom-caption={ONIKS_HERO.image.alt} aria-label={zoom(ONIKS_HERO.image.alt)}>
            <img
              src={ONIKS_HERO.image.src}
              srcset={ONIKS_HERO.image.srcset}
              sizes="(min-width: 62.5rem) 52vw, 100vw"
              width={ONIKS_HERO.image.width}
              height={ONIKS_HERO.image.height}
              alt={ONIKS_HERO.image.alt}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </button>
        </figure>
      </div>
      <div class="container">
        <dl class="oa-facts">
          {ONIKS_FACTS.map((f) => (
            <div class="oa-facts__item">
              <dt class="oa-facts__value">{f.value}</dt>
              <dd class="h-meta oa-facts__label">{typograph(f.label)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ── Коллаборация: кто что делает ── -->
    <section class="h-sec h-sec--wall" aria-labelledby="oa-collab-title">
      <div class="container">
        <h2 id="oa-collab-title" class="sr-only">Коллаборация: {SITE.studioName} и {ONIKS.factory}</h2>
        <div class="oa-duo">
          <div class="oa-duo__side">
            <p class="h-meta oa-duo__role">Фабрика</p>
            <p class="oa-duo__name">{ONIKS.brand}</p>
            <p class="h-body oa-duo__text">
              {typograph(`Производит перегородки ALUM: ${ONIKS_MODELS.length} раскладок, профиль — ${ONIKS_PROFILE_COLORS.join(', ')} или цвета эмали фабрики, стекло и триплекс. Срок изготовления — от 10 рабочих дней.`)}
            </p>
          </div>
          <span class="oa-duo__x" aria-hidden="true">×</span>
          <div class="oa-duo__side">
            <p class="h-meta oa-duo__role">Салон в&nbsp;{SITE.address.mall}</p>
            <p class="oa-duo__name">{SITE.studioName}</p>
            <p class="h-body oa-duo__text">
              {typograph('Помогает выбрать раскладку, профиль и стекло и рассчитывает перегородку под ваш проём — в салоне и по телефону.')}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Конструктор ── -->
    <section id="oa-builder" class="h-sec" aria-labelledby="oa-builder-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-builder-title" class="h-h2">Соберите перегородку</h2>
          <div>
            <p class="h-lead">{typograph('Выберите раскладку, цвет профиля и стекло — схема покажет, как будет выглядеть створка: сквозь прозрачное стекло видно комнату, матовое её размывает, зеркало отражает.')}</p>
          </div>
        </header>
        <OniksBuilder />
      </div>
    </section>

    <!-- ── Фото фабрики ── -->
    <section id="oa-photos" class="h-sec h-sec--wall" aria-labelledby="oa-photos-title">
      <div class="container">
        <header class="h-head oa-photos__head">
          <h2 id="oa-photos-title" class="h-h2">Раскладки на&nbsp;фото фабрики</h2>
          <div>
            <p class="h-lead">{typograph('Каждая раскладка в одной из отделок. Понравилась — нажмите «Собрать такую», и конструктор подставит её раскладку, профиль и стекло.')}</p>
            <div class="oa-rail__nav">
              <button type="button" class="oa-rail__btn" data-oa-rail-prev aria-label="Предыдущие раскладки" set:html={chevron('M10 4 6 8l4 4')} />
              <button type="button" class="oa-rail__btn" data-oa-rail-next aria-label="Следующие раскладки" set:html={chevron('m6 4 4 4-4 4')} />
            </div>
          </div>
        </header>

        <ul class="oa-rail" role="list" data-oa-rail>
          {ONIKS_MODELS.map((m) => (
            <li class="oa-card">
              <figure class="h-media oa-card__media">
                <button
                  type="button"
                  data-zoom={m.image}
                  data-oa-model-photo={m.num}
                  data-zoom-caption={`${m.name}: ${m.layout.toLowerCase()}. ${m.shown}`}
                  aria-label={zoom(`${m.name}, ${m.shown.toLowerCase()}`)}
                >
                  <img src={m.image} width={ONIKS_MODEL_IMAGE.width} height={ONIKS_MODEL_IMAGE.height} alt={`Перегородка ${m.name}: ${m.layout.toLowerCase()}, ${m.shown.toLowerCase()}`} loading="lazy" decoding="async" />
                </button>
              </figure>
              <h3 class="oa-card__name">{m.name}</h3>
              <p class="oa-card__layout">{typograph(m.layout)}</p>
              <p class="h-meta oa-card__shown">{typograph(`На фото: ${m.shown.toLowerCase()}`)}</p>
              <button type="button" class="h-pill h-pill--line oa-card__apply" data-oa-apply={`${m.num},${m.profile},${m.glass}`}>Собрать такую</button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Характеристики ── -->
    <section id="oa-specs" class="h-sec" aria-labelledby="oa-specs-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-specs-title" class="h-h2">Характеристики</h2>
          <div>
            <p class="h-lead">{typograph('Перегородку делают под ваш проём: размеры нестандартные, с шагом 1 см.')}</p>
          </div>
        </header>

        <div class="oa-specs-grid">
          <dl class="oa-specs">
            {ONIKS_SPECS.map((s) => (
              <div class="oa-specs__row">
                <dt class="h-meta">{s.label}</dt>
                <dd class="h-body">{typograph(cap(s.value))}</dd>
              </div>
            ))}
          </dl>
          <div class="oa-kit">
            <div>
              <h3 class="oa-subhead">В&nbsp;комплекте</h3>
              <ul class="oa-rules" role="list">
                {ONIKS_KIT.included.map((k) => <li class="h-body">{typograph(cap(k))}</li>)}
              </ul>
            </div>
            <div>
              <h3 class="oa-subhead">Отдельно</h3>
              <ul class="oa-rules" role="list">
                {ONIKS_KIT.separate.map((k) => <li class="h-body">{typograph(cap(k))}</li>)}
              </ul>
            </div>
          </div>
        </div>

        <div class="oa-specs-grid oa-specs-grid--more">
          <details class="oa-fold" open data-collapse-mobile>
            <summary class="oa-subhead">Комплектующие</summary>
            <ul class="oa-rules" role="list">
              {ONIKS_COMPONENTS.map((c) => <li class="h-body">{typograph(c)}</li>)}
            </ul>
          </details>
          <details class="oa-fold" open data-collapse-mobile>
            <summary class="oa-subhead">Стекло Opti White</summary>
            <p class="h-body oa-opti">
              {typograph('У обычного прозрачного стекла лёгкий зеленоватый оттенок — он становится заметен, когда стекло окрашивают. Для чистого цвета перегородку можно сделать на стекле Opti White: у него такого оттенка нет.')}
            </p>
          </details>
        </div>

        <h3 class="oa-subhead oa-refs__title">Материалы фабрики</h3>
        <ul class="oa-refs" role="list">
          {references.map((r) => (
            <li>
              <figure class="oa-ref">
                <button type="button" class="oa-ref__media" data-zoom={r.image.src} data-zoom-caption={r.caption} aria-label={zoom(r.image.alt)}>
                  <img src={r.image.src} srcset={r.image.srcset} sizes="(min-width: 62.5rem) 22vw, 46vw" width={r.image.width} height={r.image.height} alt={r.image.alt} loading="lazy" decoding="async" />
                </button>
                <figcaption class="h-meta oa-ref__caption">{r.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Как заказать ── -->
    <section id="oa-order" class="h-sec h-sec--wall" aria-labelledby="oa-order-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-order-title" class="h-h2">Как заказать перегородку</h2>
          <div>
            <p class="h-lead">Позвоните <a href={`tel:${PHONE.raw}`} class="h-link oa-nowrap">{PHONE.label}</a> или приезжайте в&nbsp;салон&nbsp;— {typograph(SITE.address.full)}.</p>
          </div>
        </header>
        <ol class="oa-steps" role="list">
          <li class="oa-step">
            <span class="oa-step__num" aria-hidden="true">1</span>
            <h3 class="oa-step__title">Соберите в&nbsp;конструкторе</h3>
            <p class="h-body">{typograph('Раскладка, цвет профиля и стекло — или выберите вместе с нами в салоне.')}</p>
          </li>
          <li class="oa-step">
            <span class="oa-step__num" aria-hidden="true">2</span>
            <h3 class="oa-step__title">Пришлите размеры</h3>
            <p class="h-body">{typograph('Ширина и высота проёма — по ним рассчитаем перегородку.')}</p>
          </li>
          <li class="oa-step">
            <span class="oa-step__num" aria-hidden="true">3</span>
            <h3 class="oa-step__title">Получите расчёт</h3>
            <p class="h-body">{typograph('Стоимость перегородки под ваш проём и выбранную отделку.')}</p>
          </li>
          <li class="oa-step">
            <span class="oa-step__num" aria-hidden="true">4</span>
            <h3 class="oa-step__title">Изготовление</h3>
            <p class="h-body">{typograph('На фабрике — от 10 рабочих дней.')}</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ── Статьи по теме + каталог и контакты ── -->
    <section class="h-sec" aria-labelledby="oa-more-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-more-title" class="h-h2">Ещё о&nbsp;зонировании</h2>
          <div>
            <p class="h-lead">{typograph('Как разделить пространство без стен, какое стекло выбрать и какие ещё решения есть для раздвижных систем.')}</p>
            <a href="/partitions/" class="h-pill h-pill--line oa-more__grafia">Перегородки GRAFIA <Fragment set:html={arrow} /></a>
          </div>
        </header>
        {related.length > 0 && (
          <ul class="oa-posts h-rail" role="list" style={`--cols: ${related.length}`}>
            {related.map((a) => <li><ArticleCard article={a} /></li>)}
          </ul>
        )}
        <div class="oa-more__nav">
          <ArticleNav />
        </div>
      </div>
    </section>

    <!-- ── Частые вопросы ── -->
    <section id="oa-faq" class="h-sec h-sec--wall" aria-labelledby="oa-faq-title">
      <div class="container oa-faq">
        <h2 id="oa-faq-title" class="h-h2">Вопросы о&nbsp;перегородках ALUM</h2>
        <div class="oa-faq__list">
          <FaqAccordion items={ONIKS_FAQ} title={false} />
        </div>
      </div>
    </section>

    <VisitBand lead={`Приезжайте обсудить проект: подберём раскладку, профиль и стекло перегородки ${ONIKS.system} и рассчитаем её по вашим размерам.`} />

    <ArticleLightbox />
  </div>
</BaseLayout>

<script>
  /* Телефон: справочные списки свёрнуты под заголовки (без JS — раскрыты) */
  if (matchMedia('(max-width: 43.6875rem)').matches) {
    document.querySelectorAll<HTMLDetailsElement>('[data-collapse-mobile]').forEach((d) => { d.open = false })
  }

  /* Лента фото: стрелки на компьютере, гаснут у краёв ленты */
  const rail = document.querySelector<HTMLElement>('[data-oa-rail]')
  const prev = document.querySelector<HTMLButtonElement>('[data-oa-rail-prev]')
  const next = document.querySelector<HTMLButtonElement>('[data-oa-rail-next]')
  if (rail && prev && next) {
    const step = () => Math.max(rail.clientWidth * 0.8, 200)
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    const update = () => {
      prev.disabled = rail.scrollLeft <= 4
      next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4
    }
    prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' }))
    next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' }))
    rail.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)
    update()
  }
</script>

<style>
  /* ── Первый экран ── */
  .oa-hero { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 4rem); }
  .oa-hero__grid { display: grid; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  @media (min-width: 62.5rem) {
    .oa-hero__grid { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.2fr); }
  }
  .oa-lockup {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.625rem;
    margin: 0;
    padding: 0.3125rem 0.875rem 0.3125rem 0.3125rem;
    border: 0.0625rem solid var(--h-rule);
    border-radius: 999rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--h-ink);
  }
  .oa-lockup img { width: 2rem; height: 2rem; border-radius: 50%; }
  .oa-lockup__x { font-weight: 400; color: var(--h-muted); }
  .oa-hero__title {
    margin: 1.25rem 0 0;
    font-family: var(--h-font);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--h-weight-display);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--h-ink);
    text-wrap: balance;
  }
  .oa-hero__lead { margin-top: 1.25rem; max-width: 34rem; }
  .oa-hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
