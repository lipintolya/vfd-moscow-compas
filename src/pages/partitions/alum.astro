---
/**
 * /partitions/alum/ — раздвижные перегородки ALUM, подбор и расчёт в
 * Студии Зизевского. Название фабрики на странице не упоминается.
 * Отдельно от /partitions/ (системы GRAFIA), но в дизайн-системе главной
 * (home.css).
 *
 * Порядок — как у страницы с понятной структурой товара: первый экран
 * (что за система и как её рассчитать) → конструктор (раскладка, профиль,
 * стекло — AlumBuilder) и под ним характеристики и комплект → все раскладки
 * сеткой (AlumLeaf; «Собрать такую» подставляет отделку в конструктор) →
 * профиль и стекло, материалы фабрики → преимущества → как заказать
 * (StepsRow) → статьи по теме → вопросы → призыв рассчитать → как добраться.
 * Цен на страницах фабрики нет — и здесь их нет.
 *
 * Тексты, цифры и фото — src/data/alum-partitions.ts (в разметке — только
 * подписи кнопок), исходники фото — assets/alum-partitions/ (README там же)
 * → npm run gen:alum. Салон — из src/config/site.ts.
 *
 * Для поисковиков: Service с салоном-исполнителем (без бренда фабрики),
 * FAQPage, хлебные крошки, LocalBusiness. Фото открываются во весь экран
 * (ArticleLightbox, светлый фон). Фото фабрики с её логотипом не используем.
 */
import {
  ALUM_SYSTEM, ALUM_PAGE, ALUM_FACTS, ALUM_LAYOUT_COUNT, ALUM_HERO, ALUM_SECTIONS as SEC,
  ALUM_MODELS, ALUM_SPECS, ALUM_KIT, ALUM_COMPONENTS, ALUM_OPTI_WHITE, ALUM_PROFILES,
  ALUM_GLASSES, ALUM_GLASS_GROUPS, ALUM_ENAMEL_NOTE, ALUM_BENEFITS,
  ALUM_REFERENCES, ALUM_STEPS, ALUM_ARTICLES, ALUM_VISIT_LEAD, ALUM_FAQ, profileById, glassById,
  type AlumGlass,
} from '../../data/alum-partitions'
import { getArticles } from '../../lib/articles'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { brandTitle } from '../../lib/seo-title'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../../components/ui/FaqAccordion.astro'
import QuoteCta from '../../components/ui/QuoteCta.astro'
import SectionNav from '../../components/partitions/SectionNav.astro'
import AlumBuilder from '../../components/partitions/AlumBuilder.astro'
import AlumLeaf from '../../components/partitions/AlumLeaf.astro'
import StepsRow from '../../components/home/StepsRow.astro'
import VisitBand from '../../components/home/VisitBand.astro'
import ArticleCard from '../../components/articles/ArticleCard.astro'
import ArticleNav from '../../components/articles/ArticleNav.astro'
import ArticleLightbox from '../../components/articles/ArticleLightbox.astro'
import '../../styles/home.css'
import { PHONE, SITE } from '../../config/site'
import { localBusinessSchema, LOCAL_BUSINESS_ID } from '../../lib/local-business-schema'
import { typograph, upperFirst } from '../../lib/typograph'

/* ── SEO ── Перегородки другой фабрики: в заголовке — салон, а не бренд ВФД */
const title = brandTitle(`Раздвижные перегородки для зонирования комнаты ${SITE.city.in}`)
// ~160 символов — длиннее поисковики обрезают
const description =
  `Раздвижные алюминиевые перегородки ${ALUM_SYSTEM} ${SITE.city.in}: ${ALUM_LAYOUT_COUNT}, ` +
  `${ALUM_FACTS.glass}, высота ${ALUM_FACTS.height}. Подбор и расчёт в ${SITE.studioNameOf}.`
const pageUrl = new URL(ALUM_PAGE.path, SITE.url).href
const abs = (src: string) => new URL(src, SITE.url).href

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: `Раздвижные алюминиевые перегородки ${ALUM_SYSTEM} ${SITE.city.in}`,
  serviceType: 'Подбор и заказ раздвижных алюминиевых перегородок',
  description,
  url: pageUrl,
  image: [abs(ALUM_HERO.image.src), ...ALUM_REFERENCES.items.map((r) => abs(r.image.src))],
  provider: { '@id': LOCAL_BUSINESS_ID },
  areaServed: [
    { '@type': 'City', name: SITE.city.name },
    { '@type': 'AdministrativeArea', name: 'Московская область' },
  ],
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: ALUM_FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Перегородки', href: '/partitions/' },
  { label: ALUM_PAGE.name },
]

const navItems = [
  { id: 'oa-builder', label: SEC.builder.nav },
  { id: 'oa-layouts', label: SEC.photos.nav },
  { id: 'oa-finish',  label: SEC.finish.nav },
  { id: 'oa-order',   label: SEC.order.nav },
  { id: 'oa-faq',     label: SEC.faq.nav },
]

/* Статьи по теме — по списку из данных; опечатка в имени — ошибка сборки */
const articles = await getArticles()
const related = ALUM_ARTICLES.map((id) => {
  const article = articles.find((a) => a.id === id)
  if (!article) throw new Error(`Перегородки ALUM: нет статьи «${id}» — поправьте ALUM_ARTICLES в src/data/alum-partitions.ts`)
  return article
})

/* Образцы профиля и стекла — цвета из данных, как в конструкторе */
const profileLayer = (p: { color: string; shade: string }) => `linear-gradient(145deg, ${p.color} 35%, ${p.shade})`
/* Образец стекла — слоями: тон поверх «комнаты» (прозрачное и сатинат),
   сплошной цвет (белое, чёрное, лакобель), градиент зеркала. Цвет не годится
   как background-image, поэтому тон и зеркало передаём разными свойствами */
const glassTint = (g: AlumGlass) =>
  g.kind === 'mirror' ? 'transparent'
  : g.kind === 'solid' ? g.color
  : `color-mix(in srgb, ${g.color} ${Math.round((g.opacity ?? 0.2) * 100)}%, transparent)`
const glassMirror = (g: AlumGlass) =>
  g.kind === 'mirror' ? `linear-gradient(135deg, ${g.mirror?.[0] ?? g.color}, ${g.mirror?.[1] ?? g.color})` : 'none'

const zoom = (alt: string) => `Открыть фото на весь экран: ${alt}`
const arrow = '<svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage={abs(ALUM_HERO.image.src)}
  structuredData={[localBusinessSchema({ url: SITE.url }), serviceSchema, faqSchema]}
  preloadImage={ALUM_HERO.image.src}
  preloadImageSrcset={ALUM_HERO.image.srcset}
  preloadImageSizes="(min-width: 62.5rem) 52vw, 100vw"
>
  <SectionNav items={navItems} />

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="home">
    {/* ── Первый экран ── */}
    <section class="oa-hero" aria-labelledby="oa-title">
      <div class="container oa-hero__grid">
        <div>
          <h1 id="oa-title" class="oa-hero__title">{typograph(ALUM_HERO.title)}</h1>
          <p class="h-lead oa-hero__lead">{typograph(ALUM_HERO.lead)}</p>
          <div class="oa-hero__actions">
            <a href="#oa-builder" class="h-btn h-btn--signal">Собрать перегородку</a>
            <a href={`tel:${PHONE.raw}`} class="h-btn h-btn--quiet">Рассчитать по&nbsp;телефону</a>
          </div>
        </div>
        <figure class="h-media oa-hero__media">
          <button type="button" data-zoom={ALUM_HERO.image.src} data-zoom-caption={ALUM_HERO.image.alt} aria-label={zoom(ALUM_HERO.image.alt)}>
            <img
              src={ALUM_HERO.image.src}
              srcset={ALUM_HERO.image.srcset}
              sizes="(min-width: 62.5rem) 52vw, 100vw"
              width={ALUM_HERO.image.width}
              height={ALUM_HERO.image.height}
              alt={ALUM_HERO.image.alt}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </button>
        </figure>
      </div>
    </section>

    {/* ── Конструктор и характеристики ── */}
    <section id="oa-builder" class="h-sec" aria-labelledby="oa-builder-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-builder-title" class="h-h2">{typograph(SEC.builder.title)}</h2>
          <div>
            <p class="h-lead">{typograph(SEC.builder.lead)}</p>
          </div>
        </header>
        <AlumBuilder />

        <div class="oa-specs-block">
          <h3 class="oa-subhead oa-specs-block__title">{SEC.specs.title}</h3>
          <div class="oa-specs-grid">
            <dl class="oa-specs">
              {ALUM_SPECS.map((s) => (
                <div class="oa-specs__row">
                  <dt class="h-meta">{s.label}</dt>
                  <dd class="h-body">{typograph(upperFirst(s.value))}</dd>
                </div>
              ))}
            </dl>
            <div class="oa-kit">
              {Object.values(ALUM_KIT).map((group) => (
                <div>
                  <h4 class="oa-subhead">{group.title}</h4>
                  <ul class="oa-rules" role="list">
                    {group.items.map((k) => <li class="h-body">{typograph(upperFirst(k))}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </div>
          <details class="oa-fold oa-fold--more" open data-collapse-mobile>
            <summary class="oa-subhead">{ALUM_COMPONENTS.title}</summary>
            <ul class="oa-rules" role="list">
              {ALUM_COMPONENTS.items.map((c) => <li class="h-body">{typograph(c)}</li>)}
            </ul>
          </details>
        </div>
      </div>
    </section>

    {/* ── Все раскладки — рисунками створки, сеткой без ленты ── */}
    <section id="oa-layouts" class="h-sec h-sec--wall" aria-labelledby="oa-layouts-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-layouts-title" class="h-h2">{typograph(SEC.photos.title)}</h2>
          <div>
            <p class="h-lead">{typograph(SEC.photos.lead)}</p>
          </div>
        </header>

        <ul class="oa-grid" role="list">
          {ALUM_MODELS.map((m) => (
            <li class="oa-card">
              <figure class="h-media oa-card__media">
                <AlumLeaf
                  uid={`oa-m${m.num}`}
                  layouts={[m]}
                  active={m.num}
                  profile={profileById(m.profile)}
                  glass={glassById(m.glass)}
                  title={`Перегородка ${m.name}: ${m.layout.toLowerCase()}, ${m.shown.toLowerCase()}`}
                  class="oa-card__leaf"
                />
              </figure>
              <h3 class="oa-card__name">{m.name}</h3>
              <p class="oa-card__layout">{typograph(m.layout)}</p>
              <p class="h-meta oa-card__shown">{typograph(m.shown)}</p>
              <button type="button" class="h-pill h-pill--line oa-card__apply" data-oa-apply={`${m.num},${m.profile},${m.glass}`}>Собрать такую</button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ── Профиль и стекло, материалы фабрики ── */}
    <section id="oa-finish" class="h-sec" aria-labelledby="oa-finish-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-finish-title" class="h-h2">{typograph(SEC.finish.title)}</h2>
          <div>
            <p class="h-lead">{typograph(SEC.finish.lead)}</p>
          </div>
        </header>

        <div class="oa-finish">
          <div class="oa-finish__group">
            <h3 class="oa-subhead">Цвет профиля</h3>
            <ul class="oa-tiles" role="list">
              {ALUM_PROFILES.map((p) => (
                <li class="oa-tile">
                  <span class="oa-tile__swatch oa-tile__swatch--profile" aria-hidden="true" style={`--sw: ${profileLayer(p)}`} />
                  <span class="oa-tile__name">{p.name}</span>
                  {p.enamel && <span class="h-meta oa-tile__note">{ALUM_ENAMEL_NOTE}</span>}
                </li>
              ))}
            </ul>
          </div>

          <div class="oa-finish__group">
            <h3 class="oa-subhead">Стекло</h3>
            {ALUM_GLASS_GROUPS.map((grp) => (
              <div class="oa-glass-group">
                <p class="h-meta oa-glass-group__title">{grp.title}</p>
                <ul class="oa-tiles" role="list">
                  {ALUM_GLASSES.filter((g) => g.group === grp.id).map((g) => (
                    <li class="oa-tile">
                      <span class="oa-tile__swatch oa-tile__swatch--glass" aria-hidden="true" data-kind={g.kind} style={`--tint: ${glassTint(g)}; --mirror: ${glassMirror(g)}`} />
                      <span class="oa-tile__name">{g.name}</span>
                      {g.note && <span class="h-meta oa-tile__note">{g.note}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <div class="oa-opti">
              <h3 class="oa-subhead">{ALUM_OPTI_WHITE.title}</h3>
              <p class="h-body oa-opti__text">{typograph(ALUM_OPTI_WHITE.text)}</p>
            </div>
          </div>

          <div class="oa-finish__group">
            <h3 class="oa-subhead">{ALUM_REFERENCES.title}</h3>
            <ul class="oa-refs" role="list" style={`--cols: ${ALUM_REFERENCES.items.length}`}>
              {ALUM_REFERENCES.items.map((r) => (
                <li>
                  <figure class="oa-ref">
                    <button type="button" class="oa-ref__media" data-zoom={r.image.src} data-zoom-caption={r.caption} aria-label={zoom(r.image.alt)}>
                      <img src={r.image.src} srcset={r.image.srcset} sizes="(min-width: 62.5rem) 22vw, 46vw" width={r.image.width} height={r.image.height} alt={r.image.alt} loading="lazy" decoding="async" />
                    </button>
                    <figcaption class="h-meta oa-ref__caption">{r.caption}</figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── Преимущества — светлый список, без второго тёмного блока рядом с шагами ── */}
    <section id="oa-benefits" class="h-sec h-sec--wall" aria-labelledby="oa-benefits-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-benefits-title" class="h-h2">{typograph(SEC.benefits.title)}</h2>
          <div>
            <p class="h-lead">{typograph(SEC.benefits.lead)}</p>
          </div>
        </header>
        <ul class="oa-points" role="list">
          {ALUM_BENEFITS.map((b) => (
            <li class="oa-point">
              <h3 class="h-h3 oa-point__title">{typograph(b.title)}</h3>
              <p class="h-body oa-point__text">{typograph(b.text)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ── Как заказать ── */}
    <StepsRow id="oa-order" title={SEC.order.title} lead={SEC.order.lead} steps={ALUM_STEPS}>
      <p class="oa-order__call">
        <a href={`tel:${PHONE.raw}`} class="h-btn h-btn--signal">Рассчитать по&nbsp;телефону</a>
      </p>
    </StepsRow>

    {/* ── Статьи по теме ── */}
    <section class="h-sec" aria-labelledby="oa-articles-title">
      <div class="container">
        <header class="h-head">
          <h2 id="oa-articles-title" class="h-h2">{typograph(SEC.articles.title)}</h2>
          <div>
            <p class="h-lead">{typograph(SEC.articles.lead)}</p>
            <a href={SEC.articles.more.href} class="h-pill h-pill--line oa-articles__more">{SEC.articles.more.label} <Fragment set:html={arrow} /></a>
          </div>
        </header>
        <ul class="oa-posts h-rail" role="list" style={`--cols: ${related.length}`}>
          {related.map((a) => <li><ArticleCard article={a} /></li>)}
        </ul>
        <div class="oa-articles__nav">
          <ArticleNav />
        </div>
      </div>
    </section>

    {/* ── Частые вопросы ── */}
    <section id="oa-faq" class="h-sec h-sec--wall" aria-labelledby="oa-faq-title">
      <div class="container oa-faq">
        <h2 id="oa-faq-title" class="h-h2">{typograph(SEC.faq.title)}</h2>
        <div class="oa-faq__list">
          <FaqAccordion items={ALUM_FAQ} title={false} />
        </div>
      </div>
    </section>

    {/* ── Призыв рассчитать — перед картой ── */}
    <section class="h-sec" aria-label="Расчёт перегородки">
      <div class="container">
        <QuoteCta
          image={ALUM_HERO.image.src}
          title={SEC.cta.title}
          description={SEC.cta.description}
          primaryHref={`tel:${PHONE.raw}`}
          primaryLabel="Позвонить"
          primaryExternal={false}
          secondaryHref="#oa-builder"
          secondaryLabel="Собрать перегородку"
        />
      </div>
    </section>

    <VisitBand lead={ALUM_VISIT_LEAD} />

    {/* Светлый фон: чёрный профиль перегородок на тёмном теряется */}
    <ArticleLightbox tone="light" />
  </div>
</BaseLayout>

<script>
  /* Справочные списки на телефоне свёрнуты под заголовки (без JS —
     раскрыты). Когда сворачивать, решает CSS (--oa-fold), а не второй
     брейкпоинт в скрипте */
  document.querySelectorAll<HTMLDetailsElement>('[data-collapse-mobile]').forEach((d) => {
    if (getComputedStyle(d).getPropertyValue('--oa-fold').trim() === 'closed') d.open = false
  })
</script>

<style>
  /* ── Первый экран: снизу без отступа — его даёт следующая секция ── */
  .oa-hero { padding-top: clamp(1.5rem, 3vw, 2.5rem); }
  .oa-hero__grid { display: grid; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  @media (min-width: 62.5rem) {
    .oa-hero__grid { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.2fr); }
  }
  .oa-hero__title {
    margin: 0;
    font-family: var(--h-font);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--h-weight-display);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--h-ink);
    text-wrap: balance;
  }
  .oa-hero__lead { margin-top: 1.25rem; }
  .oa-hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .oa-hero__media { aspect-ratio: 1000 / 743; border-radius: var(--h-tile-radius); }
  .oa-hero__media > button { height: 100%; }

  /* ── Характеристики под конструктором: таблица и комплект рядом ── */
  .oa-specs-block { margin-top: clamp(3rem, 6vw, 4.5rem); }
  .oa-specs-block__title { margin-bottom: 1.25rem; }
  .oa-specs-grid { display: grid; gap: clamp(1.75rem, 4vw, 3rem); }
  @media (min-width: 62.5rem) { .oa-specs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; } }
  .oa-specs { margin: 0; border-top: 0.0625rem solid var(--h-rule); }
  .oa-specs__row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 1rem; padding: 0.875rem 0; border-bottom: 0.0625rem solid var(--h-rule); }
  .oa-specs__row dt { color: var(--h-muted); }
  .oa-specs__row dd { margin: 0; color: var(--h-ink); }

  /* «В комплекте» и «Отдельно» — короткие списки, рядом и на телефоне */
  .oa-kit { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr)); gap: 1rem var(--h-gutter); }
  .oa-kit h4 { margin: 0 0 0.75rem; }
  .oa-fold { margin: clamp(2rem, 4vw, 2.5rem) 0 0; }
  /* Телефон: комплектующие сворачиваются, пока их не открыли */
  .oa-fold { --oa-fold: open; }
  @media (max-width: 43.6875rem) {
    .oa-fold { --oa-fold: closed; }
  }
  .oa-fold > summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .oa-fold > summary::-webkit-details-marker { display: none; }
  .oa-fold > summary::after { content: ''; width: 0.5rem; height: 0.5rem; border-right: 0.125rem solid currentColor; border-bottom: 0.125rem solid currentColor; transform: rotate(45deg) translate(-0.125rem, -0.125rem); }
  .oa-fold[open] > summary::after { transform: rotate(225deg); }
  /* Стрелка — только там, где блок сворачивается (телефон) */
  @media (min-width: 43.75rem) { .oa-fold > summary::after { display: none; } }
  .oa-subhead { margin: 0 0 0.75rem; font-family: var(--h-font); font-size: 1.125rem; font-weight: 600; letter-spacing: -0.01em; color: var(--h-ink); }
  .oa-rules { margin: 0; padding: 0; list-style: none; border-top: 0.0625rem solid var(--h-rule); }
  .oa-rules li { margin: 0; padding: 0.75rem 0; border-bottom: 0.0625rem solid var(--h-rule); color: var(--h-ink); }

  /* ── Раскладки: сетка 2 / 3 / 5 в ряд, без ленты и стрелок ── */
  .oa-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.25rem) var(--h-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
