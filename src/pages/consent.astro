---
/**
 * /consent/ — согласие на обработку персональных данных через cookie
 * Яндекс Метрики. С 1 сентября 2025 года согласие — отдельный документ, не
 * часть политики (ч. 1 ст. 9 152-ФЗ). Посетитель даёт его кнопкой «Принять»
 * в баннере (components/analytics/CookieConsent.astro), баннер ссылается
 * сюда. Поменяли условия — поднимите CONSENT_VERSION (src/lib/cookie-consent.ts).
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import { brandTitle } from '../lib/seo-title'
import { SITE } from '../config/site'
import { PD_OPERATOR, METRIKA_PROCESSOR, METRIKA_DATA, PD_DOCS_DATE } from '../data/personal-data'
import '../styles/legal.css'

const mail = `mailto:${PD_OPERATOR.email}`
---

<BaseLayout
  title={brandTitle('Согласие на обработку персональных данных')}
  description={`Согласие посетителя сайта ${SITE.host} на обработку персональных данных с помощью cookie Яндекс Метрики`}
  noIndex={true}
>
  <div class="prv-page">
    <div class="prv-wrap">

      <h1 class="prv-title">Согласие на обработку персональных данных с помощью cookie</h1>

      <p>Нажимая «Принять» в уведомлении о cookie на сайте <strong>{SITE.host}</strong>, я свободно, своей волей и в своём интересе даю согласие <strong>{PD_OPERATOR.name}</strong>, адрес: {SITE.address.full} (далее — Оператор, e-mail <a href={mail}>{PD_OPERATOR.email}</a>) на обработку моих персональных данных на условиях ниже. Согласие конкретное, информированное и сознательное: я ознакомлен(а) с этими условиями и с <a href="/privacy/">Политикой в отношении обработки персональных данных</a>.</p>

      <section class="prv-section">
        <h2>1. Цель обработки</h2>
        <p>Статистика посещений сайта и анализ того, как посетители им пользуются, — чтобы улучшать содержание и удобство сайта. Оператор не использует эти данные для рекламы.</p>
      </section>

      <section class="prv-section">
        <h2>2. Какие данные обрабатываются</h2>
        <ul>
          {METRIKA_DATA.map((item) => <li>{item};</li>)}
        </ul>
        <p>Имя, телефон, адрес электронной почты и другие сведения, по которым человека узнают напрямую, этим способом не собираются.</p>
      </section>

      <section class="prv-section">
        <h2>3. Действия с данными и способ обработки</h2>
        <p>Сбор, запись, систематизация, накопление, хранение, уточнение, извлечение, использование, предоставление {METRIKA_PROCESSOR.name}, обезличивание, блокирование, удаление и уничтожение. Обработка автоматизированная — с помощью сервиса Яндекс Метрика.</p>
      </section>

      <section class="prv-section">
        <h2>4. Кто обрабатывает данные по поручению Оператора</h2>
        <p>{METRIKA_PROCESSOR.name} ({METRIKA_PROCESSOR.address}) — владелец сервиса Яндекс Метрика. Обрабатывает данные по поручению Оператора (ч. 3 ст. 6 Федерального закона № 152-ФЗ) на условиях использования Метрики и своей <a href={METRIKA_PROCESSOR.policy} target="_blank" rel="noopener">политики конфиденциальности</a>. Сам Оператор не передаёт данные за пределы Российской Федерации. Политика Яндекса допускает передачу данных аффилированным лицам и обработку в других юрисдикциях — см. её раздел о передаче данных по ссылке выше.</p>
      </section>

      <section class="prv-section">
        <h2>5. Срок действия и отзыв согласия</h2>
        <p>Согласие действует до его отзыва. Отозвать его можно в любой момент:</p>
        <ul>
          <li>кнопкой «Настройки cookie» внизу любой страницы сайта → «Отказаться»: Метрика перестаёт работать в этом браузере, её cookie удаляются;</li>
          <li>письмом на <a href={mail}>{PD_OPERATOR.email}</a> с пометкой «Отзыв согласия на обработку персональных данных».</li>
        </ul>
        <p>После отзыва Оператор прекращает обработку и уничтожает данные в сроки, установленные ст. 21 Федерального закона № 152-ФЗ.</p>
      </section>

      <section class="prv-section">
        <h2>6. Если не давать согласие</h2>
        <p>Согласие добровольное. Кнопка «Отказаться» запрещает Метрику — сайт работает полностью, ни один раздел не закрывается. В браузере остаётся только запись о вашем выборе (согласие или отказ и дата), чтобы сайт не спрашивал при каждом визите.</p>
      </section>

      <div class="prv-requisites">
        <p><strong>Оператор:</strong> {PD_OPERATOR.name}</p>
        <p><strong>Адрес оператора:</strong> {SITE.address.full}</p>
        <p><strong>E-mail:</strong> <a href={mail}>{PD_OPERATOR.email}</a></p>
        <p><strong>Редакция от</strong> {PD_DOCS_DATE}</p>
      </div>

    </div>
  </div>
</BaseLayout>
