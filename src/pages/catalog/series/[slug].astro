---
/**
 * src/pages/catalog/series/[slug].astro
 * Лендинг серии: hero + якорная навигация + описание + преимущества +
 * характеристики + живая сетка моделей серии (Supabase, через catalog-data).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro'
import CatalogGrid from '../../../components/catalog/CatalogGrid.vue'
import InfoImageViewer from '../../../components/catalog/InfoImageViewer.vue'
import { getCatalogCards, getSeriesList, getSeriesCards, getColorsByCoatingSlug } from '../../../lib/catalog-data'
import { getSeriesSpec } from '../../../data/series-descriptions'
import type { CatalogCardItem } from '../../../components/catalog/types'
import { merchantPolicy } from '../../../lib/contacts-data'
import { coatingInline, hasWords, pluralRu } from '../../../lib/product-text'
import { PHONE as SITE_PHONE, SITE } from '../../../config/site'

export async function getStaticPaths() {
  const { cards } = await getCatalogCards()
  const seriesList = getSeriesList(cards)

  return seriesList.map(series => ({
    params: { slug: series.slug },
    props: { series, cards },
  }))
}

interface Props {
  series: { slug: string; name: string; coatingSlug: string; modelCount: number; minPrice: number | null }
  cards:  CatalogCardItem[]
}

const { series, cards } = Astro.props as Props

const seriesCards   = getSeriesCards(cards, series.slug)
const spec          = getSeriesSpec(series.slug, series.coatingSlug)
const heroImage     = spec.heroImage || seriesCards[0]?.photo || ''
const paletteColors = await getColorsByCoatingSlug(series.coatingSlug, series.slug)

const fmt = (n: number) => n.toLocaleString('ru-RU') + ' ₽'

const PHONE = SITE_PHONE.raw
const TG    = SITE.social.telegram
const VK    = SITE.social.vk
const MAX   = SITE.social.max

const canonicalUrl = Astro.site ? new URL(`/catalog/series/${series.slug}/`, Astro.site).href : undefined

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог', href: '/catalog/' },
  { label: 'Серии',   href: '/catalog/#series' },
  { label: series.name },
]

/* ── Характеристики — только заполненные поля (у серий без записи в
   seriesDescriptions, напр. "Смарт", всё это может быть пусто) ── */
const characteristics = [
  { label: 'Покрытие',        value: spec.coating },
  { label: 'Материал',        value: spec.material },
  { label: 'Кромка',          value: spec.edge },
  { label: 'Толщина полотна', value: spec.thickness ? `${spec.thickness} мм` : '' },
].filter(row => row.value)

const jumpLinks = [
  spec.description       && { href: '#about',    label: 'О коллекции' },
  spec.features.length   && { href: '#features', label: 'Особенности' },
  characteristics.length && { href: '#specs',    label: 'Характеристики' },
  paletteColors.length    && { href: '#colors',   label: 'Доступные цвета' },
  { href: '#models', label: 'Модели' },
].filter(Boolean) as { href: string; label: string }[]

/* Покрытие — из карточек серии (у серии одно покрытие). Пропускаем, если
   оно уже звучит в названии серии («Урбан ПЭТ», «Эмалекс Модерн»). */
const coatingName    = seriesCards[0]?.coating ?? ''
const coatingPhrase  = coatingName && !hasWords(series.name, coatingName)
  ? coatingInline({ coatingName, coatingSlug: series.coatingSlug })
  : ''
const modelsPhrase   = `${series.modelCount} ${pluralRu(series.modelCount, ['модель', 'модели', 'моделей'])}`

/* Тип товара первым — по нему ищут («межкомнатные двери скинель»),
   а само название серии тип не называет. */
const pageTitle = `Межкомнатные двери ${series.name}${coatingPhrase ? ` (${coatingPhrase})` : ''} — купить в Москве, цены | ВФД`
/* Короткая генерация всегда в meta — та же причина, что на models/[id].astro:
   spec.description (маркетинговый текст серии) длиннее ~155 символов нормы
   SERP-сниппета и не упоминает город/цену — Google обрежет её на середине
   фразы. spec.description остаётся на странице как есть (блок "О коллекции"). */
const pageDesc  =
  `Межкомнатные двери серии ${series.name}${coatingPhrase ? ` (${coatingPhrase})` : ''} — ${modelsPhrase}${series.minPrice ? `, цены от ${fmt(series.minPrice)} за полотно` : ''}. Купить в Москве в салоне ВФД в ТЦ «Компас»: замер, доставка и установка.`

/* BreadcrumbList в JSON-LD отдаёт сам Breadcrumbs.astro — здесь не дублируем. */
const structuredData = canonicalUrl ? [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Межкомнатные двери серии ${series.name}`,
    description: pageDesc,
    url: canonicalUrl,
    numberOfItems: seriesCards.length,
  },
  /* ItemList с Product/Offer на каждую модель серии — компактный список
     (в отличие от /catalog/ с 300+ моделей, где ItemList такого размера
     раздул бы страницу без выгоды), даёт карусель товаров в выдаче. */
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Модели серии ${series.name}`,
    itemListElement: seriesCards.map((card, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Product',
        name: card.name,
        description: `Дверь ${card.name} серии ${series.name}. Купить в салоне ВФД в Москве.`,
        url: new URL(`/models/${card.slug}/`, canonicalUrl).href,
        image: card.photo || undefined,
        brand: { '@type': 'Brand', name: 'ВФД' },
        ...(card.price
          ? {
              offers: {
                '@type':                 'Offer',
                price:                   card.price,
                priceCurrency:           'RUB',
                availability:            'https://schema.org/InStoreOnly',
                seller:                  { '@type': 'Organization', name: 'Салон дверей ВФД' },
                hasMerchantReturnPolicy: merchantPolicy.returnPolicy,
                shippingDetails:         merchantPolicy.shipping,
              },
            }
          : {}),
      },
    })),
  },
] : undefined
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  ogImage={heroImage || undefined}
  preloadImage={heroImage || undefined}
  canonical={canonicalUrl}
  structuredData={structuredData}
>

  <!-- ══════════════════════════════════════════════
       HERO + ЯКОРНАЯ НАВИГАЦИЯ
       Обложка заходит под фикс. хедер (margin-top отрицательный на
       высоту хедера), крошки — поверх фото, как в референсе volhovec.
  ══════════════════════════════════════════════ -->
  <section class="sr-hero" aria-label={`Серия ${series.name}`}>
    {heroImage && (
      <img
        src={heroImage}
        alt={`Двери серии ${series.name} — ВФД`}
        class="sr-hero__img"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1600"
        height="900"
      />
    )}
    <div class="sr-hero__overlay" aria-hidden="true"></div>
    <div class="container sr-hero__content">
      <div class="sr-hero__crumbs">
        <Breadcrumbs items={breadcrumbItems} />
      </div>
      <div class="sr-hero__body">
        <h1 class="sr-hero__h1">
          <span class="sr-eyebrow">{'Межкомнатные двери серии '}</span>{series.name}
        </h1>
        {spec.tagline && <p class="sr-hero__tagline">{spec.tagline}</p>}
        <div class="sr-hero__actions">
          <a href={TG} target="_blank" rel="noopener" class="btn btn-ghost">Получить расчёт</a>
          <a href={`tel:${PHONE}`} class="btn btn-ghost">Позвонить</a>
        </div>
      </div>
    </div>
  </section>

  {jumpLinks.length > 1 && (
    <nav class="sr-jumpnav" aria-label="Разделы страницы">
      <div class="container sr-jumpnav__row">
        {jumpLinks.map(link => (
          <a href={link.href} class="sr-jumpnav__link">{link.label}</a>
        ))}
      </div>
    </nav>
  )}

  <!-- ══════════════════════════════════════════════
       О КОЛЛЕКЦИИ
  ══════════════════════════════════════════════ -->
  {spec.description && (
    <section id="about" class="section sr-section">
      <div class="container">
        <h2 class="sr-h2">О коллекции</h2>
        <details class="sr-desc">
          <summary class="sr-desc__toggle">Читать описание</summary>
          <p class="sr-p sr-desc__text">{spec.description}</p>
        </details>
        {spec.infoImage && (
          <InfoImageViewer
            client:only="vue"
            variant="wide"
            aspectRatio={spec.infoImageAspect || '16 / 9'}
            images={[{
              src: spec.infoImage,
              caption: spec.infoImageCaption || `Презентация серии ${series.name}`,
              alt: spec.infoImageCaption || `Презентация серии ${series.name} — ВФД`,
            }]}
          />
        )}

        {spec.posterImages && spec.posterImages.length > 0 && (
          <InfoImageViewer
            client:only="vue"
            variant="wide"
            aspectRatio="1810 / 2560"
            columns={3}
            images={spec.posterImages.map((src, i) => ({
              src,
              caption: `${series.name} — постер ${i + 1}`,
              alt: `Коллекция ${series.name} — ВФД, постер ${i + 1}`,
            }))}
          />
        )}
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════════════
       ОСОБЕННОСТИ
  ══════════════════════════════════════════════ -->
  {spec.features.length > 0 && (
    <section id="features" class="section sr-section">
      <div class="container">
        <h2 class="sr-h2">Особенности</h2>
        <!-- Тот же язык карточки, что у «Доступные цвета» / CatalogProductCard —
             rounded-2xl border-slate-200 модуль снаружи, rounded-xl плитки внутри
             с hover:border-accent-200 hover:shadow-lg. Иконка — тонированный кружок
             (bg-accent-50/text-accent-600), как в CatalogEmptyState/Features.vue, не
             голая обводка-галочка. sr-features__item — единственный элемент с
             нечётным индексом последним растягивается на всю ширину (см. CSS),
             чтобы 5/7 фич не давали сиротливую узкую строку. -->
        <div class="sr-collapsible" data-collapsible>
          <ul class="sr-features sr-collapsible__content grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4" data-collapsible-content>
            {spec.features.map(feature => (
              <li class="sr-features__item group flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-accent-200 hover:shadow-lg hover:-translate-y-0.5">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent-50 text-accent-600">
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M4.5 10.5l3.5 3.5 7.5-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="pt-2 text-sm leading-relaxed text-slate-700">{feature}</span>
              </li>
            ))}
          </ul>
          <button type="button" class="sr-collapsible__toggle md:hidden" data-collapsible-toggle aria-expanded="false">
            <span data-collapsible-label>Показать полностью</span>
            <svg class="sr-collapsible__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════════════
       ХАРАКТЕРИСТИКИ
  ══════════════════════════════════════════════ -->
  {characteristics.length > 0 && (
    <section id="specs" class="section sr-section">
      <div class="container">
        <h2 class="sr-h2">Характеристики</h2>
        <!-- Не третья карточная сетка подряд — «Особенности» и «Доступные
             цвета» уже её использовали, повтор был бы монотонным (и данные
             тут другой природы: где-то абзац, где-то «39 мм»). Редакторский
             список: тонкий teal-номер + крупный тёмный лейбл как заголовок,
             значение — обычным текстом ниже, разделители только между
             пунктами (divide-y), не рамка на каждый ряд. Номер — та же идея,
             что и ghost-цифры в «Как мы работаем» (ProcessSteps), только
             тише — перекличка с сайтом, а не карточка в третий раз.

             specsImage (техническая инфографика конструкции полотна) —
             опциональна: если задана, список идёт в 2 колонки с картинкой
             (sticky на десктопе, картинка сверху на мобильном), иначе
             список остаётся на всю ширину, как было. -->
        <div class:list={['gap-x-12 gap-y-8', spec.specsImage && 'grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] lg:items-start']}>
          {spec.specsImage && (
            <div class="order-1 overflow-hidden rounded-2xl bg-slate-50 lg:order-2 lg:sticky lg:top-24">
              <img
                src={spec.specsImage}
                alt={`Конструкция полотна серии ${series.name}`}
                loading="lazy"
                decoding="async"
                width="800"
                height="800"
                class="h-full w-full object-contain"
              />
            </div>
          )}
          <div class:list={['order-2', spec.specsImage && 'lg:order-1']}>
            <div class="sr-collapsible" data-collapsible>
              <dl class="sr-specs sr-collapsible__content divide-y divide-slate-200" data-collapsible-content>
                {characteristics.map((row, i) => (
                  <div class="group -mx-5 rounded-xl px-5 py-7 transition-colors duration-200 first:pt-0 last:pb-0 lg:hover:bg-slate-50">
                    <dt class="mb-2 flex items-baseline gap-3">
                      <span class="text-sm font-semibold tabular-nums text-accent-600/60 transition-colors duration-200 group-hover:text-accent-600">{String(i + 1).padStart(2, '0')}</span>
                      <span class="text-lg font-semibold text-slate-900 transition-colors duration-200 group-hover:text-accent-700">{row.label}</span>
                    </dt>
                    <dd class="m-0 text-base leading-relaxed text-slate-600">{row.value}</dd>
                  </div>
                ))}
              </dl>
              <button type="button" class="sr-collapsible__toggle md:hidden" data-collapsible-toggle aria-expanded="false">
                <span data-collapsible-label>Показать полностью</span>
                <svg class="sr-collapsible__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════════════
       ДОСТУПНЫЕ ЦВЕТА
  ══════════════════════════════════════════════ -->
  {paletteColors.length > 0 && (
    <section id="colors" class="section sr-section">
      <div class="container">
        <h2 class="sr-h2">Доступные цвета</h2>
        <p class="sr-p sr-p--tight">
          Полная палитра покрытия — фабрика делает двери в любом из этих цветов,
          даже если фото конкретной модели в этом оттенке пока нет в каталоге.
        </p>
        <!-- Точка в белом боксе смотрелась слабо — маленький акцент в
             пустой карточке. Вместо этого структура настоящей товарной
             карточки (CatalogProductCard): цвет сам занимает верх карточки
             (на месте фото, которого для этого оттенка ещё нет), подпись
             снизу. Тот же самый узнаваемый паттерн сайта, не новый. -->
        <div class="sr-collapsible" data-collapsible>
          <!-- Фикс. максимум ширины трека (не 1fr) — плитки не растягиваются
               вслед за шириной контейнера, остаются компактным свотчем на
               любом экране (см. .sr-colors-grid в стилях ниже). Подпись —
               фикс. min-height + line-clamp-3 (самое длинное название,
               «Эмалекс тёмно-бежевый», реально занимает 3 строки на узкой
               карточке — с line-clamp-2 обрезалось), чтобы «Белый» и
               «Тёмно-бежевый» давали карточки одной высоты, а не вразнобой. -->
          <ul class="sr-colors-grid sr-collapsible__content" data-collapsible-content role="list">
            {paletteColors.map(color => (
              <li>
                <div class="group overflow-hidden rounded-xl border border-slate-200 bg-white transition hover:border-accent-200 hover:shadow-lg hover:-translate-y-0.5">
                  <span
                    class="block aspect-square w-full transition-transform duration-300 group-hover:scale-105"
                    style={`background-color:${color.hex}`}
                    aria-hidden="true"
                  />
                  <span class="flex min-h-18 items-center px-2.5 py-2 text-xs font-medium leading-snug text-slate-900 sm:text-sm">
                    <span class="line-clamp-3">{color.name}</span>
                  </span>
                </div>
              </li>
            ))}
          </ul>
          <button type="button" class="sr-collapsible__toggle md:hidden" data-collapsible-toggle aria-expanded="false">
            <span data-collapsible-label>Показать полностью</span>
            <svg class="sr-collapsible__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════════════
       МОДЕЛИ СЕРИИ
  ══════════════════════════════════════════════ -->
  <section id="models" class="section sr-section">
    <div class="container">
      <h2 class="sr-h2">Модели серии {series.name}</h2>
      <p class="sr-p sr-p--tight">
        {series.modelCount} {series.modelCount === 1 ? 'модель' : 'моделей'}
        {series.minPrice && <span> · от {fmt(series.minPrice)}</span>}
      </p>
      <div class="sr-grid-wrap">
        <CatalogGrid client:visible cards={seriesCards} />
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       CTA
  ══════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="sr-cta">
        <div class="sr-cta__text">
          <h2 class="sr-cta__h2">Подберём дверь серии {series.name} под ваш интерьер</h2>
          <p class="sr-cta__lead">Замер, расчёт стоимости и монтаж — в шоуруме в ТЦ «Компас».</p>
        </div>
        <div class="sr-cta__actions">
          <a href={TG} target="_blank" rel="noopener" class="btn btn-ghost">Написать в Telegram</a>
          <a href={`tel:${PHONE}`} class="btn btn-ghost">Позвонить</a>
          <a href={VK} target="_blank" rel="noopener" class="btn btn-ghost btn-icon" aria-label="Написать в VK">
            <img src="/icons/w_vk.webp" alt="" width="18" height="18" />
          </a>
          <a href={MAX} target="_blank" rel="noopener" class="btn btn-ghost btn-icon" aria-label="Написать в MAX">
            <img src="/icons/w_max.webp" alt="" width="18" height="18" />
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
.sr-eyebrow {
  display: block;
  margin: 0 0 0.875rem;
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
}
.sr-h2 {
  margin: 0 0 1rem;
  font-size: clamp(1.625rem, 3vw, 2.125rem);
  font-weight: 500;
  color: var(--color-slate-900);
  letter-spacing: -0.02em;
  line-height: 1.15;
}
.sr-p {
  margin: 0;
  color: var(--color-slate-500);
  font-size: clamp(0.9375rem, 1.4vw, 1.0625rem);
  line-height: 1.75;
}
.sr-p--tight { margin-bottom: 1.5rem; }

/* Длинный маркетинговый текст свёрнут по умолчанию — тот же паттерн
   диклоужера, что у "Смотреть описание" на /models/[id]/. */
.sr-desc { margin: 0 0 1.5rem; }
.sr-desc__toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--color-accent-600);
  cursor: pointer;
  user-select: none;
  list-style: none;
}
.sr-desc__toggle:hover { color: var(--color-accent-700); }
.sr-desc__toggle::-webkit-details-marker { display: none; }
.sr-desc__toggle::after {
  content: '';
  flex-shrink: 0;
  width: 0.5rem;
  height: 0.5rem;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(45deg);
  transition: transform 200ms ease;
}
.sr-desc[open] > .sr-desc__toggle::after { transform: rotate(-135deg); }
.sr-desc__text { margin-top: 0.75rem; }

/* ── Hero ─────────────────────────────────────────────────────── */
/* Заезжает под фикс. хедер (тот всегда position:fixed + полупрозрачный
   фон) — отрицательный margin-top на высоту хедера, а контент внутри
   получает такой же паддинг сверху, чтобы не оказаться под хедером. */
.sr-hero {
  position: relative;
  overflow: hidden;
  margin-top: calc(-1 * var(--header-height, 88px));
  /* min() против vh — без потолка по высоте вьюпорта clamp(...,46vw,...)
     на широких мониторах разбухал, а короткого текста (крошки+заголовок)
     не хватало его заполнить — зияющая пустота между ними. */
  min-height: calc(min(clamp(22rem, 42vw, 30rem), 60vh) + var(--header-height, 88px));
  background: var(--color-slate-900);
  display: flex;
  flex-direction: column;
}
.sr-hero__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.sr-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, color-mix(in srgb, var(--color-slate-900) 92%, transparent), color-mix(in srgb, var(--color-slate-900) 50%, transparent) 55%, color-mix(in srgb, var(--color-slate-900) 15%, transparent));
}
/* flex-столбец на всю высоту hero: крошки естественно у верха (сразу под
   хедером), заголовок прижат к низу через margin-top:auto на __body —
   раньше весь блок был один flex-end child, и «зазор от хедера» на деле
   определялся разницей высоты hero и высоты контента, а не паддингом. */
.sr-hero__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  flex: 1;
  padding-top: calc(var(--header-height, 88px) + clamp(2.5rem, 4vw, 3.5rem));
  padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
}
.sr-hero__crumbs :global(.breadcrumbs) { margin-bottom: 1.5rem; }
.sr-hero__crumbs :global(.breadcrumbs__link),
.sr-hero__crumbs :global(.breadcrumbs__current) { color: rgba(255,255,255,0.75); }
.sr-hero__crumbs :global(.breadcrumbs__current) { color: #fff; }
.sr-hero__crumbs :global(.breadcrumbs__link:hover) { color: #fff; background: rgba(255,255,255,0.14); }
.sr-hero__crumbs :global(.breadcrumbs__icon) { color: rgba(255,255,255,0.35); }
.sr-hero__body { margin-top: auto; color: #fff; }
/* Надзаголовок — часть H1 («Межкомнатные двери серии Скинель»), выглядит
   как прежний eyebrow над названием. */
.sr-hero__h1 .sr-eyebrow {
  line-height: 1.4;
}
.sr-hero__h1 {
  margin: 0 0 0.75rem;
  font-size: clamp(2.25rem, 5vw, 3.5rem);
  font-weight: 500;
  line-height: 1.05;
  letter-spacing: -0.03em;
}
.sr-hero__tagline {
  margin: 0 0 2rem;
  font-size: clamp(1rem, 1.6vw, 1.125rem);
  line-height: 1.65;
  color: rgba(255,255,255,0.8);
}
.sr-hero__actions { display: flex; flex-wrap: wrap; gap: 0.625rem; }

/* ── Jump nav ─────────────────────────────────────────────────── */
.sr-jumpnav {
  border-bottom: 1px solid var(--color-slate-200);
  background: #fff;
}
.sr-jumpnav__row {
  display: flex;
  flex-wrap: wrap;
  gap: clamp(1rem, 3vw, 2rem);
  padding: 0.875rem var(--container-padding, 1.25rem);
}
.sr-jumpnav__link {
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--color-slate-500);
  text-decoration: none;
  border-bottom: 1px dashed transparent;
  padding-bottom: 0.125rem;
  transition: color 150ms ease, border-color 150ms ease;
}
.sr-jumpnav__link:hover { color: var(--color-slate-900); border-color: var(--color-slate-400); }

/* ── Sections ─────────────────────────────────────────────────── */
.sr-section { scroll-margin-top: 5.5rem; }
.sr-section + .sr-section { padding-top: 0; }

/* ── Features ──────────────────────────────────────────────────────
   Разметка/паддинги/цвета — на Tailwind-утилитах прямо в шаблоне.
   Здесь только то, что утилитами не выразить: если фич нечётное число,
   последняя занимает всю ширину строки вместо сиротливой узкой карточки
   в одиночку (классический CSS-приём для «хвоста» grid-раскладки). */
.sr-features > .sr-features__item:last-child:nth-child(odd) {
  grid-column: 1 / -1;
}

/* ── Specs ────────────────────────────────────────────────────────
   Разметка/типографика/разделители — на Tailwind-утилитах (divide-y)
   прямо в шаблоне, здесь ничего не осталось. */

/* ── Grid ─────────────────────────────────────────────────────── */
.sr-grid-wrap { margin-top: 0.5rem; }

/* ── Доступные цвета: сетка свотчей ──────────────────────────────
   minmax(_, 6rem) вместо 1fr — трек не растягивается вслед за шириной
   контейнера (иначе плитки становились огромными на широком экране),
   остаётся компактным свотчем, сколько бы места ни было свободно. */
.sr-colors-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(5.5rem, 6rem));
  gap: 0.75rem;
  padding: 0;
  margin: 0;
  list-style: none;
}

/* ── Сворачивание на мобильном («Особенности» / «Характеристики» /
   «Доступные цвета») — на десктопе кнопка скрыта (md:hidden в разметке),
   контент всегда развёрнут целиком. JS дополнительно убирает кнопку
   совсем, если контент и так короче порога — см. скрипт ниже. */
@media (max-width: 767px) {
  .sr-collapsible__content {
    max-height: 15rem;
    overflow: hidden;
  }
  .sr-collapsible.is-expanded .sr-collapsible__content {
    max-height: none;
  }
}
.sr-collapsible__toggle {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  margin-top: 1rem;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-accent-hover, var(--color-accent-600));
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
}
.sr-collapsible__chevron {
  width: 0.875rem;
  height: 0.875rem;
  transition: transform 200ms ease;
}
.sr-collapsible.is-expanded .sr-collapsible__chevron {
  transform: rotate(180deg);
}

/* ── CTA ──────────────────────────────────────────────────────── */
.sr-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
  padding: clamp(2.5rem, 5vw, 4rem);
  border-radius: 1.25rem;
  background: var(--color-fg);
  color: #fff;
}
.sr-cta__h2 { margin: 0 0 0.5rem; font-size: clamp(1.5rem, 3vw, 2.125rem); font-weight: 500; letter-spacing: -0.02em; }
.sr-cta__lead { margin: 0; font-size: 0.9375rem; color: rgba(255,255,255,0.6); line-height: 1.6; }
.sr-cta__actions { display: flex; gap: 0.625rem; flex-wrap: wrap; flex-shrink: 0; }

/* ── Responsive ───────────────────────────────────────────────── */
@media (max-width: 768px) {
  .sr-cta { flex-direction: column; align-items: flex-start; gap: 1.5rem; padding: 1.75rem 1.5rem; }
}
</style>

<script>
  // «Показать полностью» — общий тоггл для «Особенности»/«Характеристики»/
  // «Доступные цвета» на мобильном. Если контент и так короче порога
  // (clamp из CSS ничего не обрезал), кнопка вообще не нужна — убираем её,
  // чтобы не было нерабочего элемента на экране.
  document.querySelectorAll('[data-collapsible]').forEach((el) => {
    const content = el.querySelector('[data-collapsible-content]')
    const btn = el.querySelector('[data-collapsible-toggle]')
    if (!(content instanceof HTMLElement) || !(btn instanceof HTMLButtonElement)) return

    if (content.scrollHeight <= content.clientHeight + 4) {
      btn.remove()
      return
    }

    const label = btn.querySelector('[data-collapsible-label]')
    btn.addEventListener('click', () => {
      const expanded = el.classList.toggle('is-expanded')
      btn.setAttribute('aria-expanded', String(expanded))
      if (label) label.textContent = expanded ? 'Свернуть' : 'Показать полностью'
    })
  })
</script>
