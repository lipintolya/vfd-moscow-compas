---
/**
 * /catalog/series/ — раньше этого файла не было: у Astro нет index.html
 * для родительской директории динамических /catalog/series/[slug]/,
 * nginx на реальный запрос каталога без autoindex отвечал 403 (не 404),
 * Google это поймал и репортил как ошибку индексации. Реальная страница
 * с содержанием — самый надёжный фикс, без правки nginx.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro'
import SeriesCard from '../../../components/catalog/SeriesCard.astro'
import { getCatalogCards, getSeriesCardsData } from '../../../lib/catalog-data'

const { cards } = await getCatalogCards()
const seriesCardsData = getSeriesCardsData(cards)

const title       = 'Все серии межкомнатных дверей — каталог | ВФД Челябинск'
const description = `Все серии межкомнатных дверей ВФД в Челябинске: ${seriesCardsData.length} серий, покрытия эмаль, ПЭТ, Эмалекс, Протач. Цены, фото, модели каждой серии.`
const canonicalUrl = Astro.site ? new URL('/catalog/series/', Astro.site).href : undefined

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог', href: '/catalog/' },
  { label: 'Серии' },
]

const structuredData = canonicalUrl ? [
  /* BreadcrumbList в JSON-LD отдаёт сам Breadcrumbs.astro — здесь не дублируем. */
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Все серии межкомнатных дверей ВФД',
    description,
    url: canonicalUrl,
    numberOfItems: seriesCardsData.length,
  },
] : undefined
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  structuredData={structuredData}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <section class="section">
    <div class="container">
      <header class="max-w-2xl mb-8 md:mb-10">
        <p class="t-eyebrow mb-3">Каталог</p>
        <h1 class="text-3xl font-medium leading-tight tracking-tight text-slate-900 md:text-5xl">
          Все серии дверей
        </h1>
        <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">
          {seriesCardsData.length} серий межкомнатных дверей ВФД — все покрытия и модели в одном каталоге.
        </p>
      </header>

      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 gap-y-6">
        {seriesCardsData.map((s, i) => <SeriesCard series={s} priority={i < 4} />)}
      </div>
    </div>
  </section>
</BaseLayout>
