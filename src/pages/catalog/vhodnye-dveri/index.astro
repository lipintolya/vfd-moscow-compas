---
/**
 * Каталог входных дверей (/catalog/vhodnye-dveri/): светлый первый экран с
 * заголовком по центру, лента плиток-групп, «Подберём за минуту» и модели по
 * группам — для квартиры, с терморазрывом, с электронным замком, со
 * стеклопакетом: слева название и пояснение группы, справа лента моделей
 * (листается пальцем или стрелками), «Показать все» раскрывает ленту в сетку;
 * внизу — путеводитель по выбору. Ориентир подачи — каталог направлений
 * volhovec.ru (центр, воздух, лента карточек). Карточка — дверь в рост, число
 * вариантов отделки и цена «от». У каждой модели своя страница ([id].astro).
 * Фильтр — только из подбора и путеводителя (событие doors:filter), отдельной
 * панели нет. Данные и тексты — src/data/entrance-doors.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { brandTitle } from '../../../lib/seo-title'
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../../../components/ui/FaqAccordion.astro'
import DoorCard from '../../../components/entrance-doors/DoorCard.astro'
import DoorRequest from '../../../components/entrance-doors/DoorRequest.astro'
import PickDoor from '../../../components/entrance-doors/PickDoor.astro'
import EntranceFilters from '../../../components/entrance-doors/EntranceFilters.astro'
import EntranceGuide from '../../../components/entrance-doors/EntranceGuide.astro'
import EntranceShowcase from '../../../components/entrance-doors/EntranceShowcase.astro'
import { GUIDE_FAQ } from '../../../data/entrance-guide'
import { DOOR_GROUPS, doorsOfGroup, groupFromPrice, groupCover, priceFacetOf, ENTRANCE_PAGE, ENTRANCE_FAQ, ENTRANCE_DOORS } from '../../../data/entrance-doors'
import { localBusinessSchema } from '../../../lib/local-business-schema'
import { PHONE, SITE } from '../../../config/site'
import { rub } from '../../../data/services'
import { typograph } from '../../../lib/typograph'
import { pluralRu } from '../../../lib/plural'
import '../../../styles/home.css'

const { hero } = ENTRANCE_PAGE
const groups = DOOR_GROUPS.map((g) => ({ ...g, doors: doorsOfGroup(g.id), from: groupFromPrice(g.id), photo: groupCover(g.id) })).filter((g) => g.doors.length)
const total = ENTRANCE_DOORS.length
const faq = [...ENTRANCE_FAQ, ...GUIDE_FAQ]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: ENTRANCE_PAGE.h1,
  numberOfItems: total,
  itemListElement: ENTRANCE_DOORS.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.title, url: new URL(d.href, SITE.url).href })),
}
---

<BaseLayout
  title={brandTitle(ENTRANCE_PAGE.title)}
  description={ENTRANCE_PAGE.description}
  ogImage={hero.large}
  ogImageMeta={{ width: hero.width, height: hero.height, alt: hero.alt }}
  structuredData={[localBusinessSchema({ url: SITE.url }), listSchema, faqSchema]}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Каталог', href: '/catalog/' }, { label: 'Входные двери' }]} />
    </div>
  </div>

  <div class="home">
    <section class="edh" aria-labelledby="doors-title">
      <div class="container edh__in">
        <h1 id="doors-title" class="h-h1 edh__title">{typograph(ENTRANCE_PAGE.h1)}</h1>
        <p class="h-lead edh__lead">{typograph(ENTRANCE_PAGE.lead)}</p>
        <div class="edh__actions">
          <a class="h-btn h-btn--ink h-btn--phone-wide" href="#doors-pick">Выбрать модель</a>
          <a class="h-btn h-btn--quiet h-btn--phone-wide" href={`tel:${PHONE.raw}`}>{PHONE.label}</a>
        </div>
      </div>
    </section>

    <nav class="edn" aria-label="Группы входных дверей">
      <div class="container">
        <div class="rail" data-rail>
          <ul class="rail__track edn__track" data-track role="list">
            {groups.map((g) => (
              <li>
                <a class="edn__tile" href={`#doors-${g.id}`}>
                  <span class="edn__text">
                    <span class="edn__name">{typograph(g.nav)}</span>
                    <span class="edn__meta">{g.doors.length} {pluralRu(g.doors.length, ['модель', 'модели', 'моделей'])}<br />от&nbsp;{rub(g.from)}</span>
                  </span>
                  <span class="edn__img" style={`--ar: 500 / ${g.photo.height}; --iw: ${(g.photo.width / g.photo.split) * 100}%`}>
                    <img src={g.photo.src} srcset={g.photo.srcset} sizes="(min-width: 75rem) 14rem, 12rem" alt="" role="presentation" width={g.photo.width} height={g.photo.height} loading="lazy" decoding="async" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="rail__bar" data-bar>
            <span class="rail__line"><i></i></span>
            <span class="rail__btns">
              <button type="button" class="rail__btn" data-prev aria-label="Назад"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <button type="button" class="rail__btn" data-next aria-label="Дальше"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </span>
          </div>
        </div>
      </div>
    </nav>

    <PickDoor />

    <div id="doors-pick" class="edcat">
      <EntranceFilters />

    {groups.map((g, gi) => (
      <section id={`doors-${g.id}`} class:list={['h-sec', 'edg-sec', { 'h-sec--wall': gi % 2 === 1 }]} data-section={g.id} aria-labelledby={`doors-${g.id}-title`}>
        <div class="container edg">
          <header class="edg__head">
            <h2 id={`doors-${g.id}-title`} class="h-h2 edg__title">{typograph(g.title)}</h2>
            <p class="h-body edg__note">{typograph(g.lead)}</p>
            <p class="edg__meta">{g.doors.length} {pluralRu(g.doors.length, ['модель', 'модели', 'моделей'])}, от&nbsp;{rub(g.from)}</p>
          </header>
          <div class="rail edg__rail" data-rail>
            <ul class="rail__track edg__track" data-track role="list">
              {g.doors.map((d) => <li data-door-li data-group={d.group} data-pf={priceFacetOf(d.from)} data-steel={d.steel} data-price={d.from} data-name={d.name.toLowerCase()}><DoorCard door={d} /></li>)}
            </ul>
            <div class="rail__bar" data-bar>
              <span class="rail__line"><i></i></span>
              <span class="rail__btns">
                <button type="button" class="rail__btn" data-prev aria-label="Назад"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <button type="button" class="rail__btn" data-next aria-label="Дальше"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              </span>
            </div>
          </div>
          <p class="edg__more"><button type="button" class="h-btn h-btn--ink h-btn--phone-wide" data-more aria-expanded="false">Показать все {g.doors.length} {pluralRu(g.doors.length, ['модель', 'модели', 'моделей'])}</button></p>
        </div>
      </section>
    ))}

    </div>

    <EntranceShowcase />

    <EntranceGuide />


    <section class="h-sec h-sec--tight-top" aria-labelledby="doors-help">
      <div class="container">
        <div class="edc">
          <div>
            <h2 id="doors-help" class="h-h2 edc__title">Не нашли нужную отделку?</h2>
            <p class="h-body edc__text">У каждой модели десятки вариантов цвета и рисунка панели — на сайте самые ходовые. Напишите, что хотите, — менеджер пришлёт фото и назовёт точную цену.</p>
          </div>
          <DoorRequest text="Подберите, пожалуйста, входную дверь. Нужная отделка: " />
        </div>
      </div>
    </section>

    <section id="doors-faq" class="h-sec" aria-labelledby="doors-faq-title">
      <div class="container h-faq">
        <h2 id="doors-faq-title" class="h-h2">Частые вопросы о входных дверях</h2>
        <FaqAccordion items={faq} title={false} />
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /* «Показать все»: лента раскрывается в сетку, кнопка исчезает */
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-more]')) {
    btn.addEventListener('click', () => {
      btn.closest('section')!.classList.add('is-open')
      btn.closest('.edg__more')!.remove()
    })
  }

  /* Ленты: полоска прогресса, стрелки на компьютере; на телефоне листается пальцем */
  const smooth = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth')
  for (const rail of document.querySelectorAll<HTMLElement>('[data-rail]')) {
    const track = rail.querySelector<HTMLElement>('[data-track]')!
    const thumb = rail.querySelector<HTMLElement>('.rail__line i')!
    const prev = rail.querySelector<HTMLButtonElement>('[data-prev]')!
    const next = rail.querySelector<HTMLButtonElement>('[data-next]')!
    const update = () => {
      const max = track.scrollWidth - track.clientWidth
      const share = max > 1 ? track.clientWidth / track.scrollWidth : 1
      const at = max > 1 ? track.scrollLeft / max : 0
      thumb.style.width = `${share * 100}%`
      thumb.style.left = `${at * (1 - share) * 100}%`
      rail.toggleAttribute('data-static', max <= 1)
      prev.disabled = track.scrollLeft <= 1
      next.disabled = track.scrollLeft >= max - 1
    }
    track.addEventListener('scroll', update, { passive: true })
    new ResizeObserver(update).observe(track)
    prev.addEventListener('click', () => track.scrollBy({ left: -track.clientWidth * 0.85, behavior: smooth() }))
    next.addEventListener('click', () => track.scrollBy({ left: track.clientWidth * 0.85, behavior: smooth() }))
    update()
  }
</script>

<style>
  /* Первый экран: светлый, по центру — заголовок, пояснение и две кнопки */
  .edh { padding: clamp(0.5rem, 2vw, 1.25rem) 0 clamp(1.5rem, 3vw, 2.25rem); }
  .edh__in { display: grid; justify-items: center; text-align: center; }
  .edh__title { margin: 0; max-width: 18ch; }
  .edh__lead { margin: 1.25rem 0 0; max-width: 40rem; color: var(--h-soft); }
  .edh__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1.75rem; }
  @media (max-width: 43.6875rem) { .edh__actions { width: 100%; } }

  /* Ленты (плитки групп и модели): листаются пальцем, на компьютере — стрелками; полоска показывает место */
  .rail { position: relative; }
  .rail__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--rail-col, 14.5rem);
    gap: var(--rail-gap, 1.5rem);
    margin: 0 calc(-1 * var(--h-pad));
    padding: 0 var(--h-pad);
    scroll-padding-inline: var(--h-pad);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .rail__track::-webkit-scrollbar { display: none; }
  .rail__track > li { scroll-snap-align: start; min-width: 0; }
  /* Планшет и компьютер: лента обрезается по краю контейнера, не вылезает за него */
  @media (min-width: 43.75rem) { .rail__track { margin: 0; padding: 0; scroll-padding-inline: 0; } }
  .rail__bar { display: flex; align-items: center; gap: 1rem; margin-top: 1.5rem; }
  .rail[data-static] .rail__bar { display: none; }
  .rail__line { position: relative; flex: 1; height: 0.125rem; background: var(--color-slate-300); }
  .rail__line i { position: absolute; top: 0; bottom: 0; background: var(--h-ink); }
  .rail__btns { display: none; gap: 0.25rem; }
  .rail__btn { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; padding: 0; border: 0; border-radius: 999rem; background: none; color: var(--h-ink); cursor: pointer; transition: color 150ms var(--ease-out); }
  .rail__btn:hover:not(:disabled) { color: var(--h-signal); }
  .rail__btn:disabled { color: var(--color-slate-300); cursor: default; }
  .rail__btn:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.125rem; }
  @media (hover: hover) and (min-width: 43.75rem) { .rail__btns { display: flex; } }

  /* Плитки групп — главный экран страницы: на графите крупно название и дверь в рост,
     дверь стоит на нижней кромке плитки */
  .edn { padding-bottom: clamp(1.5rem, 4vw, 3rem); }
  .edn__track { --rail-col: min(17rem, 78vw); --rail-gap: 1rem; }
  .edn__tile { display: flex; flex-direction: column; height: 100%; padding: clamp(1.25rem, 2vw, 1.75rem) clamp(1.25rem, 2vw, 1.75rem) 0; border-radius: var(--h-tile-radius); background: var(--color-graphite); color: var(--color-white); text-decoration: none; overflow: hidden; }
  .edn__text { display: grid; gap: 0.5rem; margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .edn__name { font-size: clamp(1.3125rem, 0.6vw + 1.0625rem, 1.5rem); font-weight: 600; line-height: 1.15; letter-spacing: -0.01em; }
  .edn__meta { font-size: 0.9375rem; line-height: 1.4; color: color-mix(in srgb, var(--color-white) 72%, transparent); }
  .edn__img { display: block; width: 74%; margin: auto auto 0; aspect-ratio: var(--ar, 5 / 8); overflow: hidden; transition: transform 300ms var(--ease-out); }
  .edn__img img { display: block; width: var(--iw, 200%); max-width: none; height: 100%; object-fit: fill; }
  .edn__tile:hover .edn__img { transform: translateY(-0.5rem); }
  .edn__tile:focus-visible { outline: 0.1875rem solid var(--color-secondary-700); outline-offset: 0.125rem; }
  @media (min-width: 75rem) {
    /* Четыре плитки умещаются в ряд — лента не нужна */
    .edn__track { grid-auto-columns: minmax(0, 1fr); }
  }

  /* Группы: слева название и пояснение, справа лента моделей; на телефоне — друг под другом */
  .edg-sec[hidden], .edg-sec li[hidden] { display: none !important; }
  /* Под липкой строкой фильтров: заголовок группы не прячется при переходе по якорю */
  .edg-sec { scroll-margin-top: 4.5rem; }
  .edg { display: grid; gap: 1.75rem 0; grid-template-areas: 'head' 'rail' 'more'; }
  .edg__head { grid-area: head; display: grid; gap: 0.75rem; align-content: start; }
  .edg__title, .edg__note { margin: 0; }
  .edg__title { font-size: clamp(1.625rem, 2vw + 1rem, 2.25rem); }
  .edg__note { color: var(--h-soft); }
  .edg__meta { margin: 0.25rem 0 0; font-size: 0.9375rem; font-weight: 600; color: var(--h-ink); }
  .edg__rail { grid-area: rail; min-width: 0; }
  .edg__more { grid-area: more; margin: 0; }
  .edg__track { --rail-col: 9rem; --rail-gap: 0.875rem; }
  @media (min-width: 43.75rem) { .edg__track { --rail-col: 14.5rem; --rail-gap: 1.5rem; } .edg__more { justify-self: start; } }
  @media (min-width: 62.5rem) {
    .edg { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-areas: 'head head head rail rail rail rail rail rail rail rail rail' 'more more more rail rail rail rail rail rail rail rail rail'; gap: 0 var(--h-gutter); grid-template-rows: auto 1fr; }
    .edg__more { align-self: start; margin-top: 1.5rem; }
    .edg__rail { padding-left: 0; }
  }
  /* Раскрыто: заголовок сверху, под ним сетка карточек той же ширины */
  .is-open .edg { grid-template-areas: 'head' 'rail'; grid-template-columns: minmax(0, 1fr); }
  .is-open .edg__head { max-width: 44rem; margin-bottom: 1rem; }
  .is-open .edg__track { grid-auto-flow: row; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 3rem var(--rail-gap); margin: 0; padding: 0; overflow: visible; }
  .is-open .rail__bar { display: none; }
  @media (max-width: 43.6875rem) { .is-open .edg__track { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .edc {
    display: grid;
    gap: 1.5rem var(--h-gutter);
    align-items: center;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--h-tile-radius);
    background: var(--h-wall);
  }
  .edc__title { margin: 0; }
  .edc__text { margin: 0.5rem 0 0; max-width: 40rem; color: var(--h-soft); }
  @media (min-width: 62.5rem) { .edc { grid-template-columns: minmax(0, 1fr) auto; } }
</style>
