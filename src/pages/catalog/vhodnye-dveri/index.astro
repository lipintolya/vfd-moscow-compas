---
/**
 * Каталог входных дверей (/catalog/vhodnye-dveri/): модели по группам —
 * для квартиры, с терморазрывом, с электронным замком, со стеклопакетом.
 * Данные и тексты — src/data/entrance-doors.ts; у каждой модели своя страница
 * ([id].astro). Цен нет: «Цена по запросу», менеджер называет её в мессенджерах.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { brandTitle } from '../../../lib/seo-title'
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro'
import QuoteCta from '../../../components/ui/QuoteCta.astro'
import FaqAccordion from '../../../components/ui/FaqAccordion.astro'
import SectionNav from '../../../components/partitions/SectionNav.astro'
import DoorCard from '../../../components/entrance-doors/DoorCard.astro'
import { DOOR_GROUPS, doorsOfGroup, ENTRANCE_PAGE, ENTRANCE_FAQ, ENTRANCE_DOORS } from '../../../data/entrance-doors'
import { whatsappWithText } from '../../../lib/messengers'
import { localBusinessSchema } from '../../../lib/local-business-schema'
import { PHONE, SITE } from '../../../config/site'
import { typograph } from '../../../lib/typograph'
import '../../../styles/home.css'

const { hero } = ENTRANCE_PAGE
const groups = DOOR_GROUPS.map((g) => ({ ...g, doors: doorsOfGroup(g.id) })).filter((g) => g.doors.length)
const navItems = [...groups.map((g) => ({ id: `doors-${g.id}`, label: g.nav })), { id: 'doors-faq', label: 'Вопросы' }]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: ENTRANCE_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: ENTRANCE_PAGE.h1,
  numberOfItems: ENTRANCE_DOORS.length,
  itemListElement: ENTRANCE_DOORS.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.title, url: new URL(d.href, SITE.url).href })),
}
---

<BaseLayout
  title={brandTitle(ENTRANCE_PAGE.title)}
  description={ENTRANCE_PAGE.description}
  ogImage={hero.large}
  ogImageMeta={{ width: hero.width, height: hero.height, alt: hero.alt }}
  preloadImage={hero.src}
  structuredData={[localBusinessSchema({ url: SITE.url }), listSchema, faqSchema]}
>
  <SectionNav items={navItems} />

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Каталог', href: '/catalog/' }, { label: 'Входные двери' }]} />
    </div>
  </div>

  <div class="home">
    <section class="edh" aria-labelledby="doors-title">
      <div class="container edh__grid">
        <div class="edh__text">
          <h1 id="doors-title" class="h-h1 edh__title">{typograph(ENTRANCE_PAGE.h1)}</h1>
          <p class="h-lead edh__lead">{typograph(ENTRANCE_PAGE.lead)}</p>
          <div class="edh__actions">
            <a class="h-btn h-btn--ink h-btn--phone-wide" href={`#doors-${groups[0]!.id}`}>Смотреть модели</a>
            <a class="h-btn h-btn--quiet h-btn--phone-wide" href={`tel:${PHONE.raw}`}>{PHONE.label}</a>
          </div>
        </div>
        <img class="edh__img" src={hero.src} srcset={hero.srcset} sizes="(min-width: 62.5rem) 40vw, 100vw" alt={hero.alt} width={hero.width} height={hero.height} fetchpriority="high" decoding="async" />
      </div>
    </section>

    {groups.map((g) => (
      <section id={`doors-${g.id}`} class="h-sec h-sec--tight-top" aria-labelledby={`doors-${g.id}-title`}>
        <div class="container">
          <header class="h-head edg-head">
            <h2 id={`doors-${g.id}-title`} class="h-h2">{typograph(g.title)}</h2>
            <p class="h-body edg-head__note">{typograph(g.lead)}</p>
          </header>
          <ul class="edg" role="list">
            {g.doors.map((d) => <li><DoorCard door={d} /></li>)}
          </ul>
        </div>
      </section>
    ))}

    <section id="doors-faq" class="h-sec" aria-labelledby="doors-faq-title">
      <div class="container h-faq">
        <h2 id="doors-faq-title" class="h-h2">Частые вопросы о входных дверях</h2>
        <FaqAccordion items={ENTRANCE_FAQ} title={false} />
      </div>
    </section>

    <section class="h-sec h-sec--tight-top" aria-label="Запрос цены">
      <div class="container">
        <QuoteCta
          image={hero.large}
          title="Нужна цена на входную дверь?"
          description="Выберите модель по фото и напишите менеджеру — ответит с ценой и вариантами отделки"
          primaryHref={whatsappWithText('Хочу узнать цену на входную дверь.')}
          primaryLabel="Написать в WhatsApp"
          primaryExternal={true}
          secondaryHref="/contacts/"
          secondaryLabel="Как нас найти"
        />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .edh { padding: clamp(1rem, 2vw, 1.5rem) 0 clamp(2.5rem, 5vw, 4rem); }
  .edh__grid { display: grid; gap: 1.5rem var(--h-gutter); align-items: center; }
  .edh__title { margin: 0; }
  .edh__lead { margin: 1rem 0 0; }
  .edh__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .edh__img { display: block; width: 100%; height: auto; border-radius: var(--h-tile-radius); background: var(--h-media-bg); }
  @media (min-width: 62.5rem) {
    .edh__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .edh__text { grid-column: 1 / span 6; }
    .edh__img { grid-column: 8 / span 5; }
  }

  .edg-head { display: grid; gap: 0.75rem var(--h-gutter); margin-bottom: clamp(1.5rem, 3vw, 2rem); }
  .edg-head :global(h2), .edg-head__note { margin: 0; }
  .edg-head__note { max-width: 44rem; color: var(--h-soft); }

  /* Модели: телефон 2 в ряд, планшет 3, ПК 4 */
  .edg { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 0.75rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 43.75rem) { .edg { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem var(--h-gutter); } }
  @media (min-width: 62.5rem) { .edg { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
