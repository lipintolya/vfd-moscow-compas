---
/**
 * Каталог входных дверей (/catalog/vhodnye-dveri/): тёмный первый экран с
 * тремя дверями в рост, «Подберём за минуту» и модели по группам — для
 * квартиры, с терморазрывом, с электронным замком, со стеклопакетом, внизу —
 * путеводитель по выбору. Карточка — дверь в рост, число вариантов отделки и
 * цена «от». У каждой модели своя страница ([id].astro). Фильтр — только из
 * подбора и путеводителя (событие doors:filter), отдельной панели нет.
 * Данные и тексты — src/data/entrance-doors.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { brandTitle } from '../../../lib/seo-title'
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../../../components/ui/FaqAccordion.astro'
import DoorCard from '../../../components/entrance-doors/DoorCard.astro'
import DoorRequest from '../../../components/entrance-doors/DoorRequest.astro'
import PickDoor from '../../../components/entrance-doors/PickDoor.astro'
import EntranceGuide from '../../../components/entrance-doors/EntranceGuide.astro'
import EntranceShowcase from '../../../components/entrance-doors/EntranceShowcase.astro'
import { GUIDE_FAQ } from '../../../data/entrance-guide'
import { DOOR_GROUPS, doorsOfGroup, groupFromPrice, ENTRANCE_PAGE, ENTRANCE_FAQ, ENTRANCE_DOORS, ENTRANCE_SHOWCASE } from '../../../data/entrance-doors'
import { localBusinessSchema } from '../../../lib/local-business-schema'
import { PHONE, SITE } from '../../../config/site'
import { rub } from '../../../data/services'
import { typograph } from '../../../lib/typograph'
import { pluralRu } from '../../../lib/plural'
import '../../../styles/home.css'

const { hero } = ENTRANCE_PAGE
const groups = DOOR_GROUPS.map((g) => ({ ...g, doors: doorsOfGroup(g.id), from: groupFromPrice(g.id) })).filter((g) => g.doors.length)
const total = ENTRANCE_DOORS.length
const faq = [...ENTRANCE_FAQ, ...GUIDE_FAQ]
/* Сколько моделей группы видно сразу (два ряда по четыре); остальные — по кнопке */
const SHOWN = 8
/* На телефоне — два ряда по две: страница не превращается в километровую ленту */
const SHOWN_PHONE = 4

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: ENTRANCE_PAGE.h1,
  numberOfItems: total,
  itemListElement: ENTRANCE_DOORS.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.title, url: new URL(d.href, SITE.url).href })),
}
---

<BaseLayout
  title={brandTitle(ENTRANCE_PAGE.title)}
  description={ENTRANCE_PAGE.description}
  ogImage={hero.large}
  ogImageMeta={{ width: hero.width, height: hero.height, alt: hero.alt }}
  preloadImage={hero.src}
  structuredData={[localBusinessSchema({ url: SITE.url }), listSchema, faqSchema]}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Каталог', href: '/catalog/' }, { label: 'Входные двери' }]} />
    </div>
  </div>

  <div class="home">
    <section class="edh" aria-labelledby="doors-title">
      <div class="container">
        <div class="edh__panel">
          <div class="edh__text">
            <h1 id="doors-title" class="h-h1 edh__title">{typograph(ENTRANCE_PAGE.h1)}</h1>
            <p class="h-lead edh__lead">{typograph(ENTRANCE_PAGE.lead)}</p>
            <div class="edh__actions">
              <a class="h-btn edh__go h-btn--phone-wide" href="#doors-pick">Выбрать модель</a>
              <a class="h-btn edh__call h-btn--phone-wide" href={`tel:${PHONE.raw}`}>{PHONE.label}</a>
            </div>
          </div>
          <ul class="edh__doors" role="list">
            {ENTRANCE_SHOWCASE.map((d, i) => (
              <li class={`edh__door edh__door--${i + 1}`}>
                <a href={d.href} class="edh__link" aria-label={`${d.title}: смотреть`}>
                  <span class="edh__img" style={`--ar: ${d.cover.split} / ${d.cover.height}; --iw: ${(d.cover.width / d.cover.split) * 100}%`}>
                    <img src={d.cover.src} srcset={d.cover.srcset} sizes="(min-width: 62.5rem) 12rem, 28vw" alt={d.cover.alt} width={d.cover.width} height={d.cover.height} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
                  </span>
                  <span class="edh__cap">{d.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <PickDoor />

    <div id="doors-pick" class="edcat">
      <p class="edreset container" data-reset hidden>
        <button type="button" class="h-btn h-btn--quiet">Показать все модели</button>
      </p>
    <p id="edb-status" class="sr-only" role="status" aria-live="polite"></p>

    {groups.map((g, gi) => (
      <section id={`doors-${g.id}`} class:list={['h-sec', 'edg-sec', { 'h-sec--wall': gi % 2 === 1 }]} data-section={g.id} aria-labelledby={`doors-${g.id}-title`}>
        <div class="container">
          <header class="edg-head">
            <div class="edg-head__text">
              <h2 id={`doors-${g.id}-title`} class="h-h2">{typograph(g.title)}</h2>
              <p class="h-body edg-head__note">{typograph(g.lead)}</p>
            </div>
            <p class="edg-head__meta">{g.doors.length} {pluralRu(g.doors.length, ['модель', 'модели', 'моделей'])}, от&nbsp;{rub(g.from)}</p>
          </header>
          <ul class="edg" role="list">
            {g.doors.map((d, i) => <li data-door-li data-xd={i >= SHOWN ? '' : undefined} data-xp={i >= SHOWN_PHONE ? '' : undefined}><DoorCard door={d} /></li>)}
          </ul>
          {g.doors.length > SHOWN_PHONE && (
            <p class="edg-more" data-short={g.doors.length <= SHOWN ? '' : undefined}><button type="button" class="h-btn h-btn--quiet" data-more aria-expanded="false">Показать все {g.doors.length} {pluralRu(g.doors.length, ['модель', 'модели', 'моделей'])}</button></p>
          )}
        </div>
      </section>
    ))}

    </div>

    <EntranceShowcase />

    <EntranceGuide />


    <section class="h-sec h-sec--tight-top" aria-labelledby="doors-help">
      <div class="container">
        <div class="edc">
          <div>
            <h2 id="doors-help" class="h-h2 edc__title">Не нашли нужную отделку?</h2>
            <p class="h-body edc__text">У каждой модели десятки вариантов цвета и рисунка панели — на сайте самые ходовые. Напишите, что хотите, — менеджер пришлёт фото и назовёт точную цену.</p>
          </div>
          <DoorRequest text="Подберите, пожалуйста, входную дверь. Нужная отделка: " />
        </div>
      </div>
    </section>

    <section id="doors-faq" class="h-sec" aria-labelledby="doors-faq-title">
      <div class="container h-faq">
        <h2 id="doors-faq-title" class="h-h2">Частые вопросы о входных дверях</h2>
        <FaqAccordion items={faq} title={false} />
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /* Фильтр каталога: его включают блок «Подберём за минуту» и кнопки «Показать модели»
     в путеводителе (событие doors:filter); «показать все» над списком выключает. */
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')]
  const items = [...document.querySelectorAll<HTMLElement>('li[data-door-li]')]
  const status = document.getElementById('edb-status')!
  const page = document.querySelector<HTMLElement>('.home')!
  const reset = document.querySelector<HTMLElement>('[data-reset]')!

  function setGroup(group: string, scroll: boolean) {
    let shown = 0
    for (const li of items) {
      const ok = group === 'all' || (li.firstElementChild as HTMLElement).dataset.group === group
      li.hidden = !ok
      if (ok) shown++
    }
    for (const s of sections) s.hidden = !s.querySelector('li[data-door-li]:not([hidden])')
    page.classList.toggle('is-filtering', group !== 'all')
    reset.hidden = group === 'all'
    status.textContent = `Найдено моделей: ${shown}`
    if (!scroll) return
    /* К кнопке сброса: она стоит прямо над первой группой, видно и что включено, и как выключить */
    reset.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
  }
  reset.querySelector('button')!.addEventListener('click', () => setGroup('all', false))
  document.addEventListener('doors:filter', (e) => setGroup((e as CustomEvent<{ group: string }>).detail.group, true))

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-more]')) {
    btn.addEventListener('click', () => {
      btn.closest('section')!.querySelector('.edg')!.classList.add('is-open')
      btn.closest('.edg-more')!.remove()
    })
  }
</script>

<style>
  /* Первый экран: графитовая панель, текст слева, три двери в рост справа */
  .edh { padding: clamp(1rem, 2vw, 1.5rem) 0 0; }
  .edh__panel {
    display: grid;
    gap: 2rem var(--h-gutter);
    align-items: end;
    padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1.25rem, 4vw, 3.5rem) 0;
    border-radius: var(--h-tile-radius);
    background: var(--color-graphite);
    color: var(--color-white);
    overflow: hidden;
  }
  .edh__text { align-self: center; padding-bottom: clamp(0rem, 3vw, 3rem); }
  .edh__title { margin: 0; color: inherit; }
  .edh__lead { margin: 1rem 0 0; max-width: 34rem; color: color-mix(in srgb, var(--color-white) 78%, transparent); }
  .edh__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .edh__go { background: var(--color-white); color: var(--h-ink); }
  .edh__go:hover { background: var(--color-slate-200); }
  .edh__call { border-color: color-mix(in srgb, var(--color-white) 35%, transparent); background: none; color: var(--color-white); }
  .edh__call:hover { border-color: var(--color-white); color: var(--color-white); }

  /* Двери стоят на одной линии пола, разной высоты; левая половина кадра — дверь снаружи */
  .edh__doors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.5rem, 2vw, 1.25rem);
    align-items: end;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Единственный «выход» на странице: двери поднимаются по очереди один раз */
  .edh__door { animation: edh-rise 700ms var(--ease-out) both; }
  .edh__door--2 { animation-delay: 90ms; }
  .edh__door--3 { animation-delay: 180ms; }
  @keyframes edh-rise { from { opacity: 0; transform: translateY(2rem); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .edh__door { animation: none; } }
  .edh__door--1 { --k: 0.9; }
  .edh__door--2 { --k: 1; }
  .edh__door--3 { --k: 0.82; }
  .edh__link { display: grid; gap: 0.5rem; color: inherit; text-decoration: none; }
  .edh__img { display: block; aspect-ratio: var(--ar, 5 / 8); overflow: hidden; border-radius: 0.625rem 0.625rem 0 0; background: var(--color-graphite-card); transform-origin: bottom; transform: scale(var(--k)); }
  .edh__img img { display: block; width: var(--iw, 200%); max-width: none; height: 100%; object-fit: cover; object-position: 0 0; }
  .edh__cap { padding-bottom: 0.875rem; font-size: 0.8125rem; font-weight: 600; text-align: center; color: color-mix(in srgb, var(--color-white) 80%, transparent); }
  .edh__link:hover .edh__cap, .edh__link:focus-visible .edh__cap { color: var(--color-white); }
  .edh__link:focus-visible { outline: 0.1875rem solid var(--color-white); outline-offset: 0.125rem; }
  @media (min-width: 62.5rem) {
    .edh__panel { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .edh__text { grid-column: 1 / span 5; }
    .edh__doors { grid-column: 6 / span 7; }
  }

  /* Панель выбора: липнет под шапкой */
  .edreset { margin: 1.5rem auto 0; }
  .edreset[hidden] { display: none; }
  /* Группы — отдельные полосы с воздухом: заголовок, пояснение и счётчик, ниже модели */
  .edg-sec[hidden], .edg li[hidden] { display: none !important; }
  .edg-head { display: grid; gap: 0.75rem 2rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .edg-head__text { display: grid; gap: 0.75rem; max-width: 44rem; }
  .edg-head :global(h2), .edg-head__note { margin: 0; }
  .edg-head__note { color: var(--h-soft); }
  .edg-head__meta { margin: 0; align-self: end; font-size: 0.9375rem; font-weight: 600; color: var(--h-ink); }
  @media (min-width: 62.5rem) { .edg-head { grid-template-columns: minmax(0, 1fr) auto; align-items: end; } }

  /* Модели: телефон 2 в ряд, планшет 3, ПК 4; после первых двух рядов — «Показать все» */
  .edg { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 0.875rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 43.75rem) { .edg { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3.25rem 1.75rem; } }
  @media (min-width: 62.5rem) { .edg { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 3.5rem 2rem; } }
  /* Что скрыто до «Показать все»: на телефоне всё с пятой модели, на компьютере — с девятой */
  .edg li[data-xp] { display: none; }
  @media (min-width: 43.75rem) { .edg li[data-xp] { display: block; } .edg li[data-xd] { display: none; } }
  .edg.is-open li, :global(.is-filtering) .edg li { display: block; }
  @media (min-width: 43.75rem) { .edg-more[data-short] { display: none; } }
  .edg-more { display: flex; justify-content: center; margin: clamp(2.5rem, 5vw, 3.5rem) 0 0; }
  :global(.is-filtering) .edg-more { display: none; }

  .edc {
    display: grid;
    gap: 1.5rem var(--h-gutter);
    align-items: center;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--h-tile-radius);
    background: var(--h-wall);
  }
  .edc__title { margin: 0; }
  .edc__text { margin: 0.5rem 0 0; max-width: 40rem; color: var(--h-soft); }
  @media (min-width: 62.5rem) { .edc { grid-template-columns: minmax(0, 1fr) auto; } }
</style>
