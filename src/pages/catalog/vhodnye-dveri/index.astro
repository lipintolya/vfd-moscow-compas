---
/**
 * Каталог входных дверей (/catalog/vhodnye-dveri/): первый экран — сцена с
 * рендером двери на доме (обложка, src/data/entrance-scenes.ts), заголовок и
 * кнопки слева на затемнении; лента плиток-групп, «Подберём за минуту» и модели по
 * группам — для квартиры, с терморазрывом, с электронным замком, со
 * стеклопакетом: слева название и пояснение группы, справа лента моделей
 * (листается пальцем или стрелками), «Показать все» раскрывает ленту в сетку;
 * дальше — рендеры «на площадке» и «на фасаде дома» (лента кадров со ссылками на
 * модели) и путеводитель по выбору. Ориентир подачи — каталог направлений
 * volhovec.ru (воздух, лента карточек). Карточка — дверь в рост, число
 * вариантов отделки и цена «от». У каждой модели своя страница ([id].astro).
 * Отдельной панели фильтров нет (владелец убрал); «Подберём за минуту»
 * (событие doors:filter) прокручивает к нужной группе. Данные и тексты — src/data/entrance-doors.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { brandTitle } from '../../../lib/seo-title'
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../../../components/ui/FaqAccordion.astro'
import DoorCard from '../../../components/entrance-doors/DoorCard.astro'
import DoorRequest from '../../../components/entrance-doors/DoorRequest.astro'
import PickDoor from '../../../components/entrance-doors/PickDoor.astro'
import EntranceGuide from '../../../components/entrance-doors/EntranceGuide.astro'
import RelatedArticleCard from '../../../components/articles/RelatedArticleCard.astro'
import { relatedArticle as relatedArticleFor } from '../../../lib/articles'
import EntranceShowcase from '../../../components/entrance-doors/EntranceShowcase.astro'
import SceneCard from '../../../components/entrance-doors/SceneCard.astro'
import { GUIDE_FAQ } from '../../../data/entrance-guide'
import { ENTRANCE_HOUSES } from '../../../data/entrance-scenes'
import { COVER_SCENE, HOUSE_SCENES } from '../../../lib/entrance-scenes'
import { DOOR_GROUPS, doorsOfGroup, groupFromPrice, groupCover, fromPrice, ENTRANCE_PAGE, ENTRANCE_FAQ, ENTRANCE_DOORS } from '../../../data/entrance-doors'
import { localBusinessSchema } from '../../../lib/local-business-schema'
import { PHONE, SITE } from '../../../config/site'
import { rub } from '../../../data/services'
import { typograph } from '../../../lib/typograph'
import { pluralRu } from '../../../lib/plural'
import '../../../styles/home.css'

/* Обложка — рендер двери на доме; на телефоне — квадратная обрезка с дверью (меньше байт, дверь по центру) */
const cover = COVER_SCENE
const coverPhone = cover.crops?.square
const PHONE_MEDIA = '(max-width: 47.9375rem)'
/* Точка на двери: на широком экране — как в рендере, на телефоне — пересчёт в квадратную обрезку.
   Рамка .edh__fit повторяет object-fit: cover в CSS (контейнерные единицы), поэтому точка стоит на двери при любом размере */
const spot = cover.spot
const spotPhone = spot && coverPhone ? { x: (spot.x - coverPhone.x) / coverPhone.w, y: spot.y } : spot
const coverGroup = DOOR_GROUPS.find((g) => g.id === cover.door.group)!
const pct = (n: number) => `${(n * 100).toFixed(2)}%`
const fitStyle = [
  `--ar-wide: ${(cover.width / cover.height).toFixed(4)}`,
  `--ar-phone: ${coverPhone ? (coverPhone.width / coverPhone.height).toFixed(4) : (cover.width / cover.height).toFixed(4)}`,
  spot && `--wx: ${pct(spot.x)}; --wy: ${pct(spot.y)}`,
  spotPhone && `--px: ${pct(spotPhone.x)}; --py: ${pct(spotPhone.y)}`,
].filter(Boolean).join('; ')
const groups = DOOR_GROUPS.map((g) => ({ ...g, doors: doorsOfGroup(g.id), from: groupFromPrice(g.id), photo: groupCover(g.id) })).filter((g) => g.doors.length)
const total = ENTRANCE_DOORS.length
const relatedArticle = await relatedArticleFor({ pagePath: '/catalog/vhodnye-dveri/' })
const faq = [...ENTRANCE_FAQ, ...GUIDE_FAQ]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: ENTRANCE_PAGE.h1,
  numberOfItems: total,
  itemListElement: ENTRANCE_DOORS.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.title, url: new URL(d.href, SITE.url).href })),
}
---

<BaseLayout
  title={brandTitle(ENTRANCE_PAGE.title)}
  description={ENTRANCE_PAGE.description}
  ogImage={cover.src}
  ogImageMeta={{ width: cover.width, height: cover.height, alt: cover.alt }}
  structuredData={[localBusinessSchema({ url: SITE.url }), listSchema, faqSchema]}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Каталог', href: '/catalog/' }, { label: 'Входные двери' }]} />
    </div>
  </div>

  <div class="home">
    <section class="edh" aria-labelledby="doors-title">
      <div class="container">
        <div class="edh__scene">
          <div class="edh__media">
            <div class="edh__fit" style={fitStyle}>
              <picture>
                {coverPhone && <source media={PHONE_MEDIA} srcset={coverPhone.srcset} sizes="calc(100vw - 2rem)" width={coverPhone.width} height={coverPhone.height} />}
                <img class="edh__img" src={cover.src} srcset={cover.srcset} sizes="(min-width: 80rem) 76rem, 100vw" alt={cover.alt} width={cover.width} height={cover.height} loading="eager" fetchpriority="high" decoding="async" />
              </picture>
              {spot && (
                <div class="edh__spot" data-hero-spot>
                  <button type="button" class="edh__dot" aria-expanded="false" aria-controls="edh-pop" aria-label={`На фото: ${cover.door.name}. Показать цену`}></button>
                  <a id="edh-pop" class="edh__pop" href={cover.door.href}>
                    <strong>{typograph(cover.door.name)}</strong>
                    <span>{typograph(coverGroup.nav)}</span>
                    <b>{fromPrice(cover.door)}</b>
                  </a>
                </div>
              )}
            </div>
          </div>
          <div class="edh__copy">
            <h1 id="doors-title" class="h-h1 edh__title">{typograph(ENTRANCE_PAGE.h1)}</h1>
            <p class="h-lead edh__lead">{typograph(ENTRANCE_PAGE.lead)}</p>
            <div class="edh__actions">
              <a class="h-btn h-btn--signal h-btn--phone-wide" href="#doors-pick">Выбрать модель</a>
              <a class="h-btn edh__call h-btn--phone-wide" href={`tel:${PHONE.raw}`}>{PHONE.label}</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <nav class="edn" aria-label="Группы входных дверей">
      <div class="container">
        <div class="rail" data-rail>
          <ul class="rail__track edn__track" data-track role="list">
            {groups.map((g) => (
              <li>
                <a class="edn__tile" href={`#doors-${g.id}`}>
                  <span class="edn__text">
                    <span class="edn__name">{typograph(g.nav)}</span>
                    <span class="edn__meta">{g.doors.length} {pluralRu(g.doors.length, ['модель', 'модели', 'моделей'])}<br />от&nbsp;{rub(g.from)}</span>
                  </span>
                  <span class="edn__img" style={`--ar: 500 / ${g.photo.height}; --iw: ${(g.photo.width / g.photo.split) * 100}%`}>
                    <img src={g.photo.src} srcset={g.photo.srcset} sizes="(min-width: 75rem) 14rem, 12rem" alt="" role="presentation" width={g.photo.width} height={g.photo.height} loading="lazy" decoding="async" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="rail__bar" data-bar>
            <span class="rail__line"><i></i></span>
            <span class="rail__btns">
              <button type="button" class="rail__btn" data-prev aria-label="Назад"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <button type="button" class="rail__btn" data-next aria-label="Дальше"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </span>
          </div>
        </div>
      </div>
    </nav>

    <PickDoor />

    <div id="doors-pick" class="edcat">
    {groups.map((g, gi) => (
      <section id={`doors-${g.id}`} class:list={['h-sec', 'edg-sec', { 'h-sec--wall': gi % 2 === 1 }]} data-section={g.id} aria-labelledby={`doors-${g.id}-title`}>
        <div class="container edg">
          <header class="edg__head">
            <h2 id={`doors-${g.id}-title`} class="h-h2 edg__title">{typograph(g.title)}</h2>
            <p class="h-body edg__note">{typograph(g.lead)}</p>
            <p class="edg__meta">{g.doors.length} {pluralRu(g.doors.length, ['модель', 'модели', 'моделей'])}, от&nbsp;{rub(g.from)}</p>
          </header>
          <div class="rail edg__rail" data-rail>
            <ul class="rail__track edg__track" data-track role="list">
              {g.doors.map((d) => <li data-door-li><DoorCard door={d} /></li>)}
            </ul>
            <div class="rail__bar" data-bar>
              <span class="rail__line"><i></i></span>
              <span class="rail__btns">
                <button type="button" class="rail__btn" data-prev aria-label="Назад"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <button type="button" class="rail__btn" data-next aria-label="Дальше"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              </span>
            </div>
          </div>
          <p class="edg__more"><button type="button" class="h-btn h-btn--ink h-btn--phone-wide" data-more aria-expanded="false">Показать все {g.doors.length} {pluralRu(g.doors.length, ['модель', 'модели', 'моделей'])}</button></p>
        </div>
      </section>
    ))}

    </div>

    <EntranceShowcase />

    {HOUSE_SCENES.length > 0 && (
      <section id="houses" class="h-sec h-sec--wall" aria-labelledby="houses-title">
        <div class="container">
          <header class="h-head">
            <h2 id="houses-title" class="h-h2">{typograph(ENTRANCE_HOUSES.title)}</h2>
            <p class="h-lead">{typograph(ENTRANCE_HOUSES.lead)}</p>
          </header>
          <div class="rail" data-rail>
            <ul class="rail__track ehs" data-track role="list" data-lightbox data-lightbox-images={JSON.stringify(HOUSE_SCENES.map((x) => ({ src: x.src, alt: x.alt })))}>
              {HOUSE_SCENES.map((scene, i) => <li style={`--ar: ${scene.ratio.toFixed(4)}`}><SceneCard scene={scene} index={i} /></li>)}
            </ul>
            <div class="rail__bar" data-bar>
              <span class="rail__line"><i></i></span>
              <span class="rail__btns">
                <button type="button" class="rail__btn" data-prev aria-label="Назад"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <button type="button" class="rail__btn" data-next aria-label="Дальше"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              </span>
            </div>
          </div>
        </div>
      </section>
    )}

    <EntranceGuide />

    {relatedArticle && <RelatedArticleCard article={relatedArticle} />}


    <section class="h-sec h-sec--tight-top" aria-labelledby="doors-help">
      <div class="container">
        <div class="edc">
          <div>
            <h2 id="doors-help" class="h-h2 edc__title">Не нашли нужную отделку?</h2>
            <p class="h-body edc__text">У каждой модели десятки вариантов цвета и рисунка панели — на сайте самые ходовые. Напишите, что хотите, — менеджер пришлёт фото и назовёт точную цену.</p>
          </div>
          <DoorRequest text="Подберите, пожалуйста, входную дверь. Нужная отделка: " />
        </div>
      </div>
    </section>

    <section id="doors-faq" class="h-sec" aria-labelledby="doors-faq-title">
      <div class="container h-faq">
        <h2 id="doors-faq-title" class="h-h2">Частые вопросы о входных дверях</h2>
        <FaqAccordion items={faq} title={false} />
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initLightboxGroups } from '../../../lib/lightbox'
  initLightboxGroups()

  /* «Подберём за минуту» ведёт к нужной группе моделей */
  document.addEventListener('doors:filter', (e) => {
    const group = (e as CustomEvent<{ group: string }>).detail.group
    document.getElementById(`doors-${group}`)?.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
  })

  /* «Показать все»: лента раскрывается в сетку, кнопка исчезает */
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-more]')) {
    btn.addEventListener('click', () => {
      btn.closest('section')!.classList.add('is-open')
      btn.closest('.edg__more')!.remove()
    })
  }

  /* Точка на двери первого экрана: нажатие открывает и закрывает карточку (на телефоне наведения нет) */
  for (const spot of document.querySelectorAll<HTMLElement>('[data-hero-spot]')) {
    const dot = spot.querySelector<HTMLButtonElement>('.edh__dot')!
    const set = (open: boolean) => {
      spot.toggleAttribute('data-open', open)
      dot.setAttribute('aria-expanded', String(open))
    }
    dot.addEventListener('click', () => set(!spot.hasAttribute('data-open')))
    document.addEventListener('click', (e) => { if (!spot.contains(e.target as Node)) set(false) })
    spot.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); dot.focus() } })
  }

  /* Появление карточек: пока карточка вне экрана — прозрачна и чуть ниже; вошла — встаёт на место */
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue
        e.target.classList.remove('is-pre')
        io.unobserve(e.target)
      }
    }, { rootMargin: '0px 0px -8% 0px' })
    for (const track of document.querySelectorAll<HTMLElement>('[data-track]')) {
      let n = 0
      for (const li of track.querySelectorAll<HTMLElement>(':scope > li')) {
        li.classList.add('rv')
        li.style.setProperty('--rv-d', `${Math.min(n++, 5) * 70}ms`)
        // уже на экране — остаётся как есть, без мигания
        const r = li.getBoundingClientRect()
        if (r.width && r.top < innerHeight && r.bottom > 0 && r.left < innerWidth && r.right > 0) continue
        li.classList.add('is-pre')
        io.observe(li)
      }
    }
  }

  /* Ленты: полоска прогресса, стрелки на компьютере; на телефоне листается пальцем */
  const smooth = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth')
  for (const rail of document.querySelectorAll<HTMLElement>('[data-rail]')) {
    const track = rail.querySelector<HTMLElement>('[data-track]')!
    const thumb = rail.querySelector<HTMLElement>('.rail__line i')!
    const prev = rail.querySelector<HTMLButtonElement>('[data-prev]')!
    const next = rail.querySelector<HTMLButtonElement>('[data-next]')!
    const update = () => {
      const max = track.scrollWidth - track.clientWidth
      const share = max > 1 ? track.clientWidth / track.scrollWidth : 1
      const at = max > 1 ? track.scrollLeft / max : 0
      thumb.style.width = `${share * 100}%`
      thumb.style.left = `${at * (1 - share) * 100}%`
      rail.toggleAttribute('data-static', max <= 1)
      prev.disabled = track.scrollLeft <= 1
      next.disabled = track.scrollLeft >= max - 1
    }
    track.addEventListener('scroll', update, { passive: true })
    new ResizeObserver(update).observe(track)
    prev.addEventListener('click', () => track.scrollBy({ left: -track.clientWidth * 0.85, behavior: smooth() }))
    next.addEventListener('click', () => track.scrollBy({ left: track.clientWidth * 0.85, behavior: smooth() }))
    update()
  }
</script>

<style>
  /* Первый экран — сцена, как на главной: рендер двери на доме, текст слева на затемнении
     (затемнение только под текстом, дверь справа остаётся чистой). Телефон: кадр сверху, текст под ним
     на графите — дверь ничем не закрыта */
  .edh { padding: clamp(0.5rem, 2vw, 1.25rem) 0 clamp(1.5rem, 3vw, 2.25rem); }
  .edh__scene { position: relative; display: grid; border-radius: 1.75rem; overflow: hidden; background: var(--color-graphite); isolation: isolate; }
  .edh__media { position: relative; aspect-ratio: 1; container-type: size; }
  .edh__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, var(--color-graphite) 0%, transparent 28%); pointer-events: none; }
  /* Рамка по пропорции кадра: покрывает сцену, как object-fit: cover (ox/oy — object-position); картинка и точка лежат в ней */
  .edh__fit {
    --ar: var(--ar-phone); --ox: 0.5; --oy: 0.5; --sx: var(--px); --sy: var(--py);
    --w: max(100cqw, calc(100cqh * var(--ar)));
    position: absolute;
    width: var(--w);
    height: calc(var(--w) / var(--ar));
    left: calc((100cqw - var(--w)) * var(--ox));
    top: calc((100cqh - var(--w) / var(--ar)) * var(--oy));
  }
  .edh__img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; color: transparent; }
  .edh__media picture { display: contents; }

  /* Точка на двери: по наведению, фокусу или нажатию — карточка с моделью и ценой */
  .edh__spot { position: absolute; z-index: 1; left: var(--sx); top: var(--sy); width: 0; height: 0; }
  .edh__dot {
    position: absolute; left: -1.375rem; top: -1.375rem;
    display: grid; place-items: center;
    width: 2.75rem; height: 2.75rem; padding: 0; border: 0; border-radius: 50%;
    background: color-mix(in srgb, var(--color-white) 32%, transparent);
    backdrop-filter: blur(0.25rem);
    cursor: pointer;
    transition: transform 250ms var(--ease-out), background-color 250ms var(--ease-out);
  }
  .edh__dot::before { content: ''; width: 1rem; height: 1rem; border-radius: 50%; background: var(--color-white); box-shadow: 0 0.125rem 0.5rem color-mix(in srgb, var(--color-slate-950) 35%, transparent); }
  .edh__dot:focus-visible { outline: 0.1875rem solid var(--color-secondary-500); outline-offset: 0.125rem; }
  .edh__spot:hover .edh__dot, .edh__spot[data-open] .edh__dot { transform: scale(1.12); background: color-mix(in srgb, var(--color-white) 45%, transparent); }
  .edh__pop {
    position: absolute; left: 0; bottom: 1.875rem; z-index: 1;
    display: grid; justify-items: center; gap: 0.125rem;
    width: max-content; min-width: 10.5rem; max-width: calc(100vw - 3rem);
    padding: 0.875rem 1.25rem; border-radius: 1rem;
    background: var(--color-white); color: var(--h-ink); text-align: center; text-decoration: none;
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, var(--color-slate-950) 28%, transparent);
    opacity: 0; visibility: hidden; transform: translate(-50%, 0.375rem);
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out), visibility 0s linear 200ms;
  }
  /* Мостик между точкой и карточкой, чтобы наведение не терялось в зазоре */
  .edh__pop::after { content: ''; position: absolute; top: 100%; left: 0; right: 0; height: 0.75rem; }
  .edh__pop strong { font-size: 1.0625rem; font-weight: 700; line-height: 1.25; }
  .edh__pop span { font-size: 0.875rem; line-height: 1.35; color: var(--h-soft); }
  .edh__pop b { margin-top: 0.125rem; font-size: 1.0625rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .edh__pop:hover strong { text-decoration: underline; text-decoration-color: var(--h-signal); text-underline-offset: 0.15em; }
  .edh__pop:focus-visible { outline: 0.1875rem solid var(--color-secondary-500); outline-offset: 0.125rem; }
  .edh__spot[data-open] .edh__pop, .edh__spot:focus-within .edh__pop { opacity: 1; visibility: visible; transform: translate(-50%, 0); transition-delay: 0s; }
  @media (hover: hover) { .edh__spot:hover .edh__pop { opacity: 1; visibility: visible; transform: translate(-50%, 0); transition-delay: 0s; } }
  .edh__copy { display: grid; justify-items: start; padding: 0 clamp(1.25rem, 4vw, 1.75rem) clamp(1.5rem, 4vw, 2rem); color: var(--color-white); }
  .edh__title { color: var(--color-white); }
  .edh__lead { margin: 1rem 0 0; max-width: 28rem; color: color-mix(in srgb, var(--color-white) 82%, transparent); }
  .edh__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  /* Вторая кнопка — на фото: белый контур, на наведение — белая (как на главной) */
