---
/**
 * Декор к дверям (/catalog/decor/): фальшфрамуга с компланарным коробом,
 * плинтус в цвет дверей, декоративные рейки.
 * Тексты — src/data/decor-page.ts, цены и фото — decor-products.ts: на
 * странице только разметка. Категория — секция DecorSection (та же, что
 * «Плинтус к дверям» на страницах моделей). Первый экран — LandingHero,
 * работы — WorkCard, визит в салон — VisitBand.
 * JSON-LD: LocalBusiness, Product + AggregateOffer на каждую категорию,
 * FAQPage; BreadcrumbList отдают сами хлебные крошки.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import { brandTitle } from '../../lib/seo-title'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import LandingHero from '../../components/ui/LandingHero.astro'
import SectionNav from '../../components/partitions/SectionNav.astro'
import DecorSection from '../../components/catalog/DecorSection.astro'
import WorkCard from '../../components/portfolio/WorkCard.astro'
import RelatedArticleCard from '../../components/articles/RelatedArticleCard.astro'
import FaqAccordion from '../../components/ui/FaqAccordion.astro'
import VisitBand from '../../components/home/VisitBand.astro'
import '../../styles/home.css'

import { DECOR_CATEGORIES, DECOR_FAQ, DECOR_PAGE, decorProducts } from '../../data/decor-page'
import { HERO_IMAGE, IMAGES } from '../../data/decor-products'
import { relatedArticle as relatedArticleFor } from '../../lib/articles'
import { getWorks } from '../../lib/works'
import { localBusinessSchema } from '../../lib/local-business-schema'
import { productSchema } from '../../lib/product-schema'
import { PHONE, SITE } from '../../config/site'

const path = Astro.url.pathname
const pageUrl = new URL(path, SITE.url).href

/* Наш монтаж — работы портфолио, которые в Strapi сослались на этот раздел */
const works = (await getWorks()).filter((w) => w.relatedLink?.href === path).slice(0, 3)

/* Статья по теме — та, что назвала эту страницу в relatedPages */
const relatedArticle = await relatedArticleFor({ pagePath: '/catalog/decor/' })

const navItems = [
  ...DECOR_CATEGORIES.map((c) => ({ id: c.id, label: c.nav })),
  ...(works.length ? [{ id: 'decor-works', label: 'Работы' }] : []),
  { id: 'decor-faq', label: 'Вопросы' },
]

const structuredData = [
  localBusinessSchema({ url: SITE.url }),
  ...decorProducts().map((p) => productSchema(p)),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: DECOR_FAQ.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
]
---

<BaseLayout
  title={brandTitle(DECOR_PAGE.title)}
  description={DECOR_PAGE.description}
  canonical={pageUrl}
  ogImage={IMAGES.hero.large}
  ogImageMeta={{ width: IMAGES.hero.width, height: IMAGES.hero.height, alt: HERO_IMAGE.alt }}
  structuredData={structuredData}
>
  <SectionNav items={navItems} />

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Каталог', href: '/catalog/' }, { label: 'Декор' }]} />
    </div>
  </div>

  <div class="home">
    <LandingHero title={DECOR_PAGE.h1} lead={DECOR_PAGE.lead} image={HERO_IMAGE}>
      <Fragment slot="actions">
        <a href={`tel:${PHONE.raw}`} class="h-btn h-btn--signal">Рассчитать декор</a>
        <a href={`#${DECOR_CATEGORIES[0]!.id}`} class="h-btn h-btn--quiet">Смотреть цены</a>
      </Fragment>
    </LandingHero>

    {DECOR_CATEGORIES.map((c, i) => <DecorSection category={c} wall={i % 2 === 0} />)}

    {works.length > 0 && (
      <section id="decor-works" class="h-sec" aria-labelledby="decor-works-title">
        <div class="container">
          <header class="h-head">
            <h2 id="decor-works-title" class="h-h2">Декор в&nbsp;наших работах</h2>
            <p class="h-lead">Объекты клиентов салона с&nbsp;фото и&nbsp;описанием монтажа.</p>
          </header>
          <ul class="dc-works h-rail" role="list">
            {works.map((w) => <li><WorkCard work={w} /></li>)}
          </ul>
        </div>
      </section>
    )}

    {relatedArticle && <RelatedArticleCard article={relatedArticle} />}

    <section id="decor-faq" class="h-sec h-sec--wall" aria-labelledby="decor-faq-title">
      <div class="container h-faq">
        <h2 id="decor-faq-title" class="h-h2">Вопросы о&nbsp;декоре к&nbsp;дверям</h2>
        <FaqAccordion items={DECOR_FAQ} title={false} />
      </div>
    </section>

    <VisitBand lead={DECOR_PAGE.visit} />
  </div>
</BaseLayout>

<style>
  .dc-works { display: grid; gap: 3rem var(--h-gutter); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 56.25rem) { .dc-works { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
