---
/**
 * src/pages/catalog/skrytye-dveri-dlya-ofisa.astro
 * SEO-лендинг под сегмент «коммерческие объекты» (офисы, шоу-румы,
 * переговорные, медицинские и бьюти-кабинеты) — не дублирует товарный
 * контент главной страницы /catalog/skrytye-dveri/ (короб/цвет кромки/
 * конструкция раскрыты там подробно), здесь фокус на том, почему
 * скрытый монтаж решает задачи именно коммерческого пространства:
 * долговечность при высоком трафике, нейтральность в переговорной,
 * скорость монтажа без остановки работы объекта.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../../components/ui/FaqAccordion.astro'
import SectionHeading from '../../components/partitions/SectionHeading.astro'
import { INVISIBLE_WORKS } from '../../data/skrytye-dveri-works'
import { merchantPolicy } from '../../lib/contacts-data'
import {
  IMAGES,
  SECRET_MIN_BLADE_PRICE,
  SECRET_MIN_KIT_PRICE,
  CUSTOM_LEAD_TIME,
} from '../../data/skrytye-dveri-products'
import { PHONE as SITE_PHONE, SITE } from '../../config/site'

const PHONE = SITE_PHONE.raw
const TG    = SITE.social.telegram

const fmt = (n: number) => n.toLocaleString('ru-RU') + ' ₽'

const canonicalUrl = Astro.site
  ? new URL('/catalog/skrytye-dveri-dlya-ofisa/', Astro.site).href
  : undefined

const title       = 'Скрытые двери для офиса и коммерческих объектов в Москве | ВФД'
const description = `Скрытые двери для офисов, шоу-румов и переговорных в Москве — монтаж без выступающих коробов и наличников, устойчивость к интенсивному трафику. Комплект от ${fmt(SECRET_MIN_KIT_PRICE)}.`

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог', href: '/catalog/' },
  { label: 'Скрытые двери', href: '/catalog/skrytye-dveri/' },
  { label: 'Для офиса и коммерции' },
]

// Работа в самом шоу-руме ВФД — честный пример коммерческого использования:
// это не квартира и не частный дом, а действующее торговое помещение.
const officeWork = INVISIBLE_WORKS.find(w => w.location?.includes('салон дверей ВФД'))

const faq = [
  {
    q: 'Выдерживает ли скрытая дверь интенсивный офисный трафик?',
    a: 'Алюминиевый короб 54×43 мм и скрытые петли рассчитаны на нагрузку до 70 кг — этого достаточно для стандартного межкомнатного полотна при активном ежедневном использовании в переговорной или коридоре.',
  },
  {
    q: 'Можно ли смонтировать без остановки работы офиса?',
    a: 'Монтаж одной двери занимает 1–2 дня и не требует демонтажа соседних конструкций — работы можно провести в нерабочее время или по отдельным кабинетам поочерёдно, не останавливая приём клиентов или сотрудников.',
  },
  {
    q: 'Подходит ли скрытая дверь для переговорной со звукоизоляцией?',
    a: 'Скрытый монтаж сам по себе не добавляет и не отнимает звукоизоляцию — зазор между полотном и стеной (1–2 мм) стандартный для межкомнатных дверей. Если нужна повышенная шумоизоляция переговорной, это отдельное конструктивное решение, обсуждается на этапе замера.',
  },
  {
    q: 'Как скрытая дверь выглядит в интерьере шоу-рума или ресепшена?',
    a: 'Полотно вровень со стеной без наличников и видимого короба — в отделанном виде дверь читается как часть стены, а не отдельный элемент. Это особенно ценно в шоу-румах и ресепшенах, где визуальный минимализм — часть бренд-презентации.',
  },
  {
    q: 'Можно ли заказать несколько дверей одного проекта со скидкой?',
    a: 'Расчёт на несколько дверей одного объекта делается индивидуально — итоговая стоимость и сроки зависят от количества позиций, кромки и высоты. Присылайте план помещений менеджеру в Telegram, посчитаем весь объём одним расчётом.',
  },
]

const structuredData = canonicalUrl ? [
  /* BreadcrumbList в JSON-LD отдаёт сам Breadcrumbs.astro — здесь не дублируем. */
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Скрытые двери для коммерческих объектов — серия «Секрет»',
    description: 'Двери скрытого монтажа для офисов, шоу-румов и переговорных: полотно заподлицо со стеной, без наличников и выступающего короба.',
    brand: { '@type': 'Brand', name: 'ВФД' },
    image: IMAGES.invisible,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'RUB',
      price: SECRET_MIN_KIT_PRICE,
      availability: 'https://schema.org/InStock',
      seller: { '@type': 'Organization', name: 'Салон дверей ВФД' },
      hasMerchantReturnPolicy: merchantPolicy.returnPolicy,
      shippingDetails:         merchantPolicy.shipping,
    },
  },
] : undefined
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={IMAGES.invisible}
  structuredData={structuredData}
>

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- HERO -->
  <section class="section bg-white">
    <div class="container">
      <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div class="order-2 lg:order-1">
          <p class="t-eyebrow mb-3">Для бизнеса</p>
          <h1 class="t-h1 mb-5">Скрытые двери для офисов и коммерческих объектов</h1>
          <p class="m-0 mb-4 t-lead text-slate-600">
            В переговорной, приёмной или шоу-руме дверь либо работает на общий вид помещения,
            либо спорит с ним. Скрытый монтаж убирает наличники и короб из поля зрения — дверь
            перестаёт быть отдельным элементом интерьера и становится частью стены.
          </p>
          <p class="m-0 mb-6 t-lead text-slate-600">
            Собственную дверь такого типа мы установили в своём салоне в ТЦ «Компас» —
            можно приехать и посмотреть, как она выглядит и работает вживую, прежде чем заказывать
            для своего объекта.
          </p>
          <div class="flex gap-2.5 flex-wrap">
            <a href={TG} target="_blank" rel="noopener" class="btn btn-primary">Рассчитать проект</a>
            <a href={`tel:${PHONE}`} class="btn btn-outline">Позвонить</a>
          </div>
        </div>
        <div class="order-1 grid grid-cols-2 gap-3 lg:order-2">
          <div class="overflow-hidden rounded-3xl">
            <img
              src={IMAGES.invisible}
              alt="Скрытая дверь «Секрет» — монтаж заподлицо со стеной"
              width="450"
              height="562"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-4/5 w-full object-cover"
            />
          </div>
          <div class="overflow-hidden rounded-3xl">
            <img
              src={IMAGES.invisibleRev}
              alt="Скрытая дверь «Секрет Реверс» — реверсивный монтаж"
              width="450"
              height="562"
              loading="lazy"
              decoding="async"
              class="aspect-4/5 w-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ПОЧЕМУ ПОДХОДИТ ДЛЯ КОММЕРЧЕСКИХ ОБЪЕКТОВ -->
  <section class="section bg-white">
    <div class="container">
      <SectionHeading eyebrow="Почему это работает" title="Три задачи, которые решает скрытый монтаж в офисе" />
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 p-6">
          <h3 class="m-0 mb-2 text-base font-medium text-ink">Нейтральный вид переговорной</h3>
          <p class="m-0 text-sm leading-relaxed text-slate-600">
            Полотно в грунте окрашивается в цвет стены после монтажа — дверь визуально исчезает,
            не отвлекая внимание от презентации или встречи.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 p-6">
          <h3 class="m-0 mb-2 text-base font-medium text-ink">Монтаж без остановки работы</h3>
          <p class="m-0 text-sm leading-relaxed text-slate-600">
            1–2 дня на дверь, без демонтажа смежных конструкций — можно ставить по кабинетам
            поочерёдно или в нерабочее время.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 p-6">
          <h3 class="m-0 mb-2 text-base font-medium text-ink">Устойчивость к трафику</h3>
          <p class="m-0 text-sm leading-relaxed text-slate-600">
            Скрытые петли держат нагрузку до 70 кг — запас прочности для стандартного полотна
            при активном ежедневном использовании в коридоре или переговорной.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ЦЕНЫ -->
  <section class="section bg-white">
    <div class="container">
      <SectionHeading
        eyebrow="Стоимость"
        title="Сколько стоит скрытая дверь для офиса"
        subtitle={`Полотно от ${fmt(SECRET_MIN_BLADE_PRICE)}, комплект с коробом от ${fmt(SECRET_MIN_KIT_PRICE)}. Точная цена зависит от кромки, ширины и стороны открывания — полная таблица на странице серии «Секрет».`}
      />
      <div class="flex flex-wrap gap-3">
        <a href="/catalog/skrytye-dveri/#secret-prices" class="btn btn-outline">Смотреть таблицу цен «Секрет»</a>
        <a href="/catalog/skrytye-dveri/#reflex" class="btn btn-outline">Скрытая дверь с зеркалом «Рефлекс»</a>
      </div>
    </div>
  </section>

  <!-- РАБОТА В НАШЕМ САЛОНЕ -->
  {officeWork && (
    <section class="section bg-white">
      <div class="container">
        <SectionHeading eyebrow="Наш пример" title="Скрытая дверь в нашем салоне в ТЦ «Компас»" />
        <div class="grid grid-cols-1 gap-4 overflow-hidden rounded-2xl border border-slate-200 sm:grid-cols-2">
          <div class="aspect-4/3 overflow-hidden bg-slate-100 sm:aspect-auto">
            <img
              src={officeWork.images[0]}
              alt={officeWork.title}
              loading="lazy"
              decoding="async"
              width="600"
              height="450"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="flex flex-col justify-center p-6">
            <p class="m-0 mb-2 text-xs font-semibold text-accent-600">{officeWork.location}</p>
            <h3 class="m-0 mb-2 text-lg font-medium leading-snug text-ink">{officeWork.title}</h3>
            {officeWork.story && <p class="m-0 mb-4 text-sm leading-relaxed text-slate-600">{officeWork.story}</p>}
            <a href="/catalog/skrytye-dveri/raboty/" class="w-fit text-sm font-semibold text-accent-600 hover:text-accent-700">
              Смотреть все работы →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section bg-white">
    <div class="container">
      <FaqAccordion items={faq} />
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-white">
    <div class="container">
      <div class="rounded-3xl bg-graphite p-[clamp(2rem,5vw,3rem)] text-white">
        <div class="flex flex-wrap items-center justify-between gap-6">
          <div>
            <h2 class="m-0 mb-2 text-2xl font-medium">Посчитаем скрытые двери для вашего объекта</h2>
            <p class="m-0 max-w-xl text-sm leading-relaxed text-white/70">
              Пришлите план помещений — рассчитаем количество дверей, кромку и сроки монтажа
              одним расчётом.
            </p>
          </div>
          <div class="flex gap-2.5 flex-wrap">
            <a href={TG} target="_blank" rel="noopener" class="btn btn-ghost">Написать в Telegram</a>
            <a href={`tel:${PHONE}`} class="btn btn-ghost">Позвонить</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
