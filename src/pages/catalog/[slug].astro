---
/**
 * src/pages/catalog/[slug].astro
 * Тонкий роут для SEO-лендингов каталога — по покрытию (DOOR_CATEGORIES),
 * по цвету (COLOR_CATEGORIES) и по стилю (STYLE_CATEGORIES). Разметка — в
 * DoorCategoryLanding.astro / ColorCategoryLanding.astro /
 * StyleCategoryLanding.astro, см. комментарии в соответствующих data-файлах.
 */

import DoorCategoryLanding from '../../components/catalog/DoorCategoryLanding.astro'
import ColorCategoryLanding from '../../components/catalog/ColorCategoryLanding.astro'
import StyleCategoryLanding from '../../components/catalog/StyleCategoryLanding.astro'
import { DOOR_CATEGORIES } from '../../data/door-categories'
import { COLOR_CATEGORIES } from '../../data/color-categories'
import { STYLE_CATEGORIES } from '../../data/style-categories'
import { getCatalogCards } from '../../lib/catalog-data'

export async function getStaticPaths() {
  const { cards } = await getCatalogCards()
  return [
    ...DOOR_CATEGORIES.map(category => ({
      params: { slug: category.slug },
      props: { kind: 'coating' as const, category, cards },
    })),
    ...COLOR_CATEGORIES.map(category => ({
      params: { slug: category.slug },
      props: { kind: 'color' as const, category, cards },
    })),
    ...STYLE_CATEGORIES.map(category => ({
      params: { slug: category.slug },
      props: { kind: 'style' as const, category, cards },
    })),
  ]
}

const { kind, category, cards } = Astro.props
---

{kind === 'coating' && <DoorCategoryLanding category={category} cards={cards} />}
{kind === 'color' && <ColorCategoryLanding category={category} cards={cards} />}
{kind === 'style' && <StyleCategoryLanding category={category} cards={cards} />}
