---
/**
 * src/pages/catalog/skrytye-dveri-dizayn-proekt.astro
 * SEO-лендинг под сегмент «дизайн-проекты» — аудитория: дизайнеры
 * интерьера и архитекторы, работающие по чужому проекту, где скрытая
 * дверь — не отдельный товар, а элемент авторской концепции (полотно
 * в цвет стены, продолжение художественной композиции). Акцент на
 * гибкости кастомизации (покраска в любой цвет, нестандартные высоты,
 * зеркальное полотно), а не на цене/сроках, как на массовых лендингах.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../../components/ui/FaqAccordion.astro'
import SectionHeading from '../../components/partitions/SectionHeading.astro'
import { INVISIBLE_WORKS } from '../../data/skrytye-dveri-works'
import { merchantPolicy } from '../../lib/contacts-data'
import {
  IMAGES,
  REFLEX_IMAGE,
  SECRET_MIN_KIT_PRICE,
  CUSTOM_LEAD_TIME,
} from '../../data/skrytye-dveri-products'
import { PHONE as SITE_PHONE, SITE } from '../../config/site'

const PHONE = SITE_PHONE.raw
const TG    = SITE.social.telegram

const fmt = (n: number) => n.toLocaleString('ru-RU') + ' ₽'

const canonicalUrl = Astro.site
  ? new URL('/catalog/skrytye-dveri-dizayn-proekt/', Astro.site).href
  : undefined

const title       = 'Скрытые двери для дизайн-проекта в Челябинске — под покраску в любой цвет | ВФД'
const description = 'Скрытые двери для реализации дизайн-проекта в Челябинске: полотно в грунте под покраску в любой цвет, нестандартные высоты, зеркальное полотно «Рефлекс». Работаем напрямую с дизайнерами и подрядчиками.'

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог', href: '/catalog/' },
  { label: 'Скрытые двери', href: '/catalog/skrytye-dveri/' },
  { label: 'Для дизайн-проекта' },
]

const designWork = INVISIBLE_WORKS.find(w => w.features?.some(f => f.includes('Дизайн:')))

const faq = [
  {
    q: 'Можно ли согласовать нестандартный цвет полотна по проекту?',
    a: 'Да — полотно поставляется в грунте и красится после монтажа в любой цвет по каталогу RAL или образцу дизайнера. Мы не ограничиваем палитру заранее, красит подрядчик или маляр на объекте уже после установки короба.',
  },
  {
    q: 'Как скрытая дверь вписывается в художественную отделку стены?',
    a: 'Короб монтируется заподлицо, зазор между полотном и стеной — 1–2 мм, поэтому дверь можно сделать частью цельной композиции: одной покраски, одной штукатурной фактуры или обойного полотна на стену и дверь без видимого шва.',
  },
  {
    q: 'Работаете ли напрямую с дизайнером или только с заказчиком?',
    a: 'Работаем с обеими сторонами: дизайнер может согласовать спецификацию и сроки напрямую с нами, а оплату и приёмку — вести заказчик. Пришлите план проёмов и техническое задание в Telegram.',
  },
  {
    q: 'Сколько времени закладывать на нестандартную высоту или размер?',
    a: `Изготовление под нестандартную высоту — ${CUSTOM_LEAD_TIME}. Это стоит внести в календарный план проекта заранее, особенно если монтаж двери привязан к другим отделочным работам.`,
  },
  {
    q: 'Можно ли использовать зеркальное полотно как акцентный элемент?',
    a: 'Да, серия «Рефлекс» — зеркало во всю высоту двери, изготавливается индивидуально. В дизайн-проекте это часто используется как приём для визуального увеличения пространства или как акцент в прихожей/гардеробной.',
  },
]

const structuredData = canonicalUrl ? [
  /* BreadcrumbList в JSON-LD отдаёт сам Breadcrumbs.astro — здесь не дублируем. */
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Скрытые двери для дизайн-проекта — серия «Секрет»',
    description: 'Двери скрытого монтажа для реализации дизайн-проектов: полотно в грунте под покраску в любой цвет, монтаж заподлицо со стеной.',
    brand: { '@type': 'Brand', name: 'ВФД' },
    image: IMAGES.invisible,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'RUB',
      price: SECRET_MIN_KIT_PRICE,
      availability: 'https://schema.org/InStock',
      seller: { '@type': 'Organization', name: 'Салон дверей ВФД' },
      hasMerchantReturnPolicy: merchantPolicy.returnPolicy,
      shippingDetails:         merchantPolicy.shipping,
    },
  },
] : undefined
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={IMAGES.invisible}
  structuredData={structuredData}
>

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- HERO -->
  <section class="section bg-white">
    <div class="container">
      <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div class="order-2 lg:order-1">
          <p class="t-eyebrow mb-3">Для дизайн-проекта</p>
          <h1 class="t-h1 mb-5">Скрытые двери для реализации дизайн-проекта</h1>
          <p class="m-0 mb-4 t-lead text-slate-600">
            В авторском интерьере дверь не должна спорить с концепцией — скрытый монтаж
            убирает наличники и короб из композиции, а полотно в грунте красится в цвет,
            заданный проектом, а не выбирается из готовой палитры каталога.
          </p>
          <p class="m-0 mb-6 t-lead text-slate-600">
            Один из объектов ниже — дверь, ставшая частью художественной композиции стены
            по проекту дизайнера Екатерины Квашниной.
          </p>
          <div class="flex gap-2.5 flex-wrap">
            <a href={TG} target="_blank" rel="noopener" class="btn btn-primary">Обсудить проект</a>
            <a href={`tel:${PHONE}`} class="btn btn-outline">Позвонить</a>
          </div>
        </div>
        <div class="order-1 overflow-hidden rounded-3xl lg:order-2">
          <img
            src={IMAGES.invisible}
            alt="Скрытая дверь в дизайн-проекте — монтаж заподлицо со стеной"
            width="900"
            height="675"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="aspect-4/3 w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ГИБКОСТЬ ПОД ПРОЕКТ -->
  <section class="section bg-white">
    <div class="container">
      <SectionHeading eyebrow="Возможности" title="Что можно заложить в проект" />
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 p-6">
          <h3 class="m-0 mb-2 text-base font-medium text-ink">Любой цвет полотна</h3>
          <p class="m-0 text-sm leading-relaxed text-slate-600">
            Грунтованная поверхность красится под RAL или образец дизайнера уже после монтажа —
            без ограничений готовой палитры покрытий.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 p-6">
          <h3 class="m-0 mb-2 text-base font-medium text-ink">Часть композиции стены</h3>
          <p class="m-0 text-sm leading-relaxed text-slate-600">
            Зазор 1–2 мм между полотном и стеной позволяет продолжить единую фактуру или
            покраску без видимого шва по периметру двери.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 p-6">
          <h3 class="m-0 mb-2 text-base font-medium text-ink">Нестандартные размеры</h3>
          <p class="m-0 text-sm leading-relaxed text-slate-600">
            Высота до 2700 мм под заказ — актуально для проектов с завышенными потолками
            и авторскими пропорциями проёмов.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- РЕФЛЕКС КАК АКЦЕНТ -->
  <section class="section bg-white">
    <div class="container">
      <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div class="order-2 overflow-hidden rounded-3xl lg:order-1">
          <img
            src={REFLEX_IMAGE}
            alt="Скрытая дверь с зеркалом «Рефлекс» как акцентный элемент дизайн-проекта"
            width="700"
            height="525"
            loading="lazy"
            decoding="async"
            class="aspect-4/3 w-full object-cover"
          />
        </div>
        <div class="order-1 lg:order-2">
          <p class="t-eyebrow mb-3">Акцентный приём</p>
          <h2 class="t-h2 mb-4">«Рефлекс» — зеркало вместо отдельного декора</h2>
          <p class="m-0 mb-4 text-sm leading-relaxed text-slate-600 sm:text-base">
            В проектах с задачей визуально увеличить пространство зеркальное полотно во всю
            высоту двери заменяет отдельный декоративный элемент — то же скрытое крепление,
            что и у «Секрета», индивидуальное изготовление под конкретный проём.
          </p>
          <a href="/catalog/skrytye-dveri/#reflex" class="btn btn-outline">Подробнее о «Рефлекс»</a>
        </div>
      </div>
    </div>
  </section>

  <!-- РАБОТА ПО ДИЗАЙН-ПРОЕКТУ -->
  {designWork && (
    <section class="section bg-white">
      <div class="container">
        <SectionHeading eyebrow="Реализованный проект" title="Художественная стена с дверью скрытого монтажа" />
        <div class="grid grid-cols-1 gap-4 overflow-hidden rounded-2xl border border-slate-200 sm:grid-cols-2">
          <div class="aspect-4/3 overflow-hidden bg-slate-100 sm:aspect-auto">
            <img
              src={designWork.images[0]}
              alt={designWork.title}
              loading="lazy"
              decoding="async"
              width="600"
              height="450"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="flex flex-col justify-center p-6">
            <p class="m-0 mb-2 text-xs font-semibold text-teal-600">{designWork.location}</p>
            <h3 class="m-0 mb-2 text-lg font-medium leading-snug text-ink">{designWork.title}</h3>
            {designWork.story && <p class="m-0 mb-4 text-sm leading-relaxed text-slate-600">{designWork.story}</p>}
            <a href="/catalog/skrytye-dveri/raboty/" class="w-fit text-sm font-semibold text-teal-600 hover:text-teal-700">
              Смотреть все работы →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section bg-white">
    <div class="container">
      <FaqAccordion items={faq} />
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-white">
    <div class="container">
      <div class="rounded-3xl bg-graphite p-[clamp(2rem,5vw,3rem)] text-white">
        <div class="flex flex-wrap items-center justify-between gap-6">
          <div>
            <h2 class="m-0 mb-2 text-2xl font-medium">Обсудим спецификацию под ваш проект</h2>
            <p class="m-0 max-w-xl text-sm leading-relaxed text-white/70">
              Пришлите техническое задание или чертежи — согласуем размеры, цвет и сроки
              изготовления под график проекта.
            </p>
          </div>
          <div class="flex gap-2.5 flex-wrap">
            <a href={TG} target="_blank" rel="noopener" class="btn btn-ghost">Написать в Telegram</a>
            <a href={`tel:${PHONE}`} class="btn btn-ghost">Позвонить</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
