---
/**
 * Напольный плинтус из МДФ — страница каталога (/catalog/plintus/).
 * Фото и описания позиций — из src/data/plintus.ts. Названий позиций и цен
 * нет: по кнопке «Запросить цену» открывается окно с телефоном и мессенджерами
 * (островок PlinthGrid.vue).
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import { brandTitle } from '../../lib/seo-title'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import QuoteCta from '../../components/ui/QuoteCta.astro'
import PlinthGrid from '../../components/catalog/PlinthGrid.vue'
import { PLINTUS } from '../../data/plintus'
import { whatsappWithText } from '../../lib/messengers'
import { SITE } from '../../config/site'
import { typograph } from '../../lib/typograph'
import '../../styles/home.css'

const title = 'Напольный плинтус из МДФ в Москве — цвета и профили'
const description = 'Напольный плинтус из МДФ в Москве: толщина 8–25 мм, высота 60–250 мм, белый под покраску, эмаль и цвета по RAL и NCS. Фото позиций, цена по запросу.'
const h1 = 'Напольный плинтус из МДФ в Москве'
const lead = 'Толщина 8–25 мм, высота 60–250 мм. Белый под покраску, белая финишная эмаль или цвет по палитре RAL или NCS. Цвета на фото — ориентир: точный оттенок уточняйте у менеджера.'

const TIPS = [
  { title: 'Высота', text: 'Высоту подбирают под потолки: для стандартных комнат обычно берут 60–100 мм, для высоких потолков — выше 100 мм.' },
  { title: 'Толщина', text: 'Толщина — от 8 до 25 мм. Тонкий профиль смотрится легче, толстый — основательнее: выбирайте по пропорциям стены и двери.' },
  { title: 'Покраска', text: 'Белый под покраску — грунтованный, его красят в нужный цвет. Белая финишная эмаль — готовый белый. Цвет по RAL или NCS — окрашивание эмалью в выбранный оттенок.' },
]

const FAQ = [
  { q: 'Какой толщины и высоты бывает напольный плинтус?', a: 'Толщина — от 8 до 25 мм, высота — от 60 до 250 мм. Размер подбирают под стену и высоту дверей.' },
  { q: 'Из чего сделан плинтус?', a: 'Из МДФ — плиты из древесного волокна. Поверхность ровная, хорошо держит покраску.' },
  { q: 'Можно ли покрасить плинтус в нужный цвет?', a: 'Да. Белый поставляется под покраску, цветной окрашивается эмалью по палитрам RAL и NCS. Точный оттенок уточняйте у менеджера.' },
  { q: 'Как узнать цену?', a: 'Цену называет менеджер. Нажмите «Запросить цену» у понравившегося варианта — откроется окно с телефоном салона и ссылками на мессенджеры.' },
]

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Декор', item: `${SITE.url}/catalog/decor/` },
    { '@type': 'ListItem', position: 3, name: 'Напольный плинтус', item: `${SITE.url}/catalog/plintus/` },
  ],
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<BaseLayout
  title={brandTitle(title)}
  description={description}
  structuredData={[breadcrumbSchema, faqSchema]}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Декор', href: '/catalog/decor/' }, { label: 'Напольный плинтус' }]} />
    </div>
  </div>

  <div class="home">
    <section class="plh" aria-labelledby="plintus-title">
      <div class="container">
        <header class="plh__head">
          <h1 id="plintus-title" class="h-h1 plh__title">{h1}</h1>
          <p class="h-lead plh__lead">{typograph(lead)}</p>
        </header>

        <section class="pl-block" aria-labelledby="plintus-colors">
          <h2 id="plintus-colors" class="h-h2 pl-h2">Цвета и профили</h2>
          <PlinthGrid items={PLINTUS} client:visible />
        </section>

        <section class="pl-block" aria-labelledby="plintus-choose">
          <h2 id="plintus-choose" class="h-h2 pl-h2">Как выбрать плинтус</h2>
          <div class="pl-tips">
            {TIPS.map((tip) => (
              <div class="pl-tip">
                <h3>{tip.title}</h3>
                <p>{tip.text}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="pl-block" aria-labelledby="plintus-faq">
          <h2 id="plintus-faq" class="h-h2 pl-h2">Частые вопросы о напольном плинтусе</h2>
          <div class="pl-faq">
            {FAQ.map((f) => (
              <div class="pl-faq__item">
                <h3 class="pl-faq__q">{f.q}</h3>
                <p class="pl-faq__a">{f.a}</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </section>

    <section class="h-sec h-sec--tight-top" aria-label="Запрос цены">
      <div class="container">
        <QuoteCta
          image={PLINTUS[0]!.photo}
          title="Нужна цена?"
          description="Выберите цвет и профиль по фото и напишите менеджеру — ответит с ценой"
          primaryHref={whatsappWithText('Хочу узнать цену на напольный плинтус из МДФ.')}
          primaryLabel="Написать в WhatsApp"
          primaryExternal={true}
          secondaryHref="/catalog/decor/"
          secondaryLabel="Декор и погонаж"
        />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Шапка — та же сетка, что у «Наших работ» */
  .plh { padding-top: clamp(1rem, 2vw, 1.5rem); }
  .plh__head {
    display: grid;
    gap: 1.25rem var(--h-gutter);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 62.5rem) {
    .plh__head { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .plh__title { grid-column: 1 / span 7; }
    .plh__lead { grid-column: 9 / span 4; }
  }

  .pl-block { margin: 0 0 3.5rem; }
  .pl-h2 { margin: 0 0 1.75rem; }

  /* Как выбрать: три короткие колонки */
  .pl-tips { display: grid; gap: 1.75rem var(--h-gutter); }
  @media (min-width: 43.75rem) { .pl-tips { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .pl-tip h3,
  .pl-faq__q { margin: 0 0 0.5rem; font-size: 1.0625rem; font-weight: 600; color: var(--h-ink); }
  .pl-tip p,
  .pl-faq__a { margin: 0; color: var(--h-muted); line-height: 1.6; }

  /* Вопросы: список с линиями, без раскрывашек — текст виден поисковику */
  .pl-faq { border-top: 1px solid var(--h-rule); }
  .pl-faq__item { padding: 1.25rem 0; border-bottom: 1px solid var(--h-rule); }
</style>
