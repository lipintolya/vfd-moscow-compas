---
/**
 * Напольный плинтус из МДФ — страница каталога (/catalog/plintus/).
 * Данные и все тексты — src/data/plintus.ts (размеры, покрытия, советы, FAQ
 * собираются из PLINTUS_SPEC и списка позиций). Цен нет: «Запросить цену»
 * открывает окно с телефонами и мессенджерами (островок PlinthGrid.vue).
 * Хлебные крошки отдают BreadcrumbList сами — здесь не дублируем.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import { brandTitle } from '../../lib/seo-title'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import QuoteCta from '../../components/ui/QuoteCta.astro'
import FaqAccordion from '../../components/ui/FaqAccordion.astro'
import PlinthGrid from '../../components/catalog/PlinthGrid.vue'
import PlintusLine from '../../components/catalog/PlintusLine.astro'
import SectionNav from '../../components/partitions/SectionNav.astro'
import { PLINTUS_LINES, PLINTUS_LINES_FAQ } from '../../data/plintus-lines'
import { PLINTUS, PLINTUS_FAQ, PLINTUS_PAGE, PLINTUS_SPEC_ROWS, PLINTUS_TIPS } from '../../data/plintus'
import { whatsappWithText } from '../../lib/messengers'
import { localBusinessSchema } from '../../lib/local-business-schema'
import { PHONE, SITE } from '../../config/site'
import { typograph } from '../../lib/typograph'
import '../../styles/home.css'

const { hero } = PLINTUS_PAGE
const faq = [...PLINTUS_FAQ, ...PLINTUS_LINES_FAQ]
const navItems = [
  { id: 'plintus-profiles', label: 'Напольный' },
  ...PLINTUS_LINES.map((l) => ({ id: l.id, label: l.nav })),
  { id: 'plintus-faq', label: 'Вопросы' },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<BaseLayout
  title={brandTitle(PLINTUS_PAGE.title)}
  description={PLINTUS_PAGE.description}
  ogImage={hero.src}
  ogImageMeta={{ width: 1000, height: 1000, alt: hero.alt }}
  preloadImage={hero.src}
  structuredData={[localBusinessSchema({ url: SITE.url }), faqSchema]}
>
  <SectionNav items={navItems} />

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Декор', href: '/catalog/decor/' }, { label: 'Плинтус' }]} />
    </div>
  </div>

  <div class="home">
    <section class="plh" aria-labelledby="plintus-title">
      <div class="container plh__grid">
        <div class="plh__text">
          <h1 id="plintus-title" class="h-h1 plh__title">{typograph(PLINTUS_PAGE.h1)}</h1>
          <p class="h-lead plh__lead">{typograph(PLINTUS_PAGE.lead)}</p>
          <div class="plh__actions">
            <a class="h-btn h-btn--ink h-btn--phone-wide" href="#plintus-profiles">Выбрать профиль</a>
            <a class="h-btn h-btn--quiet h-btn--phone-wide" href={`tel:${PHONE.raw}`}>{PHONE.label}</a>
          </div>
        </div>
        <img
          class="plh__img"
          src={hero.src}
          alt={hero.alt}
          width="1000"
          height="1000"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </section>

    <section class="h-sec h-sec--tight-top" aria-labelledby="plintus-profiles">
      <div class="container">
        <header class="h-head pl-head">
          <h2 id="plintus-profiles" class="h-h2">Напольный плинтус из МДФ</h2>
          <p class="h-body pl-head__note">Профили и цвета — нажмите на фото, чтобы посмотреть профиль в интерьере.</p>
        </header>
        <PlinthGrid items={PLINTUS} client:visible />
      </div>
    </section>

    <section class="h-sec h-sec--tight-top" aria-labelledby="plintus-spec">
      <div class="container pl-two">
        <div>
          <h2 id="plintus-spec" class="h-h2 pl-h2">Размеры и покрытие</h2>
          <dl class="pl-spec">
            {PLINTUS_SPEC_ROWS.map((row) => (
              <div class="pl-spec__row">
                <dt>{row.label}</dt>
                <dd>{typograph(row.value)}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div>
          <h2 class="h-h2 pl-h2">Как выбрать плинтус</h2>
          <div class="pl-tips">
            {PLINTUS_TIPS.map((tip) => (
              <div>
                <h3 class="h-h3 pl-tip__title">{tip.title}</h3>
                <p class="h-body pl-tip__text">{typograph(tip.text)}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {PLINTUS_LINES.map((line, i) => <PlintusLine line={line} wall={i % 2 === 0} />)}

    <section id="plintus-faq" class="h-sec" aria-labelledby="plintus-faq-title">
      <div class="container h-faq">
        <h2 id="plintus-faq-title" class="h-h2">Частые вопросы о плинтусе</h2>
        <FaqAccordion items={faq} title={false} />
      </div>
    </section>

    <section class="h-sec h-sec--tight-top" aria-label="Запрос цены">
      <div class="container">
        <QuoteCta
          image={PLINTUS[0]!.photo}
          title="Нужна цена?"
          description="Выберите профиль по фото и напишите менеджеру — ответит с ценой и сроком"
          primaryHref={whatsappWithText('Хочу узнать цену на напольный плинтус из МДФ.')}
          primaryLabel="Написать в WhatsApp"
          primaryExternal={true}
          secondaryHref="/catalog/decor/"
          secondaryLabel="Декор и погонаж"
        />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Первый экран: текст и кнопки слева, интерьер справа; на телефоне фото под текстом */
  .plh { padding: clamp(1rem, 2vw, 1.5rem) 0 0; }
  .plh__grid { display: grid; gap: 1.5rem var(--h-gutter); align-items: center; }
  .plh__title { margin: 0; }
  .plh__lead { margin: 1rem 0 0; }
  .plh__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .plh__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 100%; /* плинтус — у пола, внизу кадра */
    border-radius: var(--h-tile-radius);
    background: var(--h-media-bg);
  }
  @media (min-width: 62.5rem) {
    .plh__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .plh__text { grid-column: 1 / span 6; }
    .plh__img { grid-column: 8 / span 5; aspect-ratio: 1; }
  }

  .pl-head { display: grid; gap: 0.75rem var(--h-gutter); margin-bottom: clamp(1.5rem, 3vw, 2rem); }
  .pl-head :global(h2), .pl-head__note { margin: 0; }
  .pl-head__note { max-width: 40rem; color: var(--h-soft); }

  /* Характеристики и советы — две колонки на компьютере */
  .pl-two { display: grid; gap: clamp(2.5rem, 5vw, 3.5rem) var(--h-gutter); align-items: start; }
  @media (min-width: 62.5rem) { .pl-two { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2.5rem, 5vw, 4.5rem); } }
  .pl-h2 { margin: 0 0 1.25rem; }

  .pl-spec { margin: 0; border-top: 0.0625rem solid var(--h-rule); }
  .pl-spec__row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 1rem; padding: 0.875rem 0; border-bottom: 0.0625rem solid var(--h-rule); }
  .pl-spec__row dt { color: var(--h-muted); }
  .pl-spec__row dd { margin: 0; color: var(--h-ink); }

  .pl-tips { display: grid; gap: 1.5rem var(--h-gutter); }
  @media (min-width: 43.75rem) { .pl-tips { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .pl-tip__title { margin: 0 0 0.375rem; }
  .pl-tip__text { margin: 0; color: var(--h-soft); }
</style>
