---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../../components/ui/FaqAccordion.astro'
import ColorSelector      from '../../components/catalog/ColorSelector.vue'
import InfoImageViewer    from '../../components/catalog/InfoImageViewer.vue'
import WorksGallery      from '../../components/catalog/WorksGallery.vue'
import PromoBanner       from '../../components/ui/PromoBanner.vue'
import PhotoAutoplaySlider from '../../components/ui/PhotoAutoplaySlider.vue'
import { INVISIBLE_WORKS } from '../../data/skrytye-dveri-works'
import { PROMOS } from '../../data/promos'
import { merchantPolicy } from '../../lib/contacts-data'
import {
  IMAGES,
  INFO_IMAGES,
  BOX_PRO_IMAGE,
  BOX_LITE_IMAGE,
  SECRET_SIZES,
  SECRET_REVERS_SIZES,
  DOOR_HEIGHT,
  SECRET_PRICES_DISPLAY,
  SECRET_MIN_BLADE_PRICE,
  SECRET_MIN_KIT_PRICE,
  SECRET_MIN_BLADE_PRICE_ORIGINAL,
  SECRET_MIN_KIT_PRICE_ORIGINAL,
  SECRET_REVERS_MIN_BLADE_PRICE,
  SECRET_REVERS_MIN_KIT_PRICE,
  SECRET_REVERS_MIN_BLADE_PRICE_ORIGINAL,
  SECRET_REVERS_MIN_KIT_PRICE_ORIGINAL,
  SECRET_PROMO_ACTIVE,
  SECRET_PROMO_VALID_UNTIL,
  CUSTOM_HEIGHT_TIERS,
  CUSTOM_LEAD_TIME,
  calcCustomPrice,
  REFLEX_IMAGE,
  REFLEX_OPENING_DIAGRAM,
  REFLEX_PRICES,
  REFLEX_MIN_BLADE_PRICE,
  REFLEX_MIN_KIT_PRICE,
  REFLEX_REVERS_MIN_KIT_PRICE,
  REFLEX_HEIGHT_TIERS,
  REFLEX_TWO_SIDED_MIRROR_SURCHARGE,
} from '../../data/skrytye-dveri-products'
import { PHONE as SITE_PHONE, SITE } from '../../config/site'

const secretPromo = PROMOS.find(p => p.id === 3)

const REFLEX_CDN = 'https://storage.yandexcloud.net/vfd74ru/invisible/'
const REFLEX_IMAGES = [
  `${REFLEX_CDN}2213EA7D-2E12-4D33-9BC3-63E4943E0098.webp`,
  `${REFLEX_CDN}A158F8FC-901B-4262-BDF6-D68E573300C8.webp`,
  `${REFLEX_CDN}41CFB5EC-5142-462A-A702-E9AECDE149AD.webp`,
  REFLEX_IMAGE,
]

const PHONE = SITE_PHONE.raw
const TG    = SITE.social.telegram
const VK    = SITE.social.vk
const MAX   = SITE.social.max

const WORKS_LIMIT = 4
const ARCHIVE_HREF = '/catalog/skrytye-dveri/raboty/'
const featuredWorks = INVISIBLE_WORKS.slice(0, WORKS_LIMIT)

const fmt = (n: number) => n.toLocaleString('ru-RU') + ' ₽'

const canonicalUrl = Astro.site
  ? new URL('/catalog/skrytye-dveri/', Astro.site).href
  : undefined

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог', href: '/catalog/' },
  { label: 'Скрытые двери' },
]

const faq = [
  { q: 'Чем скрытая дверь отличается от обычной?',
    a: 'Нет видимых наличников и коробки — алюминиевая рама монтируется заподлицо, полотно располагается вровень со стеной. Петли скрытые. Дверь визуально растворяется в интерьере.' },
  { q: 'Что входит в комплект?',
    a: 'Полотно серии «Секрет» или «Секрет Реверс» и комплект скрытого короба: профиль 54×43 мм (2,5 пог. м), запил под ответную планку, ответная планка и две скрытые петли. Ручка, стопор, завёртка WC — опционально.' },
  { q: 'Можно покрасить в цвет стены?',
    a: 'Да. Полотно поставляется в грунте — красится или штукатурится после монтажа. Главное: красить только после установки, чтобы зазоры совпали по цвету.' },
  { q: 'В чём разница «Секрет» и «Секрет Реверс»?',
    a: '«Секрет» открывается «на себя» (прямой монтаж). «Секрет Реверс» — «от себя», в сторону соседнего помещения. Реверс удобен там, где нежелательно, чтобы полотно занимало пространство в комнате.' },
  { q: 'Как определить сторонность — левая дверь или правая?',
    a: 'Встаньте лицом к двери снаружи помещения (со стороны, где открываете). Если петли справа — дверь правая, петли слева — левая. Правило одинаково для «Секрет» и «Секрет Реверс». Замерщик ВФД уточнит сторонность при выезде.' },
  { q: 'Какой цвет алюминиевой кромки выбрать?',
    a: 'Три варианта: чёрная (анодированный алюминий) — под тёмную фурнитуру и контрастный интерьер; серебро (натуральный алюминий) — нейтральный, для светлых стен; золото (золотистый анод) — под бронзу, латунь и арт-деко. Цена одинакова для всех трёх.' },
  { q: 'Какой нужен проём?',
    a: 'Проём должен быть ровным, откосы — вровень с плоскостью стены. Минимальная толщина стены — 90 мм. Замерщик даёт конкретные рекомендации на месте; по Москве замер бесплатный при оформлении заказа.' },
  { q: 'Есть нестандартные размеры?',
    a: `Стандарт в наличии: ширины ${SECRET_SIZES.join(', ')} мм, высота 2000 мм. Нестандартные высоты под заказ — от 2050 до 2700 мм, надбавка к цене полотна от +20% до +50%. Срок изготовления: ${CUSTOM_LEAD_TIME}.` },
  { q: 'Сколько стоит установка?',
    a: 'Стоимость монтажа рассчитывается отдельно. Мы работаем по Москве, даём гарантию на работы. Уточняйте у менеджера при заказе.' },
  { q: 'Чем «Рефлекс» отличается от «Секрета»?',
    a: 'Тем же скрытым монтажом вровень со стеной, но вместо глухого полотна — зеркало во всю высоту двери. Изготавливается индивидуально, высотой до 2,5 м, доступны прямое и обратное открывание.' },
]

const structuredData = canonicalUrl ? [
  /* BreadcrumbList в JSON-LD отдаёт сам Breadcrumbs.astro — здесь не дублируем. */
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  ...(featuredWorks.length > 0 ? [{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Наши работы — монтаж скрытых дверей в Москве и Московской области',
    itemListElement: featuredWorks.map((w, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'CreativeWork',
        name: w.title,
        ...(w.story ? { description: w.story } : {}),
        dateCreated: w.date,
        image: w.images,
        ...(w.location ? { locationCreated: { '@type': 'Place', name: w.location } } : {}),
      },
    })),
  }] : []),
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Скрытые двери — серии «Секрет» и «Секрет Реверс»',
    description: 'Двери скрытого монтажа: полотно заподлицо со стеной, алюминиевый короб, скрытые петли. Под покраску, штукатурку, обои. Кромка: чёрная, серебро, золото.',
    brand: { '@type': 'Brand', name: 'ВФД' },
    image: IMAGES.invisible,
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'RUB',
      lowPrice: SECRET_MIN_KIT_PRICE,
      highPrice: Math.max(...SECRET_PRICES_DISPLAY.map(r => r.kitStandardPrice)),
      availability: 'https://schema.org/InStock',
      areaServed: [
        { '@type': 'City', name: 'Москва' },
        { '@type': 'AdministrativeArea', name: 'Московская область' },
      ],
      hasMerchantReturnPolicy: merchantPolicy.returnPolicy,
      shippingDetails:         merchantPolicy.shipping,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Скрытая дверь с зеркалом «Рефлекс»',
    description: 'Скрытая дверь с зеркальным полотном во всю высоту — устанавливается вровень со стеной, изготавливается индивидуально высотой до 2,5 м. Кромка: чёрная, серебро, золото.',
    brand: { '@type': 'Brand', name: 'ВФД' },
    image: REFLEX_IMAGE,
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'RUB',
      lowPrice: REFLEX_MIN_KIT_PRICE,
      highPrice: Math.max(...REFLEX_PRICES.map(r => r.kitStandardPrice)),
      availability: 'https://schema.org/InStock',
      areaServed: [
        { '@type': 'City', name: 'Москва' },
        { '@type': 'AdministrativeArea', name: 'Московская область' },
      ],
      hasMerchantReturnPolicy: merchantPolicy.returnPolicy,
      shippingDetails:         merchantPolicy.shipping,
    },
  },
] : undefined
---

<BaseLayout
  title="Скрытые двери в Москве — цены и монтаж | ВФД"
  description={`Скрытые двери «Секрет» и «Секрет Реверс» в Москве — полотно вровень со стеной, без наличников и видимых петель. Комплект от ${fmt(SECRET_MIN_KIT_PRICE)}. Бесплатный замер по Москве при заказе, монтаж под ключ.`}
  ogImage={IMAGES.invisible}
  preloadImage={IMAGES.heroCover}
  canonical={canonicalUrl}
  structuredData={structuredData}
>

  {secretPromo && (
    <PromoBanner client:only="vue" promo={secretPromo} anchor="secret-prices" />
  )}

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════ -->
  <div class="container sd-hero-wrap">
    <section class="sd-hero" aria-label="Двери скрытого монтажа">
      <img
        class="sd-hero__bg"
        src={IMAGES.heroCover}
        alt=""
        aria-hidden="true"
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="sd-hero__grad" aria-hidden="true" />

      <div class="sd-hero__body">
        <p class="sd-eyebrow">Скрытый монтаж · Москва</p>
        <h1 class="sd-hero__h1">Скрытые двери <br/>в Москве</h1>
        <p class="sd-hero__lead">
          Полотно вровень со стеной. Без наличников,
          без видимых петель. Алюминиевый короб прячется
          в проём — снаружи только чистая плоскость.
        </p>
        <div class="sd-hero__actions">
          <a href={TG} target="_blank" rel="noopener" class="btn btn-ghost">Получить расчёт</a>
          <a href={`tel:${PHONE}`} class="btn btn-ghost">Позвонить</a>
        </div>
      </div>
    </section>
  </div>

  <!-- ══════════════════════════════════════════════
       СЕРИИ — 2 ПРОДУКТА
  ══════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="sd-products">

        <!-- Секрет -->
        <article class="sd-product">
          <div class="sd-product__photo">
            <img
              src={IMAGES.invisible}
              alt="Скрытая дверь серии «Секрет» — прямой монтаж"
              loading="lazy"
              decoding="async"
              width="800"
              height="1000"
            />
          </div>
          <div class="sd-product__info">
            <span class="sd-product__eyebrow">Серия</span>
            <h2 class="sd-product__name">«Секрет»</h2>
            <p class="sd-product__type">Скрытый монтаж</p>
            <p class="sd-product__desc">
              Классический скрытый монтаж: дверь открывается «на себя».
              Алюминиевый короб монтируется заподлицо, полотно в грунте —
              под покраску, штукатурку или оклейку обоями в цвет стен.
            </p>
            <div class="sd-product__specs">
              <div class="sd-spec">
                <span class="sd-spec__key">Ширины в наличии</span>
                <span class="sd-spec__val">{SECRET_SIZES.map(w => `${w} мм`).join(' · ')}</span>
              </div>
              <div class="sd-spec">
                <span class="sd-spec__key">Высота стандарт</span>
                <span class="sd-spec__val">{DOOR_HEIGHT} мм</span>
              </div>
              <div class="sd-spec">
                <span class="sd-spec__key">Направление</span>
                <span class="sd-spec__val">Левая · Правая</span>
              </div>
              <div class="sd-spec">
                <span class="sd-spec__key">Цвет кромки</span>
                <span class="sd-spec__val">Чёрная · Серебро · Золото</span>
              </div>
            </div>
            {SECRET_PROMO_ACTIVE && (
              <span class="sd-promo-chip">🔥 Акция -8% до 31 августа</span>
            )}
            <div class="sd-product__price">
              <div>
                <span class="sd-price-label">Полотно</span>
                <span>
                  {SECRET_PROMO_ACTIVE && <span class="sd-price-old">{fmt(SECRET_MIN_BLADE_PRICE_ORIGINAL)}</span>}
                  <span class="sd-price-val">от {fmt(SECRET_MIN_BLADE_PRICE)}</span>
                </span>
              </div>
              <div>
                <span class="sd-price-label">Комплект с коробом</span>
                <span>
                  {SECRET_PROMO_ACTIVE && <span class="sd-price-old">{fmt(SECRET_MIN_KIT_PRICE_ORIGINAL)}</span>}
                  <span class="sd-price-val sd-price-val--accent">от {fmt(SECRET_MIN_KIT_PRICE)}</span>
                </span>
              </div>
            </div>
            <a href={TG} target="_blank" rel="noopener" class="btn btn-primary sd-product__btn">
              Рассчитать стоимость
            </a>
          </div>
        </article>

        <!-- Секрет Реверс -->
        <article class="sd-product sd-product--rev">
          <div class="sd-product__photo">
            <img
              src={IMAGES.invisibleRev}
              alt="Скрытая дверь серии «Секрет Реверс» — реверсивный монтаж"
              loading="lazy"
              decoding="async"
              width="800"
              height="1000"
            />
          </div>
          <div class="sd-product__info">
            <span class="sd-product__eyebrow">Серия</span>
            <h2 class="sd-product__name">«Секрет Реверс»</h2>
            <p class="sd-product__type">Реверсивный монтаж</p>
            <p class="sd-product__desc">
              Дверь открывается «от себя» — в сторону соседнего помещения.
              Удобно, когда нежелательно, чтобы полотно занимало пространство
              в текущей комнате. При заказе указывается сторона петель.
            </p>
            <div class="sd-product__specs">
              <div class="sd-spec">
                <span class="sd-spec__key">Ширины в наличии</span>
                <span class="sd-spec__val">{SECRET_REVERS_SIZES.map(w => `${w} мм`).join(' · ')}</span>
              </div>
              <div class="sd-spec">
                <span class="sd-spec__key">Высота стандарт</span>
                <span class="sd-spec__val">{DOOR_HEIGHT} мм</span>
              </div>
              <div class="sd-spec">
                <span class="sd-spec__key">Направление</span>
                <span class="sd-spec__val">Левая · Правая</span>
              </div>
              <div class="sd-spec">
                <span class="sd-spec__key">Цвет кромки</span>
                <span class="sd-spec__val">Чёрная · Серебро · Золото</span>
              </div>
            </div>
            {SECRET_PROMO_ACTIVE && (
              <span class="sd-promo-chip">🔥 Акция -8% до 31 августа</span>
            )}
            <div class="sd-product__price">
              <div>
                <span class="sd-price-label">Полотно</span>
                <span>
                  {SECRET_PROMO_ACTIVE && <span class="sd-price-old">{fmt(SECRET_REVERS_MIN_BLADE_PRICE_ORIGINAL)}</span>}
                  <span class="sd-price-val">от {fmt(SECRET_REVERS_MIN_BLADE_PRICE)}</span>
                </span>
              </div>
              <div>
                <span class="sd-price-label">Комплект с коробом</span>
                <span>
                  {SECRET_PROMO_ACTIVE && <span class="sd-price-old">{fmt(SECRET_REVERS_MIN_KIT_PRICE_ORIGINAL)}</span>}
                  <span class="sd-price-val sd-price-val--accent">от {fmt(SECRET_REVERS_MIN_KIT_PRICE)}</span>
                </span>
              </div>
            </div>
            <a href={TG} target="_blank" rel="noopener" class="btn btn-primary sd-product__btn">
              Рассчитать стоимость
            </a>
          </div>
        </article>

      </div>

      <!-- Цены «Секрет» / «Секрет Реверс» по кромке и стороне открывания -->
      <h3 id="secret-prices" class="sd-h3" style="margin-top: 2.5rem">Цены «Секрет» по кромке и стороне открывания</h3>
      {SECRET_PROMO_ACTIVE && (
        <p class="sd-promo-note">
          🔥 Цены в таблице уже с учётом акции -8% — действует до 31 августа 2026 г.
        </p>
      )}
      <div class="sd-table-wrap sd-stack-table-wrap">
        <table class="sd-compare sd-stack-table">
          <thead>
            <tr>
              <th scope="col">Кромка</th>
              <th scope="col">Открывание</th>
              <th scope="col">Полотно</th>
              <th scope="col">Комплект Стандарт</th>
              <th scope="col">Комплект Лайт</th>
            </tr>
          </thead>
          <tbody>
            {SECRET_PRICES_DISPLAY.map(row => (
              <tr>
                <td data-label="Кромка">{row.edgeLabel}</td>
                <td data-label="Открывание">{row.reverse ? 'Обратное' : 'Прямое'}</td>
                <td data-label="Полотно">{fmt(row.bladePrice)}</td>
                <td data-label="Комплект Стандарт"><strong>{fmt(row.kitStandardPrice)}</strong></td>
                <td data-label="Комплект Лайт">{row.kitLitePrice != null ? fmt(row.kitLitePrice) : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="sd-table-foot">
        Комплект Стандарт и Комплект Лайт отличаются коробом — разница в конструкции ниже.
        Для кромки золото комплект Лайт не предлагается.
      </p>

      <!-- Короб «Секрет» — два варианта конструкции, разрезы кликабельны (модалка) -->
      <h3 class="sd-h3" style="margin-top: 2.5rem">Короб «Секрет»: Стандарт и Лайт — в чём разница</h3>
      <InfoImageViewer
        client:only="vue"
        variant="wide"
        aspectRatio="5 / 4"
        images={[
          { src: BOX_LITE_IMAGE, caption: 'Короб «Секрет Лайт» — разрез', alt: 'Разрез короба «Секрет Лайт»: алюминиевый профиль с наполнением из массива сосны' },
          { src: BOX_PRO_IMAGE,  caption: 'Короб «Секрет» — профиль',     alt: 'Профиль короба «Секрет»: монолитный алюминиевый сплав со штукатурным крылом' },
        ]}
      />
      <div class="sd-box-types">
        <div class="sd-box-type">
          <h4 class="sd-box-type__name">Короб «Секрет Лайт ВФД»</h4>
          <p class="sd-p">
            Облегчённый комплект скрытого алюминиевого короба, разработанный для монтажа
            межкомнатных дверей-невидимок. Конструкция позволяет установить дверное полотно
            в одной плоскости со стеной, полностью отказавшись от традиционных наличников
            и создавая эффект «двери без двери».
          </p>
          <div class="sd-box-feature">
            <h5>Облегчённый профиль с наполнением из массива сосны</h5>
            <p>
              Сечение короба оптимизировано для снижения массы без потери жёсткости,
              необходимой для стандартных межкомнатных полотен. Внешний контур выполнен
              из тонкостенного алюминиевого профиля, внутри которого расположен массив
              сосны. Такое сочетание решает сразу несколько задач: алюминий задаёт точную
              геометрию и защищает конструкцию от внешних воздействий, а древесина
              обеспечивает плотную фиксацию крепежа.
            </p>
          </div>
        </div>
        <div class="sd-box-type">
          <h4 class="sd-box-type__name">Короб «Секрет»</h4>
          <p class="sd-p">
            Система скрытой установки межкомнатных дверей, выполненная из экструдированного
            алюминиевого сплава. Конструкция монтируется вровень со стеной и формирует
            безупречно ровный проём без наличников, создавая эффект «двери-невидимки».
          </p>
          <div class="sd-box-feature">
