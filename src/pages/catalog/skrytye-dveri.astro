---
/**
 * /catalog/skrytye-dveri/ — скрытые двери «Секрет», «Секрет Реверс» и
 * «Рефлекс» в Москве.
 *
 * Дизайн-система главной (src/styles/home.css, обёртка .home). Порядок —
 * от выбора к покупке: серии → что учесть в Москве → цены → короб →
 * кромка → конструкция → работы → для какого объекта → процесс → вопросы
 * → салон с картой.
 *
 * Цены и размеры — src/data/skrytye-dveri-products.ts, тексты и FAQ —
 * src/data/hidden-doors-page.ts, данные салона — src/config/site.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../../components/ui/FaqAccordion.astro'
import LandingHero from '../../components/ui/LandingHero.astro'
import SectionNav from '../../components/partitions/SectionNav.astro'
import PriceTable from '../../components/catalog/PriceTable.astro'
import ColorSelector from '../../components/catalog/ColorSelector.vue'
import InfoImageViewer from '../../components/catalog/InfoImageViewer.vue'
import WorkCard from '../../components/portfolio/WorkCard.astro'
import StepsRow from '../../components/home/StepsRow.astro'
import VisitBand from '../../components/home/VisitBand.astro'
import '../../styles/home.css'

import {
  IMAGES, HERO_IMAGES, INFO_IMAGES, BOX_PRO_IMAGE, BOX_LITE_IMAGE, FACTS,
  SECRET_SIZES, SECRET_REVERS_SIZES, DOOR_HEIGHT,
  SECRET_PRICES_DISPLAY, SECRET_MIN_BLADE_PRICE, SECRET_MIN_KIT_PRICE,
  SECRET_MIN_KIT_PRICE_ORIGINAL, SECRET_REVERS_MIN_BLADE_PRICE, SECRET_REVERS_MIN_KIT_PRICE,
  SECRET_REVERS_MIN_KIT_PRICE_ORIGINAL, SECRET_PROMO_ACTIVE, SECRET_PROMO_VALID_UNTIL,
  CUSTOM_HEIGHT_TIERS, CUSTOM_LEAD_TIME, CUSTOM_MAX_HEIGHT, calcCustomPrice,
  REFLEX_IMAGE, REFLEX_OPENING_DIAGRAM, REFLEX_PRICES, REFLEX_MIN_BLADE_PRICE,
  REFLEX_MIN_KIT_PRICE, REFLEX_REVERS_MIN_KIT_PRICE, REFLEX_HEIGHT_TIERS, REFLEX_MAX_HEIGHT,
  REFLEX_TWO_SIDED_MIRROR_SURCHARGE,
} from '../../data/skrytye-dveri-products'
import { HERO_FACTS, MOSCOW_NOTES, SEGMENTS, HIDDEN_DOORS_FAQ } from '../../data/hidden-doors-page'
import { PORTFOLIO_WORKS } from '../../data/portfolio-works'
import { STATUS_LABEL, type Status } from '../../data/in-salon'
import { rub } from '../../data/services'
import { merchantPolicy } from '../../lib/contacts-data'
import { localBusinessSchema, LOCAL_BUSINESS_ID } from '../../lib/local-business-schema'
import { typograph } from '../../lib/typograph'
import { PHONE, SITE } from '../../config/site'

const CALL = `tel:${PHONE.raw}`
const opening = (reverse: boolean) => (reverse ? 'от себя' : 'на себя')
const promoUntil = new Date(SECRET_PROMO_VALID_UNTIL).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', timeZone: 'UTC' })

/* ── Серии: карточки наверху страницы ── */
const series: {
  id: string; name: string; type: string; status: Status; text: string
  image: string; alt: string; specs: [string, string][]
  kit: number; kitOld?: number; blade: number; href: string
}[] = [
  {
    id: 'sekret', name: '«Секрет»', type: 'Открывается на себя', status: 'stock',
    text: 'Классический скрытый монтаж. Полотно в грунте — под покраску, штукатурку или обои в цвет стены.',
    image: IMAGES.invisible, alt: 'Скрытая дверь «Секрет» вровень со стеной',
    specs: [
      ['Ширины в наличии', `${SECRET_SIZES.join(', ')} мм`],
      ['Высота', `${DOOR_HEIGHT} мм, под заказ до ${CUSTOM_MAX_HEIGHT}`],
      ['Кромка', 'чёрная, серебро, золото'],
    ],
    kit: SECRET_MIN_KIT_PRICE, kitOld: SECRET_PROMO_ACTIVE ? SECRET_MIN_KIT_PRICE_ORIGINAL : undefined,
    blade: SECRET_MIN_BLADE_PRICE, href: '#prices',
  },
  {
    id: 'revers', name: '«Секрет Реверс»', type: 'Открывается от себя', status: 'stock',
    text: 'Полотно уходит в соседнее помещение — открытая дверь не занимает место в комнате.',
    image: IMAGES.invisibleRev, alt: 'Скрытая дверь «Секрет Реверс» с обратным открыванием',
    specs: [
      ['Ширины в наличии', `${SECRET_REVERS_SIZES.join(', ')} мм`],
      ['Высота', `${DOOR_HEIGHT} мм, под заказ до ${CUSTOM_MAX_HEIGHT}`],
      ['Кромка', 'чёрная, серебро, золото'],
    ],
    kit: SECRET_REVERS_MIN_KIT_PRICE, kitOld: SECRET_PROMO_ACTIVE ? SECRET_REVERS_MIN_KIT_PRICE_ORIGINAL : undefined,
    blade: SECRET_REVERS_MIN_BLADE_PRICE, href: '#prices',
  },
  {
    id: 'reflex', name: '«Рефлекс»', type: 'Зеркало во всю высоту', status: 'new',
    text: 'Тот же монтаж вровень со стеной, но полотно — зеркало: прихожая выглядит больше и светлее.',
    image: REFLEX_IMAGE, alt: 'Скрытая дверь с зеркалом «Рефлекс»',
    specs: [
      ['Открывание', 'на себя или от себя'],
      ['Высота', `по размеру, до ${REFLEX_MAX_HEIGHT} мм`],
      ['Опция', `зеркало с двух сторон, +${rub(REFLEX_TWO_SIDED_MIRROR_SURCHARGE)}`],
    ],
    kit: REFLEX_MIN_KIT_PRICE, blade: REFLEX_MIN_BLADE_PRICE, href: '#prices-reflex',
  },
]

/* ── Таблицы цен ── */
const lite = (v: number | null) => (v != null ? rub(v) : '—')
const secretRows = SECRET_PRICES_DISPLAY.map((r) => ({
  variant: `${r.edgeLabel}, ${opening(r.reverse)}`,
  blade: rub(r.bladePrice), standard: rub(r.kitStandardPrice), lite: lite(r.kitLitePrice),
}))
const reflexRows = REFLEX_PRICES.map((r) => ({
  variant: `${r.edgeLabel}, ${opening(r.reverse)}`,
  blade: rub(r.bladePrice), standard: rub(r.kitStandardPrice), lite: lite(r.kitLitePrice),
  standard2: rub(r.kitStandardPrice + REFLEX_TWO_SIDED_MIRROR_SURCHARGE),
  lite2: lite(r.kitLitePrice != null ? r.kitLitePrice + REFLEX_TWO_SIDED_MIRROR_SURCHARGE : null),
}))
const secretHeightRows = CUSTOM_HEIGHT_TIERS.map((t) => ({
  range: `${t.range} мм`, pct: t.pct,
  secret: rub(calcCustomPrice(SECRET_MIN_KIT_PRICE, t.surcharge)),
  revers: rub(calcCustomPrice(SECRET_REVERS_MIN_KIT_PRICE, t.surcharge)),
}))
const reflexHeightRows = REFLEX_HEIGHT_TIERS.map((t) => ({
  range: `${t.range} мм`, pct: t.pct,
  direct: rub(calcCustomPrice(REFLEX_MIN_KIT_PRICE, t.surcharge)),
  reverse: rub(calcCustomPrice(REFLEX_REVERS_MIN_KIT_PRICE, t.surcharge)),
}))

/* ── Работы: объекты портфолио со скрытыми дверями ── */
const works = PORTFOLIO_WORKS
  .filter((w) => w.category === 'hidden')
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3)

const navItems = [
  { id: 'series',    label: 'Серии' },
  { id: 'moscow',    label: 'В Москве' },
  { id: 'prices',    label: 'Цены' },
  { id: 'box',       label: 'Короб' },
  { id: 'edge',      label: 'Кромка' },
  { id: 'hd-faq',    label: 'Вопросы' },
]

/* ── SEO ── */
const pageUrl = new URL('/catalog/skrytye-dveri/', SITE.url).href
const title = `Скрытые двери под покраску ${SITE.city.in} — цены от ${rub(SECRET_MIN_KIT_PRICE)} | ${SITE.name}`
// ~160 символов — длиннее поисковики обрезают
const description =
  `Скрытые двери ${SITE.city.in}: «Секрет», «Секрет Реверс» и зеркальная «Рефлекс». ` +
  `Комплект с коробом от ${rub(SECRET_MIN_KIT_PRICE)}, высота до ${CUSTOM_MAX_HEIGHT} мм, замер и монтаж по Москве и области.`

const areaServed = [
  { '@type': 'City', name: SITE.city.name },
  { '@type': 'AdministrativeArea', name: 'Московская область' },
]
const product = (name: string, text: string, image: string, low: number, high: number) => ({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description: text,
  brand: { '@type': 'Brand', name: SITE.name },
  image: new URL(image, SITE.url).href,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'RUB',
    lowPrice: low,
    highPrice: high,
    availability: 'https://schema.org/InStock',
    areaServed,
    seller: { '@id': LOCAL_BUSINESS_ID },
    hasMerchantReturnPolicy: merchantPolicy.returnPolicy,
  },
})
const structuredData = [
  localBusinessSchema({ url: SITE.url }),
  product(
    'Скрытые двери «Секрет» и «Секрет Реверс»',
    'Двери скрытого монтажа: полотно вровень со стеной, алюминиевый короб, скрытые петли. Под покраску, штукатурку, обои. Кромка: чёрная, серебро, золото.',
    IMAGES.invisible, SECRET_MIN_KIT_PRICE, Math.max(...SECRET_PRICES_DISPLAY.map((r) => r.kitStandardPrice)),
  ),
  product(
    'Скрытая дверь с зеркалом «Рефлекс»',
    `Скрытая дверь с зеркальным полотном во всю высоту, монтаж вровень со стеной, изготовление по размеру до ${REFLEX_MAX_HEIGHT} мм.`,
    REFLEX_IMAGE, REFLEX_MIN_KIT_PRICE, Math.max(...REFLEX_PRICES.map((r) => r.kitStandardPrice)) + REFLEX_TWO_SIDED_MIRROR_SURCHARGE,
  ),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: HIDDEN_DOORS_FAQ.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
]

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог', href: '/catalog/' },
  { label: 'Скрытые двери' },
]
---

<BaseLayout title={title} description={description} canonical={pageUrl} ogImage={IMAGES.invisible} structuredData={structuredData}>
  <SectionNav items={navItems} />

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="home">
    <LandingHero
      title={`Скрытые двери ${SITE.city.in}`}
      lead="Полотно вровень со стеной — без наличников и видимых петель. Под покраску, штукатурку или обои в цвет стен. Замер и монтаж по Москве и области."
      image={HERO_IMAGES}
      facts={HERO_FACTS}
    >
      <Fragment slot="actions">
        <a href={CALL} class="h-btn h-btn--signal">Рассчитать стоимость</a>
        <a href="#prices" class="h-btn h-btn--quiet">Смотреть цены</a>
      </Fragment>
    </LandingHero>

    <!-- ── Серии ── -->
    <section id="series" class="h-sec h-sec--wall" aria-labelledby="series-title">
      <div class="container">
        <header class="h-head">
          <h2 id="series-title" class="h-h2">Три серии скрытых дверей</h2>
          <p class="h-lead">Все три ставятся вровень со&nbsp;стеной на&nbsp;алюминиевый короб и&nbsp;скрытые петли. Разница&nbsp;— в&nbsp;стороне открывания и&nbsp;полотне.</p>
        </header>

        <ul class="hd-series h-rail" role="list">
          {series.map((s) => (
            <li id={s.id} class="hd-serie">
              <span class="h-media hd-serie__media">
                <img src={s.image} alt={s.alt} width="900" height="1125" loading="lazy" decoding="async" />
              </span>
              <span class="h-status h-meta hd-serie__status" data-status={s.status}>{STATUS_LABEL[s.status]}</span>
              <h3 class="hd-serie__name">{s.name}</h3>
              <p class="h-meta hd-serie__type">{s.type}</p>
              <p class="h-body hd-serie__text">{typograph(s.text)}</p>
              <dl class="hd-serie__specs">
                {s.specs.map(([k, v]) => (
                  <div><dt class="h-meta">{k}</dt><dd>{typograph(v)}</dd></div>
                ))}
              </dl>
              <div class="hd-serie__price">
                <span class="h-meta">Комплект с&nbsp;коробом</span>
                <span class="hd-serie__value">
                  {s.kitOld && <s class="hd-serie__old">{rub(s.kitOld)}</s>}
                  от&nbsp;{rub(s.kit)}
                </span>
                <span class="h-meta">Полотно от&nbsp;{rub(s.blade)}</span>
              </div>
              <a href={s.href} class="h-link hd-serie__link">Все цены</a>
            </li>
          ))}
        </ul>
        {SECRET_PROMO_ACTIVE && (
          <p class="h-meta hd-note">Цены «Секрет» и&nbsp;«Секрет Реверс» указаны со&nbsp;скидкой&nbsp;— акция действует до&nbsp;{promoUntil}.</p>
        )}
      </div>
    </section>

    <!-- ── Что учесть в Москве ── -->
    <section id="moscow" class="h-sec" aria-labelledby="moscow-title">
      <div class="container">
        <header class="h-head">
          <h2 id="moscow-title" class="h-h2">Скрытые двери в&nbsp;московской квартире</h2>
          <p class="h-lead">Что важно учесть до&nbsp;заказа: от&nbsp;новостройки без отделки до&nbsp;высоких потолков и&nbsp;перегородок из&nbsp;гипсокартона.</p>
        </header>
        <ul class="hd-notes" role="list">
          {MOSCOW_NOTES.map((n) => (
            <li class="hd-note-item">
              <h3 class="h-h3">{typograph(n.title)}</h3>
              <p class="h-body">{typograph(n.text)}</p>
              {n.href && <a href={n.href} class="h-link hd-note-item__link">{n.link}</a>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Цены ── -->
    <section id="prices" class="h-sec h-sec--wall" aria-labelledby="prices-title">
      <div class="container">
        <header class="h-head">
          <h2 id="prices-title" class="h-h2">Цены на&nbsp;скрытые двери</h2>
          <p class="h-lead">Цена зависит от&nbsp;кромки, стороны открывания и&nbsp;короба. Комплект&nbsp;— полотно, короб, ответная планка и&nbsp;две скрытые петли.</p>
        </header>

        <div class="hd-prices">
          <div class="hd-prices__block">
            <h3 class="hd-subhead">«Секрет» и&nbsp;«Секрет Реверс»</h3>
            <PriceTable
              caption="Цены на скрытые двери «Секрет» и «Секрет Реверс»"
              rowHeader="variant"
              columns={[
                { key: 'variant',  label: 'Кромка и открывание' },
                { key: 'blade',    label: 'Полотно' },
                { key: 'standard', label: 'Комплект Стандарт', strong: true },
                { key: 'lite',     label: 'Комплект Лайт' },
              ]}
              rows={secretRows}
            />
          </div>

          <details id="prices-reflex" class="hd-prices__block" open data-collapse-mobile>
            <summary class="hd-subhead">«Рефлекс» с&nbsp;зеркалом</summary>
            <PriceTable
              caption="Цены на скрытую дверь с зеркалом «Рефлекс»"
              rowHeader="variant"
              columns={[
                { key: 'variant',   label: 'Кромка и открывание' },
                { key: 'blade',     label: 'Полотно' },
                { key: 'standard',  label: 'Комплект Стандарт', strong: true },
                { key: 'lite',      label: 'Комплект Лайт' },
                { key: 'standard2', label: 'Стандарт, зеркало с двух сторон' },
                { key: 'lite2',     label: 'Лайт, зеркало с двух сторон' },
              ]}
              rows={reflexRows}
            />
          </details>

          <details class="hd-prices__block" open data-collapse-mobile>
            <summary class="hd-subhead">Нестандартная высота</summary>
            <p class="h-body hd-prices__lead">
              Для высоких потолков: надбавка применяется к&nbsp;полотну и&nbsp;коробу,
              срок изготовления&nbsp;— {CUSTOM_LEAD_TIME}. Цены&nbsp;— за&nbsp;самый доступный комплект.
            </p>
            <div class="hd-heights">
              <PriceTable
                caption="«Секрет» нестандартной высоты"
                rowHeader="range"
                columns={[
                  { key: 'range',  label: `«Секрет», до ${CUSTOM_MAX_HEIGHT} мм` },
                  { key: 'pct',    label: 'Надбавка' },
                  { key: 'secret', label: '«Секрет»', strong: true },
                  { key: 'revers', label: '«Секрет Реверс»', strong: true },
                ]}
                rows={secretHeightRows}
              />
              <PriceTable
                caption="«Рефлекс» нестандартной высоты"
                rowHeader="range"
                columns={[
                  { key: 'range',   label: `«Рефлекс», до ${REFLEX_MAX_HEIGHT} мм` },
                  { key: 'pct',     label: 'Надбавка' },
                  { key: 'direct',  label: 'На себя', strong: true },
                  { key: 'reverse', label: 'От себя', strong: true },
                ]}
                rows={reflexHeightRows}
              />
            </div>
          </details>
        </div>

        <p class="h-meta hd-note">
          Комплекты Стандарт и&nbsp;Лайт отличаются коробом&nbsp;— разница ниже. Для&nbsp;кромки золото
          комплект Лайт не&nbsp;делают. Ручка, стопор и&nbsp;завёртка WC&nbsp;— отдельно.
          {SECRET_PROMO_ACTIVE && ` Цены «Секрет» — со скидкой по акции до ${promoUntil}.`}
        </p>
      </div>
    </section>

    <!-- ── Короб: Стандарт и Лайт ── -->
    <section id="box" class="h-sec" aria-labelledby="box-title">
      <div class="container">
        <header class="h-head">
          <h2 id="box-title" class="h-h2">Короб: Стандарт или Лайт</h2>
          <p class="h-lead">Короб держит полотно и&nbsp;задаёт плоскость стены. Оба варианта алюминиевые, разница&nbsp;— в&nbsp;сечении и&nbsp;цене.</p>
        </header>
        <div class="hd-box">
          <div class="hd-box__viewer">
            <InfoImageViewer
              client:only="vue"
              variant="wide"
              aspectRatio="5 / 4"
              images={[
                { src: BOX_PRO_IMAGE,  caption: 'Короб «Секрет» — Стандарт', alt: 'Профиль короба «Секрет»: монолитный алюминиевый сплав со штукатурным крылом' },
                { src: BOX_LITE_IMAGE, caption: 'Короб «Секрет Лайт» — разрез', alt: 'Разрез короба «Секрет Лайт»: алюминиевый профиль с наполнением из массива сосны' },
              ]}
            />
          </div>
          <div class="hd-box__types">
            <div>
              <h3 class="h-h3">Стандарт</h3>
              <ul class="hd-rules" role="list">
                <li>Монолитный профиль из&nbsp;экструдированного алюминия: без клеевых швов, не&nbsp;расслаивается и&nbsp;не&nbsp;ведёт</li>
                <li>Штукатурное крыло с&nbsp;рифлением: переход от&nbsp;короба к&nbsp;стене без&nbsp;шва и&nbsp;трещин при&nbsp;усадке</li>
                <li>Узел притвора рассчитан под&nbsp;скрытые магнитные и&nbsp;механические замки</li>
              </ul>
            </div>
            <div>
              <h3 class="h-h3">Лайт</h3>
              <ul class="hd-rules" role="list">
                <li>Облегчённый алюминиевый профиль с&nbsp;массивом сосны внутри</li>
                <li>Алюминий держит геометрию, древесина&nbsp;— крепёж</li>
                <li>Дешевле Стандарта; для&nbsp;кромки золото не&nbsp;делают</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Кромка ── -->
    <section id="edge" class="h-sec h-sec--wall" aria-labelledby="edge-title">
      <div class="container hd-edge">
        <div class="hd-edge__text">
          <h2 id="edge-title" class="h-h2">Цвет кромки</h2>
          <p class="h-lead hd-edge__lead">Тонкая алюминиевая кромка по&nbsp;контуру полотна&nbsp;— единственное, что видно на&nbsp;стене. Выбирайте под&nbsp;фурнитуру и&nbsp;отделку.</p>
          <dl class="hd-edge__list">
            <div><dt class="h-h3">Чёрная</dt><dd class="h-body">Анодированный алюминий. К&nbsp;тёмной фурнитуре и&nbsp;контрастным интерьерам.</dd></div>
            <div><dt class="h-h3">Серебро</dt><dd class="h-body">Натуральный алюминий. Нейтральный вариант для&nbsp;светлых стен и&nbsp;минимализма.</dd></div>
