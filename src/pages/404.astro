---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Страница не найдена — ВФД на Кашириных"
  description="Такой страницы нет или она была перемещена. Посмотрите каталог дверей или перейдите на главную."
  noIndex={true}
>
  <div class="section">
    <div class="container">
      <div class="nf-wrap">
        <p class="nf-code">404</p>
        <h1 class="nf-title">Страница не найдена</h1>
        <p class="nf-text">
          Такой страницы нет или она была перемещена. Возможно, ссылка устарела —
          проверьте адрес или воспользуйтесь навигацией ниже.
        </p>
        <div class="nf-actions">
          <a href="/" class="btn btn-primary">На главную</a>
          <a href="/catalog/" class="btn btn-outline">Каталог дверей</a>
          <a href="/contacts/" class="btn btn-outline">Контакты</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.nf-wrap {
  max-width: 34rem;
  margin: 0 auto;
  padding: clamp(3rem, 8vw, 6rem) 0;
  text-align: center;
}
.nf-code {
  margin: 0 0 0.5rem;
  font-size: clamp(3.5rem, 10vw, 5.5rem);
  font-weight: 500;
  line-height: 1;
  letter-spacing: -0.03em;
  color: var(--color-ink, #0f172a);
  opacity: 0.12;
}
.nf-title {
  margin: 0 0 0.875rem;
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--color-ink, #0f172a);
}
.nf-text {
  margin: 0 0 2rem;
  font-size: 1rem;
  line-height: 1.7;
  color: #64748b;
}
.nf-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.625rem;
}
</style>
