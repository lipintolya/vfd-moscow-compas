---
/**
 * /catalog/ — каталог межкомнатных дверей. Дизайн-система сайта
 * (styles/home.css): шапка раздела, каталог с фильтрами (CatalogClient —
 * фильтрация в браузере, без перезагрузки), покрытия и серии, подборки,
 * вопросы, визит в салон.
 *
 * Данные — Supabase на сборке (src/lib/catalog-data.ts). Порядок по
 * умолчанию — «популярные» (src/lib/popular-series.ts: первым «Урбан
 * Древесный»), порядок покрытий — COATING_ORDER (src/lib/catalog-filter.ts).
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import CatalogClient from '../components/catalog/CatalogClient.vue'
import FaqAccordion from '../components/ui/FaqAccordion.astro'
import VisitBand from '../components/home/VisitBand.astro'
import { getCatalogCards, getSeriesCardsData } from '../lib/catalog-data'
import { sortCards, coatingRank } from '../lib/catalog-filter'
import { getSeriesSpec, coatingGroupCopy } from '../data/series-descriptions'
import { DOOR_CATEGORIES } from '../data/door-categories'
import { COLOR_CATEGORIES } from '../data/color-categories'
import { STYLE_CATEGORIES } from '../data/style-categories'
import { MEASURE_TERMS, rub } from '../data/services'
import { brandTitle } from '../lib/seo-title'
import { pluralRu } from '../lib/plural'
import { typograph } from '../lib/typograph'
import { SITE } from '../config/site'
import '../styles/home.css'

const { cards } = await getCatalogCards()
const seriesCardsData = getSeriesCardsData(cards)

const prices = cards.map((c) => c.price).filter((p): p is number => p != null)
const minPrice = Math.min(...prices)
const modelsCount = `${cards.length} ${pluralRu(cards.length, ['модель', 'модели', 'моделей'])}`

/* Подпись подборки — заголовок её страницы без «в Москве» */
const pickLabel = (h1: string) => h1.replace(` ${SITE.city.in}`, '')

/* ── Покрытия и серии: группы по покрытию в порядке COATING_ORDER ── */
const LANDING_BY_COATING = new Map(DOOR_CATEGORIES.map((c) => [c.coatingSlug, c]))

const coatingGroups = [...new Map(seriesCardsData.map((s) => [s.coatingSlug, s.coatingName])).entries()]
  .sort(([a, an], [b, bn]) => coatingRank(a) - coatingRank(b) || an.localeCompare(bn, 'ru'))
  .map(([slug, name]) => {
    const series = seriesCardsData.filter((s) => s.coatingSlug === slug)
    /* Текст покрытия общий для его серий; нет полного — короткий из характеристик */
    const spec = getSeriesSpec(series[0]!.slug, slug)
    const copy = coatingGroupCopy[slug]
    const seriesPrices = series.map((s) => s.minPrice).filter((p): p is number => p != null)
    const landing = LANDING_BY_COATING.get(slug)
    return {
      slug,
      name,
      series,
      tagline: copy?.tagline ?? '',
      description: copy?.description ?? [spec.coating, spec.material].filter(Boolean).map((t) => t.replace(/\.?$/, '.')).join(' '),
      minPrice: seriesPrices.length ? Math.min(...seriesPrices) : null,
      cover: series.find((s) => s.cover)?.cover ?? '',
      link: landing
        ? { href: `/catalog/${landing.slug}/`, label: pickLabel(landing.h1) }
        : { href: `/catalog/?coating=${slug}`, label: `Модели: ${name}` },
    }
  })
const coatingNames = coatingGroups.map((g) => g.name)

/* ── Варианты фильтров ── */
const uniqueBy = <T,>(items: T[], key: (item: T) => string) => [...new Map(items.map((i) => [key(i), i])).values()]
const allSeries = uniqueBy(cards.filter((c) => c.seriesSlug), (c) => c.seriesSlug).map((c) => ({ label: c.series, value: c.seriesSlug }))
const allCoatings = uniqueBy(cards.filter((c) => c.coatingSlug), (c) => c.coatingSlug).map((c) => ({ label: c.coating, value: c.coatingSlug }))
/* Карточки покрытий над каталогом: фото серии в интерьере и цена «от» */
const coatingCards = coatingGroups.map((g) => ({ value: g.slug, label: g.name, cover: g.cover, minPrice: g.minPrice }))

/* ── Вопросы ── */
const catalogFaq = [
  {
    q: 'Сколько стоит межкомнатная дверь с установкой?',
    a: 'Цена складывается из полотна, погонажа (короб, наличники, добор), фурнитуры и монтажа и зависит от серии и покрытия. Цена полотна и комплекта указана у каждой модели в каталоге, полный комплект с фурнитурой удобно посчитать в калькуляторе на странице модели. Точный расчёт под ваш проём — после замера.',
  },
  {
    q: `Какое покрытие выбрать: ${coatingNames.join(', ')}?`,
    a: `Экошпон — плёнка с древесной текстурой и тиснением «в поры», выглядит как шпон и не требует особого ухода; в нём серия «Урбан Древесный». Эмаль — гладкая окрашенная поверхность и широкая палитра, классика. ПЭТ — самое стойкое к царапинам и отпечаткам, выбор для семей с детьми и животными. Эмалекс — гладкое полимерное покрытие, устойчивое к влаге и царапинам, по виду близко к эмали, но практичнее по цене. Протач — плотное матовое покрытие, приятное на ощупь и стойкое к износу. Образцы всех покрытий можно посмотреть вживую в салоне в ${SITE.address.mall}.`,
  },
  {
    q: `Где посмотреть двери вживую ${SITE.city.in}?`,
    a: `В салоне ${SITE.studioNameOf} — ${SITE.address.full}. Работаем ежедневно с ${SITE.hours.opens} до ${SITE.hours.closes}. Ближайшие станции: ${SITE.address.metro.map((m) => `${m.station}${'line' in m ? ` (${m.line})` : ''} — ${m.time}`).join(', ')}.`,
  },
  {
    q: 'Вы делаете замер и установку?',
    a: `Да. ${MEASURE_TERMS}. Монтаж выполняет наша бригада с гарантией на работы: те же специалисты, что помогают с подбором, ведут заказ до установленной двери.`,
  },
  {
    q: 'Можно ли заказать дверь нестандартного размера?',
    a: `Да, полотна изготавливаются под заказ по нестандартной высоте и ширине. Доплаты за ширину 900 мм у ${SITE.name} нет. Возможные размеры и сроки для конкретной серии подскажет менеджер при расчёте.`,
  },
  {
    q: 'Как посчитать полную стоимость комплекта?',
    a: 'На странице каждой модели есть калькулятор: выбираете цвет, короб, наличники, доборы, тип петель и замок — и сразу видите итоговую сумму комплекта. Это ориентир до замера; финальную смету составляем после замера проёмов.',
  },
]

/* ── Для поисковиков ── */
const canonicalUrl = `${SITE.url}/catalog/`
const title = brandTitle(`Межкомнатные двери ${SITE.name} — цены от ${rub(minPrice)} ${SITE.city.in}`)
const description = `Межкомнатные двери ${SITE.name} ${SITE.city.in}: ${modelsCount} с ценами от ${rub(minPrice)} за полотно. Образцы вживую в ${SITE.address.mall}, замер и монтаж.`

/* Первая страница каталога в порядке по умолчанию — то, что видно сразу */
const firstPage = sortCards(cards, 'popular').slice(0, 24)

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Межкомнатные двери ${SITE.name} ${SITE.city.in}`,
    description,
    url: canonicalUrl,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: cards.length,
      itemListElement: firstPage.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}/models/${c.slug}/`,
        name: c.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: catalogFaq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
]

const arrow = '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
---

<BaseLayout title={title} description={description} canonical={canonicalUrl} structuredData={structuredData}>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Каталог' }]} />
    </div>
  </div>

  <div class="home">
    <section class="ct" aria-labelledby="ct-title">
      <div class="container">
        <header class="ct__head">
          <h1 id="ct-title" class="h-h1">Межкомнатные двери {SITE.city.in.replace(' ', ' ')}</h1>
          <p class="h-lead ct__lead">
            {typograph(`${modelsCount} фабрики ${SITE.name} — от ${rub(minPrice)} за полотно. Образцы всех покрытий стоят в салоне в ${SITE.address.mall}: цвета и фактуры можно сравнить вживую. Замер и монтаж по Москве и области.`)}
          </p>
        </header>

        <CatalogClient
          client:idle
          cards={cards}
          series={allSeries}
          coatings={allCoatings}
          coatingCards={coatingCards}
          hideTitle
        />
      </div>
    </section>

    <section id="coatings" class="h-sec h-sec--wall" aria-labelledby="coatings-title">
      <div class="container">
        <header class="h-head">
          <h2 id="coatings-title" class="h-h2">О&nbsp;покрытиях и&nbsp;сериях</h2>
          <p class="h-lead">{typograph('Покрытие определяет, как дверь выглядит, как ощущается рукой и как переносит влажную уборку. Серия — рисунок полотна и конструкция.')}</p>
        </header>

        <ul class="co-list" role="list">
          {coatingGroups.map((g) => (
            <li class="co" id={`coating-${g.slug}`}>
              <div class="co__text">
                <h3 class="co__name">{g.name}</h3>
                <p class="h-meta co__facts">
                  {g.series.length} {pluralRu(g.series.length, ['серия', 'серии', 'серий'])}{g.minPrice && <>, от&nbsp;{rub(g.minPrice)} за&nbsp;полотно</>}
                </p>
                {g.tagline && <p class="co__tagline">{typograph(g.tagline)}</p>}
                <p class="h-body co__desc">{typograph(g.description)}</p>
                <a href={g.link.href} class="h-pill h-pill--line co__link">{g.link.label}</a>
              </div>
              <ul class="co__series" role="list" aria-label={`Серии: ${g.name}`}>
                {g.series.map((s) => (
                  <li>
                    <a href={`/catalog/series/${s.slug}/`} class="co__serie">
                      <span class="co__serie-name">{s.name}</span>
                      {s.minPrice && <span class="h-meta co__serie-price">от&nbsp;{rub(s.minPrice)}</span>}
                      <span class="co__serie-arrow" aria-hidden="true"><Fragment set:html={arrow} /></span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="h-sec" aria-labelledby="picks-title">
      <div class="container">
        <header class="h-head">
          <h2 id="picks-title" class="h-h2">Подборки</h2>
          <p class="h-lead">{typograph('Модели под цвет и стиль интерьера — с описанием, как их сочетать.')}</p>
        </header>
        <div class="pk">
          {[
            { title: 'По цвету', items: COLOR_CATEGORIES },
            { title: 'По стилю', items: STYLE_CATEGORIES },
          ].map((group) => (
            <div class="pk__group">
              <h3 class="pk__title">{group.title}</h3>
              <ul class="pk__list" role="list">
                {group.items.map((c) => (
                  <li><a href={`/catalog/${c.slug}/`} class="h-pill h-pill--line">{pickLabel(c.h1)}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="faq" class="h-sec h-sec--wall" aria-labelledby="faq-title">
      <div class="container h-faq">
        <h2 id="faq-title" class="h-h2">Вопросы о&nbsp;межкомнатных дверях</h2>
        <div>
          <FaqAccordion items={catalogFaq} title={false} />
        </div>
      </div>
    </section>

    <VisitBand lead="Образцы покрытий и двери из каталога стоят в салоне: сравните цвета вживую, подберите фурнитуру и рассчитайте комплект с менеджером." />
  </div>
</BaseLayout>

<style>
  /* ── Шапка раздела и каталог ── */
  .ct { padding-block: clamp(1rem, 2vw, 1.5rem) var(--h-sec); }
  .ct__head {
    display: grid;
    gap: 1.25rem var(--h-gutter);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 62.5rem) {
    .ct__head { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .ct__head > .h-h1 { grid-column: 1 / span 7; }
    .ct__lead { grid-column: 8 / span 5; }
  }

  /* ── Покрытия: строки под линейками — фото, текст, серии ── */
  .co-list { margin: 0; padding: 0; list-style: none; }
  .co {
    display: grid;
    gap: 1.5rem var(--h-gutter);
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 0.0625rem solid var(--h-rule);
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }
  .co:last-child { border-bottom: 0.0625rem solid var(--h-rule); }
  @media (min-width: 62.5rem) {
    .co { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .co__text { grid-column: 1 / span 7; padding-right: var(--h-gutter); }
    .co__series { grid-column: 9 / span 4; }
  }
  .co__name {
    margin: 0;
    font-family: var(--h-font);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: var(--h-weight-display);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--h-ink);
  }
  .co__facts { margin: 0.5rem 0 0; }
  .co__tagline { margin: 1.25rem 0 0; font-size: 1rem; font-weight: 600; line-height: 1.4; color: var(--h-ink); }
  .co__desc { margin-top: 0.5rem; font-size: 0.9375rem; }
  .co__tagline + .co__desc { margin-top: 0.375rem; }
  .co__text > .co__desc:first-of-type:not(.co__tagline + .co__desc) { margin-top: 1.25rem; }
  .co__link { margin-top: 1.5rem; }

  /* Список серий начинается вровень с названием покрытия; линейка сверху —
     общая у строки покрытия */
  .co__series { margin: -0.875rem 0 0; padding: 0; list-style: none; align-self: start; }
  .co__serie {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    border-bottom: 0.0625rem solid var(--h-rule);
    color: var(--h-ink);
    text-decoration: none;
  }
  .co__serie-name { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
  .co__serie-arrow {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    color: var(--h-muted);
    transition: transform 220ms var(--ease-out), background-color 220ms var(--ease-out), color 220ms var(--ease-out);
  }
  .co__serie:hover .co__serie-arrow { background: var(--h-signal); color: var(--color-white); transform: rotate(45deg); }

  /* ── Подборки ── */
  .pk { display: grid; gap: 2rem var(--h-gutter); }
  @media (min-width: 56.25rem) {
    .pk { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .pk__group { grid-column: span 6; }
  }
  .pk__group { padding-top: 1.25rem; border-top: 0.0625rem solid var(--h-rule); }
  .pk__title { margin: 0 0 1rem; font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.01em; color: var(--h-ink); }
  .pk__list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }

  @media (prefers-reduced-motion: reduce) {
    .co__serie-arrow { transition: none; }
    .co__serie:hover .co__serie-arrow { transform: none; }
  }
</style>
