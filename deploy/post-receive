#!/bin/bash
set -euo pipefail

BRANCH="main"
GIT_DIR="/var/repo/vfd-moscow-compas.git"
BUILD_DIR="/var/www/dveriziz.ru/build"
# Тот же каталог, что root в nginx (setup-server.sh)
WEB_ROOT="/var/www/dveriziz.ru/public"
ENV_FILE="$BUILD_DIR/.env.production"

export GIT_DIR
export GIT_WORK_TREE="$BUILD_DIR"

while read -r _ _ ref; do
  if [ "$ref" = "refs/heads/$BRANCH" ]; then
    echo "==> Deploying branch: $BRANCH"

    mkdir -p "$BUILD_DIR" "$WEB_ROOT"
    git checkout -f "$BRANCH"
    cd "$BUILD_DIR"

    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    export HOME="${HOME:-/root}"

    # Node ставит setup-server.sh через nvm — в окружении хука его нет в PATH
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    if [ -s "$NVM_DIR/nvm.sh" ]; then
      # shellcheck disable=SC1091
      . "$NVM_DIR/nvm.sh"
      nvm use default >/dev/null
    fi

    # Ключи Supabase — только в каталоге сборки, не в веб-руте (оттуда
    # nginx отдал бы файл любому посетителю)
    if [ -f "$ENV_FILE" ]; then
      set -a
      # shellcheck disable=SC1090
      source "$ENV_FILE"
      set +a
    else
      echo "ERROR: $ENV_FILE not found — fill it in (see setup-server.sh)"
      exit 1
    fi

    echo "==> Node $(node -v), npm $(npm -v)"

    echo "==> Installing dependencies"
    npm ci

    echo "==> Building site"
    npm run build

    echo "==> Publishing static files to $WEB_ROOT"
    rsync -a --delete dist/ "$WEB_ROOT/"

    chown -R www-data:www-data "$WEB_ROOT"
    echo "==> Deploy complete: https://dveriziz.ru"
  fi
done
